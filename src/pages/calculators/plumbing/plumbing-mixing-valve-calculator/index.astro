---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import RelatedCalculators from "@/components/RelatedCalculators.astro";
import CalculatorBreadcrumb from "@/components/CalculatorBreadcrumb.astro";
import CalculatorFaqSection from "@/components/CalculatorFaqSection.astro";
import CalculatorTradesQuoteCta from "@/components/CalculatorTradesQuoteCta.astro";
import { buildFaqPageSchema, type CalculatorFaq } from "@/lib/calculatorFaq";
import { plumbingAccentStyles } from "@/config/plumbingCalculators";
import { fmt, mixedFlow } from "@/lib/plumbing";

const title = "Mixing Valve Calculator — Tempered Water Ratio | TradesQuote";
const description =
  "Free mixing valve calculator. Split a tempered flow into its hot and cold parts, and see how much extra usable hot water storing at 140 °F and tempering to 120 °F gets out of the same tank.";

const pageUrl = "https://www.tradesquote.ai/calculators/plumbing/plumbing-mixing-valve-calculator";

const breadcrumbData = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: "https://www.tradesquote.ai/" },
    { "@type": "ListItem", position: 2, name: "Calculators", item: "https://www.tradesquote.ai/calculators" },
    { "@type": "ListItem", position: 3, name: "Plumbing", item: "https://www.tradesquote.ai/calculators/plumbing" },
    { "@type": "ListItem", position: 4, name: "Mixing Valve Calculator", item: pageUrl },
  ],
};

const webAppData = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: "Mixing Valve Calculator",
  url: pageUrl,
  applicationCategory: "BusinessApplication",
  operatingSystem: "Any (web-based)",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  description:
    "Free online thermostatic mixing valve calculator that splits a tempered flow into hot and cold components from an energy balance and reports the effective storage gain from tempering.",
};

const base = { hotF: 140, coldF: 50, mixF: 120, mixedGpm: 2.5 };
const defaults = mixedFlow(base);
const TANK = 50;
const effective = TANK * defaults.storageMultiplier;

const faqs: CalculatorFaq[] = [
  {
    question: "How much hot water does a 120 °F mix actually use?",
    answer: `Less than you would guess. Delivering 2.5 gpm at 120 °F from a 140 °F tank and 50 °F cold takes <strong>${fmt(defaults.hotFraction * 100, 1)}%</strong> hot — <strong>${fmt(defaults.hotGpm, 2)} gpm</strong> from the heater and ${fmt(defaults.coldGpm, 2)} gpm of cold blended in. Every delivered gallon is only part tank water, which is exactly why tempering stretches a heater.`,
  },
  {
    question: "How does a mixing valve make a tank bigger?",
    answer: `It does not add water, it dilutes it. At these settings each delivered gallon uses only ${fmt(defaults.hotFraction, 3)} of a gallon from the tank, so a <strong>${TANK}-gallon tank yields about ${fmt(effective, 1)} gallons</strong> of usable 120 °F water — a <strong>${fmt(defaults.storageMultiplier, 2)}×</strong> multiplier. Storing hotter increases it further; delivering hotter reduces it.`,
  },
  {
    question: "Why store at 140 °F and deliver at 120 °F rather than just storing at 120?",
    answer:
      "Two problems pull in opposite directions and tempering solves both. <em>Legionella</em> grows in the range roughly 77 to 113 °F, so storage wants to be hot. But 140 °F water can cause a serious scald in about five seconds, so delivery wants to be cool. Storing at 140 and tempering down to 120 at the valve satisfies both — and gains capacity as a side effect.",
  },
  {
    question: "What is the formula?",
    answer:
      "A straight energy balance: <strong>hot fraction = (T<sub>mix</sub> − T<sub>cold</sub>) ÷ (T<sub>hot</sub> − T<sub>cold</sub>)</strong>. Everything else follows from it. There is no fudge factor and no equipment constant — it is conservation of energy on two streams of the same fluid.",
  },
  {
    question: "Does the cold inlet temperature change the answer?",
    answer: `Yes, seasonally. With 140 °F storage delivering 120 °F, a 70 °F summer inlet needs <strong>${fmt(mixedFlow({ ...base, coldF: 70 }).hotFraction * 100, 1)}%</strong> hot, while a 40 °F winter inlet needs <strong>${fmt(mixedFlow({ ...base, coldF: 40 }).hotFraction * 100, 1)}%</strong>. Colder incoming water means less of it can be blended in, so the tank drains faster in winter — on top of the heater recovering more slowly.`,
  },
  {
    question: "Where is a mixing valve actually required?",
    answer:
      "It varies by fixture and jurisdiction, and it is worth checking rather than assuming. Tub and shower valves have long needed scald protection, and many codes now require tempered water at other fixtures too, with separate requirements for public lavatories. A master valve at the heater and point-of-use valves at fixtures serve different purposes — check what your AHJ enforces.",
  },
  {
    question: "Which valve standard should I look for?",
    answer:
      "<strong>ASSE 1017</strong> covers master mixing valves at the source; <strong>ASSE 1070</strong> covers point-of-use temperature-actuated devices at fixtures; <strong>ASSE 1016</strong> covers the shower and tub valves themselves. They are not interchangeable — a master valve does not satisfy a fixture requirement, and vice versa.",
  },
];
const faqData = buildFaqPageSchema(faqs);

const ctaHeading = "Tempering sorted? Quote the whole job in seconds.";
const ctaDescription =
  "A mixing valve is a small line on an invoice that usually arrives with a heater, an expansion tank and a permit. TradesQuote turns the whole scope into a detailed, line-item estimate with quantities and unit prices, validated by a built-in quality control agent and ready for your client to sign online.";

const relatedCalculators = [
  {
    href: "/calculators/plumbing/plumbing-water-heater-size-calculator",
    title: "Water Heater Size Calculator",
    description: "Size the tank this valve is stretching.",
  },
  {
    href: "/calculators/plumbing/plumbing-tankless-water-heater-calculator",
    title: "Tankless Water Heater Calculator",
    description: "Flow by temperature rise, the same physics.",
  },
  {
    href: "/calculators/plumbing/plumbing-expansion-tank-calculator",
    title: "Thermal Expansion Tank Calculator",
    description: "Hot storage on a closed system needs one.",
  },
  {
    href: "/calculators/plumbing/plumbing-pipe-velocity-calculator",
    title: "Pipe Velocity Calculator",
    description: "Hot lines get the lower 5 ft/s limit.",
  },
];

/** Tables computed from the lib. */
const storeTable = [120, 130, 140, 150, 160].map((hotF) => {
  const r = mixedFlow({ ...base, hotF });
  return { hotF, pct: r.hotFraction * 100, hotGpm: r.hotGpm, effective: TANK * r.storageMultiplier };
});

const coldTable = [70, 60, 50, 40].map((coldF) => {
  const r = mixedFlow({ ...base, coldF });
  return { coldF, pct: r.hotFraction * 100, hotGpm: r.hotGpm, effective: TANK * r.storageMultiplier };
});

const deliverTable = [105, 110, 115, 120, 125].map((mixF) => {
  const r = mixedFlow({ ...base, mixF });
  return { mixF, pct: r.hotFraction * 100, effective: TANK * r.storageMultiplier };
});

const styles = plumbingAccentStyles.violet;
---

<Layout {title} {description}>
  <Fragment slot="head">
    <link rel="canonical" href={pageUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Mixing Valve Calculator — Tempered Water Ratio" />
    <meta
      property="og:description"
      content="Split a tempered flow into hot and cold, and see the extra usable hot water tempering gets from the same tank. Free and instant."
    />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:site_name" content="TradesQuote" />
    <meta property="og:image" content="https://www.tradesquote.ai/logo.svg" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Mixing Valve Calculator — Tempered Water Ratio" />
    <meta
      name="twitter:description"
      content="Hot and cold split for any tempered flow, plus the storage multiplier. Free, instant, no sign-up."
    />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbData)} />
    <script type="application/ld+json" set:html={JSON.stringify(webAppData)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqData)} />
  </Fragment>

  <div class="bg-white min-h-screen text-slate-700">
    <Header />

    <main>
      <!-- ==== HERO ==== -->
      <section class="relative overflow-hidden bg-gradient-to-b from-slate-50 to-white">
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pt-10 pb-6">
          <CalculatorBreadcrumb
            category="Plumbing"
            categoryHref="/calculators/plumbing"
            current="Mixing Valve Calculator"
          />

          <div class="max-w-3xl">
            <span
              class="inline-flex items-center gap-1.5 rounded-full bg-violet-100 px-3 py-1 text-xs font-semibold text-violet-700"
            >
              <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8 7h12m0 0l-4-4m4 4l-4 4m4 6H4m0 0l4 4m-4-4l4-4" />
              </svg>
              Plumbing Tools · ASSE 1017 / 1070 · Free
            </span>

            <h1 class="mt-4 text-4xl sm:text-5xl font-extrabold tracking-tight text-slate-900">
              Mixing Valve Calculator <span class="text-violet-600">— Tempered Water Ratio</span>
            </h1>

            <p class="mt-5 text-lg text-slate-600 leading-relaxed">
              Storing hot and tempering down solves two problems at once — <em>Legionella</em> needs heat to
              suppress it, and skin needs the water cooler than that. The side effect is the interesting part:
              because every tempered gallon is only part tank water, a
              <strong>{TANK}-gallon tank delivers about {fmt(effective, 1)} gallons</strong> of usable 120 °F
              water. This splits any tempered flow into its hot and cold halves and shows that gain.
            </p>
          </div>
        </div>
      </section>

      <!-- ==== CALCULATOR ==== -->
      <section id="calculator" class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pb-12">
        <div class="mx-auto max-w-5xl rounded-2xl border border-slate-200 bg-white p-6 sm:p-8 shadow-sm">
          <h2 class="text-xl font-bold text-slate-900 flex items-center gap-2">
            <svg class="h-5 w-5 text-violet-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8 7h12m0 0l-4-4m4 4l-4 4m4 6H4m0 0l4 4m-4-4l4-4"></path>
            </svg>
            Work out the mix
          </h2>

          <div class="mt-6 lg:grid lg:grid-cols-2 lg:gap-8 lg:items-start">
            <div class="space-y-6">
              <div>
                <div class="flex items-center justify-between">
                  <label for="mv-hot" class="text-sm font-semibold text-slate-800">Stored temperature</label>
                  <div class="flex items-center gap-1">
                    <input
                      id="mv-hot"
                      type="number"
                      min="80"
                      max="200"
                      value="140"
                      class="w-24 rounded-lg border border-slate-300 px-3 py-1.5 text-right text-sm font-semibold text-slate-900 focus:border-violet-500 focus:ring-2 focus:ring-violet-200 outline-none"
                    />
                    <span class="text-sm text-slate-500">°F</span>
                  </div>
                </div>
                <input
                  id="mv-hot-range"
                  type="range"
                  min="100"
                  max="180"
                  step="1"
                  value="140"
                  class="plumb-range mt-3 w-full bg-slate-200 accent-violet-600"
                />
                <div class="flex justify-between text-xs text-slate-400 mt-1">
                  <span>100</span><span>180 °F</span>
                </div>
                <p class="mt-1.5 text-xs text-slate-500">
                  140 °F suppresses <em>Legionella</em>; below about 113 °F it can grow.
                </p>
              </div>

              <div class="grid sm:grid-cols-2 gap-5">
                <div>
                  <label for="mv-cold" class="text-sm font-semibold text-slate-800">Cold inlet</label>
                  <div class="mt-2 flex items-center gap-2">
                    <input
                      id="mv-cold"
                      type="number"
                      min="32"
                      max="100"
                      value="50"
                      class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm text-slate-900 focus:border-violet-500 focus:ring-2 focus:ring-violet-200 outline-none"
                    />
                    <span class="text-sm text-slate-500 shrink-0">°F</span>
                  </div>
                  <p class="mt-1.5 text-xs text-slate-500">Seasonal — use the winter figure.</p>
                </div>

                <div>
                  <label for="mv-mix" class="text-sm font-semibold text-slate-800">Delivered temperature</label>
                  <div class="mt-2 flex items-center gap-2">
                    <input
                      id="mv-mix"
                      type="number"
                      min="60"
                      max="180"
                      value="120"
                      class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm text-slate-900 focus:border-violet-500 focus:ring-2 focus:ring-violet-200 outline-none"
                    />
                    <span class="text-sm text-slate-500 shrink-0">°F</span>
                  </div>
                  <p class="mt-1.5 text-xs text-slate-500">120 °F is the usual scald-safe setting.</p>
                </div>

                <div>
                  <label for="mv-flow" class="text-sm font-semibold text-slate-800">Delivered flow</label>
                  <div class="mt-2 flex items-center gap-2">
                    <input
                      id="mv-flow"
                      type="number"
                      min="0"
                      max="100"
                      step="0.1"
                      value="2.5"
                      class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm text-slate-900 focus:border-violet-500 focus:ring-2 focus:ring-violet-200 outline-none"
                    />
                    <span class="text-sm text-slate-500 shrink-0">gpm</span>
                  </div>
                  <p class="mt-1.5 text-xs text-slate-500">A code-compliant shower head is 2.5 gpm.</p>
                </div>

                <div>
                  <label for="mv-tank" class="text-sm font-semibold text-slate-800">Tank size</label>
                  <div class="mt-2 flex items-center gap-2">
                    <input
                      id="mv-tank"
                      type="number"
                      min="0"
                      max="500"
                      value="50"
                      class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm text-slate-900 focus:border-violet-500 focus:ring-2 focus:ring-violet-200 outline-none"
                    />
                    <span class="text-sm text-slate-500 shrink-0">gal</span>
                  </div>
                  <p class="mt-1.5 text-xs text-slate-500">Used to show the effective capacity gain.</p>
                </div>
              </div>

              <button
                id="mv-reset"
                type="button"
                class="text-sm font-medium text-slate-500 hover:text-violet-600 transition flex items-center gap-1.5"
              >
                <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"
                  ></path>
                </svg>
                Reset to defaults
              </button>
            </div>

            <!-- Results -->
            <div
              class="mt-6 lg:mt-0 lg:sticky lg:top-6 rounded-xl border border-violet-100 bg-violet-50 p-5 sm:p-6"
            >
              <p class="text-sm font-medium text-slate-600">Hot water in the mix</p>
              <div class="mt-2 flex items-baseline gap-2">
                <span id="mv-hot-pct" class="text-5xl font-extrabold tracking-tight text-violet-600">
                  {fmt(defaults.hotFraction * 100, 1)}%
                </span>
              </div>
              <p id="mv-note" class="mt-1 text-sm font-semibold text-slate-700">
                Storing at 140 °F and delivering 120 °F makes a {TANK} gallon tank behave like{" "}
                {fmt(effective, 1)} gallons of usable hot water.
              </p>

              <div class="mt-6 grid grid-cols-2 gap-3">
                <div class="rounded-xl border border-violet-100 bg-white p-4">
                  <p class="text-xs text-slate-500">From the heater</p>
                  <p id="mv-hot-gpm" class="mt-1 text-2xl font-bold text-slate-900">
                    {fmt(defaults.hotGpm, 2)} gpm
                  </p>
                </div>
                <div class="rounded-xl border border-violet-100 bg-white p-4">
                  <p class="text-xs text-slate-500">Cold blended in</p>
                  <p id="mv-cold-gpm" class="mt-1 text-2xl font-bold text-slate-900">
                    {fmt(defaults.coldGpm, 2)} gpm
                  </p>
                </div>
              </div>

              <div id="mv-warning" class="hidden mt-4 rounded-xl border border-amber-300 bg-amber-100 p-4">
                <p class="text-sm font-semibold text-amber-800">That mix is not achievable</p>
                <p class="mt-1 text-sm text-amber-800">
                  A mixing valve can only blend between the two supplies it has. The delivered temperature has
                  to sit between the cold inlet and the stored temperature.
                </p>
              </div>

              <details class="group mt-5 rounded-xl border border-violet-100 bg-white">
                <summary
                  class="flex items-center justify-between cursor-pointer px-4 py-3 text-sm font-semibold text-slate-800"
                >
                  See the breakdown
                  <svg
                    class="h-4 w-4 text-slate-500 transition-transform group-open:rotate-180"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    viewBox="0 0 24 24"
                  >
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"></path>
                  </svg>
                </summary>
                <div class="px-4 pb-4 text-sm space-y-1.5 text-slate-600">
                  <div class="flex justify-between gap-3">
                    <span>Effective capacity</span><span id="mv-bd-effective" class="font-semibold text-slate-900">—</span>
                  </div>
                  <div class="flex justify-between gap-3">
                    <span>Storage multiplier</span><span id="mv-bd-multiplier" class="font-semibold text-slate-900">—</span>
                  </div>
                  <div class="flex justify-between gap-3">
                    <span>Cold share</span><span id="mv-bd-cold-pct" class="font-semibold text-slate-900">—</span>
                  </div>
                  <div class="flex justify-between gap-3 border-t border-slate-200 pt-1.5 mt-1.5">
                    <span>Scald check</span><span id="mv-bd-scald" class="font-semibold text-slate-900">—</span>
                  </div>
                </div>
              </details>

              <p class="mt-4 text-xs text-slate-500 leading-relaxed">
                Planning estimate. Where tempered water is <em>required</em>, and which ASSE device satisfies
                it, varies by fixture and jurisdiction — confirm with your AHJ. A licensed plumber has final
                say.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- ==== FORMULA ==== -->
      <section class="bg-slate-50 border-y border-slate-200">
        <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-14">
          <h2 class="text-3xl font-extrabold tracking-tight text-slate-900">
            The formula, explained in plain English
          </h2>
          <p class="mt-4 text-slate-600 leading-relaxed">
            One energy balance, and one consequence people rarely notice.
          </p>

          <div
            class="mt-8 rounded-2xl bg-slate-900 p-6 sm:p-8 text-slate-100 font-mono text-sm leading-relaxed overflow-x-auto"
          >
            <div class="text-violet-300"># The split</div>
            <div>hot fraction&nbsp;=&nbsp;(T<sub>mix</sub> − T<sub>cold</sub>) ÷ (T<sub>hot</sub> − T<sub>cold</sub>)</div>
            <div>cold fraction&nbsp;=&nbsp;1 − hot fraction</div>
            <div class="mt-4 text-violet-300"># The flows</div>
            <div>hot gpm&nbsp;=&nbsp;delivered × hot fraction&nbsp;&nbsp;·&nbsp;&nbsp;cold gpm&nbsp;=&nbsp;the rest</div>
            <div class="mt-4 text-violet-300"># The consequence</div>
            <div>storage multiplier&nbsp;=&nbsp;<span class="text-amber-300">1 ÷ hot fraction</span></div>
            <div class="mt-4 text-slate-400"># The defaults, worked through</div>
            <div>
              (120 − 50) ÷ (140 − 50) = 70 ÷ 90 =
              <span class="text-amber-300">{fmt(defaults.hotFraction, 4)}</span>
            </div>
            <div>
              2.5 × {fmt(defaults.hotFraction, 4)} = {fmt(defaults.hotGpm, 2)} gpm hot&nbsp;&nbsp;·&nbsp;&nbsp;{TANK}{" "}
              ÷ {fmt(defaults.hotFraction, 4)} = <span class="text-amber-300">{fmt(effective, 1)} gal</span>
            </div>
          </div>

          <div class="mt-8 grid sm:grid-cols-2 gap-4">
            <div class="rounded-xl border border-slate-200 bg-white p-5">
              <h3 class="font-bold text-slate-900">It is conservation of energy</h3>
              <p class="mt-2 text-sm text-slate-600">
                Two streams of the same fluid at different temperatures, blended to a third. There is no
                equipment constant and no fudge factor — the answer is the same for any valve that achieves the
                mix.
              </p>
            </div>
            <div class="rounded-xl border border-slate-200 bg-white p-5">
              <h3 class="font-bold text-slate-900">The multiplier is just the reciprocal</h3>
              <p class="mt-2 text-sm text-slate-600">
                If a delivered gallon is {fmt(defaults.hotFraction * 100, 1)}% tank water, the tank goes{" "}
                {fmt(defaults.storageMultiplier, 2)}× further. Storing hotter raises it; delivering hotter
                lowers it. At equal temperatures it is exactly 1.
              </p>
            </div>
            <div class="rounded-xl border border-slate-200 bg-white p-5">
              <h3 class="font-bold text-slate-900">Winter costs you twice</h3>
              <p class="mt-2 text-sm text-slate-600">
                A colder inlet means less cold can be blended in, so the tank drains faster — at the same time
                as the burner is recovering more slowly against a bigger rise. Both effects push the same way.
              </p>
            </div>
            <div class="rounded-xl border border-slate-200 bg-white p-5">
              <h3 class="font-bold text-slate-900">Capacity is not free</h3>
              <p class="mt-2 text-sm text-slate-600">
                The extra gallons come from storing hotter, which costs standby heat loss and needs the tank
                and piping rated for it. It is a real gain, not a free one.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- ==== WORKED EXAMPLES ==== -->
      <section class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 py-14">
        <h2 class="text-3xl font-extrabold tracking-tight text-slate-900">Worked examples</h2>
        <p class="mt-4 text-slate-600">
          The defaults, the case where tempering does nothing, and a winter inlet.
        </p>

        <div class="mt-8 space-y-6">
          <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
            <div class="flex items-center gap-3">
              <span
                class="flex h-9 w-9 items-center justify-center rounded-full bg-violet-100 text-violet-700 font-bold"
              >
                1
              </span>
              <h3 class="text-lg font-bold text-slate-900">Standard shower — 140 store, 120 deliver</h3>
            </div>
            <div class="mt-4 rounded-xl bg-slate-50 p-4 font-mono text-sm text-slate-700">
              hot fraction = (120 − 50) ÷ (140 − 50) ={" "}
              <span class="font-bold text-violet-700">{fmt(defaults.hotFraction * 100, 1)}%</span><br />
              hot = 2.5 × {fmt(defaults.hotFraction, 4)} = {fmt(defaults.hotGpm, 2)} gpm<br />
              cold = {fmt(defaults.coldGpm, 2)} gpm<br />
              {TANK} gal tank → <span class="font-bold text-violet-700">{fmt(effective, 1)} gal</span> of
              tempered water
            </div>
            <p class="mt-3 text-sm text-slate-600">
              <span class="font-semibold text-slate-900">Result:</span> {fmt(defaults.storageMultiplier, 2)}×
              the storage, for the cost of running the thermostat 20 degrees higher.
            </p>
          </div>

          <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
            <div class="flex items-center gap-3">
              <span
                class="flex h-9 w-9 items-center justify-center rounded-full bg-violet-100 text-violet-700 font-bold"
              >
                2
              </span>
              <h3 class="text-lg font-bold text-slate-900">Storing at 120 — the valve does nothing</h3>
            </div>
            <div class="mt-4 rounded-xl bg-slate-50 p-4 font-mono text-sm text-slate-700">
              hot fraction = (120 − 50) ÷ (120 − 50) ={" "}
              <span class="font-bold text-violet-700">100%</span><br />
              cold blended = 0.00 gpm<br />
              {TANK} gal tank → {TANK} gal — <span class="font-bold text-violet-700">no gain at all</span>
            </div>
            <p class="mt-3 text-sm text-slate-600">
              <span class="font-semibold text-slate-900">Result:</span> storing at the delivery temperature
              means there is nothing to temper. You lose the capacity multiplier <em>and</em> the tank sits in
              the range where <em>Legionella</em> is happiest. This is the setting to argue against.
            </p>
          </div>

          <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
            <div class="flex items-center gap-3">
              <span
                class="flex h-9 w-9 items-center justify-center rounded-full bg-violet-100 text-violet-700 font-bold"
              >
                3
              </span>
              <h3 class="text-lg font-bold text-slate-900">The same house in January</h3>
            </div>
            <div class="mt-4 rounded-xl bg-slate-50 p-4 font-mono text-sm text-slate-700">
              summer, 70 °F inlet: hot ={" "}
              <span class="font-bold text-violet-700">
                {fmt(mixedFlow({ ...base, coldF: 70 }).hotFraction * 100, 1)}%
              </span>, tank behaves like{" "}
              {fmt(TANK * mixedFlow({ ...base, coldF: 70 }).storageMultiplier, 1)} gal<br />
              winter, 40 °F inlet: hot ={" "}
              <span class="font-bold text-violet-700">
                {fmt(mixedFlow({ ...base, coldF: 40 }).hotFraction * 100, 1)}%
              </span>, tank behaves like{" "}
              {fmt(TANK * mixedFlow({ ...base, coldF: 40 }).storageMultiplier, 1)} gal<br />
              → {fmt(
                TANK * mixedFlow({ ...base, coldF: 70 }).storageMultiplier -
                  TANK * mixedFlow({ ...base, coldF: 40 }).storageMultiplier,
                1,
              )} gallons of effective capacity lost to the season
            </div>
            <p class="mt-3 text-sm text-slate-600">
              <span class="font-semibold text-slate-900">Result:</span> colder water means less of it gets
              blended in, so more comes out of the tank. Combined with the slower winter recovery, this is why
              a heater that coped all summer runs out in January.
            </p>
          </div>
        </div>
