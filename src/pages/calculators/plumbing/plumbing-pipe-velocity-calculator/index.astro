          </h2>
          <p class="mt-4 text-slate-600 leading-relaxed">
            Same flow, same nominal size, six different answers. Bore is what velocity actually depends on.
          </p>

          <div class="mt-8 overflow-x-auto rounded-2xl border border-slate-200 bg-white shadow-sm">
            <table class="w-full text-left text-sm">
              <thead>
                <tr class="border-b border-slate-200 text-slate-500 bg-slate-50">
                  <th class="py-3 px-5 font-semibold">Material</th>
                  <th class="py-3 px-5 font-semibold">Bore at 3/4"</th>
                  <th class="py-3 px-5 font-semibold">Velocity at 10 gpm</th>
                </tr>
              </thead>
              <tbody class="text-slate-700">
                {
                  materialTable.map((row, index) => (
                    <tr class={index === materialTable.length - 1 ? "" : "border-b border-slate-100"}>
                      <td class="py-3 px-5 font-semibold text-slate-900">
                        {PIPE_MATERIAL_LABELS[row.material]}
                      </td>
                      <td class="py-3 px-5">{fmt(row.id, 3)} in</td>
                      <td class="py-3 px-5">
