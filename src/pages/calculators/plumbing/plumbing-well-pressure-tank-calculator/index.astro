              </thead>
              <tbody class="text-slate-700">
                {
                  bandTable.map((row, index) => (
                    <tr class={index === bandTable.length - 1 ? "" : "border-b border-slate-100"}>
                      <td class="py-3 px-5 font-semibold text-slate-900">
                        {row.on} / {row.off} psi
                      </td>
                      <td class="py-3 px-5">{row.span} psi</td>
                      <td class="py-3 px-5">{fmt(row.fraction * 100, 2)}%</td>
