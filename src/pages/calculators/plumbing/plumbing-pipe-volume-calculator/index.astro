---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import RelatedCalculators from "@/components/RelatedCalculators.astro";
import CalculatorBreadcrumb from "@/components/CalculatorBreadcrumb.astro";
import CalculatorFaqSection from "@/components/CalculatorFaqSection.astro";
import CalculatorTradesQuoteCta from "@/components/CalculatorTradesQuoteCta.astro";
import { buildFaqPageSchema, type CalculatorFaq } from "@/lib/calculatorFaq";
import { plumbingAccentStyles } from "@/config/plumbingCalculators";
import {
  CUBIC_INCHES_PER_GALLON,
  PIPE_MATERIAL_LABELS,
  fmt,
  gallonsPerFoot,
  insideDiameter,
  nominalSizes,
  pipeVolume,
  sizeLabel,
  type PipeMaterial,
} from "@/lib/plumbing";

const title = "Pipe Volume Calculator — Gallons in a Pipe | TradesQuote";
const description =
  "Free pipe volume calculator. Gallons, litres and weight of water held in any run of pipe, and how long a tap runs before that standing water is pushed out. Copper, PEX, CPVC, PVC and steel.";

const pageUrl = "https://www.tradesquote.ai/calculators/plumbing/plumbing-pipe-volume-calculator";

const breadcrumbData = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: "https://www.tradesquote.ai/" },
    { "@type": "ListItem", position: 2, name: "Calculators", item: "https://www.tradesquote.ai/calculators" },
    { "@type": "ListItem", position: 3, name: "Plumbing", item: "https://www.tradesquote.ai/calculators/plumbing" },
    { "@type": "ListItem", position: 4, name: "Pipe Volume Calculator", item: pageUrl },
  ],
};

const webAppData = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: "Pipe Volume Calculator",
  url: pageUrl,
  applicationCategory: "BusinessApplication",
  operatingSystem: "Any (web-based)",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  description:
    "Free online pipe volume calculator returning gallons, litres, cubic feet and water weight for any pipe bore and length, plus the time taken to purge the run at a given flow rate.",
};

const MATERIALS: PipeMaterial[] = ["copper-l", "copper-m", "pex", "cpvc-40", "pvc-40", "steel-40"];
const COPPER_SIZES = nominalSizes("copper-l");
const id34 = insideDiameter("copper-l", 0.75) ?? 0;
const defaults = pipeVolume(id34, 50);
const purgeSec = defaults.minutesToPurge(2) * 60;

const faqs: CalculatorFaq[] = [
  {
    question: "How many gallons are in my pipe?",
    answer: `Multiply <strong>0.0408 × the bore squared</strong> to get gallons per foot, then multiply by the length. A 50-foot run of 3/4-inch Type L copper (0.785-inch bore) holds <strong>${fmt(defaults.gallons, 2)} gallons</strong> — ${fmt(defaults.litres, 1)} litres, weighing ${fmt(defaults.weightLb, 1)} lb. The calculator uses the real bore for each material rather than the nominal size.`,
  },
  {
    question: "Why does hot water take so long to arrive?",
    answer: `Because you have to push the cold water already sitting in the pipe out of the way first. That ${fmt(defaults.gallons, 2)} gallons in a 50-foot 3/4-inch run takes <strong>${fmt(purgeSec, 0)} seconds</strong> to clear at 2 gpm — before the hot water even starts to arrive. It is the reason recirculation loops and smaller-bore home runs exist, and why moving the heater closer beats insulating a long run.`,
  },
  {
    question: "What is the formula for pipe volume?",
    answer: `Area times length, converted to gallons: <strong>gal/ft = π ÷ 4 × d² × 12 ÷ ${CUBIC_INCHES_PER_GALLON}</strong>, which collapses to <strong>0.0408 × d²</strong> with d the inside diameter in inches. Cross-check: 1-inch Schedule 40 has a 1.049-inch bore, giving 0.0449 gal/ft against a published 0.0449.`,
  },
  {
    question: "Should I use the nominal size or the actual bore?",
    answer:
      "Always the bore, and the gap is large. Nominal 3/4-inch is 0.785 inch in Type L copper, 0.824 in Schedule 40, and only <strong>0.681 in PEX</strong>. Because volume goes as the square of the bore, that PEX run holds <strong>25% less water</strong> than the copper one at the same nominal size — which is one of the few places PEX's small bore is an advantage.",
  },
  {
    question: "How much does the water in a pipe weigh?",
    answer: `8.33 lb per gallon, so this 50-foot run carries ${fmt(defaults.weightLb, 1)} lb. That is negligible here, but it stops being negligible on a large main: 100 feet of 6-inch Schedule 40 holds about ${fmt(pipeVolume(insideDiameter("pvc-40", 6) ?? 0, 100).gallons, 0)} gallons weighing roughly ${fmt(pipeVolume(insideDiameter("pvc-40", 6) ?? 0, 100).weightLb, 0)} lb, which is a real load on hangers and structure.`,
  },
  {
    question: "What do I need this for besides curiosity?",
    answer:
      "Chlorinating or shock-treating a line, working out an antifreeze or glycol charge, filling and bleeding a system, estimating flush and purge time, sizing a hydrostatic test, and calculating how much water a repipe wastes on start-up. It is also the honest way to answer a client asking why the hot tap is slow.",
  },
  {
    question: "Does it work for a tank or an odd-shaped vessel?",
    answer:
      "For anything round, yes — enter the internal diameter in the custom bore field and the length or height. For a rectangular tank, multiply the three internal dimensions in inches and divide by 231 to get gallons. The custom bore field also lets you handle a pipe size or material this calculator does not list.",
  },
];
const faqData = buildFaqPageSchema(faqs);

const ctaHeading = "Volume worked out? Quote the whole job in seconds.";
const ctaDescription =
  "Pipe, fittings and the labour to run them are the bulk of most plumbing invoices. TradesQuote turns the scope into a detailed, line-item estimate with quantities and unit prices, validated by a built-in quality control agent and ready for your client to sign online.";

const relatedCalculators = [
  {
    href: "/calculators/plumbing/plumbing-unit-converter",
    title: "Plumbing Unit Converter",
    description: "Move between gallons, litres and cubic metres.",
  },
  {
    href: "/calculators/plumbing/plumbing-pipe-size-calculator",
    title: "Water Pipe Size Calculator",
    description: "Size the run against velocity and pressure.",
  },
  {
    href: "/calculators/plumbing/plumbing-pipe-velocity-calculator",
    title: "Pipe Velocity Calculator",
    description: "Same bore data, different question.",
  },
  {
    href: "/calculators/plumbing/plumbing-water-heater-size-calculator",
    title: "Water Heater Size Calculator",
    description: "System volume includes the water in the pipes.",
  },
];

/** Tables computed from the lib. */
const sizeTable = COPPER_SIZES.filter((n) => n <= 3).map((n) => {
  const cu = insideDiameter("copper-l", n) ?? 0;
  const pvc = insideDiameter("pvc-40", n) ?? 0;
  const pex = insideDiameter("pex", n);
  return {
    nominal: n,
    cu: gallonsPerFoot(cu),
    pvc: gallonsPerFoot(pvc),
    pex: pex === null ? null : gallonsPerFoot(pex),
  };
});

const runTable = [1, 2, 3, 4, 6].map((n) => {
  const id = insideDiameter("pvc-40", n) ?? 0;
  const r = pipeVolume(id, 100);
  return { nominal: n, id, gallons: r.gallons, weight: r.weightLb };
});

const purgeTable = [20, 40, 50, 75, 100].map((lengthFt) => {
  const r = pipeVolume(id34, lengthFt);
  return { lengthFt, gallons: r.gallons, sec: r.minutesToPurge(2) * 60 };
});

const styles = plumbingAccentStyles.sky;
---

<Layout {title} {description}>
  <Fragment slot="head">
    <link rel="canonical" href={pageUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Pipe Volume Calculator — Gallons in a Pipe" />
    <meta
      property="og:description"
      content="Gallons, litres and weight of water in any run of pipe, plus how long the tap runs before it clears. Free and instant."
    />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:site_name" content="TradesQuote" />
    <meta property="og:image" content="https://www.tradesquote.ai/logo.svg" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Pipe Volume Calculator — Gallons in a Pipe" />
    <meta
      name="twitter:description"
      content="How much water a run of pipe holds, and how long it takes to purge. Free, instant, no sign-up."
    />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbData)} />
    <script type="application/ld+json" set:html={JSON.stringify(webAppData)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqData)} />
  </Fragment>

  <div class="bg-white min-h-screen text-slate-700">
    <Header />

    <main>
      <!-- ==== HERO ==== -->
      <section class="relative overflow-hidden bg-gradient-to-b from-slate-50 to-white">
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pt-10 pb-6">
          <CalculatorBreadcrumb
            category="Plumbing"
            categoryHref="/calculators/plumbing"
            current="Pipe Volume Calculator"
          />

          <div class="max-w-3xl">
            <span
              class="inline-flex items-center gap-1.5 rounded-full bg-sky-100 px-3 py-1 text-xs font-semibold text-sky-700"
            >
              <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 2.69l5.66 5.66a8 8 0 11-11.31 0z" />
              </svg>
              Plumbing Tools · Free
            </span>

            <h1 class="mt-4 text-4xl sm:text-5xl font-extrabold tracking-tight text-slate-900">
              Pipe Volume Calculator <span class="text-sky-600">— Gallons in a Pipe</span>
            </h1>

            <p class="mt-5 text-lg text-slate-600 leading-relaxed">
              Useful for chlorinating a line, charging a system with glycol, sizing a hydrostatic test — and
              for the question every homeowner asks. Hot water is slow to arrive because
              <strong>you have to push the cold water already in the pipe out first</strong>, and this tells
              you exactly how much that is and how long it takes.
            </p>
          </div>
        </div>
      </section>

      <!-- ==== CALCULATOR ==== -->
      <section id="calculator" class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pb-12">
        <div class="mx-auto max-w-5xl rounded-2xl border border-slate-200 bg-white p-6 sm:p-8 shadow-sm">
          <h2 class="text-xl font-bold text-slate-900 flex items-center gap-2">
            <svg class="h-5 w-5 text-sky-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"></path>
            </svg>
            Work out the volume
          </h2>

          <div class="mt-6 lg:grid lg:grid-cols-2 lg:gap-8 lg:items-start">
            <div class="space-y-6">
              <div>
                <div class="flex items-center justify-between">
                  <label for="pvol-length" class="text-sm font-semibold text-slate-800">Pipe length</label>
                  <div class="flex items-center gap-1">
                    <input
                      id="pvol-length"
                      type="number"
                      min="0"
                      max="10000"
                      value="50"
                      class="w-24 rounded-lg border border-slate-300 px-3 py-1.5 text-right text-sm font-semibold text-slate-900 focus:border-sky-500 focus:ring-2 focus:ring-sky-200 outline-none"
                    />
                    <span class="text-sm text-slate-500">ft</span>
                  </div>
                </div>
                <input
                  id="pvol-length-range"
                  type="range"
                  min="5"
                  max="500"
                  step="5"
                  value="50"
                  class="plumb-range mt-3 w-full bg-slate-200 accent-sky-600"
                />
                <div class="flex justify-between text-xs text-slate-400 mt-1">
                  <span>5</span><span>500 ft</span>
                </div>
              </div>

              <div class="grid sm:grid-cols-2 gap-5">
                <div class="sm:col-span-2">
                  <label for="pvol-material" class="text-sm font-semibold text-slate-800">Pipe material</label>
                  <select
                    id="pvol-material"
                    class="mt-2 w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm text-slate-900 focus:border-sky-500 focus:ring-2 focus:ring-sky-200 outline-none"
                  >
                    {
                      MATERIALS.map((m) => (
                        <option value={m} selected={m === "copper-l"}>
                          {PIPE_MATERIAL_LABELS[m]}
                        </option>
                      ))
                    }
                  </select>
                </div>

                <div>
                  <label for="pvol-size" class="text-sm font-semibold text-slate-800">Nominal size</label>
                  <select
                    id="pvol-size"
                    class="mt-2 w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm text-slate-900 focus:border-sky-500 focus:ring-2 focus:ring-sky-200 outline-none"
                  >
                    {
                      COPPER_SIZES.map((n) => (
                        <option value={n} selected={n === 0.75}>
                          {sizeLabel(n)}
                        </option>
                      ))
                    }
                  </select>
                </div>

                <div>
                  <label for="pvol-flow" class="text-sm font-semibold text-slate-800">Flow rate</label>
                  <div class="mt-2 flex items-center gap-2">
                    <input
                      id="pvol-flow"
                      type="number"
                      min="0"
                      max="500"
                      step="0.1"
                      value="2"
                      class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm text-slate-900 focus:border-sky-500 focus:ring-2 focus:ring-sky-200 outline-none"
                    />
                    <span class="text-sm text-slate-500 shrink-0">gpm</span>
                  </div>
                  <p class="mt-1.5 text-xs text-slate-500">Used for the purge time.</p>
                </div>

                <div class="sm:col-span-2">
                  <label for="pvol-custom-id" class="text-sm font-semibold text-slate-800">
                    Custom bore (optional)
                  </label>
                  <div class="mt-2 flex items-center gap-2">
                    <input
                      id="pvol-custom-id"
                      type="number"
                      min="0"
                      max="120"
                      step="0.001"
                      placeholder="leave blank to use the size above"
                      class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm text-slate-900 focus:border-sky-500 focus:ring-2 focus:ring-sky-200 outline-none"
                    />
                    <span class="text-sm text-slate-500 shrink-0">in</span>
                  </div>
                  <p class="mt-1.5 text-xs text-slate-500">
                    Overrides the pickers — use it for an unlisted size, a tank, or a well casing.
                  </p>
                </div>
              </div>

              <button
                id="pvol-reset"
                type="button"
                class="text-sm font-medium text-slate-500 hover:text-sky-600 transition flex items-center gap-1.5"
              >
                <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"
                  ></path>
                </svg>
                Reset to defaults
              </button>
            </div>

            <!-- Results -->
            <div class="mt-6 lg:mt-0 lg:sticky lg:top-6 rounded-xl border border-sky-100 bg-sky-50 p-5 sm:p-6">
              <p class="text-sm font-medium text-slate-600">Water held</p>
              <div class="mt-2 flex items-baseline gap-2">
                <span id="pvol-gallons" class="text-5xl font-extrabold tracking-tight text-sky-600">
                  {fmt(defaults.gallons, 2)} gal
                </span>
              </div>
              <p id="pvol-note" class="mt-1 text-sm font-semibold text-slate-700">
                At 2.0 gpm the tap runs {fmt(purgeSec, 0)} seconds before the water standing in this run has
                been pushed out.
              </p>

              <div class="mt-6 grid grid-cols-2 gap-3">
                <div class="rounded-xl border border-sky-100 bg-white p-4">
                  <p class="text-xs text-slate-500">Litres</p>
                  <p id="pvol-litres" class="mt-1 text-2xl font-bold text-slate-900">
                    {fmt(defaults.litres, 1)} L
                  </p>
                </div>
                <div class="rounded-xl border border-sky-100 bg-white p-4">
                  <p class="text-xs text-slate-500">Time to purge</p>
                  <p id="pvol-purge" class="mt-1 text-2xl font-bold text-slate-900">{fmt(purgeSec, 0)} sec</p>
                </div>
              </div>

              <details class="group mt-5 rounded-xl border border-sky-100 bg-white">
                <summary
                  class="flex items-center justify-between cursor-pointer px-4 py-3 text-sm font-semibold text-slate-800"
                >
                  See the breakdown
                  <svg
                    class="h-4 w-4 text-slate-500 transition-transform group-open:rotate-180"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    viewBox="0 0 24 24"
                  >
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"></path>
                  </svg>
                </summary>
                <div class="px-4 pb-4 text-sm space-y-1.5 text-slate-600">
                  <div class="flex justify-between gap-3">
                    <span>Bore used</span><span id="pvol-bd-id" class="font-semibold text-slate-900">—</span>
                  </div>
                  <div class="flex justify-between gap-3">
                    <span>Per foot</span><span id="pvol-bd-per-foot" class="font-semibold text-slate-900">—</span>
                  </div>
                  <div class="flex justify-between gap-3">
                    <span>Cubic feet</span><span id="pvol-bd-cubic" class="font-semibold text-slate-900">—</span>
                  </div>
                  <div class="flex justify-between gap-3">
                    <span>Weight</span><span id="pvol-bd-weight" class="font-semibold text-slate-900">—</span>
                  </div>
                  <div class="flex justify-between gap-3 border-t border-slate-200 pt-1.5 mt-1.5">
                    <span>One size up</span><span id="pvol-bd-next" class="font-semibold text-slate-900">—</span>
                  </div>
                </div>
              </details>

              <p class="mt-4 text-xs text-slate-500 leading-relaxed">
                Geometry only — fittings, valves and the water in the heater are not counted. For a whole
                system, add the appliance volumes separately.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- ==== FORMULA ==== -->
      <section class="bg-slate-50 border-y border-slate-200">
        <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-14">
          <h2 class="text-3xl font-extrabold tracking-tight text-slate-900">
            The formula, explained in plain English
          </h2>
          <p class="mt-4 text-slate-600 leading-relaxed">
            The area of a circle, a length, and one unit conversion.
          </p>

          <div
            class="mt-8 rounded-2xl bg-slate-900 p-6 sm:p-8 text-slate-100 font-mono text-sm leading-relaxed overflow-x-auto"
          >
            <div class="text-sky-300"># The geometry</div>
            <div>
              volume (in³)&nbsp;=&nbsp;π ÷ 4 × d² × length (in)
            </div>
            <div class="mt-4 text-sky-300"># To gallons</div>
            <div>
              gallons&nbsp;=&nbsp;volume ÷ <span class="text-amber-300">{CUBIC_INCHES_PER_GALLON}</span> in³ per
              gallon
            </div>
            <div class="mt-4 text-sky-300"># Collapsed to the working shortcut</div>
            <div>
              gal per ft&nbsp;=&nbsp;π ÷ 4 × d² × 12 ÷ {CUBIC_INCHES_PER_GALLON}&nbsp;=&nbsp;<span
                class="text-amber-300">0.0408</span
              > × d²
            </div>
            <div class="mt-4 text-sky-300"># And the two things people actually want</div>
            <div>weight (lb)&nbsp;=&nbsp;gallons × <span class="text-amber-300">8.33</span></div>
            <div>purge time (min)&nbsp;=&nbsp;gallons ÷ flow (gpm)</div>
            <div class="mt-4 text-slate-400"># The defaults, worked through</div>
            <div>
              0.0408 × 0.785² = {fmt(defaults.perFoot, 4)} gal/ft × 50 ft ={" "}
              <span class="text-amber-300">{fmt(defaults.gallons, 3)} gal</span>
            </div>
          </div>

          <div class="mt-8 grid sm:grid-cols-2 gap-4">
            <div class="rounded-xl border border-slate-200 bg-white p-5">
              <h3 class="font-bold text-slate-900">Bore squared, so it moves fast</h3>
              <p class="mt-2 text-sm text-slate-600">
                Doubling the bore quadruples the volume. Going from 3/4 to 1 inch copper is a 31% wider bore
                and 71% more water standing in the run — which is why oversizing a hot line makes the wait
                worse.
              </p>
            </div>
            <div class="rounded-xl border border-slate-200 bg-white p-5">
              <h3 class="font-bold text-slate-900">Nominal size is not the bore</h3>
              <p class="mt-2 text-sm text-slate-600">
                Nominal 3/4 inch is 0.785 in Type L copper, 0.824 in Schedule 40, and 0.681 in PEX. Every
                figure here uses the real bore, computed from outside diameter and wall thickness.
              </p>
            </div>
            <div class="rounded-xl border border-slate-200 bg-white p-5">
              <h3 class="font-bold text-slate-900">PEX wins this one</h3>
              <p class="mt-2 text-sm text-slate-600">
                PEX's small bore is usually a disadvantage — worse velocity and worse friction. For hot-water
                wait time it is the opposite: a PEX run holds about 25% less water, so it delivers hot sooner.
              </p>
            </div>
            <div class="rounded-xl border border-slate-200 bg-white p-5">
              <h3 class="font-bold text-slate-900">Weight matters at scale</h3>
              <p class="mt-2 text-sm text-slate-600">
                8.33 lb per gallon is nothing on a fixture branch and a real structural load on a large main —
                100 feet of 6-inch holds over half a ton of water before you add the pipe itself.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- ==== WORKED EXAMPLES ==== -->
      <section class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 py-14">
        <h2 class="text-3xl font-extrabold tracking-tight text-slate-900">Worked examples</h2>
        <p class="mt-4 text-slate-600">
          The slow hot tap, chlorinating a well line, and why upsizing makes the wait worse.
        </p>

        <div class="mt-8 space-y-6">
          <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
            <div class="flex items-center gap-3">
              <span class="flex h-9 w-9 items-center justify-center rounded-full bg-sky-100 text-sky-700 font-bold">
                1
              </span>
              <h3 class="text-lg font-bold text-slate-900">Why the far bathroom is slow</h3>
            </div>
            <div class="mt-4 rounded-xl bg-slate-50 p-4 font-mono text-sm text-slate-700">
              50 ft of 3/4" Type L copper, bore 0.785 in<br />
              {fmt(defaults.perFoot, 4)} gal/ft × 50 = <span class="font-bold text-sky-700">
                {fmt(defaults.gallons, 2)} gal
              </span> standing in the pipe<br />
              at 2 gpm: {fmt(defaults.gallons, 2)} ÷ 2 = {fmt(defaults.minutesToPurge(2), 2)} min ={" "}
              <span class="font-bold text-sky-700">{fmt(purgeSec, 0)} seconds</span>
            </div>
            <p class="mt-3 text-sm text-slate-600">
              <span class="font-semibold text-slate-900">Result:</span> {fmt(purgeSec, 0)} seconds of cold
              water before the hot even starts arriving — and that is at full flow. Insulation does not fix
              this; it only keeps the standing water warm for longer between draws.
            </p>
          </div>

          <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
            <div class="flex items-center gap-3">
              <span class="flex h-9 w-9 items-center justify-center rounded-full bg-sky-100 text-sky-700 font-bold">
                2
              </span>
              <h3 class="text-lg font-bold text-slate-900">Chlorinating a service line</h3>
            </div>
            <p class="mt-3 text-sm text-slate-600">
              200 feet of 1-inch Schedule 40 from a well to the house.
            </p>
            <div class="mt-4 rounded-xl bg-slate-50 p-4 font-mono text-sm text-slate-700">
              bore 1.049 in → {fmt(gallonsPerFoot(insideDiameter("pvc-40", 1) ?? 0), 4)} gal/ft<br />
              × 200 ft = <span class="font-bold text-sky-700">
                {fmt(pipeVolume(insideDiameter("pvc-40", 1) ?? 0, 200).gallons, 1)} gal
              </span><br />
              = {fmt(pipeVolume(insideDiameter("pvc-40", 1) ?? 0, 200).litres, 1)} L, weighing{" "}
              {fmt(pipeVolume(insideDiameter("pvc-40", 1) ?? 0, 200).weightLb, 0)} lb
            </div>
            <p class="mt-3 text-sm text-slate-600">
              <span class="font-semibold text-slate-900">Result:</span> knowing the exact volume is what lets
              you dose a disinfection correctly rather than guessing — and it tells you how long to run the
              tap to confirm the chlorine has reached the far end.
            </p>
          </div>

          <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
            <div class="flex items-center gap-3">
              <span class="flex h-9 w-9 items-center justify-center rounded-full bg-sky-100 text-sky-700 font-bold">
                3
              </span>
              <h3 class="text-lg font-bold text-slate-900">Upsizing the hot line backfires</h3>
            </div>
            <div class="mt-4 rounded-xl bg-slate-50 p-4 font-mono text-sm text-slate-700">
              50 ft of 3/4" Type L: {fmt(defaults.gallons, 2)} gal → {fmt(purgeSec, 0)} s at 2 gpm<br />
              50 ft of 1" Type L: {fmt(pipeVolume(insideDiameter("copper-l", 1) ?? 0, 50).gallons, 2)} gal →{" "}
              <span class="font-bold text-sky-700">
                {fmt(pipeVolume(insideDiameter("copper-l", 1) ?? 0, 50).minutesToPurge(2) * 60, 0)} s
              </span><br />
              50 ft of 3/4" PEX: {fmt(pipeVolume(insideDiameter("pex", 0.75) ?? 0, 50).gallons, 2)} gal →{" "}
              <span class="font-bold text-sky-700">
                {fmt(pipeVolume(insideDiameter("pex", 0.75) ?? 0, 50).minutesToPurge(2) * 60, 0)} s
              </span>
            </div>
            <p class="mt-3 text-sm text-slate-600">
              <span class="font-semibold text-slate-900">Result:</span> the 1-inch line makes the wait{" "}
              {fmt(
                pipeVolume(insideDiameter("copper-l", 1) ?? 0, 50).minutesToPurge(2) * 60 - purgeSec,
                0,
              )} seconds <em>longer</em>, and the PEX run makes it{" "}
              {fmt(
                purgeSec - pipeVolume(insideDiameter("pex", 0.75) ?? 0, 50).minutesToPurge(2) * 60,
                0,
              )} seconds shorter. For hot-water branches, smaller bore is the right instinct — the opposite of
              the rule on cold mains.
            </p>
          </div>
        </div>
