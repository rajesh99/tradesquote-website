                  <th class="py-3 px-5 font-semibold">Height</th>
                  <th class="py-3 px-5 font-semibold">Pressure lost</th>
                  <th class="py-3 px-5 font-semibold">Left from 65 psi</th>
                </tr>
              </thead>
              <tbody class="text-slate-700">
                {
                  storeyTable.map((row, index) => (
                    <tr class={index === storeyTable.length - 1 ? "" : "border-b border-slate-100"}>
                      <td class="py-3 px-5 font-semibold text-slate-900">{row.storey}</td>
                      <td class="py-3 px-5">{row.ft} ft</td>
                      <td class="py-3 px-5">{fmt(row.loss, 2)} psi</td>
                      <td class="py-3 px-5">
                        {fmt(row.left, 2)} psi
                        {row.left < 30 && (
                          <span class="ml-2 rounded-full bg-amber-100 px-2 py-0.5 text-xs font-semibold text-amber-800">
                            booster territory
                          </span>
                        )}
                      </td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>

          <h2 class="mt-14 text-3xl font-extrabold tracking-tight text-slate-900">PSI to feet of head</h2>
          <p class="mt-4 text-slate-600 leading-relaxed">
            The conversion both trades need, with the IPC 604.8 threshold marked.
          </p>

          <div class="mt-8 overflow-x-auto rounded-2xl border border-slate-200 bg-white shadow-sm">
            <table class="w-full text-left text-sm">
              <thead>
                <tr class="border-b border-slate-200 text-slate-500 bg-slate-50">
                  <th class="py-3 px-5 font-semibold">Pressure</th>
                  <th class="py-3 px-5 font-semibold">Feet of head</th>
                  <th class="py-3 px-5 font-semibold">PRV required?</th>
                </tr>
              </thead>
              <tbody class="text-slate-700">
                {
                  conversionTable.map((row, index) => (
                    <tr class={index === conversionTable.length - 1 ? "" : "border-b border-slate-100"}>
                      <td class="py-3 px-5 font-semibold text-slate-900">{row.psi} psi</td>
                      <td class="py-3 px-5">{fmt(row.head, 1)} ft</td>
                      <td class="py-3 px-5">
                        {row.prv ? (
                          <span class="rounded-full bg-amber-100 px-2 py-0.5 text-xs font-semibold text-amber-800">
                            Yes — IPC 604.8
                          </span>
                        ) : (
                          "No"
                        )}
                      </td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>

          <p class="mt-6 text-sm text-slate-500">
            Sources &amp; standards: <a
              class="underline hover:text-amber-600"
              href="https://codes.iccsafe.org/codes/i-codes"
              target="_blank"
              rel="noopener">IPC</a
            > 2021 604.8 (maximum flow and water-hammer arrestors — pressure-reducing valve required above 80
            psi) and 607.3 (thermal expansion control on a closed system). The psi-to-head constant is derived
            from the density of water at 60 °F, not taken from a table. Roughly fifteen states use the <a
              class="underline hover:text-amber-600"
              href="https://www.iapmo.org/uniform-plumbing-code"
              target="_blank"
              rel="noopener">UPC</a
            > or a derivative. Local amendments override the model code.
          </p>
        </div>
      </section>

