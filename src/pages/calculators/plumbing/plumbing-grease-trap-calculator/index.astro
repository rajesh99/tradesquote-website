---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import RelatedCalculators from "@/components/RelatedCalculators.astro";
import CalculatorBreadcrumb from "@/components/CalculatorBreadcrumb.astro";
import CalculatorFaqSection from "@/components/CalculatorFaqSection.astro";
import CalculatorTradesQuoteCta from "@/components/CalculatorTradesQuoteCta.astro";
import { buildFaqPageSchema, type CalculatorFaq } from "@/lib/calculatorFaq";
import { plumbingAccentStyles } from "@/config/plumbingCalculators";
import {
  CUBIC_INCHES_PER_GALLON,
  GREASE_INTERCEPTOR_MINIMUM_GAL,
  GREASE_RETENTION_HOURS,
  GREASE_SINK_FILL_FRACTION,
  GREASE_STORAGE_FACTORS,
  GREASE_WASTE_PER_MEAL,
  PDI_GREASE_LB_PER_GPM,
  PDI_GREASE_TRAPS,
  fmt,
  greaseInterceptorVolume,
  greaseTrapHydraulic,
} from "@/lib/plumbing";

const title = "Grease Trap Size Calculator — PDI Flow & Interceptor Volume | TradesQuote";
const description =
  "Free grease trap calculator. Size an under-sink hydromechanical interceptor from sink volume in gpm, or a gravity grease interceptor from seats and meals in gallons — two methods that answer two different questions.";

const pageUrl =
  "https://www.tradesquote.ai/calculators/plumbing/plumbing-grease-trap-calculator";

const breadcrumbData = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: "https://www.tradesquote.ai/" },
    { "@type": "ListItem", position: 2, name: "Calculators", item: "https://www.tradesquote.ai/calculators" },
    { "@type": "ListItem", position: 3, name: "Plumbing", item: "https://www.tradesquote.ai/calculators/plumbing" },
    { "@type": "ListItem", position: 4, name: "Grease Trap Size Calculator", item: pageUrl },
  ],
};

const webAppData = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: "Grease Trap Size Calculator",
  url: pageUrl,
  applicationCategory: "BusinessApplication",
  operatingSystem: "Any (web-based)",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  description:
    "Free online grease trap calculator. Sizes a PDI-rated hydromechanical grease interceptor from three-compartment sink dimensions, and a gravity grease interceptor from seat count, meals, waste flow, retention time and storage factor.",
};

/* ---- Everything below is computed from the lib, never typed from a draft ---- */
const sinkBase = { lengthIn: 24, widthIn: 24, depthIn: 12, compartments: 3 };
const hydraulic = greaseTrapHydraulic(sinkBase);

const interceptorBase = {
  seats: 100,
  turnoverPerHour: 1,
  wasteFlowPerMeal: 6,
  retentionHours: 2.5,
  storageFactor: 1,
};
const interceptor = greaseInterceptorVolume(interceptorBase);

const sinkTable = ([
  [16, 16],
  [18, 18],
  [20, 20],
  [24, 24],
  [30, 24],
] as [number, number][]).map(([lengthIn, widthIn]) => {
  const r = greaseTrapHydraulic({ ...sinkBase, lengthIn, widthIn });
  return { lengthIn, widthIn, gallons: r.gallons, flowGpm: r.flowGpm, ratedGpm: r.ratedGpm, capacityLb: r.capacityLb };
});

const seatTable = [30, 50, 75, 100, 150, 200, 300].map((seats) => {
  const r = greaseInterceptorVolume({ ...interceptorBase, seats });
  return { seats, calculated: r.calculated, required: r.required, stocked: r.stocked, governedBy: r.governedBy };
});

const storageTable = GREASE_STORAGE_FACTORS.map((f) => {
  const r = greaseInterceptorVolume({ ...interceptorBase, storageFactor: f.factor });
  return { label: f.label, factor: f.factor, calculated: r.calculated, stocked: r.stocked };
});

/** The single-compartment volume, used in prose and validated against 231 in³/gal. */
const oneCompartment = (24 * 24 * 12) / CUBIC_INCHES_PER_GALLON;
const smallKitchen = greaseInterceptorVolume({ ...interceptorBase, seats: 50 });
const twentyInch = greaseTrapHydraulic({ ...sinkBase, lengthIn: 20, widthIn: 20 });

const faqs: CalculatorFaq[] = [
  {
    question: "What size grease trap do I need?",
    answer: `It depends which device you mean, and that is the whole problem. For a standard three-compartment sink at 24 × 24 × 12 inches, the hydraulic method gives <strong>${fmt(hydraulic.flowGpm, 1)} gpm</strong>, which takes a <strong>${hydraulic.ratedGpm} gpm PDI interceptor</strong> holding ${hydraulic.capacityLb} lb of grease. For a ${interceptorBase.seats}-seat restaurant, the meal-count method gives <strong>${fmt(interceptor.required, 0)} gallons</strong> of gravity interceptor. Both answers can be right on the same job, because they size two different devices.`,
  },
  {
    question: "What is the difference between a grease trap and a grease interceptor?",
    answer:
      "In everyday use the words are swapped freely, but the devices are not. A <strong>hydromechanical interceptor</strong> — the small steel or plastic box under the sink — is rated in <strong>gpm</strong> and works by slowing flow enough for grease to float. A <strong>gravity grease interceptor</strong> — the buried concrete tank — is rated in <strong>gallons</strong> and works by holding the wastewater long enough for separation to happen on its own. Sizing one with the other's method is the commonest mistake on this subject.",
  },
  {
    question: "Why is the grease capacity always double the flow rating?",
    answer: `Because PDI-G101 defines it that way. A ${PDI_GREASE_TRAPS[4].gpm} gpm unit is rated for ${PDI_GREASE_TRAPS[4].capacityLb} lb of grease, a ${PDI_GREASE_TRAPS[7].gpm} gpm unit for ${PDI_GREASE_TRAPS[7].capacityLb} lb, and so on at ${PDI_GREASE_LB_PER_GPM} lb per gpm right across the range. So "how many pounds" and "how many gpm" are not two specifications to look up — they are one number expressed twice.`,
  },
  {
    question: "Where does the 75% figure come from?",
    answer: `The fixture-volume method assumes a sink compartment is filled to about <strong>${fmt(GREASE_SINK_FILL_FRACTION * 100, 0)}%</strong> of its geometric capacity before it drains, because nobody fills a sink to the rim. The full ${fmt(sinkBase.lengthIn * sinkBase.widthIn * sinkBase.depthIn, 0)} cubic inches of one 24 × 24 × 12 compartment is ${fmt(oneCompartment, 2)} gallons; three of them at ${fmt(GREASE_SINK_FILL_FRACTION * 100, 0)}% is ${fmt(hydraulic.drainedGallons, 1)} gallons, and draining that in one minute is the ${fmt(hydraulic.flowGpm, 1)} gpm the interceptor has to pass. The fill fraction and the drain period are both editable here because jurisdictions vary them.`,
  },
  {
    question: "Why did my calculation come out bigger than the units on the shelf?",
    answer: `Because a full-size three-compartment sink genuinely outruns the small end of the hydromechanical range. A 20 × 20 × 12 sink needs ${twentyInch.ratedGpm} gpm; a 24 × 24 × 12 needs ${hydraulic.ratedGpm}. Past about 50 gpm most authorities want an outdoor gravity interceptor instead, and many will not permit an indoor unit for a commercial kitchen at all. A <strong>flow control fitting</strong> is the other half of the answer — it throttles the line to the interceptor's rated flow, which is why the rating is a design figure rather than a peak one.`,
  },
  {
    question: "Does the plumbing code tell me which size to fit?",
    answer:
      "Not on its own. IPC 1003.3.4 requires interception and permits the authority having jurisdiction to approve a sizing method, which means the real decision usually sits with your <strong>local sewer authority's FOG programme</strong> — fats, oils and grease. Those programmes routinely impose a flat minimum interceptor size, mandate outdoor installation, set pump-out intervals, and require a sample port. Run the numbers here to scope the job, then confirm with the authority before you order anything.",
  },
  {
    question: "Why does a small restaurant still need a 1,000 gallon tank?",
    answer: `Because the floor governs, not the formula. At ${smallKitchen.mealsPerPeakHour} meals in the peak hour the calculation gives only <strong>${fmt(smallKitchen.calculated, 0)} gallons</strong>, but the common ${fmt(GREASE_INTERCEPTOR_MINIMUM_GAL, 0)}-gallon minimum takes over. That crossover happens at around ${fmt(GREASE_INTERCEPTOR_MINIMUM_GAL / (interceptorBase.wasteFlowPerMeal * interceptorBase.retentionHours * interceptorBase.storageFactor), 0)} seats on these defaults — below it, every small kitchen in the jurisdiction gets the same tank.`,
  },
  {
    question: "What is out of scope here?",
    answer:
      "Flow control fittings and their vent, sample ports, the pump-out schedule, effluent limits, and any automatic grease removal unit. Those are set by the FOG programme rather than by arithmetic. This tool sizes the vessel; it does not design the installation, and the meal-count factors are commonly published figures rather than values verified against a primary source — which is why every one of them is an editable field.",
  },
];
const faqData = buildFaqPageSchema(faqs);

const ctaHeading = "Interceptor sized? Quote the whole job in seconds.";
const ctaDescription =
  "A grease interceptor is never a single line — there is excavation or a rough-in, a flow control fitting, the drain modification, and often a sample port. TradesQuote turns the whole scope into a detailed line-item estimate with quantities and unit prices, validated by a built-in quality control agent and ready for your client to sign online.";

const relatedCalculators = [
  {
    href: "/calculators/plumbing/plumbing-drain-pipe-size-calculator",
    title: "Drain Pipe Size Calculator",
    description: "Size the drain feeding the interceptor.",
  },
  {
    href: "/calculators/plumbing/plumbing-drainage-fixture-unit-calculator",
    title: "Drainage Fixture Unit Calculator",
    description: "The DFU load a commercial kitchen puts on it.",
  },
  {
    href: "/calculators/plumbing/plumbing-pipe-slope-calculator",
    title: "Drain Pipe Slope Calculator",
    description: "The fall on the run out to the tank.",
  },
  {
    href: "/calculators/plumbing/plumbing-estimate-calculator",
    title: "Plumbing Estimate Calculator",
    description: "Price the install once it is scoped.",
  },
];

const styles = plumbingAccentStyles.teal;
---

<Layout {title} {description}>
  <Fragment slot="head">
    <link rel="canonical" href={pageUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Grease Trap Size Calculator — PDI Flow & Interceptor Volume" />
    <meta
      property="og:description"
      content="Size an under-sink hydromechanical grease interceptor in gpm, or a gravity grease interceptor in gallons. Two methods, two different devices. Free and instant."
    />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:site_name" content="TradesQuote" />
    <meta property="og:image" content="https://www.tradesquote.ai/logo.svg" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Grease Trap Size Calculator — PDI Flow & Interceptor Volume" />
    <meta
      name="twitter:description"
      content="Hydraulic sizing from sink volume and meal-count sizing for a gravity interceptor, with every FOG-programme variable left editable. Free, no sign-up."
    />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbData)} />
    <script type="application/ld+json" set:html={JSON.stringify(webAppData)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqData)} />
  </Fragment>

  <div class="bg-white min-h-screen text-slate-700">
    <Header />

    <main>
      <!-- ==== HERO ==== -->
      <section class="relative overflow-hidden bg-gradient-to-b from-slate-50 to-white">
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pt-10 pb-6">
          <CalculatorBreadcrumb
            category="Plumbing"
            categoryHref="/calculators/plumbing"
            current="Grease Trap Size Calculator"
          />

          <div class="max-w-3xl">
            <span
              class="inline-flex items-center gap-1.5 rounded-full bg-teal-100 px-3 py-1 text-xs font-semibold text-teal-700"
            >
              <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 2.69l5.66 5.66a8 8 0 11-11.31 0z" />
              </svg>
              Plumbing Tools · IPC 1003.3 · Free
            </span>

            <h1 class="mt-4 text-4xl sm:text-5xl font-extrabold tracking-tight text-slate-900">
              Grease Trap Size Calculator <span class="text-teal-600">— Flow &amp; Interceptor Volume</span>
            </h1>

            <p class="mt-5 text-lg text-slate-600 leading-relaxed">
              Two devices answer to the name "grease trap", and they are sized by two unrelated methods. The
              under-sink <strong>hydromechanical interceptor</strong> is rated in <strong>gpm</strong> and
              sized from how fast the sink empties. The buried <strong>gravity interceptor</strong> is rated in
              <strong>gallons</strong> and sized from how many meals the kitchen serves. Pick a method below —
              and note that on most commercial jobs the local FOG programme, not the arithmetic, has the last
              word.
            </p>
          </div>
        </div>
      </section>

      <!-- ==== CALCULATOR ==== -->
      <section id="calculator" class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pb-12">
        <div class="mx-auto max-w-5xl rounded-2xl border border-slate-200 bg-white p-6 sm:p-8 shadow-sm">
          <h2 class="text-xl font-bold text-slate-900 flex items-center gap-2">
            <svg class="h-5 w-5 text-teal-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"
              ></path>
            </svg>
            Size the interceptor
          </h2>

          <div class="mt-6">
            <label for="gt-method" class="text-sm font-semibold text-slate-800">Which device?</label>
            <select
              id="gt-method"
              class="mt-2 w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm text-slate-900 focus:border-teal-500 focus:ring-2 focus:ring-teal-200 outline-none"
            >
              <option value="hydraulic" selected>
                Hydromechanical interceptor — sized in gpm from the sink
              </option>
              <option value="interceptor">
                Gravity grease interceptor — sized in gallons from the kitchen
              </option>
            </select>
          </div>

          <div class="mt-6 lg:grid lg:grid-cols-2 lg:gap-8 lg:items-start">
            <div class="space-y-6">
              <!-- Hydraulic inputs -->
              <div id="gt-inputs-hydraulic" class="space-y-5">
                <p class="text-sm text-slate-500 leading-relaxed">
                  Measure the <strong>interior</strong> of one compartment, not the outside of the sink.
                </p>

                <div class="grid sm:grid-cols-3 gap-4">
                  <div>
                    <label for="gt-length" class="text-sm font-semibold text-slate-800">Length</label>
                    <div class="mt-2 flex items-center gap-2">
                      <input
                        id="gt-length"
                        type="number"
                        min="1"
                        max="120"
                        value="24"
                        class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm text-slate-900 focus:border-teal-500 focus:ring-2 focus:ring-teal-200 outline-none"
                      />
                      <span class="text-sm text-slate-500 shrink-0">in</span>
                    </div>
                  </div>
                  <div>
                    <label for="gt-width" class="text-sm font-semibold text-slate-800">Width</label>
                    <div class="mt-2 flex items-center gap-2">
                      <input
                        id="gt-width"
                        type="number"
                        min="1"
                        max="120"
                        value="24"
                        class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm text-slate-900 focus:border-teal-500 focus:ring-2 focus:ring-teal-200 outline-none"
                      />
                      <span class="text-sm text-slate-500 shrink-0">in</span>
                    </div>
                  </div>
                  <div>
                    <label for="gt-depth" class="text-sm font-semibold text-slate-800">Depth</label>
                    <div class="mt-2 flex items-center gap-2">
                      <input
                        id="gt-depth"
                        type="number"
                        min="1"
                        max="60"
                        value="12"
                        class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm text-slate-900 focus:border-teal-500 focus:ring-2 focus:ring-teal-200 outline-none"
                      />
                      <span class="text-sm text-slate-500 shrink-0">in</span>
                    </div>
                  </div>
                </div>

                <div class="grid sm:grid-cols-3 gap-4">
                  <div>
                    <label for="gt-compartments" class="text-sm font-semibold text-slate-800">
                      Compartments
                    </label>
                    <input
                      id="gt-compartments"
                      type="number"
                      min="1"
                      max="6"
                      value="3"
                      class="mt-2 w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm text-slate-900 focus:border-teal-500 focus:ring-2 focus:ring-teal-200 outline-none"
                    />
                  </div>
                  <div>
                    <label for="gt-fill" class="text-sm font-semibold text-slate-800">Fill fraction</label>
                    <div class="mt-2 flex items-center gap-2">
                      <input
                        id="gt-fill"
                        type="number"
                        min="10"
                        max="100"
                        value="75"
                        class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm text-slate-900 focus:border-teal-500 focus:ring-2 focus:ring-teal-200 outline-none"
                      />
                      <span class="text-sm text-slate-500 shrink-0">%</span>
                    </div>
                  </div>
                  <div>
                    <label for="gt-period" class="text-sm font-semibold text-slate-800">Drain period</label>
                    <div class="mt-2 flex items-center gap-2">
                      <input
                        id="gt-period"
                        type="number"
                        min="0.5"
                        max="10"
                        step="0.5"
                        value="1"
                        class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm text-slate-900 focus:border-teal-500 focus:ring-2 focus:ring-teal-200 outline-none"
                      />
                      <span class="text-sm text-slate-500 shrink-0">min</span>
                    </div>
                  </div>
                </div>
                <p class="text-xs text-slate-500 leading-relaxed">
                  A one-minute drain period is the usual assumption. Some jurisdictions work it at two, which
                  halves the required rating — check before you rely on it.
                </p>
              </div>

              <!-- Interceptor inputs -->
              <div id="gt-inputs-interceptor" class="hidden space-y-5">
                <div>
                  <div class="flex items-center justify-between">
                    <label for="gt-seats" class="text-sm font-semibold text-slate-800">Seats</label>
                    <div class="flex items-center gap-1">
                      <input
                        id="gt-seats"
                        type="number"
                        min="1"
                        max="1000"
                        value="100"
                        class="w-24 rounded-lg border border-slate-300 px-3 py-1.5 text-right text-sm font-semibold text-slate-900 focus:border-teal-500 focus:ring-2 focus:ring-teal-200 outline-none"
                      />
                      <span class="text-sm text-slate-500">seats</span>
                    </div>
                  </div>
                  <input
                    id="gt-seats-range"
                    type="range"
                    min="10"
                    max="400"
                    step="5"
                    value="100"
                    class="plumb-range mt-3 w-full bg-slate-200 accent-teal-600"
                  />
                  <div class="flex justify-between text-xs text-slate-400 mt-1">
                    <span>10</span><span>400 seats</span>
                  </div>
                </div>

                <div class="grid sm:grid-cols-2 gap-5">
                  <div>
                    <label for="gt-turnover" class="text-sm font-semibold text-slate-800">
                      Turnover per hour
                    </label>
                    <input
                      id="gt-turnover"
                      type="number"
                      min="0.1"
                      max="6"
                      step="0.1"
                      value="1"
                      class="mt-2 w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm text-slate-900 focus:border-teal-500 focus:ring-2 focus:ring-teal-200 outline-none"
                    />
                    <p class="mt-1.5 text-xs text-slate-500">Seatings in the busiest hour. Fast food is higher.</p>
                  </div>

                  <div>
                    <label for="gt-storage" class="text-sm font-semibold text-slate-800">
                      Hours of operation
                    </label>
                    <select
                      id="gt-storage"
                      class="mt-2 w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm text-slate-900 focus:border-teal-500 focus:ring-2 focus:ring-teal-200 outline-none"
                    >
                      {
                        GREASE_STORAGE_FACTORS.map((f) => (
                          <option value={f.factor} selected={f.factor === 1}>
                            {f.label}
                          </option>
                        ))
                      }
                    </select>
                  </div>

                  <div>
                    <label for="gt-waste-preset" class="text-sm font-semibold text-slate-800">Kitchen type</label>
                    <select
                      id="gt-waste-preset"
                      class="mt-2 w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm text-slate-900 focus:border-teal-500 focus:ring-2 focus:ring-teal-200 outline-none"
                    >
                      {
                        GREASE_WASTE_PER_MEAL.map((w) => (
                          <option value={w.gallons} selected={w.gallons === 6}>
                            {w.label}
                          </option>
                        ))
                      }
                    </select>
                  </div>

                  <div>
                    <label for="gt-waste" class="text-sm font-semibold text-slate-800">
                      Waste flow per meal
                    </label>
                    <div class="mt-2 flex items-center gap-2">
                      <input
                        id="gt-waste"
                        type="number"
                        min="0.1"
                        max="20"
                        step="0.1"
                        value="6"
                        class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm text-slate-900 focus:border-teal-500 focus:ring-2 focus:ring-teal-200 outline-none"
                      />
                      <span class="text-sm text-slate-500 shrink-0">gal</span>
                    </div>
                    <p class="mt-1.5 text-xs text-slate-500">Editable — jurisdictions differ.</p>
                  </div>

                  <div>
                    <label for="gt-retention-preset" class="text-sm font-semibold text-slate-800">
                      Retention basis
                    </label>
                    <select
                      id="gt-retention-preset"
                      class="mt-2 w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm text-slate-900 focus:border-teal-500 focus:ring-2 focus:ring-teal-200 outline-none"
                    >
                      {
                        GREASE_RETENTION_HOURS.map((r) => (
                          <option value={r.hours} selected={r.hours === 2.5}>
                            {r.label}
                          </option>
                        ))
                      }
                    </select>
                  </div>

                  <div>
                    <label for="gt-retention" class="text-sm font-semibold text-slate-800">Retention time</label>
                    <div class="mt-2 flex items-center gap-2">
                      <input
                        id="gt-retention"
                        type="number"
                        min="0.5"
                        max="12"
                        step="0.5"
                        value="2.5"
                        class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm text-slate-900 focus:border-teal-500 focus:ring-2 focus:ring-teal-200 outline-none"
                      />
                      <span class="text-sm text-slate-500 shrink-0">hr</span>
                    </div>
                  </div>

                  <div class="sm:col-span-2">
                    <label for="gt-minimum" class="text-sm font-semibold text-slate-800">
                      Local minimum size
                    </label>
                    <div class="mt-2 flex items-center gap-2">
                      <input
                        id="gt-minimum"
                        type="number"
                        min="0"
                        max="10000"
                        step="50"
                        value="1000"
                        class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm text-slate-900 focus:border-teal-500 focus:ring-2 focus:ring-teal-200 outline-none"
                      />
                      <span class="text-sm text-slate-500 shrink-0">gal</span>
                    </div>
                    <p class="mt-1.5 text-xs text-slate-500">
                      Most sewer authorities impose one. Set it to 0 to see the raw calculation.
                    </p>
                  </div>
                </div>
              </div>

              <button
