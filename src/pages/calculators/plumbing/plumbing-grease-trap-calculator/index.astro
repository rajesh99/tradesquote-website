                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"
                  ></path>
                </svg>
                Reset to defaults
              </button>
            </div>

            <!-- Results -->
            <div class="mt-6 lg:mt-0 lg:sticky lg:top-6 rounded-xl border border-teal-100 bg-teal-50 p-5 sm:p-6">
              <!-- Hydraulic result -->
              <div id="gt-result-hydraulic">
                <p class="text-sm font-medium text-slate-600">Interceptor rating</p>
                <div class="mt-2 flex items-baseline gap-2">
                  <span id="gt-rating" class="text-5xl font-extrabold tracking-tight text-teal-600">
                    {hydraulic.ratedGpm} gpm
                  </span>
                </div>
                <p id="gt-h-note" class="mt-1 text-sm font-semibold text-slate-700">
                  Smallest PDI rating covering {fmt(hydraulic.flowGpm, 1)} gpm, holding{" "}
                  {hydraulic.capacityLb} lb of grease — {PDI_GREASE_LB_PER_GPM}× the flow rating, by definition.
                </p>

                <div class="mt-6 grid grid-cols-2 gap-3">
                  <div class="rounded-xl border border-teal-100 bg-white p-4">
                    <p class="text-xs text-slate-500">Required flow</p>
                    <p id="gt-flow" class="mt-1 text-2xl font-bold text-slate-900">
                      {fmt(hydraulic.flowGpm, 1)} gpm
                    </p>
                  </div>
                  <div class="rounded-xl border border-teal-100 bg-white p-4">
                    <p class="text-xs text-slate-500">Grease capacity</p>
                    <p class="mt-1 text-2xl font-bold text-slate-900">{hydraulic.capacityLb} lb</p>
                  </div>
                </div>

                <div id="gt-h-warning" class="hidden mt-4 rounded-xl border border-amber-300 bg-amber-100 p-4">
                  <p class="text-sm font-semibold text-amber-800">Probably an outdoor job</p>
                  <p class="mt-1 text-sm text-amber-800">
                    Past about 50 gpm most authorities want a gravity grease interceptor outside rather than a
                    hydromechanical unit under the sink. Check the FOG programme before specifying either.
                  </p>
                </div>

                <details class="group mt-5 rounded-xl border border-teal-100 bg-white">
                  <summary
                    class="flex items-center justify-between cursor-pointer px-4 py-3 text-sm font-semibold text-slate-800"
                  >
                    See the breakdown
                    <svg
                      class="h-4 w-4 text-slate-500 transition-transform group-open:rotate-180"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      viewBox="0 0 24 24"
                    >
                      <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"></path>
                    </svg>
                  </summary>
                  <div class="px-4 pb-4 text-sm space-y-1.5 text-slate-600">
                    <div class="flex justify-between gap-3">
                      <span>Sink interior volume</span><span id="gt-bd-volume" class="font-semibold text-slate-900">—</span>
                    </div>
                    <div class="flex justify-between gap-3">
                      <span>Volume that drains</span><span id="gt-bd-drained" class="font-semibold text-slate-900">—</span>
                    </div>
                    <div class="flex justify-between gap-3">
                      <span>Flow over the drain period</span><span id="gt-bd-flow" class="font-semibold text-slate-900">—</span>
                    </div>
                    <div class="flex justify-between gap-3 border-t border-slate-200 pt-1.5 mt-1.5">
                      <span>Rated to hold</span><span id="gt-bd-capacity" class="font-semibold text-slate-900">—</span>
                    </div>
                  </div>
                </details>
              </div>

              <!-- Interceptor result -->
              <div id="gt-result-interceptor" class="hidden">
                <p class="text-sm font-medium text-slate-600">Interceptor size</p>
                <div class="mt-2 flex items-baseline gap-2">
                  <span id="gt-size" class="text-5xl font-extrabold tracking-tight text-teal-600">
                    {fmt(interceptor.stocked ?? 0, 0)} gal
                  </span>
                </div>
                <p id="gt-i-note" class="mt-1 text-sm font-semibold text-slate-700">
                  Smallest stocked vessel covering the {fmt(interceptor.required, 0)} gallon requirement, well
                  past the {fmt(interceptor.minimum, 0)} gallon floor.
                </p>

                <div class="mt-6 grid grid-cols-2 gap-3">
                  <div class="rounded-xl border border-teal-100 bg-white p-4">
                    <p class="text-xs text-slate-500">Volume required</p>
                    <p id="gt-calculated" class="mt-1 text-2xl font-bold text-slate-900">
                      {fmt(interceptor.required, 0)} gal
                    </p>
                  </div>
                  <div class="rounded-xl border border-teal-100 bg-white p-4">
                    <p class="text-xs text-slate-500">Peak-hour meals</p>
                    <p class="mt-1 text-2xl font-bold text-slate-900">
                      {fmt(interceptor.mealsPerPeakHour, 0)}
                    </p>
                  </div>
                </div>

                <div id="gt-i-warning" class="hidden mt-4 rounded-xl border border-amber-300 bg-amber-100 p-4">
                  <p class="text-sm font-semibold text-amber-800">Past a single vessel</p>
                  <p class="mt-1 text-sm text-amber-800">
                    Expect two interceptors in series or a custom-poured structure, and a design the authority
                    will want to review rather than approve over the counter.
                  </p>
                </div>

                <details class="group mt-5 rounded-xl border border-teal-100 bg-white">
                  <summary
                    class="flex items-center justify-between cursor-pointer px-4 py-3 text-sm font-semibold text-slate-800"
                  >
                    See the breakdown
                    <svg
                      class="h-4 w-4 text-slate-500 transition-transform group-open:rotate-180"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      viewBox="0 0 24 24"
                    >
                      <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"></path>
                    </svg>
                  </summary>
                  <div class="px-4 pb-4 text-sm space-y-1.5 text-slate-600">
                    <div class="flex justify-between gap-3">
                      <span>Peak-hour meals</span><span id="gt-bd-meals" class="font-semibold text-slate-900">—</span>
                    </div>
                    <div class="flex justify-between gap-3">
                      <span>Formula result</span><span id="gt-bd-calculated" class="font-semibold text-slate-900">—</span>
                    </div>
                    <div class="flex justify-between gap-3">
                      <span>Local floor</span><span id="gt-bd-minimum" class="font-semibold text-slate-900">—</span>
                    </div>
                    <div class="flex justify-between gap-3 border-t border-slate-200 pt-1.5 mt-1.5">
                      <span>Governed by</span><span id="gt-bd-governed" class="font-semibold text-slate-900">—</span>
                    </div>
                  </div>
                </details>
              </div>

              <p class="mt-4 text-xs text-slate-500 leading-relaxed">
                Planning estimate. <strong>The local sewer authority's FOG programme governs</strong>, and it
                routinely imposes a minimum size, an outdoor location, a pump-out interval, and a sample port
                that no calculation predicts. Confirm before ordering.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- ==== FORMULA ==== -->
      <section class="bg-slate-50 border-y border-slate-200">
        <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-14">
          <h2 class="text-3xl font-extrabold tracking-tight text-slate-900">
            Both formulas, explained in plain English
          </h2>
          <p class="mt-4 text-slate-600 leading-relaxed">
            One asks how fast water arrives. The other asks how long it has to sit still.
          </p>

          <div
            class="mt-8 rounded-2xl bg-slate-900 p-6 sm:p-8 text-slate-100 font-mono text-sm leading-relaxed overflow-x-auto"
          >
            <div class="text-teal-300"># Method 1 — Hydromechanical, rated in GPM</div>
            <div>gallons&nbsp;=&nbsp;L × W × D × compartments ÷ {CUBIC_INCHES_PER_GALLON}</div>
            <div>gpm&nbsp;=&nbsp;gallons × fill fraction ÷ drain minutes</div>
            <div>lb of grease&nbsp;=&nbsp;rated gpm × {PDI_GREASE_LB_PER_GPM}&nbsp;&nbsp;<span class="text-slate-400">— PDI-G101</span></div>
            <div class="mt-2 text-slate-400">
              24 × 24 × 12 × 3 = {fmt(sinkBase.lengthIn * sinkBase.widthIn * sinkBase.depthIn * sinkBase.compartments, 0)} in³ = {fmt(hydraulic.gallons, 2)} gal
            </div>
            <div class="text-slate-400">
              × {fmt(GREASE_SINK_FILL_FRACTION, 2)} ÷ 1 min ={" "}
              <span class="text-amber-300">{fmt(hydraulic.flowGpm, 2)} gpm</span> → {hydraulic.ratedGpm} gpm /{" "}
              {hydraulic.capacityLb} lb
            </div>

            <div class="mt-5 text-teal-300"># Method 2 — Gravity interceptor, rated in GALLONS</div>
            <div>meals/hr&nbsp;=&nbsp;seats × turnover per hour</div>
            <div>gallons&nbsp;=&nbsp;meals/hr × gal per meal</div>
            <div>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;× retention hr × storage</div>
            <div>size&nbsp;=&nbsp;the larger of that and the local floor</div>
            <div class="mt-2 text-slate-400">
              {interceptorBase.seats} × {interceptorBase.turnoverPerHour} × {interceptorBase.wasteFlowPerMeal} ×{" "}
              {interceptorBase.retentionHours} × {interceptorBase.storageFactor} ={" "}
              <span class="text-amber-300">{fmt(interceptor.calculated, 0)} gal</span> → {interceptor.stocked}{" "}
              gallon vessel
            </div>
          </div>

          <div class="mt-8 grid sm:grid-cols-2 gap-4">
            <div class="rounded-xl border border-slate-200 bg-white p-5">
              <h3 class="font-bold text-slate-900">Flow versus retention</h3>
              <p class="mt-2 text-sm text-slate-600">
                A hydromechanical unit separates grease by <em>slowing</em> flow, so its rating is the speed it
                can cope with. A gravity interceptor separates by <em>waiting</em>, so its rating is how much
                it can hold while that happens. Sizing one with the other's method produces a number that
                looks plausible and means nothing.
              </p>
            </div>
            <div class="rounded-xl border border-slate-200 bg-white p-5">
              <h3 class="font-bold text-slate-900">Pounds and gpm are one number</h3>
              <p class="mt-2 text-sm text-slate-600">
                PDI-G101 fixes grease capacity at {PDI_GREASE_LB_PER_GPM} lb per gpm across the whole ladder,
                so a {PDI_GREASE_TRAPS[2].gpm} gpm unit is a {PDI_GREASE_TRAPS[2].capacityLb} lb unit and a{" "}
                {PDI_GREASE_TRAPS[8].gpm} gpm unit is a {PDI_GREASE_TRAPS[8].capacityLb} lb unit. There is
                nothing to look up.
              </p>
            </div>
            <div class="rounded-xl border border-slate-200 bg-white p-5">
              <h3 class="font-bold text-slate-900">The flow control fitting</h3>
              <p class="mt-2 text-sm text-slate-600">
                A hydromechanical interceptor is rated at a design flow, not a peak one, so an orifice fitting
                upstream throttles the line to match it. Without one, a fast-emptying sink pushes flow straight
                through and the unit separates nothing — a correctly sized trap installed without flow control
                is still a failure.
              </p>
            </div>
            <div class="rounded-xl border border-slate-200 bg-white p-5">
              <h3 class="font-bold text-slate-900">The floor usually wins</h3>
              <p class="mt-2 text-sm text-slate-600">
                On these defaults the meal-count formula only overtakes a {fmt(GREASE_INTERCEPTOR_MINIMUM_GAL, 0)}
                -gallon minimum at around{" "}
                {fmt(
                  GREASE_INTERCEPTOR_MINIMUM_GAL /
                    (interceptorBase.wasteFlowPerMeal *
                      interceptorBase.retentionHours *
                      interceptorBase.storageFactor),
                  0,
                )} seats. Below that, every small kitchen in the jurisdiction gets the same tank regardless of
                what the arithmetic says.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- ==== WORKED EXAMPLES ==== -->
      <section class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 py-14">
        <h2 class="text-3xl font-extrabold tracking-tight text-slate-900">Worked examples</h2>
        <p class="mt-4 text-slate-600">
          The standard three-compartment sink, the small kitchen the floor governs, and the same restaurant
          open around the clock.
        </p>

        <div class="mt-8 space-y-6">
          <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
            <div class="flex items-center gap-3">
              <span class="flex h-9 w-9 items-center justify-center rounded-full bg-teal-100 text-teal-700 font-bold">
                1
              </span>
              <h3 class="text-lg font-bold text-slate-900">A 24 × 24 × 12 three-compartment sink</h3>
            </div>
            <div class="mt-4 rounded-xl bg-slate-50 p-4 font-mono text-sm text-slate-700">
              one compartment = 24 × 24 × 12 ÷ {CUBIC_INCHES_PER_GALLON} = {fmt(oneCompartment, 2)} gal<br />
              three of them = {fmt(hydraulic.gallons, 2)} gal<br />
              × {fmt(GREASE_SINK_FILL_FRACTION * 100, 0)}% = {fmt(hydraulic.drainedGallons, 2)} gal draining in
              1 min<br />
              → <span class="font-bold text-teal-700">{fmt(hydraulic.flowGpm, 2)} gpm</span> →
              <span class="font-bold text-teal-700"> {hydraulic.ratedGpm} gpm PDI unit</span>,{" "}
              {hydraulic.capacityLb} lb
            </div>
            <p class="mt-3 text-sm text-slate-600">
              <span class="font-semibold text-slate-900">Result:</span> a standard commercial sink already
              needs the {hydraulic.ratedGpm} gpm unit — near the top of the hydromechanical range. Drop to a
              20 × 20 × 12 sink and it falls to {twentyInch.ratedGpm} gpm. This is why full-service kitchens so
              often end up outside with a gravity interceptor instead.
            </p>
          </div>

          <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
            <div class="flex items-center gap-3">
              <span class="flex h-9 w-9 items-center justify-center rounded-full bg-teal-100 text-teal-700 font-bold">
                2
              </span>
              <h3 class="text-lg font-bold text-slate-900">A 50-seat café — where the floor takes over</h3>
            </div>
            <div class="mt-4 rounded-xl bg-slate-50 p-4 font-mono text-sm text-slate-700">
              meals/hr = 50 × {interceptorBase.turnoverPerHour} = {fmt(smallKitchen.mealsPerPeakHour, 0)}<br />
              formula = {fmt(smallKitchen.mealsPerPeakHour, 0)} × {interceptorBase.wasteFlowPerMeal} ×{" "}
              {interceptorBase.retentionHours} × {interceptorBase.storageFactor} ={" "}
              {fmt(smallKitchen.calculated, 0)} gal<br />
              local floor = {fmt(smallKitchen.minimum, 0)} gal<br />
              → <span class="font-bold text-teal-700">{fmt(smallKitchen.required, 0)} gal</span>, governed by{" "}
              <span class="font-bold text-teal-700">the minimum</span>
            </div>
            <p class="mt-3 text-sm text-slate-600">
              <span class="font-semibold text-slate-900">Result:</span> the arithmetic asks for{" "}
              {fmt(smallKitchen.calculated, 0)} gallons and the job gets {fmt(smallKitchen.required, 0)}. Worth
              knowing before you quote, because the excavation for a{" "}
              {fmt(smallKitchen.required, 0)}-gallon vessel is a different job from the one the customer
              imagined.
            </p>
          </div>

          <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
            <div class="flex items-center gap-3">
              <span class="flex h-9 w-9 items-center justify-center rounded-full bg-teal-100 text-teal-700 font-bold">
                3
              </span>
              <h3 class="text-lg font-bold text-slate-900">The same 100 seats, open 24 hours</h3>
            </div>
            <div class="mt-4 rounded-xl bg-slate-50 p-4 font-mono text-sm text-slate-700">
              {
                storageTable.map((row) => (
                  <>
                    {row.label} (×{row.factor}): {fmt(row.calculated, 0)} gal → {row.stocked} gal vessel
                    <br />
                  </>
                ))
              }
            </div>
            <p class="mt-3 text-sm text-slate-600">
              <span class="font-semibold text-slate-900">Result:</span> hours of operation is a straight
              multiplier, so the same dining room needs{" "}
              {fmt(storageTable[2].calculated / storageTable[0].calculated, 0)}× the vessel running around the
              clock. It is the input most often guessed at and the one with the largest single effect.
            </p>
          </div>
        </div>
      </section>

      <!-- ==== REFERENCE TABLES ==== -->
      <section class="bg-slate-50 border-y border-slate-200">
        <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-14">
          <h2 class="text-3xl font-extrabold tracking-tight text-slate-900">PDI interceptor ratings</h2>
          <p class="mt-4 text-slate-600 leading-relaxed">
            The published ladder of hydromechanical units. The pound column is <strong>computed</strong> from
            the gpm column at {PDI_GREASE_LB_PER_GPM} lb per gpm rather than transcribed alongside it, because
            PDI-G101 defines it that way — the two can never disagree here.
          </p>

          <div class="mt-8 overflow-x-auto rounded-2xl border border-slate-200 bg-white shadow-sm">
            <table class="w-full text-left text-sm">
              <thead>
                <tr class="border-b border-slate-200 text-slate-500 bg-slate-50">
                  <th class="py-3 px-5 font-semibold">Flow rating</th>
                  <th class="py-3 px-5 font-semibold">Grease capacity</th>
                  <th class="py-3 px-5 font-semibold">Typical application</th>
                </tr>
              </thead>
              <tbody class="text-slate-700">
                {
                  PDI_GREASE_TRAPS.map((row, index) => (
                    <tr class={index === PDI_GREASE_TRAPS.length - 1 ? "" : "border-b border-slate-100"}>
                      <td class="py-3 px-5 font-semibold text-slate-900">{row.gpm} gpm</td>
                      <td class="py-3 px-5">{row.capacityLb} lb</td>
                      <td class="py-3 px-5">
                        {row.gpm <= 10
                          ? "Single sink or a bar"
                          : row.gpm <= 25
                            ? "Small two-compartment sink"
                            : row.gpm <= 50
                              ? "Three-compartment sink"
                              : "Large sink — usually an outdoor job instead"}
                      </td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>

          <h2 class="mt-14 text-3xl font-extrabold tracking-tight text-slate-900">
            Rating by sink size
          </h2>
          <p class="mt-4 text-slate-600 leading-relaxed">
            Three compartments, 12 inches deep, drained in one minute at{" "}
            {fmt(GREASE_SINK_FILL_FRACTION * 100, 0)}% fill.
          </p>

          <div class="mt-8 overflow-x-auto rounded-2xl border border-slate-200 bg-white shadow-sm">
            <table class="w-full text-left text-sm">
              <thead>
                <tr class="border-b border-slate-200 text-slate-500 bg-slate-50">
                  <th class="py-3 px-5 font-semibold">Compartment</th>
                  <th class="py-3 px-5 font-semibold">Total volume</th>
                  <th class="py-3 px-5 font-semibold">Required flow</th>
                  <th class="py-3 px-5 font-semibold">PDI unit</th>
                </tr>
              </thead>
              <tbody class="text-slate-700">
                {
                  sinkTable.map((row, index) => (
                    <tr class={index === sinkTable.length - 1 ? "" : "border-b border-slate-100"}>
                      <td class="py-3 px-5 font-semibold text-slate-900">
                        {row.lengthIn} × {row.widthIn} × 12 in
                      </td>
                      <td class="py-3 px-5">{fmt(row.gallons, 1)} gal</td>
                      <td class="py-3 px-5">{fmt(row.flowGpm, 2)} gpm</td>
                      <td class="py-3 px-5">
                        {row.ratedGpm === null ? "Outdoor interceptor" : `${row.ratedGpm} gpm / ${row.capacityLb} lb`}
                      </td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>

          <h2 class="mt-14 text-3xl font-extrabold tracking-tight text-slate-900">
            Gravity interceptor by seat count
          </h2>
          <p class="mt-4 text-slate-600 leading-relaxed">
            Full kitchen with dishwashing, one turnover per hour, {interceptorBase.retentionHours} hour
            retention, eight-hour day, and a {fmt(GREASE_INTERCEPTOR_MINIMUM_GAL, 0)}-gallon local floor.
          </p>

          <div class="mt-8 overflow-x-auto rounded-2xl border border-slate-200 bg-white shadow-sm">
            <table class="w-full text-left text-sm">
              <thead>
                <tr class="border-b border-slate-200 text-slate-500 bg-slate-50">
                  <th class="py-3 px-5 font-semibold">Seats</th>
                  <th class="py-3 px-5 font-semibold">Formula</th>
                  <th class="py-3 px-5 font-semibold">Required</th>
                  <th class="py-3 px-5 font-semibold">Governed by</th>
                  <th class="py-3 px-5 font-semibold">Vessel</th>
                </tr>
              </thead>
              <tbody class="text-slate-700">
                {
                  seatTable.map((row, index) => (
                    <tr class={index === seatTable.length - 1 ? "" : "border-b border-slate-100"}>
                      <td class="py-3 px-5 font-semibold text-slate-900">{row.seats}</td>
                      <td class="py-3 px-5">{fmt(row.calculated, 0)} gal</td>
                      <td class="py-3 px-5">{fmt(row.required, 0)} gal</td>
                      <td class="py-3 px-5">
                        {row.governedBy === "minimum" ? "The local floor" : "The calculation"}
                      </td>
                      <td class="py-3 px-5">{row.stocked === null ? "Two in series" : `${row.stocked} gal`}</td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>

          <p class="mt-6 text-sm text-slate-500">
            Sources &amp; standards: <a
              class="underline hover:text-teal-600"
              href="https://codes.iccsafe.org/codes/i-codes"
              target="_blank"
              rel="noopener">IPC</a
            > 2021 1003.3 (grease interception) and the PDI-G101 rating standard for hydromechanical units. The
            volume arithmetic is derived from {CUBIC_INCHES_PER_GALLON} cubic inches per US gallon and the pound
            capacities are computed from the flow ratings, so neither is transcribed. <strong
              >The meal-count factors — gallons per meal, retention time and storage factor — are commonly
              published figures rather than values verified here against a primary source</strong
            >, which is why all three are editable. IPC 1003.3.4 permits the authority having jurisdiction to
            approve a sizing method, and in practice the local FOG programme sets the minimum size, the
            location, the pump-out interval and the sampling requirement. Confirm before ordering.
          </p>
        </div>
      </section>

      <CalculatorFaqSection
        faqs={faqs}
        accent="teal"
        subtitle="Common questions about trap versus interceptor, PDI ratings, and FOG programme requirements."
      />

