---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import RelatedCalculators from "@/components/RelatedCalculators.astro";
import CalculatorBreadcrumb from "@/components/CalculatorBreadcrumb.astro";
import CalculatorFaqSection from "@/components/CalculatorFaqSection.astro";
import CalculatorTradesQuoteCta from "@/components/CalculatorTradesQuoteCta.astro";
import { buildFaqPageSchema, type CalculatorFaq } from "@/lib/calculatorFaq";
import { plumbingAccentStyles } from "@/config/plumbingCalculators";
import { HOURS_PER_YEAR, fmt, labourRate, usd, usd2 } from "@/lib/plumbing";

const title = "Plumbing Labor Rate Calculator — Wage to Bill Rate | TradesQuote";
const description =
  "Free plumbing labor rate calculator. Turn a plumber's wage into the hourly rate you have to bill — payroll burden, overhead per tech, and the billable utilisation that moves the number more than the wage does.";

const pageUrl = "https://www.tradesquote.ai/calculators/plumbing/plumbing-labor-rate-calculator";

const breadcrumbData = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: "https://www.tradesquote.ai/" },
    { "@type": "ListItem", position: 2, name: "Calculators", item: "https://www.tradesquote.ai/calculators" },
    { "@type": "ListItem", position: 3, name: "Plumbing", item: "https://www.tradesquote.ai/calculators/plumbing" },
    { "@type": "ListItem", position: 4, name: "Plumbing Labor Rate Calculator", item: pageUrl },
  ],
};

const webAppData = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: "Plumbing Labor Rate Calculator",
  url: pageUrl,
  applicationCategory: "BusinessApplication",
  operatingSystem: "Any (web-based)",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  description:
    "Free online plumbing labor rate calculator converting an hourly wage into a billable rate through payroll burden, overhead per technician, billable utilisation and target margin.",
};

const base = {
  wage: 38,
  burdenPercent: 32,
  overheadPerTech: 11000,
  billableHours: 1560,
  marginPercent: 40,
};
const defaults = labourRate(base);
const at60 = labourRate({ ...base, billableHours: 1248 });
const at90 = labourRate({ ...base, billableHours: 1872 });

const faqs: CalculatorFaq[] = [
  {
    question: "What should I charge per hour as a plumber?",
    answer: `Whatever covers your loaded cost plus your margin — for the defaults here that is <strong>${usd2(defaults.billRate)} an hour</strong>. A $38 wage becomes ${usd(defaults.baseWage)} a year, plus ${fmt(base.burdenPercent, 0)}% burden and ${usd(base.overheadPerTech)} of overhead, divided by <strong>1,560 billable hours</strong>, then divided by 0.60 for a 40% margin. That is <strong>${fmt(defaults.multiple, 2)}× the wage</strong>, which is a normal multiple and usually a shock the first time you see it.`,
  },
  {
    question: "Why is my bill rate three times the wage?",
    answer: `Three things stack. Payroll burden adds ${fmt(base.burdenPercent, 0)}% before you have driven anywhere. Overhead — van, insurance, licensing, software, office — adds ${usd(base.overheadPerTech)} per tech per year. And crucially you can only invoice about ${fmt(defaults.utilisation, 0)}% of the hours you pay for, so the other ${fmt(100 - defaults.utilisation, 0)}% has to be recovered inside the ones you can. Multiply those together and 3× is arithmetic, not greed.`,
  },
  {
    question: "What is payroll burden and what should it be?",
    answer:
      "Everything you pay on top of the wage: employer payroll taxes, workers' compensation, health insurance, retirement contributions, paid time off, and training. For a US plumbing contractor <strong>25% to 40%</strong> is typical, and workers' comp rates for plumbing push it toward the upper half. The default here is 32%.",
  },
  {
    question: "What are billable hours and why do they matter so much?",
    answer: `The hours you can actually put on an invoice. A full-time tech is paid ${HOURS_PER_YEAR.toLocaleString("en-US")} hours a year, but drive time, the supply house, warranty callbacks, training, vacation and slow days take a large bite. <strong>1,560 hours is 75% utilisation</strong> and is a realistic target for a well-run service outfit. This is the single strongest lever on the page — see the sweep table below.`,
  },
  {
    question: "Does raising utilisation beat raising the rate?",
    answer: `Almost always, and it is the insight most shops never act on. At the same $38 wage, moving from <strong>60% to 90% utilisation</strong> takes the required bill rate from <strong>${usd2(at60.billRate)} to ${usd2(at90.billRate)}</strong> — a ${usd2(at60.billRate - at90.billRate)} swing you can pass on as competitiveness or keep as profit. No price increase does that, and customers never object to it.`,
  },
  {
    question: "Should apprentices bill at a different rate?",
    answer:
      "Run this calculator separately for each person. An apprentice has a lower wage but a similar share of overhead and often lower utilisation, so their bill rate is <em>not</em> proportionally lower. Many shops bill one blended rate for simplicity, which is fine as long as the blend is weighted by the hours each person actually sells rather than by headcount.",
  },
  {
    question: "Is this the same as what I quote the customer?",
    answer:
      'Not necessarily. This is the rate that makes an hour of labour profitable. Many plumbing companies bill flat-rate by task rather than hourly — but flat-rate pricing is <em>built</em> from an hourly rate like this one multiplied by a task time. Either way, this is the number underneath it. Feed it into the <a href="/calculators/plumbing/plumbing-estimate-calculator" class="font-semibold text-teal-700 underline decoration-teal-300 hover:decoration-teal-600">Plumbing Estimate Calculator</a> to price a whole job.',
  },
];
const faqData = buildFaqPageSchema(faqs);

const ctaHeading = "Rate set? Put it to work on every quote.";
const ctaDescription =
  "A correct rate only helps if every estimate uses it. TradesQuote turns a scope into a detailed, line-item estimate with your labour rate, quantities and unit prices applied consistently — validated by a built-in quality control agent and ready for your client to sign online.";

const relatedCalculators = [
  {
    href: "/calculators/plumbing/plumbing-estimate-calculator",
    title: "Plumbing Estimate Calculator",
    description: "Price a whole job using this rate.",
  },
  {
    href: "/calculators/plumbing/plumbing-repipe-cost-calculator",
    title: "Repipe Cost Calculator",
    description: "The biggest labour-heavy ticket you quote.",
  },
  {
    href: "/calculators/plumbing/plumbing-water-heater-replacement-cost-calculator",
    title: "Water Heater Replacement Cost Calculator",
    description: "Where labour hours are fixed and the rate decides.",
  },
  {
    href: "/calculators/plumbing/plumbing-drainage-fixture-unit-calculator",
    title: "Drainage Fixture Unit Calculator",
    description: "Scope the work before you price the hours.",
  },
];

/** Tables computed from the lib. */
const utilisationTable = [1248, 1352, 1456, 1560, 1664, 1768, 1872].map((h) => {
  const r = labourRate({ ...base, billableHours: h });
  return { hours: h, utilisation: r.utilisation, loaded: r.loadedCost, rate: r.billRate };
});

const wageTable = [28, 33, 38, 43, 48].map((w) => {
  const r = labourRate({ ...base, wage: w });
  return { wage: w, rate: r.billRate, multiple: r.multiple };
});

const styles = plumbingAccentStyles.teal;
---

<Layout {title} {description}>
  <Fragment slot="head">
    <link rel="canonical" href={pageUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Plumbing Labor Rate Calculator — Wage to Bill Rate" />
    <meta
      property="og:description"
      content="Turn a plumber's wage into the hourly rate you have to bill — burden, overhead, and the utilisation that matters more than the wage. Free and instant."
    />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:site_name" content="TradesQuote" />
    <meta property="og:image" content="https://www.tradesquote.ai/logo.svg" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Plumbing Labor Rate Calculator — Wage to Bill Rate" />
    <meta
      name="twitter:description"
      content="Wage to billable rate through burden, overhead and utilisation. Free, instant, no sign-up."
    />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbData)} />
    <script type="application/ld+json" set:html={JSON.stringify(webAppData)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqData)} />
  </Fragment>

  <div class="bg-white min-h-screen text-slate-700">
    <Header />

    <main>
      <!-- ==== HERO ==== -->
      <section class="relative overflow-hidden bg-gradient-to-b from-slate-50 to-white">
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pt-10 pb-6">
          <CalculatorBreadcrumb
            category="Plumbing"
            categoryHref="/calculators/plumbing"
            current="Plumbing Labor Rate Calculator"
          />

          <div class="max-w-3xl">
            <span
              class="inline-flex items-center gap-1.5 rounded-full bg-teal-100 px-3 py-1 text-xs font-semibold text-teal-700"
            >
              <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              Plumbing Tools · Business · Free
            </span>

            <h1 class="mt-4 text-4xl sm:text-5xl font-extrabold tracking-tight text-slate-900">
              Plumbing Labor Rate Calculator <span class="text-teal-600">— Wage to Bill Rate</span>
            </h1>

            <p class="mt-5 text-lg text-slate-600 leading-relaxed">
              The step almost everyone skips is dividing by <strong>billable</strong> hours rather than paid
              hours. A tech is paid {HOURS_PER_YEAR.toLocaleString("en-US")} hours a year and sells far fewer,
              and that gap has to be recovered inside the hours you can actually invoice. Add payroll burden
              and overhead on top and a ${base.wage} wage needs a{" "}
              <strong>{usd2(defaults.billRate)}</strong> bill rate — {fmt(defaults.multiple, 2)}× the wage.
            </p>
          </div>
        </div>
      </section>

      <!-- ==== CALCULATOR ==== -->
      <section id="calculator" class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pb-12">
        <div class="mx-auto max-w-5xl rounded-2xl border border-slate-200 bg-white p-6 sm:p-8 shadow-sm">
          <h2 class="text-xl font-bold text-slate-900 flex items-center gap-2">
            <svg class="h-5 w-5 text-teal-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            Work out your rate
          </h2>

          <div class="mt-6 lg:grid lg:grid-cols-2 lg:gap-8 lg:items-start">
            <div class="space-y-6">
              <div>
                <div class="flex items-center justify-between">
                  <label for="lr-wage" class="text-sm font-semibold text-slate-800">Hourly wage paid</label>
                  <div class="flex items-center gap-1">
                    <span class="text-sm text-slate-500">$</span>
                    <input
                      id="lr-wage"
                      type="number"
                      min="0"
                      max="200"
                      step="0.5"
                      value="38"
                      class="w-24 rounded-lg border border-slate-300 px-3 py-1.5 text-right text-sm font-semibold text-slate-900 focus:border-teal-500 focus:ring-2 focus:ring-teal-200 outline-none"
                    />
                    <span class="text-sm text-slate-500">/h</span>
                  </div>
                </div>
                <input
                  id="lr-wage-range"
                  type="range"
                  min="18"
                  max="80"
                  step="1"
                  value="38"
                  class="plumb-range mt-3 w-full bg-slate-200 accent-teal-600"
                />
                <div class="flex justify-between text-xs text-slate-400 mt-1">
                  <span>$18</span><span>$80/h</span>
                </div>
              </div>

              <div class="grid sm:grid-cols-2 gap-5">
                <div>
                  <label for="lr-burden" class="text-sm font-semibold text-slate-800">Payroll burden</label>
                  <div class="mt-2 flex items-center gap-2">
                    <input
                      id="lr-burden"
                      type="number"
                      min="0"
                      max="100"
                      value="32"
                      class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm text-slate-900 focus:border-teal-500 focus:ring-2 focus:ring-teal-200 outline-none"
                    />
                    <span class="text-sm text-slate-500 shrink-0">%</span>
                  </div>
                  <p class="mt-1.5 text-xs text-slate-500">
                    Taxes, workers' comp, insurance, PTO. 25–40% typical.
                  </p>
                </div>

                <div>
                  <label for="lr-overhead" class="text-sm font-semibold text-slate-800">
                    Overhead per tech
                  </label>
                  <div class="mt-2 flex items-center gap-2">
                    <span class="text-sm text-slate-500 shrink-0">$</span>
                    <input
                      id="lr-overhead"
                      type="number"
                      min="0"
                      max="200000"
                      step="500"
                      value="11000"
                      class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm text-slate-900 focus:border-teal-500 focus:ring-2 focus:ring-teal-200 outline-none"
                    />
                    <span class="text-sm text-slate-500 shrink-0">/yr</span>
                  </div>
                  <p class="mt-1.5 text-xs text-slate-500">Van, fuel, tools, software, office, advertising.</p>
                </div>

                <div>
                  <label for="lr-billable" class="text-sm font-semibold text-slate-800">
                    Billable hours a year
                  </label>
                  <div class="mt-2 flex items-center gap-2">
                    <input
                      id="lr-billable"
                      type="number"
                      min="100"
                      max="2080"
                      step="10"
                      value="1560"
                      class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm text-slate-900 focus:border-teal-500 focus:ring-2 focus:ring-teal-200 outline-none"
                    />
                    <span class="text-sm text-slate-500 shrink-0">h</span>
                  </div>
                  <p class="mt-1.5 text-xs text-slate-500">
                    Of {HOURS_PER_YEAR.toLocaleString("en-US")} paid. 1,560 is 75%.
                  </p>
                </div>

                <div>
                  <label for="lr-margin" class="text-sm font-semibold text-slate-800">Target margin</label>
                  <div class="mt-2 flex items-center gap-2">
                    <input
                      id="lr-margin"
                      type="number"
                      min="0"
                      max="90"
                      value="40"
                      class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm text-slate-900 focus:border-teal-500 focus:ring-2 focus:ring-teal-200 outline-none"
                    />
                    <span class="text-sm text-slate-500 shrink-0">% of rate</span>
                  </div>
                  <p class="mt-1.5 text-xs text-slate-500">Of the rate, not of cost — divided, not multiplied.</p>
                </div>
              </div>

              <button
                id="lr-reset"
                type="button"
                class="text-sm font-medium text-slate-500 hover:text-teal-600 transition flex items-center gap-1.5"
              >
                <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"
                  ></path>
                </svg>
                Reset to defaults
              </button>
            </div>

            <!-- Results -->
            <div class="mt-6 lg:mt-0 lg:sticky lg:top-6 rounded-xl border border-teal-100 bg-teal-50 p-5 sm:p-6">
              <p class="text-sm font-medium text-slate-600">Bill this rate</p>
              <div class="mt-2 flex items-baseline gap-2">
                <span id="lr-rate" class="text-5xl font-extrabold tracking-tight text-teal-600">
                  {usd2(defaults.billRate)}/h
                </span>
              </div>
              <p id="lr-note" class="mt-1 text-sm font-semibold text-slate-700">
                At {fmt(defaults.utilisation, 0)}% utilisation you have to bill {usd2(defaults.billRate)}.
                Selling one more hour a day — 240 a year — would bring that down to{" "}
                {usd2(labourRate({ ...base, billableHours: 1800 }).billRate)}.
              </p>

              <div class="mt-6 grid grid-cols-2 gap-3">
                <div class="rounded-xl border border-teal-100 bg-white p-4">
                  <p class="text-xs text-slate-500">Loaded cost</p>
                  <p id="lr-loaded" class="mt-1 text-2xl font-bold text-slate-900">
                    {usd2(defaults.loadedCost)}/h
                  </p>
                </div>
                <div class="rounded-xl border border-teal-100 bg-white p-4">
                  <p class="text-xs text-slate-500">Multiple of wage</p>
                  <p id="lr-multiple" class="mt-1 text-2xl font-bold text-slate-900">
                    {fmt(defaults.multiple, 2)}×
                  </p>
                </div>
              </div>

              <details class="group mt-5 rounded-xl border border-teal-100 bg-white">
                <summary
                  class="flex items-center justify-between cursor-pointer px-4 py-3 text-sm font-semibold text-slate-800"
                >
                  See the breakdown
                  <svg
                    class="h-4 w-4 text-slate-500 transition-transform group-open:rotate-180"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    viewBox="0 0 24 24"
                  >
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"></path>
                  </svg>
                </summary>
                <div class="px-4 pb-4 text-sm space-y-1.5 text-slate-600">
                  <div class="flex justify-between gap-3">
                    <span>Base wage</span><span id="lr-bd-wage" class="font-semibold text-slate-900">—</span>
                  </div>
                  <div class="flex justify-between gap-3">
                    <span>Burden</span><span id="lr-bd-burden" class="font-semibold text-slate-900">—</span>
                  </div>
                  <div class="flex justify-between gap-3">
                    <span>Total annual cost</span><span id="lr-bd-total" class="font-semibold text-slate-900">—</span>
                  </div>
                  <div class="flex justify-between gap-3">
                    <span>Utilisation</span><span id="lr-bd-utilisation" class="font-semibold text-slate-900">—</span>
                  </div>
                  <div class="flex justify-between gap-3 border-t border-slate-200 pt-1.5 mt-1.5">
                    <span>Unbilled hours</span><span id="lr-bd-unbilled" class="font-semibold text-slate-900">—</span>
                  </div>
                </div>
              </details>

              <p class="mt-4 text-xs text-slate-500 leading-relaxed">
                Planning estimate. Overtime premiums, callback and warranty time, and bad debt are not
                modelled — all three push the required rate up. Replace the defaults with your own figures
                from last year's accounts.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- ==== FORMULA ==== -->
      <section class="bg-slate-50 border-y border-slate-200">
        <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-14">
          <h2 class="text-3xl font-extrabold tracking-tight text-slate-900">
            The formula, explained in plain English
          </h2>
          <p class="mt-4 text-slate-600 leading-relaxed">
            Four steps, and the third one is where most rates go wrong.
          </p>

          <div
            class="mt-8 rounded-2xl bg-slate-900 p-6 sm:p-8 text-slate-100 font-mono text-sm leading-relaxed overflow-x-auto"
          >
            <div class="text-teal-300"># Step 1 — Annual wage</div>
            <div>
              wage × <span class="text-amber-300">{HOURS_PER_YEAR}</span> paid hours
            </div>
            <div class="mt-4 text-teal-300"># Step 2 — Add payroll burden</div>
            <div>+ taxes, workers' comp, insurance, PTO, training</div>
            <div class="mt-4 text-teal-300"># Step 3 — Divide by BILLABLE hours, not paid</div>
            <div>
              loaded $/h&nbsp;=&nbsp;(wage + burden + overhead) ÷
              <span class="text-amber-300">billable hours</span>
            </div>
            <div class="text-slate-400">this is the step everyone skips</div>
            <div class="mt-4 text-teal-300"># Step 4 — Apply the margin — DIVIDE</div>
            <div>bill rate&nbsp;=&nbsp;loaded ÷ (<span class="text-amber-300">1 − margin</span>)</div>
            <div class="mt-4 text-slate-400"># The defaults, worked through</div>
            <div>
              {usd(defaults.baseWage)} + {usd(defaults.burden)} + {usd(base.overheadPerTech)} ={" "}
              {usd(defaults.totalCost)}
            </div>
            <div>
              ÷ {base.billableHours} = {usd2(defaults.loadedCost)} ÷ 0.60 ={" "}
              <span class="text-amber-300">{usd2(defaults.billRate)}</span>
            </div>
          </div>

          <div class="mt-8 grid sm:grid-cols-2 gap-4">
            <div class="rounded-xl border border-slate-200 bg-white p-5">
              <h3 class="font-bold text-slate-900">Billable, not paid</h3>
              <p class="mt-2 text-sm text-slate-600">
                Dividing by {HOURS_PER_YEAR.toLocaleString("en-US")} instead of{" "}
                {base.billableHours.toLocaleString("en-US")} would give {usd2(defaults.totalCost / HOURS_PER_YEAR)}{" "}
                of loaded cost instead of {usd2(defaults.loadedCost)} — a{" "}
                {fmt((1 - HOURS_PER_YEAR / base.billableHours) * -100, 0)}% understatement that quietly turns
                profitable jobs into break-even ones.
              </p>
            </div>
            <div class="rounded-xl border border-slate-200 bg-white p-5">
              <h3 class="font-bold text-slate-900">Utilisation beats price</h3>
              <p class="mt-2 text-sm text-slate-600">
                60% to 90% utilisation moves the required rate from {usd2(at60.billRate)} to{" "}
                {usd2(at90.billRate)}. No price rise achieves a {usd2(at60.billRate - at90.billRate)} swing,
                and no customer objects to it.
              </p>
            </div>
            <div class="rounded-xl border border-slate-200 bg-white p-5">
              <h3 class="font-bold text-slate-900">Overhead is per tech</h3>
              <p class="mt-2 text-sm text-slate-600">
                Divide total company overhead by the number of billing technicians, not by headcount.
                Dispatchers and office staff are overhead; they do not carry a share of it themselves.
              </p>
            </div>
            <div class="rounded-xl border border-slate-200 bg-white p-5">
              <h3 class="font-bold text-slate-900">Margin is of the rate</h3>
              <p class="mt-2 text-sm text-slate-600">
                Divide by (1 − margin), do not multiply by (1 + margin). At 40% the two differ enormously:{" "}
                {usd2(defaults.loadedCost / 0.6)} against {usd2(defaults.loadedCost * 1.4)}. The second is only
                a 28.6% margin.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- ==== WORKED EXAMPLES ==== -->
      <section class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 py-14">
        <h2 class="text-3xl font-extrabold tracking-tight text-slate-900">Worked examples</h2>
        <p class="mt-4 text-slate-600">
          The defaults, the shop that only sells 60% of its hours, and what a raise really costs.
        </p>

        <div class="mt-8 space-y-6">
          <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
            <div class="flex items-center gap-3">
              <span class="flex h-9 w-9 items-center justify-center rounded-full bg-teal-100 text-teal-700 font-bold">
                1
              </span>
              <h3 class="text-lg font-bold text-slate-900">$38 wage, 75% utilisation</h3>
            </div>
            <div class="mt-4 rounded-xl bg-slate-50 p-4 font-mono text-sm text-slate-700">
              $38 × 2,080 = {usd(defaults.baseWage)}<br />
              + 32% burden {usd(defaults.burden)} = {usd(defaults.wageWithBurden)}<br />
              + {usd(base.overheadPerTech)} overhead = {usd(defaults.totalCost)}<br />
              ÷ 1,560 billable = <span class="font-bold text-teal-700">{usd2(defaults.loadedCost)}</span>{" "}
              loaded<br />
              ÷ 0.60 = <span class="font-bold text-teal-700">{usd2(defaults.billRate)}</span> ={" "}
              {fmt(defaults.multiple, 2)}× the wage
            </div>
            <p class="mt-3 text-sm text-slate-600">
              <span class="font-semibold text-slate-900">Result:</span> {usd2(defaults.billRate)}. Note the
              loaded cost is already {usd2(defaults.loadedCost)} — nearly double the wage — before a cent of
              profit.
            </p>
          </div>

          <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
            <div class="flex items-center gap-3">
              <span class="flex h-9 w-9 items-center justify-center rounded-full bg-teal-100 text-teal-700 font-bold">
                2
              </span>
              <h3 class="text-lg font-bold text-slate-900">The same tech at 60% utilisation</h3>
            </div>
            <div class="mt-4 rounded-xl bg-slate-50 p-4 font-mono text-sm text-slate-700">
              same {usd(defaults.totalCost)} of annual cost<br />
              ÷ 1,248 billable = {usd2(at60.loadedCost)} loaded<br />
              ÷ 0.60 = <span class="font-bold text-teal-700">{usd2(at60.billRate)}</span><br />
              versus {usd2(defaults.billRate)} at 75% → must charge{" "}
              <span class="font-bold text-teal-700">{usd2(at60.billRate - defaults.billRate)} more</span>
            </div>
            <p class="mt-3 text-sm text-slate-600">
              <span class="font-semibold text-slate-900">Result:</span> nothing about the tech changed. Three
              hundred fewer sellable hours a year forces a{" "}
              {usd2(at60.billRate - defaults.billRate)} higher rate — and that shop then looks expensive
              against a competitor who simply schedules better.
            </p>
          </div>

          <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
            <div class="flex items-center gap-3">
              <span class="flex h-9 w-9 items-center justify-center rounded-full bg-teal-100 text-teal-700 font-bold">
                3
              </span>
              <h3 class="text-lg font-bold text-slate-900">What a $5 raise actually costs</h3>
            </div>
            <div class="mt-4 rounded-xl bg-slate-50 p-4 font-mono text-sm text-slate-700">
              $38 → $43 wage<br />
              bill rate {usd2(defaults.billRate)} → {usd2(labourRate({ ...base, wage: 43 }).billRate)}<br />
              → <span class="font-bold text-teal-700">
                {usd2(labourRate({ ...base, wage: 43 }).billRate - defaults.billRate)} per billed hour
              </span><br />
              every $1 of wage costs {usd2((labourRate({ ...base, wage: 43 }).billRate - defaults.billRate) / 5)}{" "}
              of rate
            </div>
            <p class="mt-3 text-sm text-slate-600">
              <span class="font-semibold text-slate-900">Result:</span> a $5 raise needs almost{" "}
              {usd2(labourRate({ ...base, wage: 43 }).billRate - defaults.billRate)} more on the hour — because
              the raise carries burden, then gets spread over fewer hours than you pay for, then gets marked
              up for margin. Worth knowing before you promise one.
            </p>
          </div>
        </div>
      </section>

      <!-- ==== REFERENCE TABLES ==== -->
      <section class="bg-slate-50 border-y border-slate-200">
        <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-14">
