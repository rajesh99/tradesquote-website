---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import RelatedCalculators from "@/components/RelatedCalculators.astro";
import CalculatorBreadcrumb from "@/components/CalculatorBreadcrumb.astro";
import CalculatorFaqSection from "@/components/CalculatorFaqSection.astro";
import CalculatorTradesQuoteCta from "@/components/CalculatorTradesQuoteCta.astro";
import { buildFaqPageSchema, type CalculatorFaq } from "@/lib/calculatorFaq";
import { plumbingAccentStyles } from "@/config/plumbingCalculators";
import {
  HAZEN_WILLIAMS_C,
  PIPE_MATERIAL_LABELS,
  fmt,
  frictionLossPsiPerFoot,
  insideDiameter,
  nominalSizes,
  psiToHead,
  sizeLabel,
  totalDynamicHead,
  velocity,
  velocityHead,
  type PipeMaterial,
} from "@/lib/plumbing";

const title = "Pump Head Calculator — Total Dynamic Head | TradesQuote";
const description =
  "Free pump head calculator. Add static lift, friction head, pressure head and velocity head to get the total dynamic head a sump, well or booster pump has to make — with each term shown as a share of the total.";

const pageUrl = "https://www.tradesquote.ai/calculators/plumbing/plumbing-pump-head-calculator";

const breadcrumbData = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: "https://www.tradesquote.ai/" },
    { "@type": "ListItem", position: 2, name: "Calculators", item: "https://www.tradesquote.ai/calculators" },
    { "@type": "ListItem", position: 3, name: "Plumbing", item: "https://www.tradesquote.ai/calculators/plumbing" },
    { "@type": "ListItem", position: 4, name: "Pump Head Calculator", item: pageUrl },
  ],
};

const webAppData = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: "Pump Head Calculator",
  url: pageUrl,
  applicationCategory: "BusinessApplication",
  operatingSystem: "Any (web-based)",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  description:
    "Free online pump head calculator that sums static lift, Hazen-Williams friction head, pressure head and velocity head into the total dynamic head required from a sump, well or booster pump.",
};

const faqs: CalculatorFaq[] = [
  {
    question: "What head does my pump need?",
    answer:
      "For a typical sump — 30 gpm up a 12-foot lift through 40 feet of 1-1/2 inch PVC — the answer is <strong>14.43 feet</strong> of total dynamic head. Those are the defaults above. Pick a pump whose curve delivers 30 gpm at 14.4 feet or better; the curve, not the horsepower, is what you match against.",
  },
  {
    question: "What is total dynamic head?",
    answer:
      "Everything the pump has to overcome, added up in feet. <strong>Static lift</strong> is the vertical rise. <strong>Friction head</strong> is what the pipe and fittings cost. <strong>Pressure head</strong> is any pressure the discharge has to be delivered at. <strong>Velocity head</strong> is the energy in the moving water itself. In the defaults those are 12, 2.08, 0 and 0.35 feet.",
  },
  {
    question: "Can I ignore velocity head?",
    answer:
      "Usually, and it is honest to say so. In the defaults velocity head is <strong>0.35 feet — 2.4% of the total</strong>. It is real, it belongs in the equation, and it almost never changes which pump you buy. Static lift is 83% of that same total. Spend your attention there.",
  },
  {
    question: "Why does the discharge pipe size matter?",
    answer:
      "Because friction head is the term you can actually design away. Going from 1-1/2 inch to 2 inch PVC on the defaults cuts the friction from 2.08 feet to about 0.6 — a small absolute saving here, but on a long run or a higher flow it dominates. When the calculator says friction is the bigger share, upsizing the discharge is the cheapest fix available.",
  },
  {
    question: "How do I convert head in feet to psi?",
    answer:
      "Divide by 2.309, or multiply by 0.4331. The default <strong>14.43 feet of head is 6.25 psi</strong>. Pump curves are published in feet, plumbing pressure in psi, and you will convert between them constantly — the breakdown panel shows both.",
  },
  {
    question: "Should I add a safety margin to the head?",
    answer:
      "A modest one, and put it in the right place. Adding 10% to friction head is reasonable because fittings get missed and pipe roughens with age. Do <em>not</em> pad the static lift — it is a measured dimension, not an estimate. And avoid oversizing badly: a pump running far left of its best efficiency point cycles more, wears faster and can cavitate.",
  },
  {
    question: "Does this cover suction lift for a well pump?",
    answer:
      "Only as part of the static term. A surface pump lifting water from below itself is also limited by <strong>net positive suction head</strong> — practically about 25 feet at sea level and less with altitude or warm water, because atmospheric pressure is doing the lifting. Beyond that you need a submersible or a jet pump, and this calculator will not warn you about it.",
  },
];
const faqData = buildFaqPageSchema(faqs);

const ctaHeading = "Pump sized? Quote the whole job in seconds.";
const ctaDescription =
  "The pump is one line item next to pit, piping, check valve, alarm and electrical. TradesQuote turns the whole scope into a detailed, line-item estimate with quantities and unit prices — validated by a built-in quality control agent and ready for your client to sign online.";

const relatedCalculators = [
  {
    href: "/calculators/plumbing/plumbing-friction-loss-calculator",
    title: "Pipe Friction Loss Calculator",
    description: "Work the developed length out including fittings.",
  },
  {
    href: "/calculators/plumbing/plumbing-water-pressure-calculator",
    title: "Water Pressure Calculator",
    description: "Convert between psi and feet of head.",
  },
  {
    href: "/calculators/plumbing/plumbing-pipe-velocity-calculator",
    title: "Pipe Velocity Calculator",
    description: "Keep the discharge line out of erosion territory.",
  },
  {
    href: "/calculators/plumbing/plumbing-drain-pipe-size-calculator",
    title: "Drain Pipe Size Calculator",
    description: "For everything that can drain by gravity instead.",
  },
];

const MATERIALS: PipeMaterial[] = ["pvc-40", "cpvc-40", "copper-l", "copper-m", "pex", "steel-40"];
const PVC_SIZES = nominalSizes("pvc-40");

/** Reference tables computed from the lib. */
function tdhFor(nominal: number, gpm = 30, lengthFt = 40, liftFt = 12) {
  const id = insideDiameter("pvc-40", nominal) ?? 0;
  const frictionPsi = frictionLossPsiPerFoot(gpm, id, HAZEN_WILLIAMS_C["pvc-40"]) * lengthFt;
  const frictionFt = psiToHead(frictionPsi);
  const v = velocity(gpm, id);
  const vHead = velocityHead(v);
  const tdh = totalDynamicHead({
    staticLiftFeet: liftFt,
    frictionHeadFeet: frictionFt,
    pressureHeadFeet: 0,
    velocityHeadFeet: vHead,
  });
  return { nominal, id, frictionFt, v, vHead, tdh };
}

const sizeTable = PVC_SIZES.filter((n) => n >= 1 && n <= 4).map((n) => tdhFor(n));

const liftTable = [5, 10, 12, 15, 20, 30].map((liftFt) => {
  const r = tdhFor(1.5, 30, 40, liftFt);
  return { liftFt, ...r, staticShare: (liftFt / r.tdh) * 100 };
});

const styles = plumbingAccentStyles.orange;
---

<Layout {title} {description}>
  <Fragment slot="head">
    <link rel="canonical" href={pageUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Pump Head Calculator — Total Dynamic Head" />
    <meta
      property="og:description"
      content="Static lift, friction head, pressure head and velocity head added up into the total dynamic head your pump has to make. Free and instant."
    />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:site_name" content="TradesQuote" />
    <meta property="og:image" content="https://www.tradesquote.ai/logo.svg" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Pump Head Calculator — Total Dynamic Head" />
    <meta
      name="twitter:description"
      content="Total dynamic head for a sump, well or booster pump, term by term. Free, instant, no sign-up."
    />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbData)} />
    <script type="application/ld+json" set:html={JSON.stringify(webAppData)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqData)} />
  </Fragment>

  <div class="bg-white min-h-screen text-slate-700">
    <Header />

    <main>
      <!-- ==== HERO ==== -->
      <section class="relative overflow-hidden bg-gradient-to-b from-slate-50 to-white">
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pt-10 pb-6">
          <CalculatorBreadcrumb
            category="Plumbing"
            categoryHref="/calculators/plumbing"
            current="Pump Head Calculator"
          />

          <div class="max-w-3xl">
            <span
              class="inline-flex items-center gap-1.5 rounded-full bg-orange-100 px-3 py-1 text-xs font-semibold text-orange-700"
            >
              <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 21V9m0 0L7 14m5-5l5 5M5 5h14" />
              </svg>
              Plumbing Tools · TDH · Free
            </span>

            <h1 class="mt-4 text-4xl sm:text-5xl font-extrabold tracking-tight text-slate-900">
              Pump Head Calculator <span class="text-orange-600">— Total Dynamic Head</span>
            </h1>

            <p class="mt-5 text-lg text-slate-600 leading-relaxed">
              A pump is selected against a <strong>curve</strong>, not a horsepower, and the number you take to
              that curve is total dynamic head — everything the pump has to overcome, expressed in feet. Four
              terms make it up: the vertical <strong>lift</strong>, the <strong>friction</strong> in the
              discharge pipe, any <strong>pressure</strong> the outlet has to deliver at, and the
              <strong>velocity</strong> of the water itself. This adds them and shows what share each takes.
            </p>
          </div>
        </div>
      </section>

      <!-- ==== CALCULATOR ==== -->
      <section id="calculator" class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pb-12">
        <div class="mx-auto max-w-5xl rounded-2xl border border-slate-200 bg-white p-6 sm:p-8 shadow-sm">
          <h2 class="text-xl font-bold text-slate-900 flex items-center gap-2">
            <svg class="h-5 w-5 text-orange-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 21V9m0 0L7 14m5-5l5 5M5 5h14"></path>
            </svg>
            Work out the head
          </h2>

          <div class="mt-6 lg:grid lg:grid-cols-2 lg:gap-8 lg:items-start">
            <div class="space-y-6">
              <div>
                <div class="flex items-center justify-between">
                  <label for="ph-gpm" class="text-sm font-semibold text-slate-800">Required flow</label>
                  <div class="flex items-center gap-1">
                    <input
                      id="ph-gpm"
                      type="number"
                      min="0"
                      max="500"
                      step="0.1"
                      value="30"
                      class="w-24 rounded-lg border border-slate-300 px-3 py-1.5 text-right text-sm font-semibold text-slate-900 focus:border-orange-500 focus:ring-2 focus:ring-orange-200 outline-none"
                    />
                    <span class="text-sm text-slate-500">gpm</span>
                  </div>
                </div>
                <input
                  id="ph-gpm-range"
                  type="range"
                  min="5"
                  max="200"
                  step="1"
                  value="30"
                  class="plumb-range mt-3 w-full bg-slate-200 accent-orange-600"
                />
                <div class="flex justify-between text-xs text-slate-400 mt-1">
                  <span>5</span><span>200 gpm</span>
                </div>
              </div>

              <div class="grid sm:grid-cols-2 gap-5">
                <div>
                  <label for="ph-lift" class="text-sm font-semibold text-slate-800">Static lift</label>
                  <div class="mt-2 flex items-center gap-2">
                    <input
                      id="ph-lift"
                      type="number"
                      min="0"
                      max="500"
                      value="12"
                      class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm text-slate-900 focus:border-orange-500 focus:ring-2 focus:ring-orange-200 outline-none"
                    />
                    <span class="text-sm text-slate-500 shrink-0">ft</span>
                  </div>
                  <p class="mt-1.5 text-xs text-slate-500">Water level to discharge point, vertically.</p>
                </div>

                <div>
                  <label for="ph-length" class="text-sm font-semibold text-slate-800">
                    Developed pipe length
                  </label>
                  <div class="mt-2 flex items-center gap-2">
                    <input
                      id="ph-length"
                      type="number"
                      min="0"
                      max="2000"
                      value="40"
                      class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm text-slate-900 focus:border-orange-500 focus:ring-2 focus:ring-orange-200 outline-none"
                    />
                    <span class="text-sm text-slate-500 shrink-0">ft</span>
                  </div>
                  <p class="mt-1.5 text-xs text-slate-500">Including fitting equivalents.</p>
                </div>

                <div>
                  <label for="ph-material" class="text-sm font-semibold text-slate-800">
                    Discharge material
                  </label>
                  <select
                    id="ph-material"
                    class="mt-2 w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm text-slate-900 focus:border-orange-500 focus:ring-2 focus:ring-orange-200 outline-none"
                  >
                    {
                      MATERIALS.map((m) => (
                        <option value={m} selected={m === "pvc-40"}>
                          {PIPE_MATERIAL_LABELS[m]}
                        </option>
                      ))
                    }
                  </select>
                </div>

                <div>
                  <label for="ph-size" class="text-sm font-semibold text-slate-800">Discharge size</label>
                  <select
                    id="ph-size"
                    class="mt-2 w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm text-slate-900 focus:border-orange-500 focus:ring-2 focus:ring-orange-200 outline-none"
                  >
                    {
                      PVC_SIZES.map((n) => (
                        <option value={n} selected={n === 1.5}>
                          {sizeLabel(n)}
                        </option>
                      ))
                    }
                  </select>
                </div>

                <div class="sm:col-span-2">
                  <label for="ph-discharge" class="text-sm font-semibold text-slate-800">
                    Pressure required at the discharge
                  </label>
                  <div class="mt-2 flex items-center gap-2">
                    <input
                      id="ph-discharge"
                      type="number"
                      min="0"
                      max="200"
                      step="0.1"
                      value="0"
                      class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm text-slate-900 focus:border-orange-500 focus:ring-2 focus:ring-orange-200 outline-none"
                    />
                    <span class="text-sm text-slate-500 shrink-0">psi</span>
                  </div>
                  <p class="mt-1.5 text-xs text-slate-500">
                    Zero for an open discharge such as a sump. A booster feeding a system needs the real
                    figure.
                  </p>
                </div>
              </div>

              <button
                id="ph-reset"
                type="button"
                class="text-sm font-medium text-slate-500 hover:text-orange-600 transition flex items-center gap-1.5"
              >
                <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"
                  ></path>
                </svg>
                Reset to defaults
              </button>
            </div>

            <!-- Results -->
            <div
              class="mt-6 lg:mt-0 lg:sticky lg:top-6 rounded-xl border border-orange-100 bg-orange-50 p-5 sm:p-6"
            >
              <p class="text-sm font-medium text-slate-600">Total dynamic head</p>
              <div class="mt-2 flex items-baseline gap-2">
                <span id="ph-tdh" class="text-5xl font-extrabold tracking-tight text-orange-600">14.43 ft</span>
              </div>
              <p id="ph-note" class="mt-1 text-sm font-semibold text-slate-700">
                Static lift dominates at 83% of the total, so pipe size makes little difference here.
              </p>

              <div class="mt-6 grid grid-cols-2 gap-3">
                <div class="rounded-xl border border-orange-100 bg-white p-4">
                  <p class="text-xs text-slate-500">Friction head</p>
                  <p id="ph-friction" class="mt-1 text-2xl font-bold text-slate-900">2.08 ft</p>
                </div>
                <div class="rounded-xl border border-orange-100 bg-white p-4">
                  <p class="text-xs text-slate-500">Discharge velocity</p>
                  <p id="ph-velocity" class="mt-1 text-2xl font-bold text-slate-900">4.73 ft/s</p>
                </div>
              </div>

              <details class="group mt-5 rounded-xl border border-orange-100 bg-white">
                <summary
                  class="flex items-center justify-between cursor-pointer px-4 py-3 text-sm font-semibold text-slate-800"
                >
                  See the breakdown
                  <svg
                    class="h-4 w-4 text-slate-500 transition-transform group-open:rotate-180"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    viewBox="0 0 24 24"
                  >
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"></path>
                  </svg>
                </summary>
                <div class="px-4 pb-4 text-sm space-y-1.5 text-slate-600">
                  <div class="flex justify-between gap-3">
                    <span>Static lift</span><span id="ph-bd-static" class="font-semibold text-slate-900">—</span>
                  </div>
                  <div class="flex justify-between gap-3">
                    <span>Friction</span><span id="ph-bd-friction-psi" class="font-semibold text-slate-900">—</span>
                  </div>
                  <div class="flex justify-between gap-3">
                    <span>Pressure head</span><span id="ph-bd-pressure" class="font-semibold text-slate-900">—</span>
                  </div>
                  <div class="flex justify-between gap-3">
                    <span>Velocity head</span><span id="ph-bd-velocity-head" class="font-semibold text-slate-900">—</span>
                  </div>
                  <div class="flex justify-between gap-3 border-t border-slate-200 pt-1.5 mt-1.5">
                    <span>Take this to the curve</span><span id="ph-bd-share" class="font-semibold text-slate-900">—</span>
                  </div>
                </div>
              </details>

              <p class="mt-4 text-xs text-slate-500 leading-relaxed">
                Planning estimate. Net positive suction head, cavitation margin and pump-curve efficiency are
                not modelled — a surface pump can only lift about 25 ft on the suction side at sea level
                whatever this says. A licensed plumber and the pump manufacturer's curve have final say.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- ==== FORMULA ==== -->
      <section class="bg-slate-50 border-y border-slate-200">
        <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-14">
          <h2 class="text-3xl font-extrabold tracking-tight text-slate-900">
            The formula, explained in plain English
          </h2>
          <p class="mt-4 text-slate-600 leading-relaxed">
            Four terms, all converted to feet so they can be added, then matched against a pump curve.
          </p>

          <div
            class="mt-8 rounded-2xl bg-slate-900 p-6 sm:p-8 text-slate-100 font-mono text-sm leading-relaxed overflow-x-auto"
          >
            <div class="text-orange-300"># Total dynamic head</div>
            <div>TDH&nbsp;=&nbsp;static lift + friction head + pressure head + velocity head</div>
            <div class="mt-4 text-orange-300"># Friction, via Hazen-Williams then converted</div>
            <div>
              psi&nbsp;=&nbsp;<span class="text-amber-300">4.52</span> × Q^1.852 ÷ (C^1.852 × d^4.8704) ×
              length
            </div>
            <div>feet&nbsp;=&nbsp;psi × <span class="text-amber-300">2.309</span></div>
            <div class="mt-4 text-orange-300"># Pressure head</div>
            <div>feet&nbsp;=&nbsp;discharge psi × <span class="text-amber-300">2.309</span></div>
            <div class="mt-4 text-orange-300"># Velocity head</div>
            <div>
              feet&nbsp;=&nbsp;V² ÷ (2 × <span class="text-amber-300">32.174</span>)&nbsp;&nbsp;·&nbsp;&nbsp;V
              = 0.4085 × Q ÷ d²
            </div>
            <div class="mt-4 text-slate-400"># Then pick the pump</div>
            <div>find a curve delivering Q gpm at or above TDH feet</div>
          </div>

          <div class="mt-8 grid sm:grid-cols-2 gap-4">
            <div class="rounded-xl border border-slate-200 bg-white p-5">
              <h3 class="font-bold text-slate-900">Everything in feet, not psi</h3>
              <p class="mt-2 text-sm text-slate-600">
                Pump curves are published in feet of head because feet are independent of fluid density. Convert
                every term to feet first, add them, and only convert to psi at the end if you need to.
              </p>
            </div>
            <div class="rounded-xl border border-slate-200 bg-white p-5">
              <h3 class="font-bold text-slate-900">Static lift is not negotiable</h3>
              <p class="mt-2 text-sm text-slate-600">
                It is a measured dimension. Friction you can design down by upsizing the discharge; pressure
                head depends on what you are feeding; lift is whatever the building is.
              </p>
            </div>
            <div class="rounded-xl border border-slate-200 bg-white p-5">
              <h3 class="font-bold text-slate-900">Velocity head is honest but tiny</h3>
              <p class="mt-2 text-sm text-slate-600">
                At 4.73 ft/s it is 0.35 feet — 2.4% of the default total. It belongs in the equation and it
                will not change your pump. Including it and saying it is small beats quietly dropping it.
              </p>
            </div>
            <div class="rounded-xl border border-slate-200 bg-white p-5">
              <h3 class="font-bold text-slate-900">Oversizing has a cost</h3>
              <p class="mt-2 text-sm text-slate-600">
                A pump running far from its best efficiency point short-cycles, wears its seals and can
                cavitate. Match the curve near the duty point rather than buying the biggest unit that fits.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- ==== WORKED EXAMPLES ==== -->
      <section class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 py-14">
        <h2 class="text-3xl font-extrabold tracking-tight text-slate-900">Worked examples</h2>
        <p class="mt-4 text-slate-600">
          A basement sump, a long run where friction takes over, and a booster where pressure head dominates.
        </p>

        <div class="mt-8 space-y-6">
          <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
            <div class="flex items-center gap-3">
              <span
                class="flex h-9 w-9 items-center justify-center rounded-full bg-orange-100 text-orange-700 font-bold"
              >
                1
              </span>
              <h3 class="text-lg font-bold text-slate-900">Basement sump — 30 gpm, 12 ft lift</h3>
            </div>
            <p class="mt-3 text-sm text-slate-600">
              40 ft of 1-1/2 inch PVC, open discharge. The calculator's defaults.
            </p>
            <div class="mt-4 rounded-xl bg-slate-50 p-4 font-mono text-sm text-slate-700">
              static = 12.00 ft (83%)<br />
              friction = 0.90 psi × 2.309 = 2.08 ft (14%)<br />
              pressure = 0 ft&nbsp;·&nbsp;velocity 4.73 ft/s → 0.35 ft (2.4%)<br />
              TDH = <span class="font-bold text-orange-700">14.43 ft</span> = 6.25 psi
            </div>
            <p class="mt-3 text-sm text-slate-600">
              <span class="font-semibold text-slate-900">Result:</span> find a pump delivering 30 gpm at 14.4
              feet. Static lift is five sixths of the job — no realistic pipe change moves this number much.
            </p>
          </div>

          <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
            <div class="flex items-center gap-3">
              <span
                class="flex h-9 w-9 items-center justify-center rounded-full bg-orange-100 text-orange-700 font-bold"
              >
                2
              </span>
              <h3 class="text-lg font-bold text-slate-900">Long discharge to a ditch — friction takes over</h3>
            </div>
            <p class="mt-3 text-sm text-slate-600">
              Same 30 gpm and 12 ft lift, but 300 ft of 1-1/2 inch PVC to reach the outfall.
            </p>
            <div class="mt-4 rounded-xl bg-slate-50 p-4 font-mono text-sm text-slate-700">
              friction = 2.26 psi/100 ft × 3.0 = 6.77 psi = 15.63 ft<br />
              TDH = 12 + 15.63 + 0 + 0.35 = <span class="font-bold text-orange-700">27.97 ft</span><br />
              friction is now <span class="font-bold text-orange-700">56%</span> of the total<br />
              upsize to 2": friction drops to 4.63 ft → TDH = 16.76 ft
            </div>
            <p class="mt-3 text-sm text-slate-600">
              <span class="font-semibold text-slate-900">Result:</span> the same pit and the same lift need
              nearly twice the head, purely because of the run. Here the discharge pipe size is the whole
              design decision — one size up removes 11.2 feet of head.
            </p>
          </div>

          <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
            <div class="flex items-center gap-3">
              <span
                class="flex h-9 w-9 items-center justify-center rounded-full bg-orange-100 text-orange-700 font-bold"
              >
                3
              </span>
              <h3 class="text-lg font-bold text-slate-900">Booster pump — pressure head dominates</h3>
            </div>
            <p class="mt-3 text-sm text-slate-600">
              20 gpm, 30 ft of lift, 100 ft of 1-1/4 inch copper, and 40 psi required at the outlet.
            </p>
            <div class="mt-4 rounded-xl bg-slate-50 p-4 font-mono text-sm text-slate-700">
              pressure head = 40 × 2.309 = <span class="font-bold text-orange-700">92.4 ft</span><br />
              static = 30 ft&nbsp;·&nbsp;friction 9.04 ft&nbsp;·&nbsp;velocity head 0.41 ft<br />
              TDH = <span class="font-bold text-orange-700">131.80 ft</span><br />
              pressure head alone is <span class="font-bold text-orange-700">70%</span> of it
            </div>
            <p class="mt-3 text-sm text-slate-600">
              <span class="font-semibold text-slate-900">Result:</span> on a booster the required discharge
              pressure swamps everything else. Forty psi is worth ninety-two feet of head — three times the
              actual lift — which is why booster duty points look so different from sump duty points.
            </p>
          </div>
        </div>
      </section>

