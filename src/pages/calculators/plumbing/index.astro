---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import CalculatorToolCard from "@/components/CalculatorToolCard.astro";
import CalculatorBreadcrumb from "@/components/CalculatorBreadcrumb.astro";
import CalculatorFaqSection from "@/components/CalculatorFaqSection.astro";
import CalculatorTradesQuoteCta from "@/components/CalculatorTradesQuoteCta.astro";
import ExternalResources from "@/components/ExternalResources.astro";
import type { ExternalResource } from "@/config/hvacExternalResources";
import { buildFaqPageSchema } from "@/lib/calculatorFaq";
import { calculatorCategories } from "@/config/calculatorCategories";
import { getSinglePage } from "@/lib/contentParser.astro";
import taxonomyFilter from "@/lib/utils/taxonomyFilter";
import {
  plumbingCalculators,
  plumbingCalculatorGroups,
  plumbingCalculatorGuide,
  plumbingFaqs,
  plumbingAccentStyles,
  ungroupedPlumbingCalculators,
} from "@/config/plumbingCalculators";
import { hvacCalculators } from "@/config/hvacCalculators";
import { electricalCalculators } from "@/config/electricalCalculators";

const title = "Free Plumbing Calculators (IPC) | TradesQuote";
const description =
  "Free IPC-based plumbing calculators — water supply and drainage fixture units, water pipe size, pipe velocity, Hazen-Williams friction loss, drain and sewer sizing, minimum slope and fall, vent size and trap arm length, storm drainage, septic and grease interceptor sizing, water pressure and head, pump total dynamic head, well pressure tank drawdown, water heater, tankless, expansion tank and mixing valve sizing, pipe volume, unit conversion, repipe and water heater replacement cost, labor rate, and job pricing. Every formula explained in plain English with the code section cited.";

const pageUrl = "https://www.tradesquote.ai/calculators/plumbing";
const basePath = "/calculators/plumbing";

const comingSoonCategories = calculatorCategories.filter((c) => c.status === "coming-soon");

const breadcrumbData = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: "https://www.tradesquote.ai/" },
    { "@type": "ListItem", position: 2, name: "Calculators", item: "https://www.tradesquote.ai/calculators" },
    { "@type": "ListItem", position: 3, name: "Plumbing", item: pageUrl },
  ],
};

const itemListData = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Free Plumbing Calculators",
  description:
    "Free online plumbing calculators built on the International Plumbing Code: water supply fixture units and peak demand, water pipe sizing against velocity and friction, pipe velocity, Hazen-Williams friction loss, drainage fixture units from Table 709.1, drain and sewer sizing from Tables 710.1(1) and 710.1(2), minimum slope from Table 704.1, vent sizing under 906.2 with Table 909.1 trap arm limits, roof and storm drainage runoff, septic tank and leach field sizing, grease interceptor sizing under 1003.3, pressure and head conversion with the IPC 604.8 pressure-reducing valve threshold, pump total dynamic head, well pressure tank drawdown, storage and tankless water heater sizing, thermal expansion tank and mixing valve sizing, pipe volume and purge time, unit conversion, whole-house repipe cost, water heater replacement cost, loaded labor rate, and contractor job pricing.",
  itemListElement: plumbingCalculators.map((calc, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: calc.title,
    url: `${pageUrl}/${calc.slug}`,
  })),
};

const faqData = buildFaqPageSchema(plumbingFaqs);

const allPosts = await getSinglePage("posts");
const recentPlumbingPosts = taxonomyFilter(allPosts, "categories", "plumbing")
  .filter((p) => !p.data.draft)
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 3);

const ctaHeading = "Calculators size the system. TradesQuote prices the job.";
const ctaDescription =
  "Once the pipe size, the fall, and the vent are settled, the real work is the quote. Describe the job or upload photos, and TradesQuote's AI builds a detailed line-item estimate — fixtures, pipe, fittings, and labor with quantities, unit prices, and totals — validated by a built-in quality control agent and ready for your client to sign online.";

const externalResourceStyles = {
  hoverBorder: "hover:border-orange-300",
  iconBg: "bg-orange-100",
  iconColor: "text-orange-700",
  hoverTitle: "group-hover:text-orange-700",
  hoverIcon: "group-hover:text-orange-600",
};

const ICON_BOOK =
  "M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253";
const ICON_SHIELD =
  "M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z";
const ICON_BEAKER =
  "M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z";
const ICON_CHART =
  "M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z";

const plumbingResources: ExternalResource[] = [
  {
    href: "https://codes.iccsafe.org/codes/i-codes",
    name: "ICC — International Plumbing Code",
    description:
      "The model code these calculators are built on. Chapter 6 covers water supply, Chapter 7 sanitary drainage, Chapter 9 vents, and Appendix E water pipe sizing.",
    iconPath: ICON_BOOK,
  },
  {
    href: "https://www.iapmo.org/uniform-plumbing-code",
    name: "IAPMO — Uniform Plumbing Code",
    description:
      "The other model code. Roughly fifteen states use the UPC or a derivative such as California's CPC, and its fixture-unit values and sizing tables differ from the IPC's.",
    iconPath: ICON_SHIELD,
  },
  {
    href: "https://www.aspe.org/",
    name: "ASPE — American Society of Plumbing Engineers",
    description:
      "Source of the velocity design limits and the Hunter's-curve demand method. The IPC requires a system free of noise and erosion without naming a number; ASPE names it.",
    iconPath: ICON_CHART,
  },
  {
    href: "https://www.astm.org/",
    name: "ASTM International",
    description:
      "Pipe dimensional standards: B88 for copper tube, F876 for PEX, D1785 for Schedule 40. Every inside diameter here is computed from these, not transcribed.",
    iconPath: ICON_BEAKER,
  },
  {
    href: "https://www.energy.gov/energysaver/sizing-new-water-heater",
    name: "US DOE — Water heater sizing",
    description:
      "The first-hour-rating worksheet and per-use hot water figures behind the peak-hour demand model in the water heater calculator.",
    iconPath: ICON_CHART,
  },
  {
    href: "https://www.copper.org/applications/plumbing/",
    name: "Copper Development Association",
    description:
      "Copper tube handbook data — wall thicknesses, friction-loss charts, and the erosion-corrosion velocity guidance that sets the 5 ft/s hot-water limit.",
    iconPath: ICON_BOOK,
  },
];
---

<Layout {title} {description}>
  <Fragment slot="head">
    <link rel="canonical" href={pageUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Free Plumbing Calculators (IPC)" />
    <meta
      property="og:description"
      content="Water supply and drainage fixture units, pipe size, velocity, friction loss, drain sizing, slope, venting, pressure and pump head, water heater sizing, and job pricing — free IPC-based tools with every formula explained."
    />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:site_name" content="TradesQuote" />
    <meta property="og:image" content="https://www.tradesquote.ai/logo.svg" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Free Plumbing Calculators (IPC)" />
    <meta
      name="twitter:description"
      content="Free IPC-based plumbing calculators for supply sizing, drainage and venting, pressure and pump head, water heating, and job pricing."
    />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbData)} />
    <script type="application/ld+json" set:html={JSON.stringify(itemListData)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqData)} />
  </Fragment>

  <div class="bg-white min-h-screen text-slate-700">
    <Header />

    <main>
      <!-- Hero -->
      <section class="relative overflow-hidden bg-gradient-to-b from-slate-50 to-white">
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pt-10 pb-8">
          <CalculatorBreadcrumb category="Plumbing" categoryHref="/calculators/plumbing" />

          <div class="max-w-3xl">
            <span
              class="inline-flex items-center gap-1.5 rounded-full bg-orange-100 px-3 py-1 text-xs font-semibold text-orange-700"
            >
              <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M12 2.69l5.66 5.66a8 8 0 11-11.31 0z"
                />
              </svg>
              Plumbing Tools · {plumbingCalculators.length} Free Calculators
            </span>

            <h1 class="mt-4 text-4xl sm:text-5xl font-extrabold tracking-tight text-slate-900">
              Free Plumbing Calculators <span class="text-orange-600">— IPC Supply, Drainage &amp; Cost</span>
            </h1>

            <p class="mt-5 text-lg text-slate-600 leading-relaxed">
              Size a system end to end without opening the code book. On the pressure side: fixture units
              into peak demand, then the pipe that carries it — checked against the velocity ceiling
              <em>and</em> the pressure budget, because a pipe that passes one can still fail the other. On the
              gravity side: drainage fixture units, the drain the code allows, the fall it needs, and the vent
              that keeps the traps sealed. Then size the water heater and price the job. Every tool is free,
              instant, and shows which rule governed its answer.
            </p>

            <div class="mt-6 rounded-xl border border-amber-200 bg-amber-50 p-4">
              <p class="text-sm text-amber-900 leading-relaxed">
                <span class="font-semibold">Code baseline: IPC 2021.</span> The IPC is a model code. Roughly
                fifteen states use the <strong>UPC</strong> or a derivative such as California's CPC instead,
                where fixture-unit values and sizing tables differ — and local amendments override either one.
                Results are for estimating and planning; a licensed plumber and your AHJ have final say on
                anything installed.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- Start here quick-nav -->
      <section class="border-b border-slate-100 bg-slate-50">
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-6">
          <p class="text-xs font-semibold uppercase tracking-widest text-slate-400 mb-3">Start here</p>
          <div class="flex flex-wrap gap-3">
            <a
              href={`${basePath}/plumbing-pipe-size-calculator`}
              class="inline-flex items-center gap-2 rounded-xl border border-sky-200 bg-white px-4 py-2.5 text-sm font-medium text-sky-700 shadow-sm hover:bg-sky-50 hover:border-sky-300 transition-colors"
            >
              <svg class="h-4 w-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"/></svg>
              Size a water line
            </a>
            <a
              href={`${basePath}/plumbing-drain-pipe-size-calculator`}
              class="inline-flex items-center gap-2 rounded-xl border border-indigo-200 bg-white px-4 py-2.5 text-sm font-medium text-indigo-700 shadow-sm hover:bg-indigo-50 hover:border-indigo-300 transition-colors"
            >
              <svg class="h-4 w-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
              Size a drain
            </a>
            <a
              href={`${basePath}/plumbing-pipe-slope-calculator`}
              class="inline-flex items-center gap-2 rounded-xl border border-violet-200 bg-white px-4 py-2.5 text-sm font-medium text-violet-700 shadow-sm hover:bg-violet-50 hover:border-violet-300 transition-colors"
            >
              <svg class="h-4 w-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6l16 12M4 18h16"/></svg>
              Set the fall
            </a>
            <a
              href={`${basePath}/plumbing-water-heater-size-calculator`}
              class="inline-flex items-center gap-2 rounded-xl border border-red-200 bg-white px-4 py-2.5 text-sm font-medium text-red-700 shadow-sm hover:bg-red-50 hover:border-red-300 transition-colors"
            >
              <svg class="h-4 w-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 18.657A8 8 0 016.343 7.343S7 9 9 10c0-2 .5-5 2.986-7C14 5 16.09 5.777 17.656 7.343A7.975 7.975 0 0120 13a7.975 7.975 0 01-2.343 5.657z"/></svg>
              Size a water heater
            </a>
            <a
              href={`${basePath}/plumbing-estimate-calculator`}
              class="inline-flex items-center gap-2 rounded-xl border border-emerald-200 bg-white px-4 py-2.5 text-sm font-medium text-emerald-700 shadow-sm hover:bg-emerald-50 hover:border-emerald-300 transition-colors"
            >
              <svg class="h-4 w-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              Price the job
            </a>
          </div>
        </div>
      </section>

      <!-- Calculator directory — grouped by workflow -->
      <section id="calculators" class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-14">
        {
          plumbingCalculatorGroups.map((group) => (
            <div class="mb-14">
              <div class="mb-5">
                <h2 class="text-xl font-bold text-slate-900">{group.label}</h2>
                <p class="mt-1 text-sm text-slate-500">{group.description}</p>
              </div>
              <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5">
                {group.slugs.map((slug) => {
                  const calculator = plumbingCalculators.find((c) => c.slug === slug);
                  return calculator ? (
                    <CalculatorToolCard
                      {calculator}
                      styles={plumbingAccentStyles[calculator.accent]}
                      {basePath}
                    />
                  ) : null;
                })}
              </div>
            </div>
          ))
        }

        {
          /* Safety net: anything registered but not placed in a group above still
             renders, so a missing group entry is visible rather than silent. */
          ungroupedPlumbingCalculators.length > 0 && (
            <div class="mb-14">
              <div class="mb-5">
                <h2 class="text-xl font-bold text-slate-900">More plumbing tools</h2>
                <p class="mt-1 text-sm text-slate-500">
                  Calculators that have not been sorted into a group yet.
                </p>
              </div>
              <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5">
                {ungroupedPlumbingCalculators.map((calculator) => (
                  <CalculatorToolCard
                    {calculator}
                    styles={plumbingAccentStyles[calculator.accent]}
                    {basePath}
                  />
                ))}
              </div>
            </div>
          )
        }

        <!-- Cross-category pointer -->
        <div class="rounded-2xl border border-slate-200 bg-slate-50 p-6">
          <h2 class="text-lg font-bold text-slate-900">Running a gas line?</h2>
          <p class="mt-2 text-sm text-slate-600 leading-relaxed">
            Gas piping reads the same IFGC table whether a plumber or an HVAC tech sizes it, so rather than
            keep two copies the
            <a href="/calculators/hvac/hvac-gas-line-sizing-calculator" class="font-semibold text-orange-600 hover:underline"
              >Gas Line Sizing Calculator</a
            >
            is shared. Feed it the total appliance load in BTU/h and the longest run and it returns the pipe
            size and its capacity. There are
            <a href="/calculators/hvac" class="font-semibold text-orange-600 hover:underline"
              >{hvacCalculators.length} HVAC calculators</a
            >
            and
            <a href="/calculators/electrical" class="font-semibold text-orange-600 hover:underline"
              >{electricalCalculators.length} electrical calculators</a
            > alongside these — useful when a water heater needs a circuit or a boiler needs a load calculation.
          </p>
        </div>

        <!-- Coming soon card -->
        <div class="mt-6 flex flex-col rounded-2xl border border-dashed border-slate-300 bg-slate-50 p-6 max-w-lg">
          <div class="flex items-center gap-3">
            <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-slate-200 text-slate-500">
              <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6m0 0v6m6-6h-6m-6 0h6" />
              </svg>
            </span>
            <h2 class="text-lg font-bold text-slate-700">More plumbing tools on the way</h2>
          </div>
          <p class="mt-3 text-sm text-slate-600 leading-relaxed">
            Every tool the last round promised is now built. Next for plumbing is the written side — guides
            and how-tos, which this category does not have yet — plus a grey-water and rainwater-harvesting
            calculator. Calculators for these trades are also planned:
          </p>
          <div class="mt-3 flex flex-wrap gap-2">
            {
              comingSoonCategories.map((category) => (
                <span class="rounded-full bg-white border border-slate-200 px-3 py-1 text-xs font-medium text-slate-600">
                  {category.name}
                </span>
              ))
            }
          </div>
          <p class="mt-auto pt-4 text-xs text-slate-500">Coming soon</p>
        </div>
      </section>

      <!-- Which calculator do I need? -->
      <section class="bg-slate-50 border-y border-slate-200">
        <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 py-14">
          <h2 class="text-3xl font-extrabold tracking-tight text-slate-900">Which calculator do I need?</h2>
          <p class="mt-4 text-slate-600 leading-relaxed">
            Match your question to the right tool. A supply job runs
            <span class="font-semibold text-slate-900">Fixture units → Demand → Pipe size</span>. A drainage
            job runs <span class="font-semibold text-slate-900">DFU → Drain size → Slope → Vent</span>. If you
            already know the gpm, start at pipe size; if you already know the DFU, start at drain size.
          </p>

          <div class="mt-8 overflow-x-auto rounded-2xl border border-slate-200 bg-white shadow-sm">
            <table class="w-full text-left text-sm">
              <thead>
                <tr class="border-b border-slate-200 text-slate-500 bg-slate-50">
                  <th class="py-3 px-5 font-semibold">You're asking…</th>
                  <th class="py-3 px-5 font-semibold">Use this tool</th>
                  <th class="py-3 px-5 font-semibold">The rule it's built on</th>
                </tr>
              </thead>
              <tbody class="text-slate-700">
                {
                  plumbingCalculatorGuide.map((row, index) => {
                    const linkColor = plumbingAccentStyles[row.accent].linkColor;
                    const isLast = index === plumbingCalculatorGuide.length - 1;
                    return (
                      <tr class={isLast ? "" : "border-b border-slate-100"}>
                        <td class="py-3 px-5">{row.question}</td>
                        <td class="py-3 px-5">
                          <a
                            href={`${basePath}/${row.slug}`}
                            class={`font-semibold ${linkColor} hover:underline`}
                          >
                            {row.tool}
                          </a>
                        </td>
                        <td class="py-3 px-5">{row.rule}</td>
                      </tr>
                    );
                  })
                }
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <!-- Formula reference pointer -->
      <section class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-14">
        <h2 class="text-3xl font-extrabold tracking-tight text-slate-900">
          Every plumbing formula on one page
        </h2>
        <p class="mt-4 text-slate-600 leading-relaxed">
          Rather than repeat them here, every formula behind these tools lives on one reference page — each
          with what every variable means, the values you should expect back, and the IPC section it comes
          from. Two more reference pages sit alongside it: the vocabulary, and the one subject where getting
          the device wrong is a health risk rather than a callback.
        </p>

        <a
          href={`${basePath}/formulas`}
          class="group mt-8 flex items-start gap-5 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm hover:border-orange-300 hover:shadow-md transition-all"
        >
          <span
            class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-orange-100 text-orange-600"
          >
            <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"
              />
            </svg>
          </span>
          <span class="min-w-0">
            <span class="block text-lg font-bold text-slate-900 group-hover:text-orange-600">
              Plumbing Formula Reference
            </span>
            <span class="mt-2 block text-sm text-slate-600 leading-relaxed">
              Water supply fixture units to gpm, pipe velocity, Hazen-Williams friction loss, available
              pressure, developed length, drainage fixture units, minimum slope, Manning's equation, vent and
              trap arm sizing, pressure and head, total dynamic head, recovery rate, first-hour rating,
              tankless flow, mixing-valve ratio, and gas load in CFH.
            </span>
            <span class="mt-3 block text-sm font-semibold text-orange-600 group-hover:underline">
              Open the reference →
            </span>
          </span>
        </a>

        <div class="mt-5 grid sm:grid-cols-2 gap-5">
          <a
            href={`${basePath}/glossary`}
            class="group flex flex-col rounded-2xl border border-slate-200 bg-white p-6 shadow-sm hover:border-orange-300 hover:shadow-md transition-all"
          >
            <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-orange-100 text-orange-600">
              <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M4 6h16M4 12h16M4 18h7"
                />
              </svg>
            </span>
            <span class="mt-4 block text-lg font-bold text-slate-900 group-hover:text-orange-600">
              Plumbing Glossary
            </span>
            <span class="mt-2 block text-sm text-slate-600 leading-relaxed">
              The vocabulary in plain English — trap arm, wet vent, WSFU, drawdown, flood level rim,
              scour velocity — weighted toward the pairs people mix up.
            </span>
            <span class="mt-auto pt-4 block text-sm font-semibold text-orange-600 group-hover:underline">
              Open the glossary →
            </span>
          </a>

          <a
            href={`${basePath}/backflow-prevention`}
            class="group flex flex-col rounded-2xl border border-slate-200 bg-white p-6 shadow-sm hover:border-orange-300 hover:shadow-md transition-all"
          >
            <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-orange-100 text-orange-600">
              <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
                />
              </svg>
            </span>
            <span class="mt-4 block text-lg font-bold text-slate-900 group-hover:text-orange-600">
              Backflow Prevention
            </span>
            <span class="mt-2 block text-sm text-slate-600 leading-relaxed">
              Backpressure against backsiphonage, hazard class, every assembly from air gap to RPZ, and the
              device each connection takes — because no vacuum breaker stops backpressure.
            </span>
            <span class="mt-auto pt-4 block text-sm font-semibold text-orange-600 group-hover:underline">
              Open the reference →
            </span>
          </a>
        </div>

        <p class="mt-6 text-sm text-slate-500">
          These reproduce IPC tables and standard hydraulic formulas, but they cannot see your existing
          piping, water quality, fixture selection, or local amendments. Confirm final design with a licensed
          plumber and the edition of the code your jurisdiction actually enforces.
        </p>
      </section>

      <CalculatorFaqSection
        faqs={plumbingFaqs}
        accent="orange"
        subtitle="About the calculators, which code edition they follow, and what's next."
      />

      <ExternalResources
        heading="Trusted Plumbing Standards & Resources"
        subheading="Every fixture unit value, sizing table, pipe dimension, and velocity limit on these pages traces back to a published standard. These are the organisations that write them and the data behind the sizing figures."
        resources={plumbingResources}
        styles={externalResourceStyles}
      />

      <CalculatorTradesQuoteCta heading={ctaHeading} description={ctaDescription} />

      {
        recentPlumbingPosts.length > 0 && (
          <section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-14">
            <div class="flex items-end justify-between mb-8">
              <div>
                <h2 class="text-3xl font-extrabold tracking-tight text-slate-900">From the Blog</h2>
                <p class="mt-2 text-slate-600">
                  Guides and deep-dives on IPC sizing, code compliance, and plumbing job pricing.
                </p>
              </div>
              <a
                href="/blog/categories/plumbing"
                class="hidden sm:inline-flex items-center gap-1.5 text-sm font-semibold text-orange-600 hover:text-orange-800"
              >
                All plumbing articles
                <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                </svg>
              </a>
            </div>
            <div class="grid md:grid-cols-3 gap-6">
              {recentPlumbingPosts.map((post) => (
                <a
                  href={`/blog/${post.id}`}
                  class="group flex flex-col rounded-2xl border border-slate-200 bg-white p-6 hover:border-orange-300 hover:shadow-md transition-all"
                >
                  <p class="text-xs font-semibold uppercase tracking-widest text-orange-600 mb-2">Plumbing</p>
                  <h3 class="text-base font-bold text-slate-900 group-hover:text-orange-600 leading-snug">
                    {post.data.title}
                  </h3>
                  {post.data.description && (
                    <p class="mt-2 text-sm text-slate-500 leading-relaxed line-clamp-2">
                      {post.data.description}
                    </p>
                  )}
                  <span class="mt-auto pt-4 text-sm font-semibold text-orange-600 group-hover:underline">
                    Read article →
                  </span>
                </a>
              ))}
            </div>
            <div class="mt-6 sm:hidden">
              <a
                href="/blog/categories/plumbing"
                class="text-sm font-semibold text-orange-600 hover:text-orange-800"
              >
                View all plumbing articles →
              </a>
            </div>
          </section>
        )
      }
    </main>

    <Footer />
  </div>
</Layout>
