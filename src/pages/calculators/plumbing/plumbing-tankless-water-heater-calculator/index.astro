---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import RelatedCalculators from "@/components/RelatedCalculators.astro";
import CalculatorBreadcrumb from "@/components/CalculatorBreadcrumb.astro";
import CalculatorFaqSection from "@/components/CalculatorFaqSection.astro";
import CalculatorTradesQuoteCta from "@/components/CalculatorTradesQuoteCta.astro";
import { buildFaqPageSchema, type CalculatorFaq } from "@/lib/calculatorFaq";
import { plumbingAccentStyles } from "@/config/plumbingCalculators";
import { BTU_PER_GPM_PER_DEGF, fmt, tanklessBtuRequired, tanklessGpm } from "@/lib/plumbing";

const title = "Tankless Water Heater Calculator — GPM by Temperature Rise | TradesQuote";
const description =
  "Free tankless water heater sizing calculator. Get the flow a unit can actually hold at your temperature rise, and the BTU input a target flow needs — the winter-inlet calculation that headline gpm ratings hide.";

const pageUrl =
  "https://www.tradesquote.ai/calculators/plumbing/plumbing-tankless-water-heater-calculator";

const breadcrumbData = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: "https://www.tradesquote.ai/" },
    { "@type": "ListItem", position: 2, name: "Calculators", item: "https://www.tradesquote.ai/calculators" },
    { "@type": "ListItem", position: 3, name: "Plumbing", item: "https://www.tradesquote.ai/calculators/plumbing" },
    { "@type": "ListItem", position: 4, name: "Tankless Water Heater Calculator", item: pageUrl },
  ],
};

const webAppData = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: "Tankless Water Heater Calculator",
  url: pageUrl,
  applicationCategory: "BusinessApplication",
  operatingSystem: "Any (web-based)",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  description:
    "Free online tankless water heater calculator that converts BTU input, efficiency and temperature rise into deliverable flow in gallons per minute, and works backwards to the BTU input a target flow requires.",
};

const faqs: CalculatorFaq[] = [
  {
    question: "What size tankless water heater do I need?",
    answer:
      "Work from the <strong>temperature rise</strong>, not the headline gpm. A 199,000 BTU unit at 95% efficiency delivers <strong>5.40 gpm</strong> with a 50 °F inlet and a 120 °F target — a 70 °F rise. Those are the defaults. The same unit does 7.57 gpm on a warm 70 °F inlet and only <strong>4.73 gpm</strong> at 40 °F. Size for your coldest month.",
  },
  {
    question: "Why does the advertised gpm never match what I get?",
    answer:
      "Because the headline figure assumes a temperature rise most of the country never sees. Manufacturers commonly quote flow at a 35 or 45 °F rise, which is a summer inlet in a warm state. At a realistic northern winter rise of 80 °F, the same unit loses <strong>38% of its output</strong> against a 50 °F rise. This is the single most common tankless sizing failure and it is entirely predictable.",
  },
  {
    question: "How do I work out my temperature rise?",
    answer:
      "Target temperature minus incoming groundwater temperature. Target is usually <strong>120 °F</strong> for domestic use. Inlet ranges from about 70 °F along the Gulf coast to <strong>40 °F</strong> in the northern states in winter — and it is the winter number that matters, because that is when everyone showers longest.",
  },
  {
    question: "How many fixtures can one tankless unit run?",
    answer:
      "Divide the deliverable flow by what the fixtures draw. At <strong>5.40 gpm</strong> you get roughly two 2.0 gpm showers with a little left over, or one shower plus a kitchen sink. A modern low-flow shower at 1.5 gpm stretches that to three. Count the fixtures that will genuinely run <em>simultaneously</em>, not the total in the house.",
  },
  {
    question: "What is the 500 in the formula?",
    answer:
      "It is <strong>8.33 lb/gal × 60 minutes</strong> = 499.8, the BTU needed per hour to raise one gallon per minute by one degree Fahrenheit. Every water-heating calculation in the trade uses it. This calculator carries the exact 499.8 rather than the rounded 500, which is why results sit a fraction of a percent above what a hand calculation gives.",
  },
  {
    question: "Does a tankless need a bigger gas line?",
    answer:
      "Usually, and it is the cost that surprises people. A 199,000 BTU tankless can draw more gas than every other appliance in the house combined, and a 1/2-inch branch that fed a 40,000 BTU tank will not carry it. Size the gas line properly — the <a href=\"/calculators/hvac/hvac-gas-line-sizing-calculator\" class=\"font-semibold text-blue-700 underline decoration-blue-300 hover:decoration-blue-600\">Gas Line Sizing Calculator</a> handles that. A condensing unit also needs its own sealed vent and a condensate drain.",
  },
  {
    question: "Is tankless always better than a tank?",
    answer:
      'Not always. Tankless wins on standby loss and endless supply, and takes far less floor space. A tank wins on <strong>burst capacity</strong> — it has gallons already hot, so a short heavy draw is easy for it, whereas a tankless is limited to its flow rate no matter how brief the demand. Compare with the <a href="/calculators/plumbing/plumbing-water-heater-size-calculator" class="font-semibold text-blue-700 underline decoration-blue-300 hover:decoration-blue-600">Water Heater Size Calculator</a> before deciding.',
  },
];
const faqData = buildFaqPageSchema(faqs);

const ctaHeading = "Unit picked? Quote the whole job in seconds.";
const ctaDescription =
  "A tankless swap is rarely just the unit — gas upsize, sealed vent, condensate, and often electrical. TradesQuote turns the whole scope into a detailed, line-item estimate with quantities and unit prices — validated by a built-in quality control agent and ready for your client to sign online.";

const relatedCalculators = [
  {
    href: "/calculators/plumbing/plumbing-water-heater-size-calculator",
    title: "Water Heater Size Calculator",
    description: "Compare against a storage tank on the same demand.",
  },
  {
    href: "/calculators/plumbing/plumbing-water-heater-replacement-cost-calculator",
    title: "Water Heater Replacement Cost Calculator",
    description: "What a tankless conversion really costs.",
  },
  {
    href: "/calculators/hvac/hvac-gas-line-sizing-calculator",
    title: "Gas Line Sizing Calculator",
    description: "Check the gas branch can carry 199,000 BTU.",
  },
  {
    href: "/calculators/plumbing/plumbing-pipe-velocity-calculator",
    title: "Pipe Velocity Calculator",
    description: "Keep the hot line under the 5 ft/s limit.",
  },
];

/** Both tables computed from the lib. */
const inletTable = [70, 60, 50, 40].map((inletT) => {
  const rise = 120 - inletT;
  return { inletT, rise, flow: tanklessGpm(199000, 0.95, rise) };
});

const unitTable = [120000, 150000, 180000, 199000].map((input) => ({
  input,
  warm: tanklessGpm(input, 0.95, 50),
  mid: tanklessGpm(input, 0.95, 70),
  cold: tanklessGpm(input, 0.95, 80),
}));

const styles = plumbingAccentStyles.blue;
---

<Layout {title} {description}>
  <Fragment slot="head">
    <link rel="canonical" href={pageUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Tankless Water Heater Calculator — GPM by Temperature Rise" />
    <meta
      property="og:description"
      content="The flow a tankless unit can actually hold at your temperature rise, and the BTU a target flow needs. Free and instant."
    />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:site_name" content="TradesQuote" />
    <meta property="og:image" content="https://www.tradesquote.ai/logo.svg" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Tankless Water Heater Calculator — GPM by Temperature Rise" />
    <meta
      name="twitter:description"
      content="Tankless flow by temperature rise, and the BTU a target flow needs. Free, instant, no sign-up."
    />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbData)} />
    <script type="application/ld+json" set:html={JSON.stringify(webAppData)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqData)} />
  </Fragment>

  <div class="bg-white min-h-screen text-slate-700">
    <Header />

    <main>
      <!-- ==== HERO ==== -->
      <section class="relative overflow-hidden bg-gradient-to-b from-slate-50 to-white">
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pt-10 pb-6">
          <CalculatorBreadcrumb
            category="Plumbing"
            categoryHref="/calculators/plumbing"
            current="Tankless Water Heater Calculator"
          />

          <div class="max-w-3xl">
            <span
              class="inline-flex items-center gap-1.5 rounded-full bg-blue-100 px-3 py-1 text-xs font-semibold text-blue-700"
            >
              <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 2.69l5.66 5.66a8 8 0 11-11.31 0z" />
              </svg>
              Plumbing Tools · Temperature rise · Free
            </span>

            <h1 class="mt-4 text-4xl sm:text-5xl font-extrabold tracking-tight text-slate-900">
              Tankless Water Heater Calculator <span class="text-blue-600">— GPM by Temperature Rise</span>
            </h1>

            <p class="mt-5 text-lg text-slate-600 leading-relaxed">
              A tankless unit has no reserve — whatever it can heat as the water passes through is all you get.
              That output depends entirely on <strong>temperature rise</strong>, and the gpm figure on the box
              assumes a rise most of the country never sees. Enter the real inlet temperature for your coldest
              month and see what the unit actually delivers.
            </p>
          </div>
        </div>
      </section>

      <!-- ==== CALCULATOR ==== -->
      <section id="calculator" class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pb-12">
        <div class="mx-auto max-w-5xl rounded-2xl border border-slate-200 bg-white p-6 sm:p-8 shadow-sm">
          <h2 class="text-xl font-bold text-slate-900 flex items-center gap-2">
            <svg class="h-5 w-5 text-blue-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 2.69l5.66 5.66a8 8 0 11-11.31 0z"></path>
            </svg>
            Size your tankless unit
          </h2>

          <div class="mt-6 lg:grid lg:grid-cols-2 lg:gap-8 lg:items-start">
            <div class="space-y-6">
              <div>
                <div class="flex items-center justify-between">
                  <label for="tl-btu" class="text-sm font-semibold text-slate-800">Burner input</label>
                  <div class="flex items-center gap-1">
                    <input
                      id="tl-btu"
                      type="number"
                      min="0"
                      max="400000"
                      step="1000"
                      value="199000"
                      class="w-28 rounded-lg border border-slate-300 px-3 py-1.5 text-right text-sm font-semibold text-slate-900 focus:border-blue-500 focus:ring-2 focus:ring-blue-200 outline-none"
                    />
                    <span class="text-sm text-slate-500">BTU/h</span>
                  </div>
                </div>
                <input
                  id="tl-btu-range"
                  type="range"
                  min="40000"
                  max="250000"
                  step="1000"
                  value="199000"
                  class="plumb-range mt-3 w-full bg-slate-200 accent-blue-600"
                />
                <div class="flex justify-between text-xs text-slate-400 mt-1">
                  <span>40k</span><span>250k BTU/h</span>
                </div>
                <p class="mt-1.5 text-xs text-slate-500">
                  199,000 is the common ceiling before commercial venting rules apply.
                </p>
              </div>

              <div class="grid sm:grid-cols-2 gap-5">
                <div>
                  <label for="tl-efficiency" class="text-sm font-semibold text-slate-800">Efficiency</label>
                  <div class="mt-2 flex items-center gap-2">
                    <input
                      id="tl-efficiency"
                      type="number"
                      min="10"
                      max="100"
                      value="95"
                      class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm text-slate-900 focus:border-blue-500 focus:ring-2 focus:ring-blue-200 outline-none"
                    />
                    <span class="text-sm text-slate-500 shrink-0">%</span>
                  </div>
                  <p class="mt-1.5 text-xs text-slate-500">Condensing ~95%, non-condensing ~82%.</p>
                </div>

                <div>
                  <label for="tl-wanted" class="text-sm font-semibold text-slate-800">Flow you want</label>
                  <div class="mt-2 flex items-center gap-2">
                    <input
                      id="tl-wanted"
                      type="number"
                      min="0"
                      max="20"
                      step="0.1"
                      value="4"
                      class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm text-slate-900 focus:border-blue-500 focus:ring-2 focus:ring-blue-200 outline-none"
                    />
                    <span class="text-sm text-slate-500 shrink-0">gpm</span>
                  </div>
                  <p class="mt-1.5 text-xs text-slate-500">Simultaneous fixtures only, not the whole house.</p>
                </div>

                <div>
                  <label for="tl-inlet" class="text-sm font-semibold text-slate-800">
                    Cold inlet temperature
                  </label>
                  <div class="mt-2 flex items-center gap-2">
                    <input
                      id="tl-inlet"
                      type="number"
                      min="30"
                      max="90"
                      value="50"
                      class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm text-slate-900 focus:border-blue-500 focus:ring-2 focus:ring-blue-200 outline-none"
                    />
                    <span class="text-sm text-slate-500 shrink-0">°F</span>
                  </div>
                  <p class="mt-1.5 text-xs text-slate-500">Coldest month: ~70 Gulf coast, ~40 northern.</p>
                </div>

                <div>
                  <label for="tl-target" class="text-sm font-semibold text-slate-800">
                    Target temperature
                  </label>
                  <div class="mt-2 flex items-center gap-2">
                    <input
                      id="tl-target"
                      type="number"
                      min="80"
                      max="180"
                      value="120"
                      class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm text-slate-900 focus:border-blue-500 focus:ring-2 focus:ring-blue-200 outline-none"
                    />
                    <span class="text-sm text-slate-500 shrink-0">°F</span>
                  </div>
                  <p class="mt-1.5 text-xs text-slate-500">120 °F is the usual domestic delivery setting.</p>
                </div>
              </div>

              <button
                id="tl-reset"
                type="button"
                class="text-sm font-medium text-slate-500 hover:text-blue-600 transition flex items-center gap-1.5"
              >
                <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"
                  ></path>
                </svg>
                Reset to defaults
              </button>
            </div>

            <!-- Results -->
            <div class="mt-6 lg:mt-0 lg:sticky lg:top-6 rounded-xl border border-blue-100 bg-blue-50 p-5 sm:p-6">
              <p class="text-sm font-medium text-slate-600">Deliverable flow</p>
              <div class="mt-2 flex items-baseline gap-2">
                <span id="tl-gpm" class="text-5xl font-extrabold tracking-tight text-blue-600">5.40 gpm</span>
              </div>
              <p id="tl-note" class="mt-1 text-sm font-semibold text-slate-700">
                Covers the 4.0 gpm you asked for with 1.40 gpm to spare at this rise.
              </p>

              <div class="mt-6 grid grid-cols-2 gap-3">
                <div class="rounded-xl border border-blue-100 bg-white p-4">
                  <p class="text-xs text-slate-500">Temperature rise</p>
                  <p id="tl-rise" class="mt-1 text-2xl font-bold text-slate-900">70 °F</p>
                </div>
                <div class="rounded-xl border border-blue-100 bg-white p-4">
                  <p class="text-xs text-slate-500">BTU for your target flow</p>
                  <p id="tl-required" class="mt-1 text-2xl font-bold text-slate-900">147,309 BTU/h</p>
                </div>
              </div>

              <div id="tl-warning" class="hidden mt-4 rounded-xl border border-amber-300 bg-amber-100 p-4">
                <p class="text-sm font-semibold text-amber-800">Short of your target flow</p>
                <p class="mt-1 text-sm text-amber-800">
                  At this temperature rise the unit cannot deliver what you asked for. Raise the input, lower
                  the target temperature, or plan on fewer simultaneous fixtures — a tankless has no reserve to
                  fall back on.
                </p>
              </div>

              <details class="group mt-5 rounded-xl border border-blue-100 bg-white">
                <summary
                  class="flex items-center justify-between cursor-pointer px-4 py-3 text-sm font-semibold text-slate-800"
                >
                  See the breakdown
                  <svg
                    class="h-4 w-4 text-slate-500 transition-transform group-open:rotate-180"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    viewBox="0 0 24 24"
                  >
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"></path>
                  </svg>
                </summary>
                <div class="px-4 pb-4 text-sm space-y-1.5 text-slate-600">
                  <div class="flex justify-between gap-3">
                    <span>Heat delivered</span><span id="tl-bd-output" class="font-semibold text-slate-900">—</span>
                  </div>
                  <div class="flex justify-between gap-3">
                    <span>Simultaneous showers</span><span id="tl-bd-fixtures" class="font-semibold text-slate-900">—</span>
                  </div>
                  <div class="flex justify-between gap-3">
                    <span>Warm-inlet output</span><span id="tl-bd-summer" class="font-semibold text-slate-900">—</span>
                  </div>
                  <div class="flex justify-between gap-3">
                    <span>Cold-inlet output</span><span id="tl-bd-winter" class="font-semibold text-slate-900">—</span>
                  </div>
                  <div class="flex justify-between gap-3 border-t border-slate-200 pt-1.5 mt-1.5">
                    <span>Seasonal swing</span><span id="tl-bd-shortfall" class="font-semibold text-slate-900">—</span>
                  </div>
                </div>
              </details>

              <p class="mt-4 text-xs text-slate-500 leading-relaxed">
                Planning estimate. Minimum activation flow, modulation range, cold-water sandwich and gas
                supply capacity are not modelled — check the unit's own spec, and confirm the gas branch can
                carry the input. A licensed plumber has final say.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- ==== FORMULA ==== -->
      <section class="bg-slate-50 border-y border-slate-200">
        <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-14">
          <h2 class="text-3xl font-extrabold tracking-tight text-slate-900">
            The formula, explained in plain English
          </h2>
          <p class="mt-4 text-slate-600 leading-relaxed">
            One equation, run in both directions, with everything hanging on the temperature rise.
          </p>

          <div
            class="mt-8 rounded-2xl bg-slate-900 p-6 sm:p-8 text-slate-100 font-mono text-sm leading-relaxed overflow-x-auto"
          >
            <div class="text-blue-300"># What a unit delivers</div>
            <div>
              gpm&nbsp;=&nbsp;BTU/h × efficiency ÷ (<span class="text-amber-300"
                >{fmt(BTU_PER_GPM_PER_DEGF, 1)}</span
              > × rise)
            </div>
            <div class="mt-4 text-blue-300"># What a target flow demands</div>
            <div>
              BTU/h&nbsp;=&nbsp;gpm × <span class="text-amber-300">{fmt(BTU_PER_GPM_PER_DEGF, 1)}</span> × rise
              ÷ efficiency
            </div>
            <div class="mt-4 text-slate-400"># Where the 500 comes from</div>
            <div>
              <span class="text-amber-300">8.33</span> lb/gal × <span class="text-amber-300">60</span>
              min/hr × 1 BTU/lb·°F&nbsp;=&nbsp;<span class="text-amber-300">499.8</span>
            </div>
            <div class="mt-4 text-blue-300"># Rise is the whole game</div>
            <div>rise&nbsp;=&nbsp;target − inlet</div>
            <div>
              50 °F rise&nbsp;→&nbsp;<span class="text-amber-300">7.57</span> gpm&nbsp;·&nbsp;80 °F
              rise&nbsp;→&nbsp;<span class="text-amber-300">4.73</span> gpm (same 199k unit)
            </div>
          </div>

          <div class="mt-8 grid sm:grid-cols-2 gap-4">
            <div class="rounded-xl border border-slate-200 bg-white p-5">
              <h3 class="font-bold text-slate-900">Inverse, not linear-ish</h3>
              <p class="mt-2 text-sm text-slate-600">
                Flow is inversely proportional to rise. Going from a 50 °F rise to 80 °F is a 60% increase in
                rise and a 38% cut in output — the same unit, the same gas, a different month.
              </p>
            </div>
            <div class="rounded-xl border border-slate-200 bg-white p-5">
              <h3 class="font-bold text-slate-900">No reserve, ever</h3>
              <p class="mt-2 text-sm text-slate-600">
                A tank has gallons already hot, so a brief heavy draw costs it nothing. A tankless is capped at
                its flow rate for every second of every draw. Burst demand is the one thing a tank does better.
              </p>
            </div>
            <div class="rounded-xl border border-slate-200 bg-white p-5">
              <h3 class="font-bold text-slate-900">Count simultaneous, not total</h3>
              <p class="mt-2 text-sm text-slate-600">
                Three bathrooms do not mean three showers at once. Size on what genuinely overlaps — usually
                two fixtures in a family house, and often just one plus a sink.
              </p>
            </div>
            <div class="rounded-xl border border-slate-200 bg-white p-5">
              <h3 class="font-bold text-slate-900">The gas line is part of the job</h3>
              <p class="mt-2 text-sm text-slate-600">
                A 199,000 BTU unit can exceed the whole rest of the house combined. A 1/2-inch branch that fed
                a 40,000 BTU tank will not carry it, and the upsize is frequently the largest single line on a
                conversion quote.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- ==== WORKED EXAMPLES ==== -->
      <section class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 py-14">
        <h2 class="text-3xl font-extrabold tracking-tight text-slate-900">Worked examples</h2>
        <p class="mt-4 text-slate-600">
          The defaults, the same unit moved north, and sizing backwards from a flow you actually need.
        </p>

        <div class="mt-8 space-y-6">
          <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
            <div class="flex items-center gap-3">
              <span class="flex h-9 w-9 items-center justify-center rounded-full bg-blue-100 text-blue-700 font-bold">
                1
              </span>
              <h3 class="text-lg font-bold text-slate-900">199,000 BTU condensing, 50 °F inlet</h3>
            </div>
            <div class="mt-4 rounded-xl bg-slate-50 p-4 font-mono text-sm text-slate-700">
              rise = 120 − 50 = 70 °F<br />
              gpm = 199,000 × 0.95 ÷ (499.8 × 70) = 189,050 ÷ 34,986<br />
              → <span class="font-bold text-blue-700">5.40 gpm</span><br />
              = two 2.0 gpm showers with 1.4 gpm to spare
            </div>
            <p class="mt-3 text-sm text-slate-600">
              <span class="font-semibold text-slate-900">Result:</span> 5.40 gpm. Comfortable for a family
              house in a temperate climate — two showers, or a shower and a kitchen sink, at once.
            </p>
          </div>

          <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
            <div class="flex items-center gap-3">
              <span class="flex h-9 w-9 items-center justify-center rounded-full bg-blue-100 text-blue-700 font-bold">
                2
              </span>
              <h3 class="text-lg font-bold text-slate-900">The same unit in a northern winter</h3>
            </div>
            <div class="mt-4 rounded-xl bg-slate-50 p-4 font-mono text-sm text-slate-700">
              Gulf coast, 70 °F inlet: rise 50 →
              <span class="font-bold text-blue-700">7.57 gpm</span><br />
              temperate, 50 °F inlet: rise 70 → 5.40 gpm<br />
              northern winter, 40 °F inlet: rise 80 →
              <span class="font-bold text-blue-700">4.73 gpm</span><br />
              → <span class="font-bold text-blue-700">38% less output</span> for the same appliance
            </div>
            <p class="mt-3 text-sm text-slate-600">
              <span class="font-semibold text-slate-900">Result:</span> the identical unit that ran two
              showers and a sink in Texas struggles with two showers in Minnesota. Nothing has broken — the
              rise went up by 60% and the flow came down accordingly.
            </p>
          </div>

          <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
            <div class="flex items-center gap-3">
              <span class="flex h-9 w-9 items-center justify-center rounded-full bg-blue-100 text-blue-700 font-bold">
                3
              </span>
              <h3 class="text-lg font-bold text-slate-900">Working backwards from 4 gpm</h3>
            </div>
            <div class="mt-4 rounded-xl bg-slate-50 p-4 font-mono text-sm text-slate-700">
              BTU = 4 × 499.8 × 70 ÷ 0.95<br />
              → <span class="font-bold text-blue-700">147,309 BTU/h</span> at a 70 °F rise<br />
              same 4 gpm at an 80 °F rise = 168,354 BTU/h<br />
              non-condensing at 82%: 4 × 499.8 × 70 ÷ 0.82 = 170,663
            </div>
            <p class="mt-3 text-sm text-slate-600">
              <span class="font-semibold text-slate-900">Result:</span> 4 gpm at a temperate rise needs about
              150,000 BTU. Push either the climate or the efficiency the wrong way and the same 4 gpm needs
              nearly 170,000 — which is how a mid-range unit quietly becomes a top-of-range one.
            </p>
          </div>
        </div>
      </section>

