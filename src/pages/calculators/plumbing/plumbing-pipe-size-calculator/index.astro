              </tbody>
            </table>
          </div>

          <h2 class="mt-14 text-3xl font-extrabold tracking-tight text-slate-900">
            The same 18 gpm in every material
          </h2>
          <p class="mt-4 text-slate-600 leading-relaxed">
            Nominal size is not bore. This is why a material swap can quietly change the size you need.
          </p>

          <div class="mt-8 overflow-x-auto rounded-2xl border border-slate-200 bg-white shadow-sm">
            <table class="w-full text-left text-sm">
              <thead>
                <tr class="border-b border-slate-200 text-slate-500 bg-slate-50">
                  <th class="py-3 px-5 font-semibold">Material</th>
                  <th class="py-3 px-5 font-semibold">Size</th>
                  <th class="py-3 px-5 font-semibold">Actual bore</th>
                  <th class="py-3 px-5 font-semibold">Velocity</th>
                  <th class="py-3 px-5 font-semibold">Loss / 100 ft</th>
                </tr>
              </thead>
              <tbody class="text-slate-700">
                {
                  materialLadder.map((row, index) => (
                    <tr class={index === materialLadder.length - 1 ? "" : "border-b border-slate-100"}>
                      <td class="py-3 px-5 font-semibold text-slate-900">
                        {PIPE_MATERIAL_LABELS[row.material]}
                      </td>
                      <td class="py-3 px-5">
                        {row.size === null ? "—" : sizeLabel(row.size)}
                        {row.size !== null && row.size > 1 && (
                          <span class="ml-2 rounded-full bg-amber-100 px-2 py-0.5 text-xs font-semibold text-amber-800">
                            size up
                          </span>
                        )}
                      </td>
                      <td class="py-3 px-5">{fmt(row.id, 3)} in</td>
                      <td class="py-3 px-5">{fmt(row.velocity, 2)} ft/s</td>
                      <td class="py-3 px-5">{fmt(row.lossPer100, 2)} psi</td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>

          <p class="mt-6 text-sm text-slate-500">
            Sources &amp; standards: IPC 2021 Appendix E — <a
              class="underline hover:text-sky-600"
              href="https://codes.iccsafe.org/codes/i-codes"
              target="_blank"
              rel="noopener">Sizing of Water Piping System</a
            >; IPC 604.3 maximum fixture flow rates; pipe dimensions from <a
              class="underline hover:text-sky-600"
              href="https://www.astm.org/"
