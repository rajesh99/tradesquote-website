---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import RelatedCalculators from "@/components/RelatedCalculators.astro";
import CalculatorBreadcrumb from "@/components/CalculatorBreadcrumb.astro";
import CalculatorFaqSection from "@/components/CalculatorFaqSection.astro";
import CalculatorTradesQuoteCta from "@/components/CalculatorTradesQuoteCta.astro";
import { buildFaqPageSchema, type CalculatorFaq } from "@/lib/calculatorFaq";
import { electricalAccentStyles } from "@/config/electricalCalculators";

const title = "House Rewiring Cost Calculator — Per Square Foot | TradesQuote";
const description =
  "Free whole-house rewiring cost calculator. Estimate from square footage, wall access, construction age, and storeys — with the dollars-per-square-foot figure to sanity-check the total against market data.";

const pageUrl = "https://www.tradesquote.ai/calculators/electrical/electrical-rewiring-cost-calculator";

const breadcrumbData = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: "https://www.tradesquote.ai/" },
    { "@type": "ListItem", position: 2, name: "Calculators", item: "https://www.tradesquote.ai/calculators" },
    { "@type": "ListItem", position: 3, name: "Electrical", item: "https://www.tradesquote.ai/calculators/electrical" },
    { "@type": "ListItem", position: 4, name: "Rewiring Cost Calculator", item: pageUrl },
  ],
};

const webAppData = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: "Rewiring Cost Calculator",
  url: pageUrl,
  applicationCategory: "BusinessApplication",
  operatingSystem: "Any (web-based)",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  description:
    "Free online whole-house rewiring cost calculator estimating from floor area, wall accessibility, construction age, and number of storeys, with a dollars-per-square-foot cross-check.",
};

const faqs: CalculatorFaq[] = [
  {
    question: "How much does it cost to rewire a house?",
    answer:
      "US market data for 2026 puts whole-house rewiring at <strong>$8,000 to $30,000</strong>, or roughly <strong>$5 to $17 per square foot</strong>, with most homes landing between $12,000 and $20,000. A 1,000 sq ft single-storey house with good access might come in near $5,000; a 3,000 sq ft two-storey with plaster walls can exceed $25,000.",
  },
  {
    question: "What drives the cost more than anything else?",
    answer:
      "<strong>Access.</strong> Rewiring is mostly the labor of getting cable from A to B without destroying the house. An unfinished basement plus an accessible attic on a single storey is the cheap case. Finished plaster walls on a two-storey with no attic access is the expensive case, because every run means opening and repairing a wall. Same wire, same devices, double the price.",
  },
  {
    question: "Does a rewire include a new panel?",
    answer:
      "Usually, and it should. A house old enough to need rewiring almost always has a panel that is undersized, obsolete, or a known-defective brand. Doing the rewire without the panel means terminating brand-new circuits into failing equipment. Budget roughly <strong>$3,000</strong> for a 200 A service as part of the job — the toggle above includes it by default.",
  },
  {
    question: "Do I need to rewire knob-and-tube or cloth wiring?",
    answer:
      "Not automatically, but usually yes in practice. Knob-and-tube is not inherently illegal where it remains undisturbed and in good condition, but it has <strong>no equipment grounding conductor</strong>, its insulation embrittles with age, and it must never be buried in insulation. Many insurers now refuse or surcharge policies on homes with it, and mortgage lenders sometimes require replacement — which is often what forces the decision rather than the Code.",
  },
  {
    question: "Can a rewire be done in stages?",
    answer:
      "Yes, and it is often the right answer for a lived-in home. Common approach: panel and service first, then kitchen and bathrooms (highest GFCI/AFCI benefit), then bedrooms, then the remainder. Staging costs 15–25% more in total because of repeated setup and permit visits, but it spreads the spend and keeps the house habitable. Price each phase as its own job.",
  },
  {
    question: "What isn't included in this estimate?",
    answer:
      "Drywall and plaster repair, painting, asbestos or lead remediation, structural work to create access, fixture and appliance upgrades, low-voltage and network cabling, and any exterior or detached-structure work. Patching alone frequently adds thousands on a finished home, and it is the single most common omission in a rewire quote — decide explicitly whether you are including it.",
  },
];
const faqData = buildFaqPageSchema(faqs);

const ctaHeading = "Rewire scoped? Send a real estimate in seconds.";
const ctaDescription =
  "A rewire is hundreds of line items. Describe the job or upload photos and TradesQuote's AI builds the full detailed estimate — devices, cable, boxes, panel, permit, and labor — with quantities and totals, validated by a built-in quality control agent.";

const relatedCalculators = [
  {
    href: "/calculators/electrical/electrical-panel-upgrade-cost-calculator",
    title: "Panel Upgrade Cost Calculator",
    description: "Price the service work inside the rewire.",
  },
  {
    href: "/calculators/electrical/electrical-load-calculator",
    title: "Residential Load Calculator",
    description: "Size the new service the rewire will feed.",
  },
  {
    href: "/calculators/electrical/electrical-estimate-calculator",
    title: "Electrical Estimate Calculator",
    description: "Apply your target margin to the total.",
  },
  {
    href: "/calculators/electrical/electrical-labor-rate-calculator",
    title: "Labor Rate Calculator",
    description: "Know your real cost per billable hour.",
  },
];

const styles = electricalAccentStyles.orange;
---

<Layout {title} {description}>
  <Fragment slot="head">
    <link rel="canonical" href={pageUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="House Rewiring Cost Calculator — Per Square Foot" />
    <meta
      property="og:description"
      content="Estimate whole-house rewiring from square footage, wall access, and construction age — with a dollars-per-square-foot cross-check."
    />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:site_name" content="TradesQuote" />
    <meta property="og:image" content="https://www.tradesquote.ai/logo.svg" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="House Rewiring Cost Calculator — Per Square Foot" />
    <meta name="twitter:description" content="What a whole-house rewire really costs. Free and instant." />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbData)} />
    <script type="application/ld+json" set:html={JSON.stringify(webAppData)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqData)} />
  </Fragment>

  <div class="bg-white min-h-screen text-slate-700">
    <Header />

    <main>
      <section class="relative overflow-hidden bg-gradient-to-b from-slate-50 to-white">
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pt-10 pb-6">
          <CalculatorBreadcrumb
            category="Electrical"
            categoryHref="/calculators/electrical"
            current="Rewiring Cost Calculator"
          />

          <div class="max-w-3xl">
            <span
              class="inline-flex items-center gap-1.5 rounded-full bg-orange-100 px-3 py-1 text-xs font-semibold text-orange-700"
            >
              <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
              Electrical Tools · Free
            </span>

            <h1 class="mt-4 text-4xl sm:text-5xl font-extrabold tracking-tight text-slate-900">
              Rewiring Cost Calculator <span class="text-orange-600">— By Square Foot & Access</span>
            </h1>

            <p class="mt-5 text-lg text-slate-600 leading-relaxed">
              Rewiring cost is almost entirely a question of <strong>access</strong>. The cable and devices are a
              minor line item; the labor of routing new circuits through a finished house is the job. Open walls
              in a gut renovation run about $4 a square foot. Finished plaster with no attic or crawlspace runs
              three times that. Age matters too — knob-and-tube and cloth wiring add remediation work.
            </p>
          </div>
        </div>
      </section>

      <section id="calculator" class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pb-12">
        <div class="mx-auto max-w-5xl rounded-2xl border border-slate-200 bg-white p-6 sm:p-8 shadow-sm">
          <h2 class="text-xl font-bold text-slate-900 flex items-center gap-2">
            <svg class="h-5 w-5 text-orange-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 21h18M5 21V7l7-4 7 4v14M10 21v-6h4v6"></path>
            </svg>
            Estimate the rewire
          </h2>

          <div class="mt-6 lg:grid lg:grid-cols-2 lg:gap-8 lg:items-start">
            <div class="space-y-6">
              <div>
                <div class="flex items-center justify-between">
                  <label for="rw-area" class="text-sm font-semibold text-slate-800">Floor area</label>
                  <div class="flex items-center gap-1">
                    <input
                      id="rw-area"
                      type="number"
                      min="100"
                      max="12000"
                      value="1800"
                      class="w-24 rounded-lg border border-slate-300 px-3 py-1.5 text-right text-sm font-semibold text-slate-900 focus:border-orange-500 focus:ring-2 focus:ring-orange-200 outline-none"
                    />
                    <span class="text-sm text-slate-500">sq ft</span>
                  </div>
                </div>
                <input
                  id="rw-area-range"
                  type="range"
                  min="400"
                  max="6000"
                  step="50"
                  value="1800"
                  class="elec-range mt-3 w-full bg-slate-200 accent-orange-600"
                />
                <div class="flex justify-between text-xs text-slate-400 mt-1">
                  <span>400</span><span>6,000 sq ft</span>
                </div>
              </div>

              <div>
                <label for="rw-access" class="text-sm font-semibold text-slate-800">Wall and cavity access</label>
                <select
                  id="rw-access"
                  class="mt-2 w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm text-slate-900 focus:border-orange-500 focus:ring-2 focus:ring-orange-200 outline-none"
                >
                  <option value="easy">Easy — gut renovation, walls open ($4/sq ft)</option>
                  <option value="average" selected>Average — attic and basement access ($7/sq ft)</option>
                  <option value="difficult">Difficult — finished plaster, no access ($12/sq ft)</option>
                </select>
                <p class="mt-1.5 text-xs text-slate-500">
                  The single biggest cost driver. Be honest about it before quoting.
                </p>
              </div>

              <div class="grid sm:grid-cols-2 gap-5">
                <div>
                  <label for="rw-age" class="text-sm font-semibold text-slate-800">Construction age</label>
                  <select
                    id="rw-age"
                    class="mt-2 w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm text-slate-900 focus:border-orange-500 focus:ring-2 focus:ring-orange-200 outline-none"
                  >
                    <option value="modern">1990 or later (×1.00)</option>
                    <option value="midcentury" selected>1960–1990 (×1.10)</option>
                    <option value="old">Pre-1960, knob-and-tube or cloth (×1.25)</option>
                  </select>
                </div>

                <div>
                  <label for="rw-stories" class="text-sm font-semibold text-slate-800">Storeys</label>
                  <select
                    id="rw-stories"
                    class="mt-2 w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm text-slate-900 focus:border-orange-500 focus:ring-2 focus:ring-orange-200 outline-none"
                  >
                    <option value="1" selected>Single storey (×1.00)</option>
                    <option value="2">Two or more (×1.15)</option>
                  </select>
                </div>

                <div>
                  <label for="rw-panel" class="text-sm font-semibold text-slate-800">Include 200 A service?</label>
                  <select
                    id="rw-panel"
                    class="mt-2 w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm text-slate-900 focus:border-orange-500 focus:ring-2 focus:ring-orange-200 outline-none"
                  >
                    <option value="yes" selected>Yes — add $3,000</option>
                    <option value="no">No — panel stays</option>
                  </select>
                </div>

                <div>
                  <label for="rw-permit" class="text-sm font-semibold text-slate-800">Permit fee</label>
                  <div class="mt-2 flex items-center gap-2">
                    <span class="text-sm text-slate-500 shrink-0">$</span>
                    <input
                      id="rw-permit"
                      type="number"
                      min="0"
                      max="10000"
                      value="500"
                      class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm text-slate-900 focus:border-orange-500 focus:ring-2 focus:ring-orange-200 outline-none"
                    />
                  </div>
                </div>
              </div>

              <button
                id="rw-reset"
                type="button"
                class="text-sm font-medium text-slate-500 hover:text-orange-600 transition flex items-center gap-1.5"
              >
                <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"
                  ></path>
                </svg>
                Reset to defaults
              </button>
            </div>

            <div class="mt-6 lg:mt-0 rounded-xl border border-orange-100 bg-orange-50 p-5 sm:p-6">
              <p class="text-sm font-medium text-slate-600">Estimated cost</p>
              <div class="mt-2 flex items-baseline gap-2">
                <span id="rw-total" class="text-5xl font-extrabold tracking-tight text-orange-600">$17,360</span>
              </div>
              <p id="rw-note" class="mt-1 text-sm font-semibold text-slate-700">
                $9.64/sq ft sits inside the $5–$17 range published for US whole-house rewiring in 2026.
              </p>

              <div class="mt-6 grid grid-cols-3 gap-3">
                <div class="rounded-xl border border-orange-100 bg-white p-4">
                  <p class="text-xs text-slate-500">Low</p>
                  <p id="rw-low" class="mt-1 text-xl font-bold text-slate-900">$13,888</p>
                </div>
                <div class="rounded-xl border border-orange-100 bg-white p-4">
                  <p class="text-xs text-slate-500">High</p>
                  <p id="rw-high" class="mt-1 text-xl font-bold text-slate-900">$20,832</p>
                </div>
                <div class="rounded-xl border border-orange-100 bg-white p-4">
                  <p class="text-xs text-slate-500">Per sq ft</p>
                  <p id="rw-per-sqft" class="mt-1 text-xl font-bold text-slate-900">$9.64</p>
                </div>
              </div>

              <details class="group mt-5 rounded-xl border border-orange-100 bg-white" open>
                <summary
                  class="flex items-center justify-between cursor-pointer px-4 py-3 text-sm font-semibold text-slate-800"
                >
                  See the breakdown
                  <svg
                    class="h-4 w-4 text-slate-500 transition-transform group-open:rotate-180"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    viewBox="0 0 24 24"
                  >
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"></path>
                  </svg>
                </summary>
                <div class="px-4 pb-4 text-sm space-y-1.5 text-slate-600">
                  <div class="flex justify-between gap-3">
                    <span>Base by access</span><span id="rw-bd-base" class="font-semibold text-slate-900">—</span>
                  </div>
                  <div class="flex justify-between gap-3">
                    <span>Age factor</span><span id="rw-bd-age" class="font-semibold text-slate-900">—</span>
                  </div>
                  <div class="flex justify-between gap-3">
                    <span>Storey factor</span><span id="rw-bd-stories" class="font-semibold text-slate-900">—</span>
                  </div>
                  <div class="flex justify-between gap-3">
                    <span>Wiring subtotal</span><span id="rw-bd-wiring" class="font-semibold text-slate-900">—</span>
                  </div>
                  <div class="flex justify-between gap-3">
                    <span>Service / panel</span><span id="rw-bd-panel" class="font-semibold text-slate-900">—</span>
                  </div>
                  <div class="flex justify-between gap-3">
                    <span>Permit</span><span id="rw-bd-permit" class="font-semibold text-slate-900">—</span>
                  </div>
                  <div class="flex justify-between gap-3 border-t border-slate-200 pt-1.5 mt-1.5">
                    <span class="font-bold">Total</span><span id="rw-bd-total" class="font-bold text-slate-900">—</span>
                  </div>
                </div>
              </details>

              <p class="mt-4 text-xs text-slate-500 leading-relaxed">
                <strong>Excludes</strong> drywall and plaster repair, painting, asbestos or lead remediation,
                structural access work, fixtures, and low-voltage cabling. Patching alone often adds thousands on
                a finished home.
              </p>
            </div>
          </div>
        </div>
      </section>

      <section class="bg-slate-50 border-y border-slate-200">
        <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-14">
          <h2 class="text-3xl font-extrabold tracking-tight text-slate-900">The build-up, explained</h2>

          <div
            class="mt-8 rounded-2xl bg-slate-900 p-6 sm:p-8 text-slate-100 font-mono text-sm leading-relaxed overflow-x-auto"
          >
            <div class="text-cyan-300"># Base rate by access</div>
            <div>easy <span class="text-amber-300">$4</span>/sq ft&nbsp;·&nbsp;average <span class="text-amber-300">$7</span>/sq ft&nbsp;·&nbsp;difficult <span class="text-amber-300">$12</span>/sq ft</div>
            <div class="mt-4 text-cyan-300"># Multipliers</div>
            <div>age: post-1990 ×1.00&nbsp;·&nbsp;1960–1990 ×<span class="text-amber-300">1.10</span>&nbsp;·&nbsp;pre-1960 ×<span class="text-amber-300">1.25</span></div>
            <div>storeys: single ×1.00&nbsp;·&nbsp;two or more ×<span class="text-amber-300">1.15</span></div>
            <div class="mt-4 text-cyan-300"># Total</div>
            <div>wiring&nbsp;=&nbsp;sq ft × rate × age × storeys</div>
            <div>total&nbsp;=&nbsp;wiring + service/panel + permit&nbsp;&nbsp;·&nbsp;&nbsp;range shown at ±20%</div>
            <div class="mt-4 text-cyan-300"># Cross-check</div>
            <div>$/sq ft&nbsp;=&nbsp;total ÷ area&nbsp;&nbsp;→&nbsp;&nbsp;should land in the <span class="text-amber-300">$5–$17</span> band</div>
          </div>

          <div class="mt-8 grid sm:grid-cols-2 gap-4">
            <div class="rounded-xl border border-slate-200 bg-white p-5">
              <h3 class="font-bold text-slate-900">Access is the whole job</h3>
              <p class="mt-2 text-sm text-slate-600">
                Cable and devices are a small fraction of a rewire. What you are selling is the labor of routing
                circuits without wrecking finishes — which is why the same house costs triple with plaster walls.
              </p>
            </div>
            <div class="rounded-xl border border-slate-200 bg-white p-5">
              <h3 class="font-bold text-slate-900">Always cross-check per square foot</h3>
              <p class="mt-2 text-sm text-slate-600">
                If the total divided by floor area lands outside $5–$17, something in the assumptions is wrong.
                It is the fastest sanity check on a rewire number.
              </p>
            </div>
            <div class="rounded-xl border border-slate-200 bg-white p-5">
              <h3 class="font-bold text-slate-900">Patching is the classic omission</h3>
              <p class="mt-2 text-sm text-slate-600">
                Drywall repair and paint are not in this figure and frequently add thousands. Decide explicitly
                whether you are including them, and say so in the quote.
              </p>
            </div>
            <div class="rounded-xl border border-slate-200 bg-white p-5">
              <h3 class="font-bold text-slate-900">Staging costs more but sells better</h3>
              <p class="mt-2 text-sm text-slate-600">
                Phasing adds 15–25% in total from repeated setup and permits, but keeps the house habitable and
                spreads the spend. Price each phase as its own job.
              </p>
            </div>
          </div>
        </div>
      </section>

      <section class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 py-14">
        <h2 class="text-3xl font-extrabold tracking-tight text-slate-900">Worked examples</h2>
        <p class="mt-4 text-slate-600">The same house three ways — access changes everything.</p>

        <div class="mt-8 space-y-6">
          <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
            <div class="flex items-center gap-3">
              <span class="flex h-9 w-9 items-center justify-center rounded-full bg-orange-100 text-orange-700 font-bold">1</span>
              <h3 class="text-lg font-bold text-slate-900">1,800 sq ft, 1970s ranch, good access</h3>
            </div>
            <p class="mt-3 text-sm text-slate-600">
              Single storey · attic and basement access · new 200 A service · $500 permit. The defaults above.
            </p>
            <div class="mt-4 rounded-xl bg-slate-50 p-4 font-mono text-sm text-slate-700">
              1,800 × $7 = $12,600 × 1.10 × 1.00 = $13,860<br />
              + service $3,000 + permit $500 = <span class="font-bold text-orange-700">$17,360</span><br />
              = $9.64/sq ft · range $13,888 – $20,832
            </div>
            <p class="mt-3 text-sm text-slate-600">
              <span class="font-semibold text-slate-900">Result:</span> squarely in the middle of the market band
              and inside the $12,000–$20,000 range most homes land in. The accessible attic and basement are what
              keep it there.
            </p>
          </div>

          <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
            <div class="flex items-center gap-3">
              <span class="flex h-9 w-9 items-center justify-center rounded-full bg-orange-100 text-orange-700 font-bold">2</span>
              <h3 class="text-lg font-bold text-slate-900">Same house mid-gut-renovation</h3>
            </div>
            <p class="mt-3 text-sm text-slate-600">Walls already open — easy access, everything else identical.</p>
            <div class="mt-4 rounded-xl bg-slate-50 p-4 font-mono text-sm text-slate-700">
              1,800 × $4 = $7,200 × 1.10 = $7,920<br />
              + $3,000 + $500 = <span class="font-bold text-orange-700">$11,420</span> = $6.34/sq ft
            </div>
            <p class="mt-3 text-sm text-slate-600">
              <span class="font-semibold text-slate-900">Result:</span> $5,940 less for identical scope, purely
              because the walls are open. This is why rewiring during a renovation is always the right call — and
              worth telling a customer who is planning one.
            </p>
          </div>

          <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
            <div class="flex items-center gap-3">
              <span class="flex h-9 w-9 items-center justify-center rounded-full bg-orange-100 text-orange-700 font-bold">3</span>
              <h3 class="text-lg font-bold text-slate-900">2,600 sq ft 1920s two-storey, plaster walls</h3>
            </div>
            <p class="mt-3 text-sm text-slate-600">
              Knob-and-tube · difficult access · two storeys · new service · $800 permit.
            </p>
            <div class="mt-4 rounded-xl bg-slate-50 p-4 font-mono text-sm text-slate-700">
              2,600 × $12 = $31,200 × 1.25 × 1.15 = $44,850<br />
              + $3,000 + $800 = <span class="font-bold text-orange-700">$48,650</span> = $18.71/sq ft
            </div>
            <p class="mt-3 text-sm text-slate-600">
              <span class="font-semibold text-slate-900">Result:</span> above the $5–$17 band, and the calculator
              flags it. That is not necessarily wrong — plaster, knob-and-tube, and two storeys with no access
              genuinely reach here — but a number this far outside the market range needs explaining line by line
