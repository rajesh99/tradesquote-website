---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import RelatedCalculators from "@/components/RelatedCalculators.astro";
import CalculatorBreadcrumb from "@/components/CalculatorBreadcrumb.astro";
import CalculatorFaqSection from "@/components/CalculatorFaqSection.astro";
import CalculatorTradesQuoteCta from "@/components/CalculatorTradesQuoteCta.astro";
import { buildFaqPageSchema, type CalculatorFaq } from "@/lib/calculatorFaq";
import { electricalAccentStyles } from "@/config/electricalCalculators";
import { fmt } from "@/lib/nec";

const title = "kWh Cost Calculator — What Any Appliance Costs to Run | TradesQuote";
const description =
  "Free electricity cost calculator. Enter wattage, hours per day, and your rate per kWh to get the daily, monthly, and annual running cost of any appliance or circuit.";

const pageUrl = "https://www.tradesquote.ai/calculators/electrical/electrical-kwh-cost-calculator";
const RATE = 0.17;

const breadcrumbData = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: "https://www.tradesquote.ai/" },
    { "@type": "ListItem", position: 2, name: "Calculators", item: "https://www.tradesquote.ai/calculators" },
    { "@type": "ListItem", position: 3, name: "Electrical", item: "https://www.tradesquote.ai/calculators/electrical" },
    { "@type": "ListItem", position: 4, name: "kWh Cost Calculator", item: pageUrl },
  ],
};

const webAppData = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: "kWh Cost Calculator",
  url: pageUrl,
  applicationCategory: "BusinessApplication",
  operatingSystem: "Any (web-based)",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  description:
    "Free online electricity cost calculator returning daily, monthly, and annual running cost for any appliance from its wattage, run time, and the local rate per kilowatt-hour.",
};

const faqs: CalculatorFaq[] = [
  {
    question: "How do I calculate electricity cost?",
    answer:
      "Convert watts to kilowatts, multiply by hours to get kilowatt-hours, then multiply by your rate: <strong>cost = (watts ÷ 1,000) × hours × $/kWh</strong>. A 1,500 W heater for 4 hours uses 6 kWh; at $0.17 per kWh that is <strong>$1.02 a day</strong>.",
  },
  {
    question: "What is a kilowatt-hour?",
    answer:
      "One kilowatt of power drawn for one hour. It is a unit of <em>energy</em>, not power — the distinction that matters on a bill. A 1,000 W appliance running one hour and a 100 W appliance running ten hours both consume exactly <strong>1 kWh</strong> and cost the same.",
  },
  {
    question: "What's the average cost per kWh?",
    answer:
      "US residential electricity averages around <strong>$0.17 per kWh</strong>, but the spread across states is enormous — roughly $0.11 in the cheapest states to over $0.30 in Hawaii and parts of the Northeast. Commercial rates are usually lower per kWh but add a <strong>demand charge</strong> based on peak kW or kVA. Take the rate off an actual bill rather than using a national average: divide the total by the kWh delivered to capture taxes and fees too.",
  },
  {
    question: "Where do I find an appliance's wattage?",
    answer:
      "On the nameplate or rating label — usually on the back, base, or inside the door. If it gives only amps, multiply by the voltage: 12.5 A at 120 V is 1,500 W. If it gives volt-amperes, that is close enough to watts for cost estimating on resistive loads, but will overstate cost on motors and electronics with a power factor below 1.0.",
  },
  {
    question: "Why is my actual bill higher than this estimate?",
    answer:
      "Usually three reasons. Appliances with thermostats or compressors <strong>cycle</strong> rather than running continuously, so real run hours differ from the nameplate assumption. Bills include fixed connection charges, taxes, and delivery fees on top of the energy rate. And tiered or time-of-use tariffs mean marginal kWh can cost far more than average. This calculator gives the energy component only.",
  },
  {
    question: "Does this work for an EV charger or a heat pump?",
    answer:
      'It works, but be careful with the hours. An EV drawing 11.5 kW for 4 hours uses 46 kWh — about $7.82 at $0.17. For heat pumps, the nameplate is the maximum draw, not the average: a modern inverter unit modulates and may average a third of it over a day. Use metered data if you have it. For HVAC operating cost specifically, the <a href="/calculators/hvac/hvac-operating-cost-calculator" class="font-semibold text-amber-700 underline decoration-amber-300 hover:decoration-amber-600">HVAC Operating Cost Calculator</a> accounts for efficiency ratings.',
  },
];
const faqData = buildFaqPageSchema(faqs);

const ctaHeading = "Running cost known? Quote the upgrade in seconds.";
const ctaDescription =
  "Running cost is often the argument that closes the job. TradesQuote turns the work into a detailed line-item estimate — fixtures, conductor, devices, and labor — with quantities and totals, validated by a built-in quality control agent.";

const relatedCalculators = [
  {
    href: "/calculators/electrical/electrical-amps-to-watts-calculator",
    title: "Amps to Watts Calculator",
    description: "Get the wattage from a current reading.",
  },
  {
    href: "/calculators/electrical/electrical-unit-converter",
    title: "Electrical Unit Converter",
    description: "Decode whatever unit the nameplate uses.",
  },
  {
    href: "/calculators/hvac/hvac-operating-cost-calculator",
    title: "HVAC Operating Cost Calculator",
    description: "Running cost adjusted for SEER, HSPF, and AFUE.",
  },
  {
    href: "/calculators/electrical/electrical-power-factor-calculator",
    title: "Power Factor Correction",
    description: "Cut the kVA demand charge on a commercial bill.",
  },
];

/** Common loads at a representative $0.17/kWh, computed inline so the table matches the tool. */
const applianceRows = [
  { name: "LED bulb (10 W)", watts: 10, hours: 5 },
  { name: "Desktop computer", watts: 200, hours: 8 },
  { name: "Refrigerator (averaged)", watts: 150, hours: 24 },
  { name: "Window air conditioner", watts: 900, hours: 8 },
  { name: "Space heater", watts: 1500, hours: 4 },
  { name: "Electric water heater", watts: 4500, hours: 3 },
  { name: "Clothes dryer", watts: 5000, hours: 1 },
  { name: "EV charger (48 A)", watts: 11520, hours: 4 },
].map((r) => {
  const dailyKwh = (r.watts / 1000) * r.hours;
  return {
    ...r,
    dailyKwh,
    monthly: dailyKwh * 30 * RATE,
    annual: dailyKwh * 30 * 12 * RATE,
  };
});

const styles = electricalAccentStyles.amber;
---

<Layout {title} {description}>
  <Fragment slot="head">
    <link rel="canonical" href={pageUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="kWh Cost Calculator — What Any Appliance Costs to Run" />
    <meta
      property="og:description"
      content="Daily, monthly, and annual running cost for any appliance or circuit, from its wattage and your rate per kWh."
    />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:site_name" content="TradesQuote" />
    <meta property="og:image" content="https://www.tradesquote.ai/logo.svg" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="kWh Cost Calculator — What Any Appliance Costs to Run" />
    <meta name="twitter:description" content="Electricity running cost, daily to annual. Free and instant." />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbData)} />
    <script type="application/ld+json" set:html={JSON.stringify(webAppData)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqData)} />
  </Fragment>

  <div class="bg-white min-h-screen text-slate-700">
    <Header />

    <main>
      <section class="relative overflow-hidden bg-gradient-to-b from-slate-50 to-white">
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pt-10 pb-6">
          <CalculatorBreadcrumb
            category="Electrical"
            categoryHref="/calculators/electrical"
            current="kWh Cost Calculator"
          />

          <div class="max-w-3xl">
            <span
              class="inline-flex items-center gap-1.5 rounded-full bg-amber-100 px-3 py-1 text-xs font-semibold text-amber-700"
            >
              <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
              Electrical Tools · Free
            </span>

            <h1 class="mt-4 text-4xl sm:text-5xl font-extrabold tracking-tight text-slate-900">
              kWh Cost Calculator <span class="text-amber-600">— Running Cost, Any Load</span>
            </h1>

            <p class="mt-5 text-lg text-slate-600 leading-relaxed">
              Watts tell you how hard something pulls; <strong>kilowatt-hours</strong> tell you what it costs.
              The conversion is simple — watts ÷ 1,000 × hours × your rate — but the number it produces is often
              the most persuasive figure in a quote. Enter the load, its real run time, and the rate off an
              actual bill.
            </p>
          </div>
        </div>
      </section>

      <section id="calculator" class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pb-12">
        <div class="mx-auto max-w-5xl rounded-2xl border border-slate-200 bg-white p-6 sm:p-8 shadow-sm">
          <h2 class="text-xl font-bold text-slate-900 flex items-center gap-2">
            <svg class="h-5 w-5 text-amber-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
              ></path>
            </svg>
            Calculate running cost
          </h2>

          <div class="mt-6 lg:grid lg:grid-cols-2 lg:gap-8 lg:items-start">
            <div class="space-y-6">
              <div>
                <div class="flex items-center justify-between">
                  <label for="kc-watts" class="text-sm font-semibold text-slate-800">Power draw</label>
                  <div class="flex items-center gap-1">
                    <input
                      id="kc-watts"
                      type="number"
                      min="0"
                      max="100000"
                      value="1500"
                      class="w-28 rounded-lg border border-slate-300 px-3 py-1.5 text-right text-sm font-semibold text-slate-900 focus:border-amber-500 focus:ring-2 focus:ring-amber-200 outline-none"
                    />
                    <span class="text-sm text-slate-500">watts</span>
                  </div>
                </div>
                <input
                  id="kc-watts-range"
                  type="range"
                  min="10"
                  max="20000"
                  step="10"
                  value="1500"
                  class="elec-range mt-3 w-full bg-slate-200 accent-amber-600"
                />
                <div class="flex justify-between text-xs text-slate-400 mt-1">
                  <span>10</span><span>20,000 W</span>
                </div>
              </div>

              <div class="grid sm:grid-cols-3 gap-4">
                <div>
                  <label for="kc-hours" class="text-sm font-semibold text-slate-800">Hours per day</label>
                  <input
                    id="kc-hours"
                    type="number"
                    min="0"
                    max="24"
                    step="0.5"
                    value="4"
                    class="mt-2 w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm text-slate-900 focus:border-amber-500 focus:ring-2 focus:ring-amber-200 outline-none"
                  />
                </div>
                <div>
                  <label for="kc-days" class="text-sm font-semibold text-slate-800">Days per month</label>
                  <input
                    id="kc-days"
                    type="number"
                    min="0"
                    max="31"
                    value="30"
                    class="mt-2 w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm text-slate-900 focus:border-amber-500 focus:ring-2 focus:ring-amber-200 outline-none"
                  />
                </div>
                <div>
                  <label for="kc-rate" class="text-sm font-semibold text-slate-800">Rate $/kWh</label>
                  <input
                    id="kc-rate"
                    type="number"
                    min="0"
                    max="2"
                    step="0.001"
                    value="0.17"
                    class="mt-2 w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm text-slate-900 focus:border-amber-500 focus:ring-2 focus:ring-amber-200 outline-none"
                  />
                </div>
              </div>

              <p class="text-xs text-slate-500">
                Take the rate from an actual bill — divide the total charge by the kWh delivered, which captures
                taxes and delivery fees the headline rate leaves out.
              </p>

              <button
                id="kc-reset"
                type="button"
                class="text-sm font-medium text-slate-500 hover:text-amber-600 transition flex items-center gap-1.5"
              >
                <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"
                  ></path>
                </svg>
                Reset to defaults
              </button>
            </div>

            <div class="mt-6 lg:mt-0 rounded-xl border border-amber-100 bg-amber-50 p-5 sm:p-6">
              <p class="text-sm font-medium text-slate-600">Monthly cost</p>
              <div class="mt-2 flex items-baseline gap-2">
                <span id="kc-monthly" class="text-5xl font-extrabold tracking-tight text-amber-600">$30.60</span>
              </div>
              <p id="kc-note" class="mt-1 text-sm font-semibold text-slate-700">
                1,500 W running 4 h/day for 30 days uses 180 kWh a month.
              </p>

              <div class="mt-6 grid grid-cols-2 gap-3">
                <div class="rounded-xl border border-amber-100 bg-white p-4">
                  <p class="text-xs text-slate-500">Per day</p>
                  <p id="kc-daily" class="mt-1 text-2xl font-bold text-slate-900">$1.02</p>
                </div>
                <div class="rounded-xl border border-amber-100 bg-white p-4">
                  <p class="text-xs text-slate-500">Per year</p>
                  <p id="kc-annual" class="mt-1 text-2xl font-bold text-slate-900">$367</p>
                </div>
              </div>

              <details class="group mt-5 rounded-xl border border-amber-100 bg-white">
                <summary
                  class="flex items-center justify-between cursor-pointer px-4 py-3 text-sm font-semibold text-slate-800"
                >
                  See the breakdown
                  <svg
                    class="h-4 w-4 text-slate-500 transition-transform group-open:rotate-180"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    viewBox="0 0 24 24"
                  >
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"></path>
                  </svg>
                </summary>
                <div class="px-4 pb-4 text-sm space-y-1.5 text-slate-600">
                  <div class="flex justify-between gap-3">
                    <span>Kilowatts</span><span id="kc-bd-kw" class="font-semibold text-slate-900">—</span>
                  </div>
                  <div class="flex justify-between gap-3">
                    <span>Daily energy</span><span id="kc-bd-daily-kwh" class="font-semibold text-slate-900">—</span>
                  </div>
                  <div class="flex justify-between gap-3">
                    <span>Monthly energy</span><span id="kc-bd-monthly-kwh" class="font-semibold text-slate-900">—</span>
                  </div>
                  <div class="flex justify-between gap-3">
                    <span>Annual energy</span><span id="kc-bd-annual-kwh" class="font-semibold text-slate-900">—</span>
                  </div>
                  <div class="flex justify-between gap-3">
                    <span>Rate</span><span id="kc-bd-rate" class="font-semibold text-slate-900">—</span>
                  </div>
                  <div class="flex justify-between gap-3 border-t border-slate-200 pt-1.5 mt-1.5">
                    <span class="font-bold">Annual cost</span><span id="kc-bd-annual-cost" class="font-bold text-slate-900">—</span>
                  </div>
                </div>
              </details>

              <p class="mt-4 text-xs text-slate-500 leading-relaxed">
                Energy component only. Real bills add fixed connection charges, taxes, and delivery fees, and
                thermostatted appliances cycle rather than running continuously.
              </p>
            </div>
          </div>
        </div>
      </section>

      <section class="bg-slate-50 border-y border-slate-200">
        <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-14">
          <h2 class="text-3xl font-extrabold tracking-tight text-slate-900">
            The formula, explained in plain English
          </h2>

          <div
            class="mt-8 rounded-2xl bg-slate-900 p-6 sm:p-8 text-slate-100 font-mono text-sm leading-relaxed overflow-x-auto"
          >
            <div class="text-cyan-300"># Step 1 — Watts to kilowatts</div>
            <div>kW&nbsp;=&nbsp;W ÷ <span class="text-amber-300">1,000</span></div>
            <div class="mt-4 text-cyan-300"># Step 2 — Power to energy</div>
            <div>kWh per day&nbsp;=&nbsp;kW × hours per day</div>
            <div class="mt-4 text-cyan-300"># Step 3 — Energy to money</div>
            <div>cost&nbsp;=&nbsp;kWh × $/kWh</div>
            <div class="mt-4 text-cyan-300"># Scaled out</div>
            <div>monthly&nbsp;=&nbsp;daily × days&nbsp;&nbsp;·&nbsp;&nbsp;annual&nbsp;=&nbsp;monthly × <span class="text-amber-300">12</span></div>
          </div>

          <div class="mt-8 grid sm:grid-cols-2 gap-4">
            <div class="rounded-xl border border-slate-200 bg-white p-5">
              <h3 class="font-bold text-slate-900">Power vs energy</h3>
              <p class="mt-2 text-sm text-slate-600">
                Watts is a rate; kilowatt-hours is a quantity. A 1,000 W load for one hour and a 100 W load for
                ten hours cost exactly the same — the bill only counts energy.
              </p>
            </div>
            <div class="rounded-xl border border-slate-200 bg-white p-5">
              <h3 class="font-bold text-slate-900">Run hours dominate</h3>
              <p class="mt-2 text-sm text-slate-600">
                A 150 W refrigerator running 24/7 costs more than a 1,500 W heater used an hour a day. When an
                estimate looks wrong, the run-time assumption is almost always why.
              </p>
            </div>
            <div class="rounded-xl border border-slate-200 bg-white p-5">
              <h3 class="font-bold text-slate-900">Commercial bills add demand</h3>
              <p class="mt-2 text-sm text-slate-600">
                Commercial tariffs charge for peak kW or kVA on top of energy. Reducing peak draw can save more
                than reducing total consumption.
              </p>
            </div>
            <div class="rounded-xl border border-slate-200 bg-white p-5">
              <h3 class="font-bold text-slate-900">Use the effective rate</h3>
              <p class="mt-2 text-sm text-slate-600">
                Divide the whole bill by the kWh delivered. That captures taxes, delivery, and fixed charges,
                and is usually well above the advertised energy rate.
              </p>
            </div>
          </div>
        </div>
      </section>

      <section class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 py-14">
        <h2 class="text-3xl font-extrabold tracking-tight text-slate-900">Worked examples</h2>
        <p class="mt-4 text-slate-600">A heater, an always-on load, and an EV — three very different shapes.</p>

        <div class="mt-8 space-y-6">
          <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
            <div class="flex items-center gap-3">
              <span class="flex h-9 w-9 items-center justify-center rounded-full bg-amber-100 text-amber-700 font-bold">1</span>
              <h3 class="text-lg font-bold text-slate-900">1,500 W space heater, 4 h/day</h3>
            </div>
            <p class="mt-3 text-sm text-slate-600">30 days a month at $0.17/kWh. The defaults above.</p>
            <div class="mt-4 rounded-xl bg-slate-50 p-4 font-mono text-sm text-slate-700">
              1.5 kW × 4 h = 6 kWh/day → $1.02/day<br />
              × 30 days = 180 kWh → <span class="font-bold text-amber-700">$30.60/month</span><br />
              × 12 = 2,160 kWh → $367/year
            </div>
            <p class="mt-3 text-sm text-slate-600">
              <span class="font-semibold text-slate-900">Result:</span> $367 a year to heat one room with
              resistance heat. The same heat from a heat pump at COP 3 would cost roughly a third of that, which
              is the electrification argument in one number.
            </p>
          </div>

          <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
            <div class="flex items-center gap-3">
              <span class="flex h-9 w-9 items-center justify-center rounded-full bg-amber-100 text-amber-700 font-bold">2</span>
              <h3 class="text-lg font-bold text-slate-900">150 W refrigerator, 24 h/day</h3>
            </div>
            <p class="mt-3 text-sm text-slate-600">A tenth the power, but always on.</p>
            <div class="mt-4 rounded-xl bg-slate-50 p-4 font-mono text-sm text-slate-700">
              0.15 kW × 24 h = 3.6 kWh/day → $0.61/day<br />
              × 30 = 108 kWh → <span class="font-bold text-amber-700">$18.36/month</span> → $220/year
            </div>
            <p class="mt-3 text-sm text-slate-600">
              <span class="font-semibold text-slate-900">Result:</span> a 150 W load costs 60% as much as a
              1,500 W load, because it runs six times as long. Run hours matter more than wattage.
            </p>
          </div>

          <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
            <div class="flex items-center gap-3">
              <span class="flex h-9 w-9 items-center justify-center rounded-full bg-amber-100 text-amber-700 font-bold">3</span>
              <h3 class="text-lg font-bold text-slate-900">48 A EV charger, 4 h/day</h3>
            </div>
            <p class="mt-3 text-sm text-slate-600">11,520 W (48 A × 240 V), charging four hours a night.</p>
            <div class="mt-4 rounded-xl bg-slate-50 p-4 font-mono text-sm text-slate-700">
              11.52 kW × 4 h = 46.08 kWh/day → $7.83/day<br />
              × 30 = 1,382 kWh → <span class="font-bold text-amber-700">$235/month</span> → $2,820/year
            </div>
            <p class="mt-3 text-sm text-slate-600">
              <span class="font-semibold text-slate-900">Result:</span> daily full-rate charging is a serious
              load — comparable to a whole small household. This is also why time-of-use tariffs and overnight
              rates change the answer dramatically; rerun it with your off-peak rate.
            </p>
          </div>
        </div>
      </section>

      <section class="bg-slate-50 border-y border-slate-200">
        <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-14">
          <h2 class="text-3xl font-extrabold tracking-tight text-slate-900">Common appliance running costs</h2>
          <p class="mt-4 text-slate-600 leading-relaxed">
            At ${RATE.toFixed(2)} per kWh and 30 days a month, using the run hours shown. Change either input
            above to match your situation.
          </p>

          <div class="mt-8 overflow-x-auto rounded-2xl border border-slate-200 bg-white shadow-sm">
            <table class="w-full text-left text-sm">
              <thead>
                <tr class="border-b border-slate-200 text-slate-500 bg-slate-50">
                  <th class="py-3 px-5 font-semibold">Appliance</th>
                  <th class="py-3 px-4 font-semibold">Watts</th>
                  <th class="py-3 px-4 font-semibold">h/day</th>
                  <th class="py-3 px-4 font-semibold">kWh/day</th>
                  <th class="py-3 px-4 font-semibold">Per month</th>
                  <th class="py-3 px-4 font-semibold">Per year</th>
                </tr>
              </thead>
              <tbody class="text-slate-700">
                {
                  applianceRows.map((row, index) => (
                    <tr class={index === applianceRows.length - 1 ? "" : "border-b border-slate-100"}>
                      <td class="py-3 px-5 font-semibold text-slate-900">{row.name}</td>
                      <td class="py-3 px-4">{row.watts.toLocaleString("en-US")}</td>
                      <td class="py-3 px-4">{row.hours}</td>
                      <td class="py-3 px-4">{fmt(row.dailyKwh, 2)}</td>
                      <td class="py-3 px-4">${fmt(row.monthly, 2)}</td>
                      <td class="py-3 px-4 font-semibold text-slate-900">${Math.round(row.annual).toLocaleString("en-US")}</td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>

          <p class="mt-6 text-sm text-slate-500">
            Sources &amp; standards: electricity price per kilowatt-hour from the
            <a
              href="https://www.eia.gov/electricity/monthly/"
              target="_blank"
              rel="noopener noreferrer"
              class="font-semibold text-amber-700 underline decoration-amber-300 hover:decoration-amber-600"
              >U.S. Energy Information Administration</a
            > Electric Power Monthly. The ${RATE.toFixed(2)}/kWh default is a US residential average; state rates
            range from roughly $0.11 to over $0.30. Figures cover the energy component only and exclude fixed
            charges, taxes, delivery fees, and demand charges.
          </p>
        </div>
      </section>

      <CalculatorFaqSection
        faqs={faqs}
        accent="amber"
        subtitle="Common questions about kilowatt-hours and electricity cost."
      />

      <CalculatorTradesQuoteCta heading={ctaHeading} description={ctaDescription} />

      <RelatedCalculators calculators={relatedCalculators} styles={styles} heading="More electrical calculators" />
    </main>

    <Footer />
  </div>

