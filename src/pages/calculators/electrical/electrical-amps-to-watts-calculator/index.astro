                  <th class="py-3 px-4 font-semibold">120 V max</th>
                  <th class="py-3 px-4 font-semibold">120 V continuous</th>
                  <th class="py-3 px-4 font-semibold">240 V max</th>
                  <th class="py-3 px-4 font-semibold">240 V continuous</th>
