---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import CalculatorToolCard from "@/components/CalculatorToolCard.astro";
import CalculatorBreadcrumb from "@/components/CalculatorBreadcrumb.astro";
import CalculatorFaqSection from "@/components/CalculatorFaqSection.astro";
import CalculatorTradesQuoteCta from "@/components/CalculatorTradesQuoteCta.astro";
import ExternalResources from "@/components/ExternalResources.astro";
import { buildFaqPageSchema } from "@/lib/calculatorFaq";
import { calculatorCategories } from "@/config/calculatorCategories";
import { getSinglePage } from "@/lib/contentParser.astro";
import taxonomyFilter from "@/lib/utils/taxonomyFilter";
import {
  electricalCalculators,
  electricalCalculatorGroups,
  electricalCalculatorGuide,
  electricalFaqs,
  electricalAccentStyles,
} from "@/config/electricalCalculators";
import { hvacCalculators } from "@/config/hvacCalculators";
import {
  DEFAULT_ELECTRICAL_EXTERNAL_RESOURCES,
  ELECTRICAL_EXTERNAL_RESOURCE_STYLES,
} from "@/config/electricalExternalResources";

const title = "Free Electrical Calculators (NEC) | TradesQuote";
const description =
  "Twenty-three free NEC-based electrical calculators — wire size by ampacity and voltage drop, ampacity derating, breaker sizing, service and feeder conductors, grounding, conduit and box fill, residential load calculation, service sizing, EV charger circuits, watts to amps, Ohm's law, unit conversion, kVA, three-phase power, power-factor correction, running cost, panel upgrade and rewiring cost, labor rate, and job pricing. Every formula explained in plain English with the code article cited.";

const pageUrl = "https://www.tradesquote.ai/calculators/electrical";
const basePath = "/calculators/electrical";

const comingSoonCategories = calculatorCategories.filter((c) => c.status === "coming-soon");

const breadcrumbData = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: "https://www.tradesquote.ai/" },
    { "@type": "ListItem", position: 2, name: "Calculators", item: "https://www.tradesquote.ai/calculators" },
    { "@type": "ListItem", position: 3, name: "Electrical", item: pageUrl },
  ],
};

const itemListData = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Free Electrical Calculators",
  description:
    "Free online electrical calculators built on the National Electrical Code: wire size from Table 310.16 ampacity and voltage drop, ampacity derating, breaker sizing, dwelling service and feeder conductors from Table 310.12, equipment grounding and grounding electrode conductors, Chapter 9 conduit fill, 314.16 box fill, NEC 220.82 residential load calculation, service sizing, NEC 625 EV charger circuits, watts-to-amps and Ohm's law conversions, kVA and three-phase power, power-factor correction, appliance running cost, panel upgrade and whole-house rewiring cost, loaded labor rate, and contractor job pricing.",
  itemListElement: electricalCalculators.map((calc, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: calc.title,
    url: `${pageUrl}/${calc.slug}`,
  })),
};

const faqData = buildFaqPageSchema(electricalFaqs);

const allPosts = await getSinglePage("posts");
const recentElectricalPosts = taxonomyFilter(allPosts, "categories", "electrical")
  .filter((p) => !p.data.draft)
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 3);

const ctaHeading = "Calculators size the circuit. TradesQuote prices the job.";
const ctaDescription =
  "Once the conductors, breaker, and panel capacity are settled, the real work is the quote. Describe the job or upload photos, and TradesQuote's AI builds a detailed line-item estimate — quantities, unit prices, and totals — validated by a built-in quality control agent and ready for your client to sign online.";
---

<Layout {title} {description}>
  <Fragment slot="head">
    <link rel="canonical" href={pageUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Free Electrical Calculators (NEC)" />
    <meta
      property="og:description"
      content="Wire size, voltage drop, ampacity derating, breaker sizing, service &amp; feeder conductors, grounding, conduit fill, box fill, residential load calculation, service sizing, EV charger circuits, and job pricing — twelve free NEC-based tools with every formula explained."
    />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:site_name" content="TradesQuote" />
    <meta property="og:image" content="https://www.tradesquote.ai/logo.svg" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Free Electrical Calculators (NEC)" />
    <meta
      name="twitter:description"
      content="Twelve free NEC-based electrical calculators for conductor sizing, protection, grounding, raceway fill, load calculations, EV circuits, and job pricing."
    />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbData)} />
    <script type="application/ld+json" set:html={JSON.stringify(itemListData)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqData)} />
  </Fragment>

  <div class="bg-white min-h-screen text-slate-700">
    <Header />

    <main>
      <!-- Hero -->
      <section class="relative overflow-hidden bg-gradient-to-b from-slate-50 to-white">
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pt-10 pb-8">
          <CalculatorBreadcrumb category="Electrical" categoryHref="/calculators/electrical" />

          <div class="max-w-3xl">
            <span
              class="inline-flex items-center gap-1.5 rounded-full bg-sky-100 px-3 py-1 text-xs font-semibold text-sky-700"
            >
              <svg
                class="h-3.5 w-3.5"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                viewBox="0 0 24 24"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
              Electrical Tools · {electricalCalculators.length} Free Calculators
            </span>

            <h1 class="mt-4 text-4xl sm:text-5xl font-extrabold tracking-tight text-slate-900">
              Free Electrical Calculators <span class="text-sky-600">— NEC Sizing, Protection & Cost</span>
            </h1>

            <p class="mt-5 text-lg text-slate-600 leading-relaxed">
              Size a circuit end to end without opening the code book: conductor gauge from ampacity
              <em>and</em> voltage drop, the breaker that protects it, the conduit and box that hold it, and the
              grounding conductors that go with it. Convert whatever the nameplate gives you — watts,
              horsepower, kVA — into the amps the sizing tools need. Run the whole-house load calculation that
              decides whether the service can take it. Then price the job. Every tool is free, instant, and
              explains its formula in plain English with the NEC article cited.
            </p>

            <div class="mt-6 rounded-xl border border-amber-200 bg-amber-50 p-4">
              <p class="text-sm text-amber-900 leading-relaxed">
                <span class="font-semibold">Code baseline: NEC 2023.</span> NEC 2026 was published in August
                2025, but most states still enforce the 2020 or 2023 edition — and local amendments override the
                model code either way. Results are for estimating and planning; a licensed electrician and your
                AHJ have final say on anything installed.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- Start here quick-nav -->
      <section class="border-b border-slate-100 bg-slate-50">
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-6">
          <p class="text-xs font-semibold uppercase tracking-widest text-slate-400 mb-3">Start here</p>
          <div class="flex flex-wrap gap-3">
            <a
              href={`${basePath}/electrical-wire-size-calculator`}
              class="inline-flex items-center gap-2 rounded-xl border border-blue-200 bg-white px-4 py-2.5 text-sm font-medium text-blue-700 shadow-sm hover:bg-blue-50 hover:border-blue-300 transition-colors"
            >
              <svg class="h-4 w-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7h12m0 0l-4-4m4 4l-4 4m4 6H4m0 0l4 4m-4-4l4-4"/></svg>
              Size a circuit
            </a>
            <a
              href={`${basePath}/electrical-load-calculator`}
              class="inline-flex items-center gap-2 rounded-xl border border-indigo-200 bg-white px-4 py-2.5 text-sm font-medium text-indigo-700 shadow-sm hover:bg-indigo-50 hover:border-indigo-300 transition-colors"
            >
              <svg class="h-4 w-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
              Size a service
            </a>
            <a
              href={`${basePath}/electrical-ev-charger-calculator`}
              class="inline-flex items-center gap-2 rounded-xl border border-emerald-200 bg-white px-4 py-2.5 text-sm font-medium text-emerald-700 shadow-sm hover:bg-emerald-50 hover:border-emerald-300 transition-colors"
            >
              <svg class="h-4 w-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M13 8l-4 5h3l-1 4 4-5h-3l1-4z"/></svg>
              Wire an EV charger
            </a>
            <a
              href={`${basePath}/electrical-watts-to-amps-calculator`}
              class="inline-flex items-center gap-2 rounded-xl border border-teal-200 bg-white px-4 py-2.5 text-sm font-medium text-teal-700 shadow-sm hover:bg-teal-50 hover:border-teal-300 transition-colors"
            >
              <svg class="h-4 w-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7h12m0 0l-4-4m4 4l-4 4m4 6H4m0 0l4 4m-4-4l4-4"/></svg>
              Convert watts, amps & hp
            </a>
            <a
              href={`${basePath}/electrical-estimate-calculator`}
              class="inline-flex items-center gap-2 rounded-xl border border-rose-200 bg-white px-4 py-2.5 text-sm font-medium text-rose-700 shadow-sm hover:bg-rose-50 hover:border-rose-300 transition-colors"
            >
              <svg class="h-4 w-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              Price the job
            </a>
          </div>
        </div>
      </section>

      <!-- Calculator directory — grouped by workflow -->
      <section id="calculators" class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-14">
        {
          electricalCalculatorGroups.map((group) => (
            <div class="mb-14">
              <div class="mb-5">
                <h2 class="text-xl font-bold text-slate-900">{group.label}</h2>
                <p class="mt-1 text-sm text-slate-500">{group.description}</p>
              </div>
              <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5">
                {group.slugs.map((slug) => {
                  const calculator = electricalCalculators.find((c) => c.slug === slug);
                  return calculator ? (
                    <CalculatorToolCard
                      {calculator}
                      styles={electricalAccentStyles[calculator.accent]}
                      {basePath}
                    />
                  ) : null;
                })}
              </div>
            </div>
          ))
        }

        <!-- Cross-category pointer -->
        <div class="rounded-2xl border border-slate-200 bg-slate-50 p-6">
          <h2 class="text-lg font-bold text-slate-900">Working on HVAC equipment?</h2>
          <p class="mt-2 text-sm text-slate-600 leading-relaxed">
            Sizing the circuit for a condenser, air handler, or heat pump starts from the equipment nameplate,
            not from a load calculation. The
            <a
              href="/calculators/hvac/hvac-amp-draw-calculator"
              class="font-semibold text-sky-600 hover:underline">HVAC Amp Draw Calculator</a
            >
            turns BTU capacity into RLA, minimum circuit ampacity (MCA), and maximum overcurrent protection
            (MOCP) — the numbers that decide the breaker and the wire. There are
            <a href="/calculators/hvac" class="font-semibold text-sky-600 hover:underline"
              >{hvacCalculators.length} HVAC calculators</a
            > alongside these.
          </p>
        </div>

        <!-- Coming soon card -->
        <div class="mt-6 flex flex-col rounded-2xl border border-dashed border-slate-300 bg-slate-50 p-6 max-w-lg">
          <div class="flex items-center gap-3">
            <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-slate-200 text-slate-500">
              <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6m0 0v6m6-6h-6m-6 0h6" />
              </svg>
            </span>
            <h2 class="text-lg font-bold text-slate-700">More electrical tools on the way</h2>
          </div>
          <p class="mt-3 text-sm text-slate-600 leading-relaxed">
            Motor and transformer circuits, available fault current, solar interconnection and the 705.12 120%
            busbar rule, generator sizing, and lighting layout are next. Calculators for these trades are also
            planned:
          </p>
          <div class="mt-3 flex flex-wrap gap-2">
            {
              comingSoonCategories.map((category) => (
                <span class="rounded-full bg-white border border-slate-200 px-3 py-1 text-xs font-medium text-slate-600">
                  {category.name}
                </span>
              ))
            }
          </div>
          <p class="mt-auto pt-4 text-xs text-slate-500">Coming soon</p>
        </div>
      </section>

      <!-- Which calculator do I need? -->
      <section class="bg-slate-50 border-y border-slate-200">
        <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 py-14">
          <h2 class="text-3xl font-extrabold tracking-tight text-slate-900">Which calculator do I need?</h2>
          <p class="mt-4 text-slate-600 leading-relaxed">
            Match your question to the right tool. For a full circuit the natural order is:
            <span class="font-semibold text-slate-900">Load → Wire → Breaker → Conduit/Box → Ground</span> —
            get the load, size the conductor, protect it, then house and bond it. If you already know the
            amps, start at wire size.
          </p>

          <div class="mt-8 overflow-x-auto rounded-2xl border border-slate-200 bg-white shadow-sm">
            <table class="w-full text-left text-sm">
              <thead>
                <tr class="border-b border-slate-200 text-slate-500 bg-slate-50">
                  <th class="py-3 px-5 font-semibold">You're asking…</th>
                  <th class="py-3 px-5 font-semibold">Use this tool</th>
                  <th class="py-3 px-5 font-semibold">The code rule it's built on</th>
                </tr>
              </thead>
              <tbody class="text-slate-700">
                {
                  electricalCalculatorGuide.map((row, index) => {
                    const linkColor = electricalAccentStyles[row.accent].linkColor;
                    const isLast = index === electricalCalculatorGuide.length - 1;
                    return (
                      <tr class={isLast ? "" : "border-b border-slate-100"}>
                        <td class="py-3 px-5">{row.question}</td>
                        <td class="py-3 px-5">
                          <a
                            href={`${basePath}/${row.slug}`}
                            class={`font-semibold ${linkColor} hover:underline`}
                          >
                            {row.tool}
                          </a>
                        </td>
                        <td class="py-3 px-5">{row.rule}</td>
                      </tr>
                    );
                  })
                }
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <!-- Formulas -->
      <section class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-14">
        <h2 class="text-3xl font-extrabold tracking-tight text-slate-900">
          Every electrical formula on one page
        </h2>
        <p class="mt-4 text-slate-600 leading-relaxed">
          Every rule behind these tools, with the NEC article that carries it. Each calculator's page walks
          through its formula in plain English with worked examples — this is the cheat sheet.
        </p>

        <div
          class="mt-8 rounded-2xl bg-slate-900 p-6 sm:p-8 text-slate-100 font-mono text-sm leading-relaxed overflow-x-auto"
        >
          <div class="text-blue-300"># Wire size — ampacity path (Table 310.16, 110.14(C))</div>
          <div>required A&nbsp;=&nbsp;non-continuous + continuous × <span class="text-amber-300">1.25</span>&nbsp;&nbsp;→&nbsp;&nbsp;smallest AWG with ampacity ≥ required</div>
          <div class="mt-4 text-sky-300"># Voltage drop (210.19(A) IN — recommendation, not a requirement)</div>
          <div>1φ: VD&nbsp;=&nbsp;<span class="text-amber-300">2</span> × K × I × L ÷ CM&nbsp;&nbsp;·&nbsp;&nbsp;3φ: VD&nbsp;=&nbsp;<span class="text-amber-300">1.732</span> × K × I × L ÷ CM</div>
          <div>K&nbsp;=&nbsp;<span class="text-amber-300">12.9</span> copper&nbsp;·&nbsp;<span class="text-amber-300">21.2</span> aluminum&nbsp;&nbsp;·&nbsp;&nbsp;VD%&nbsp;=&nbsp;VD ÷ V × 100</div>
          <div class="mt-4 text-cyan-300"># Ampacity derating (310.15(B)(1), 310.15(C)(1))</div>
          <div>derated&nbsp;=&nbsp;base × ambient factor × bundling factor&nbsp;&nbsp;·&nbsp;&nbsp;capped by the 75°C termination column</div>
          <div>bundling: 4–6 → <span class="text-amber-300">0.80</span>&nbsp;·&nbsp;7–9 → <span class="text-amber-300">0.70</span>&nbsp;·&nbsp;10–20 → <span class="text-amber-300">0.50</span></div>
          <div class="mt-4 text-red-300"># Breaker size (210.20(A), 240.6(A), 240.4(D))</div>
          <div>OCPD&nbsp;=&nbsp;next standard rating ≥ required A&nbsp;&nbsp;·&nbsp;&nbsp;caps: 14 AWG <span class="text-amber-300">15A</span>, 12 AWG <span class="text-amber-300">20A</span>, 10 AWG <span class="text-amber-300">30A</span></div>
          <div class="mt-4 text-blue-300"># Service &amp; feeder conductors — dwellings (Table 310.12)</div>
          <div>conductors rated at <span class="text-amber-300">83%</span> of the service rating&nbsp;&nbsp;·&nbsp;&nbsp;200A → 2/0 Cu or 4/0 Al</div>
          <div class="mt-4 text-emerald-300"># Grounding (Table 250.122 · Table 250.66)</div>
          <div>EGC&nbsp;=&nbsp;by OCPD rating&nbsp;&nbsp;·&nbsp;&nbsp;GEC&nbsp;=&nbsp;by service conductor size</div>
          <div>caps: rod electrode <span class="text-amber-300">6 AWG</span>&nbsp;·&nbsp;concrete-encased <span class="text-amber-300">4 AWG</span> (250.66(A)(B))</div>
          <div class="mt-4 text-teal-300"># Conduit fill (Chapter 9 Tables 1, 4, 5)</div>
          <div>fill limit&nbsp;=&nbsp;<span class="text-amber-300">53%</span> for 1 conductor&nbsp;·&nbsp;<span class="text-amber-300">31%</span> for 2&nbsp;·&nbsp;<span class="text-amber-300">40%</span> for 3 or more</div>
          <div class="mt-4 text-teal-300"># Box fill (314.16(B))</div>
          <div>each conductor ×1&nbsp;·&nbsp;all grounds ×1&nbsp;·&nbsp;all clamps ×1&nbsp;·&nbsp;each device yoke ×<span class="text-amber-300">2</span>&nbsp;·&nbsp;each support fitting ×<span class="text-amber-300">2</span></div>
          <div>volumes: 14 AWG <span class="text-amber-300">2.00</span>&nbsp;·&nbsp;12 AWG <span class="text-amber-300">2.25</span>&nbsp;·&nbsp;10 AWG <span class="text-amber-300">2.50</span> in³</div>
          <div class="mt-4 text-indigo-300"># Residential load — optional method (220.82)</div>
          <div>general&nbsp;=&nbsp;<span class="text-amber-300">3</span> VA/ft² × area + <span class="text-amber-300">1,500</span> × (small-appliance + laundry) + appliance nameplates</div>
          <div>then first <span class="text-amber-300">10,000</span> VA at 100%, remainder at <span class="text-amber-300">40%</span>, plus the largest 220.82(C) HVAC term</div>
          <div class="mt-4 text-indigo-300"># Service size (230.79, 408.36)</div>
          <div>amps&nbsp;=&nbsp;VA ÷ <span class="text-amber-300">240</span>&nbsp;&nbsp;→&nbsp;&nbsp;smallest standard service ≥ amps&nbsp;&nbsp;·&nbsp;&nbsp;flag above <span class="text-amber-300">80%</span> utilisation</div>
          <div class="mt-4 text-emerald-300"># EV charger circuit (625.41, 625.42)</div>
          <div>continuous load&nbsp;→&nbsp;conductors and OCPD at <span class="text-amber-300">125%</span>&nbsp;&nbsp;·&nbsp;&nbsp;48A → 60A breaker, 6 AWG Cu, 10 AWG EGC</div>
          <div class="mt-4 text-emerald-300"># Watts ↔ amps</div>
          <div>DC: I&nbsp;=&nbsp;P ÷ V&nbsp;&nbsp;·&nbsp;&nbsp;1φ: I&nbsp;=&nbsp;P ÷ (V × PF)&nbsp;&nbsp;·&nbsp;&nbsp;3φ: I&nbsp;=&nbsp;P ÷ (<span class="text-amber-300">1.732</span> × V × PF)</div>
          <div class="mt-4 text-teal-300"># Ohm's law and the power wheel</div>
          <div>V&nbsp;=&nbsp;I × R&nbsp;&nbsp;·&nbsp;&nbsp;P&nbsp;=&nbsp;V × I&nbsp;&nbsp;·&nbsp;&nbsp;P&nbsp;=&nbsp;I² × R&nbsp;&nbsp;·&nbsp;&nbsp;P&nbsp;=&nbsp;V² ÷ R</div>
          <div class="mt-4 text-sky-300"># Unit conversions</div>
          <div>1 hp&nbsp;=&nbsp;<span class="text-amber-300">745.7</span> W&nbsp;&nbsp;·&nbsp;&nbsp;1 W&nbsp;=&nbsp;<span class="text-amber-300">3.412</span> BTU/h&nbsp;&nbsp;·&nbsp;&nbsp;1 ton&nbsp;=&nbsp;<span class="text-amber-300">12,000</span> BTU/h</div>
          <div class="mt-4 text-emerald-300"># Apparent, real, and reactive power</div>
          <div>1φ: kVA&nbsp;=&nbsp;V × I ÷ 1,000&nbsp;&nbsp;·&nbsp;&nbsp;3φ: kVA&nbsp;=&nbsp;<span class="text-amber-300">1.732</span> × V × I ÷ 1,000</div>
          <div>kW&nbsp;=&nbsp;kVA × PF&nbsp;&nbsp;·&nbsp;&nbsp;kVAR&nbsp;=&nbsp;√(kVA² − kW²)</div>
          <div class="mt-4 text-teal-300"># Power factor correction</div>
          <div>Qc&nbsp;=&nbsp;P × (tan φ₁ − tan φ₂),&nbsp;&nbsp;φ&nbsp;=&nbsp;arccos(PF)</div>
          <div class="mt-4 text-amber-300"># Running cost</div>
          <div>cost&nbsp;=&nbsp;W ÷ <span class="text-amber-300">1,000</span> × hours × days × $/kWh</div>
          <div class="mt-4 text-rose-300"># Job price (estimate calculator)</div>
          <div>price&nbsp;=&nbsp;(labor + fixtures + material + overhead) ÷ (1 − <span class="text-amber-300">margin</span>)</div>
          <div class="mt-4 text-rose-300"># Loaded labor rate</div>
          <div>bill rate&nbsp;=&nbsp;(wage + burden + overhead) ÷ billable hours ÷ (1 − margin)</div>
        </div>

        <p class="mt-6 text-sm text-slate-500">
          These reproduce NEC tables and formulas, but they cannot see your ambient conditions, existing
          conductors, terminal ratings, or local amendments. Confirm final design with a licensed electrician
          and the edition of the code your jurisdiction actually enforces.
        </p>
      </section>

      <CalculatorFaqSection
        faqs={electricalFaqs}
        accent="sky"
        subtitle="About the calculators, which code edition they follow, and what's next."
      />

      <ExternalResources
        heading="Trusted Electrical Standards & Resources"
        subheading="Every ampacity, fill percentage, demand factor, and grounding size on these pages traces back to a published standard. These are the organisations that write them and the data sources behind the cost figures."
        resources={DEFAULT_ELECTRICAL_EXTERNAL_RESOURCES}
        styles={ELECTRICAL_EXTERNAL_RESOURCE_STYLES}
      />

      <CalculatorTradesQuoteCta heading={ctaHeading} description={ctaDescription} />

      {
        recentElectricalPosts.length > 0 && (
          <section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-14">
            <div class="flex items-end justify-between mb-8">
              <div>
                <h2 class="text-3xl font-extrabold tracking-tight text-slate-900">From the Blog</h2>
                <p class="mt-2 text-slate-600">
                  Guides and deep-dives on NEC sizing, code compliance, and electrical job pricing.
                </p>
              </div>
              <a
                href="/blog/categories/electrical"
                class="hidden sm:inline-flex items-center gap-1.5 text-sm font-semibold text-sky-600 hover:text-sky-800"
              >
                All electrical articles
                <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                </svg>
              </a>
            </div>
            <div class="grid md:grid-cols-3 gap-6">
              {recentElectricalPosts.map((post) => (
                <a
                  href={`/blog/${post.id}`}
                  class="group flex flex-col rounded-2xl border border-slate-200 bg-white p-6 hover:border-sky-300 hover:shadow-md transition-all"
                >
                  <p class="text-xs font-semibold uppercase tracking-widest text-sky-600 mb-2">Electrical</p>
                  <h3 class="text-base font-bold text-slate-900 group-hover:text-sky-600 leading-snug">
                    {post.data.title}
                  </h3>
                  {post.data.description && (
                    <p class="mt-2 text-sm text-slate-500 leading-relaxed line-clamp-2">
                      {post.data.description}
                    </p>
                  )}
                  <span class="mt-auto pt-4 text-sm font-semibold text-sky-600 group-hover:underline">
                    Read article →
                  </span>
                </a>
              ))}
            </div>
            <div class="mt-6 sm:hidden">
              <a
                href="/blog/categories/electrical"
                class="text-sm font-semibold text-sky-600 hover:text-sky-800"
              >
                View all electrical articles →
              </a>
            </div>
          </section>
        )
      }
    </main>

    <Footer />
  </div>
</Layout>
