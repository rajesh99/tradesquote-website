---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import RelatedCalculators from "@/components/RelatedCalculators.astro";
import CalculatorBreadcrumb from "@/components/CalculatorBreadcrumb.astro";
import CalculatorFaqSection from "@/components/CalculatorFaqSection.astro";
import CalculatorTradesQuoteCta from "@/components/CalculatorTradesQuoteCta.astro";
import { buildFaqPageSchema, type CalculatorFaq } from "@/lib/calculatorFaq";
import { electricalAccentStyles } from "@/config/electricalCalculators";
import {
  TABLE_8_DC_RESISTANCE,
  fmtInt,
  requiredAicRating,
  transformerSecondaryFaultCurrent,
  typicalPercentZ,
} from "@/lib/nec";

const title = "Available Fault Current Calculator — Point-to-Point & AIC Check | TradesQuote";
const description =
  "Free short-circuit calculator. Available fault current at the transformer secondary and at the end of a feeder by the point-to-point method, with the interrupting rating NEC 110.9 requires.";

const pageUrl = "https://www.tradesquote.ai/calculators/electrical/electrical-short-circuit-calculator";

const breadcrumbData = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: "https://www.tradesquote.ai/" },
    { "@type": "ListItem", position: 2, name: "Calculators", item: "https://www.tradesquote.ai/calculators" },
    { "@type": "ListItem", position: 3, name: "Electrical", item: "https://www.tradesquote.ai/calculators/electrical" },
    { "@type": "ListItem", position: 4, name: "Available Fault Current Calculator", item: pageUrl },
  ],
};

const webAppData = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: "Available Fault Current Calculator",
  url: pageUrl,
  applicationCategory: "BusinessApplication",
  operatingSystem: "Any (web-based)",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  description:
    "Free online available fault current calculator using the point-to-point method. Returns symmetrical RMS short-circuit current at a transformer secondary and at the end of a feeder, plus the interrupting rating required by NEC 110.9.",
};

const faqs: CalculatorFaq[] = [
  {
    question: "What is available fault current and why does it matter?",
    answer:
      "It is the current that would flow if a bolted short circuit occurred at a given point. It matters because <strong>NEC 110.9</strong> requires every device intended to interrupt a fault to have an interrupting rating at least equal to what is available there. A 10 kA loadcenter on a 22 kA supply can fail catastrophically rather than clearing the fault. <strong>110.24</strong> additionally requires the available fault current to be field-marked at a service.",
  },
  {
    question: "Why assume an infinite primary source?",
    answer:
      "Because it is the conservative assumption and it needs no data from the utility. Treating the primary as infinite means all the impedance limiting the fault is the transformer's own, so the answer is the highest the transformer can produce. Including the real utility and primary-conductor impedance always lowers the result — so if the equipment passes on the infinite-source figure, it passes.",
  },
  {
    question: "Why apply a −10% impedance tolerance?",
    answer:
      "Because transformer impedance is a nameplate value with a manufacturing tolerance of about ±10%, and a transformer at the <em>low</em> end of that band produces <em>more</em> fault current. For an interrupting-rating check the worst case is the low-impedance unit, so the calculator can multiply the nameplate impedance by 0.90. This is standard practice in a short-circuit study.",
  },
  {
    question: "How does the point-to-point method work?",
    answer:
      "You take the fault current at the start of a run, add the run's own impedance, and get the reduced current at the far end. The classic form is <strong>M = 1 ÷ (1 + f)</strong>, where f is the run impedance divided by the source impedance. This calculator computes the source impedance implied by the upstream current and adds the run impedance from NEC Chapter 9 Tables 8 and 9 — algebraically identical, but every number traces to the code book rather than to proprietary conductor constants.",
  },
  {
    question: "Does conductor length really reduce fault current that much?",
    answer:
      "Yes, and it is the main reason a residential loadcenter is usually adequate. On the default 300 kVA example the current falls from 11,455 A at the transformer to 8,626 A after only 100 ft of 4/0 copper — a 25% reduction. Length is why fault current is highest at the service and drops steadily downstream, and why the equipment nearest the transformer needs the highest rating.",
  },
  {
    question: "What interrupting ratings are available?",
    answer:
      "Residential loadcenters and their breakers are commonly rated <strong>10 kA</strong>. Commercial panelboards run <strong>22 kA</strong> and <strong>65 kA</strong>, with <strong>100 kA</strong> and <strong>200 kA</strong> available on switchgear and current-limiting fuses. A <strong>series rating</strong> is also permitted, where a tested upstream device protects a lower-rated downstream one — but only in the exact combination the manufacturer tested and listed, and 240.86 requires it to be field-marked.",
  },
  {
    question: "Is this a substitute for a short-circuit study?",
    answer:
      "No. This is a planning tool for a single transformer and one feeder run. A real coordination study models motor contribution, multiple sources, cable and bus impedance throughout, asymmetrical peak currents, and arc-flash incident energy — and where equipment ratings are marginal or arc-flash labelling is required, that study needs a licensed engineer.",
  },
];
const faqData = buildFaqPageSchema(faqs);

const ctaHeading = "Fault current checked? Price the equipment.";
const ctaDescription =
  "Interrupting ratings drive equipment cost more than almost anything else on a commercial job. TradesQuote turns your scope into a detailed line-item estimate with quantities and totals, checked by a built-in quality control agent.";

const relatedCalculators = [
  {
    href: "/calculators/electrical/electrical-transformer-sizing-calculator",
    title: "Transformer Sizing Calculator",
    description: "kVA, FLA and the 450.3(B) protection ceilings.",
  },
  {
    href: "/calculators/electrical/electrical-conductor-resistance-calculator",
    title: "Conductor Resistance Calculator",
    description: "The Table 8 and Table 9 impedance behind this result.",
  },
  {
    href: "/calculators/electrical/electrical-motor-circuit-calculator",
    title: "Motor Circuit Calculator",
    description: "The device whose interrupting rating you just checked.",
  },
  {
    href: "/calculators/electrical/electrical-service-wire-size-calculator",
    title: "Service & Feeder Wire Size",
    description: "Size the feeder this fault current runs down.",
  },
];

/** Reference table computed with the same helpers the calculator uses. */
const transformerRows = [75, 112.5, 150, 225, 300, 500, 750, 1000].map((kva) => {
  const percentZ = typicalPercentZ(kva);
  const result = transformerSecondaryFaultCurrent({
    kva,
    secondaryVolts: 480,
    phase: "3ph",
    percentZ,
    applyToleranceMargin: true,
  });
  return { kva, percentZ, fla: result.fla, faultCurrent: result.faultCurrent, aic: requiredAicRating(result.faultCurrent) };
});

const conductorOptions = Object.keys(TABLE_8_DC_RESISTANCE);

const styles = electricalAccentStyles.red;
---

<Layout {title} {description}>
  <Fragment slot="head">
    <link rel="canonical" href={pageUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Available Fault Current Calculator — Point-to-Point & AIC Check" />
    <meta
      property="og:description"
      content="Symmetrical RMS fault current at a transformer secondary and down a feeder, with the interrupting rating NEC 110.9 requires."
    />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:site_name" content="TradesQuote" />
    <meta property="og:image" content="https://www.tradesquote.ai/logo.svg" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Available Fault Current Calculator" />
    <meta name="twitter:description" content="Point-to-point short-circuit current and the AIC rating it demands. Free and instant." />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbData)} />
    <script type="application/ld+json" set:html={JSON.stringify(webAppData)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqData)} />
  </Fragment>

  <div class="bg-white min-h-screen text-slate-700">
    <Header />

    <main>
      <section class="relative overflow-hidden bg-gradient-to-b from-slate-50 to-white">
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pt-10 pb-6">
          <CalculatorBreadcrumb
            category="Electrical"
            categoryHref="/calculators/electrical"
            current="Available Fault Current Calculator"
          />

          <div class="max-w-3xl">
            <span
              class="inline-flex items-center gap-1.5 rounded-full bg-red-100 px-3 py-1 text-xs font-semibold text-red-700"
            >
              <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
              Electrical Tools · Free
            </span>

            <h1 class="mt-4 text-4xl sm:text-5xl font-extrabold tracking-tight text-slate-900">
              Available Fault Current <span class="text-red-600">— Point to Point</span>
            </h1>

            <p class="mt-5 text-lg text-slate-600 leading-relaxed">
              <strong>NEC 110.9</strong> requires every device that interrupts a fault to be rated for what is
              actually available at that point — and at a service, <strong>110.24</strong> requires the figure to
              be field-marked. This tool works it out from the transformer's impedance, then shows how much the
              feeder run sheds on the way to the panel.
            </p>
          </div>
        </div>
      </section>

      <section id="calculator" class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pb-12">
        <div class="mx-auto max-w-5xl rounded-2xl border border-slate-200 bg-white p-6 sm:p-8 shadow-sm">
          <h2 class="text-xl font-bold text-slate-900 flex items-center gap-2">
            <svg class="h-5 w-5 text-red-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
            </svg>
            Calculate the available fault current
          </h2>

          <div class="mt-6 lg:grid lg:grid-cols-2 lg:gap-8 lg:items-start">
            <div class="space-y-5">
              <p class="text-sm font-semibold text-slate-800">Source transformer</p>
              <div class="grid sm:grid-cols-2 gap-4">
                <div>
                  <label for="sc-kva" class="text-sm font-medium text-slate-700">Transformer kVA</label>
                  <input
                    id="sc-kva"
                    type="number"
                    min="1"
                    max="3000"
                    step="0.5"
                    value="300"
                    class="mt-2 w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm text-slate-900 focus:border-red-500 focus:ring-2 focus:ring-red-200 outline-none"
                  />
                </div>
                <div>
                  <label for="sc-percent-z" class="text-sm font-medium text-slate-700">Nameplate %Z</label>
                  <input
                    id="sc-percent-z"
                    type="number"
                    min="0.5"
                    max="12"
                    step="0.05"
                    value="3.5"
                    class="mt-2 w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm text-slate-900 focus:border-red-500 focus:ring-2 focus:ring-red-200 outline-none"
                  />
                </div>
                <div>
                  <label for="sc-phase" class="text-sm font-medium text-slate-700">Configuration</label>
                  <select
                    id="sc-phase"
                    class="mt-2 w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm text-slate-900 focus:border-red-500 focus:ring-2 focus:ring-red-200 outline-none"
                  >
                    <option value="1ph">Single-phase</option>
                    <option value="3ph" selected>Three-phase</option>
                  </select>
                </div>
                <div>
                  <label for="sc-volts" class="text-sm font-medium text-slate-700">Secondary voltage</label>
                  <select
                    id="sc-volts"
                    class="mt-2 w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm text-slate-900 focus:border-red-500 focus:ring-2 focus:ring-red-200 outline-none"
                  >
                    <option value="600">600 V</option>
                    <option value="480" selected>480 V</option>
                    <option value="240">240 V</option>
                    <option value="208">208 V</option>
                    <option value="120">120 V</option>
                  </select>
                </div>
                <div class="sm:col-span-2">
                  <label for="sc-tolerance" class="text-sm font-medium text-slate-700">Impedance tolerance</label>
                  <select
                    id="sc-tolerance"
                    class="mt-2 w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm text-slate-900 focus:border-red-500 focus:ring-2 focus:ring-red-200 outline-none"
                  >
                    <option value="yes" selected>Apply −10% worst case (recommended)</option>
                    <option value="no">Use the nameplate value as marked</option>
                  </select>
                </div>
              </div>

              <p class="text-sm font-semibold text-slate-800 border-t border-slate-200 pt-5">Feeder to the panel</p>
              <div class="grid sm:grid-cols-2 gap-4">
                <div>
                  <label for="sc-size" class="text-sm font-medium text-slate-700">Conductor size</label>
                  <select
                    id="sc-size"
                    class="mt-2 w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm text-slate-900 focus:border-red-500 focus:ring-2 focus:ring-red-200 outline-none"
                  >
                    {conductorOptions.map((label) => (
                      <option value={label} selected={label === "4/0"}>
                        {label.includes("kcmil") ? label : `${label} AWG`}
                      </option>
                    ))}
                  </select>
                </div>
                <div>
                  <label for="sc-material" class="text-sm font-medium text-slate-700">Material</label>
                  <select
                    id="sc-material"
                    class="mt-2 w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm text-slate-900 focus:border-red-500 focus:ring-2 focus:ring-red-200 outline-none"
                  >
                    <option value="copper" selected>Copper</option>
                    <option value="aluminum">Aluminum</option>
                  </select>
                </div>
                <div>
                  <label for="sc-raceway" class="text-sm font-medium text-slate-700">Raceway</label>
                  <select
                    id="sc-raceway"
                    class="mt-2 w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm text-slate-900 focus:border-red-500 focus:ring-2 focus:ring-red-200 outline-none"
                  >
                    <option value="steel" selected>Steel (EMT, RMC)</option>
                    <option value="nonmagnetic">PVC or aluminum</option>
                  </select>
                </div>
                <div>
                  <label for="sc-sets" class="text-sm font-medium text-slate-700">Parallel sets</label>
                  <select
                    id="sc-sets"
                    class="mt-2 w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm text-slate-900 focus:border-red-500 focus:ring-2 focus:ring-red-200 outline-none"
                  >
                    <option value="1" selected>1</option>
                    <option value="2">2</option>
                    <option value="3">3</option>
                    <option value="4">4</option>
                  </select>
                </div>
              </div>

              <div>
                <div class="flex items-center justify-between">
                  <label for="sc-length" class="text-sm font-semibold text-slate-800">Feeder length</label>
                  <div class="flex items-center gap-1">
                    <input
                      id="sc-length"
                      type="number"
                      min="0"
                      max="1000"
                      value="100"
                      class="w-20 rounded-lg border border-slate-300 px-3 py-1.5 text-right text-sm font-semibold text-slate-900 focus:border-red-500 focus:ring-2 focus:ring-red-200 outline-none"
                    />
                    <span class="text-sm text-slate-500">ft</span>
                  </div>
                </div>
                <input
                  id="sc-length-range"
                  type="range"
                  min="0"
                  max="1000"
                  step="10"
                  value="100"
                  class="elec-range mt-3 w-full bg-slate-200 accent-red-600"
                />
                <div class="flex justify-between text-xs text-slate-400 mt-1">
                  <span>0 ft</span><span>1,000 ft</span>
                </div>
              </div>

              <button
                id="sc-reset"
                type="button"
                class="text-sm font-medium text-slate-500 hover:text-red-600 transition flex items-center gap-1.5"
              >
                <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"
                  ></path>
                </svg>
                Reset to defaults
              </button>
            </div>

            <div class="mt-6 lg:mt-0 rounded-xl border border-red-100 bg-red-50 p-5 sm:p-6">
              <p class="text-sm font-medium text-slate-600">Fault current at the panel</p>
              <div class="mt-2 flex items-baseline gap-2">
                <span id="sc-at-panel" class="text-5xl font-extrabold tracking-tight text-red-600">8,626 A</span>
              </div>
              <p class="mt-1 text-sm font-semibold text-slate-700">Symmetrical RMS, infinite primary source</p>

              <div class="mt-6 grid grid-cols-2 gap-3">
                <div class="rounded-xl border border-red-100 bg-white p-4">
                  <p class="text-xs text-slate-500">At the transformer</p>
                  <p id="sc-at-transformer" class="mt-1 text-2xl font-bold text-slate-900">11,455 A</p>
                </div>
                <div class="rounded-xl border border-red-100 bg-white p-4">
                  <p class="text-xs text-slate-500">AIC there</p>
                  <p id="sc-aic-transformer" class="mt-1 text-2xl font-bold text-slate-900">22,000 A</p>
                </div>
                <div class="col-span-2 rounded-xl border border-red-200 bg-white p-4">
                  <p class="text-xs text-slate-500">Minimum interrupting rating at the panel</p>
                  <p id="sc-aic-panel" class="mt-1 text-2xl font-bold text-slate-900">10,000 A</p>
                </div>
              </div>

              <details class="group mt-5 rounded-xl border border-red-100 bg-white">
                <summary
                  class="flex items-center justify-between cursor-pointer px-4 py-3 text-sm font-semibold text-slate-800"
                >
                  See the breakdown
                  <svg
                    class="h-4 w-4 text-slate-500 transition-transform group-open:rotate-180"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    viewBox="0 0 24 24"
                  >
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"></path>
                  </svg>
                </summary>
                <div class="px-4 pb-4 text-sm space-y-1.5 text-slate-600">
                  <div class="flex justify-between gap-3">
                    <span>Secondary FLA</span><span id="sc-bd-fla" class="font-semibold text-slate-900">—</span>
                  </div>
                  <div class="flex justify-between gap-3">
                    <span>Effective %Z</span><span id="sc-bd-z" class="font-semibold text-slate-900">—</span>
                  </div>
                  <div class="flex justify-between gap-3">
                    <span>At the secondary</span><span id="sc-bd-secondary" class="font-semibold text-slate-900">—</span>
                  </div>
                  <div class="flex justify-between gap-3">
                    <span>Run impedance</span><span id="sc-bd-run-z" class="font-semibold text-slate-900">—</span>
                  </div>
                  <div class="flex justify-between gap-3">
                    <span>Source impedance</span><span id="sc-bd-source-z" class="font-semibold text-slate-900">—</span>
                  </div>
                  <div class="flex justify-between gap-3">
                    <span>f factor</span><span id="sc-bd-f" class="font-semibold text-slate-900">—</span>
                  </div>
                  <div class="flex justify-between gap-3">
                    <span>Multiplier M</span><span id="sc-bd-multiplier" class="font-semibold text-slate-900">—</span>
                  </div>
                  <div class="flex justify-between gap-3 border-t border-slate-200 pt-1.5 mt-1.5">
                    <span class="font-bold">At the panel</span><span id="sc-bd-fault" class="font-bold text-slate-900">—</span>
                  </div>
                </div>
              </details>

              <p id="sc-note" class="mt-4 text-xs text-slate-500 leading-relaxed">
                The run sheds 25% of the fault current, dropping the requirement from a 22,000 A device at the
                transformer to 10,000 A at the panel.
              </p>
            </div>
          </div>
        </div>
      </section>

      <section class="bg-slate-50 border-y border-slate-200">
        <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-14">
          <h2 class="text-3xl font-extrabold tracking-tight text-slate-900">
            The method, explained in plain English
          </h2>

          <div
            class="mt-8 rounded-2xl bg-slate-900 p-6 sm:p-8 text-slate-100 font-mono text-sm leading-relaxed overflow-x-auto"
          >
            <div class="text-cyan-300"># Step 1 — at the transformer secondary</div>
            <div>FLA&nbsp;=&nbsp;kVA&nbsp;×&nbsp;1000&nbsp;÷&nbsp;(V&nbsp;×&nbsp;1.732&nbsp;on&nbsp;three-phase)</div>
            <div>I_sc&nbsp;=&nbsp;FLA&nbsp;÷&nbsp;(%Z&nbsp;÷&nbsp;100)&nbsp;&nbsp;&nbsp;&nbsp;# ×0.90 on %Z for the worst case</div>
            <div class="mt-4 text-cyan-300"># Step 2 — down the run</div>
            <div>Z_source&nbsp;=&nbsp;V_driving&nbsp;÷&nbsp;I_sc&nbsp;&nbsp;&nbsp;&nbsp;# implied by the upstream current</div>
            <div>Z_run&nbsp;&nbsp;&nbsp;=&nbsp;√(R²&nbsp;+&nbsp;X²)&nbsp;&nbsp;&nbsp;&nbsp;# Chapter 9, Tables 8 and 9</div>
            <div>f&nbsp;=&nbsp;Z_run&nbsp;÷&nbsp;Z_source&nbsp;&nbsp;·&nbsp;&nbsp;M&nbsp;=&nbsp;<span class="text-red-300">1 ÷ (1 + f)</span></div>
            <div class="mt-4 text-cyan-300"># Step 3 — the code check</div>
            <div>device&nbsp;interrupting&nbsp;rating&nbsp;≥&nbsp;available&nbsp;fault&nbsp;current&nbsp;&nbsp;&nbsp;# 110.9</div>
          </div>

          <div class="mt-8 grid sm:grid-cols-2 gap-4">
            <div class="rounded-xl border border-slate-200 bg-white p-5">
              <h3 class="font-bold text-slate-900">Infinite primary is the safe assumption</h3>
              <p class="mt-2 text-sm text-slate-600">
                Including the real utility impedance always lowers the answer. If the equipment passes on the
                infinite-source figure, it passes for real.
              </p>
            </div>
            <div class="rounded-xl border border-slate-200 bg-white p-5">
              <h3 class="font-bold text-slate-900">Low impedance is the worst case</h3>
              <p class="mt-2 text-sm text-slate-600">
                Nameplate %Z carries about ±10% tolerance, and the low-impedance unit produces more fault current.
                For an AIC check, use the low end.
              </p>
            </div>
            <div class="rounded-xl border border-slate-200 bg-white p-5">
              <h3 class="font-bold text-slate-900">Length is your friend here</h3>
              <p class="mt-2 text-sm text-slate-600">
                Fault current is highest at the service and falls steadily downstream. The equipment nearest the
                transformer needs the highest rating.
              </p>
            </div>
            <div class="rounded-xl border border-slate-200 bg-white p-5">
              <h3 class="font-bold text-slate-900">Series ratings are exact combinations</h3>
              <p class="mt-2 text-sm text-slate-600">
                240.86 permits a tested upstream device to protect a lower-rated one — only in the listed pairing,
                and it has to be field-marked.
              </p>
            </div>
          </div>
        </div>
      </section>

      <section class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 py-14">
        <h2 class="text-3xl font-extrabold tracking-tight text-slate-900">Worked examples</h2>
        <p class="mt-4 text-slate-600">The same 300 kVA transformer, at three distances.</p>

        <div class="mt-8 space-y-6">
          <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
            <div class="flex items-center gap-3">
              <span class="flex h-9 w-9 items-center justify-center rounded-full bg-red-100 text-red-700 font-bold">1</span>
              <h3 class="text-lg font-bold text-slate-900">At the secondary terminals</h3>
            </div>
            <div class="mt-4 rounded-xl bg-slate-50 p-4 font-mono text-sm text-slate-700">
              FLA = 300,000 ÷ (1.732 × 480) = 360.8 A<br />
              %Z = 3.5 × 0.90 = 3.15%<br />
              I_sc = 360.8 ÷ 0.0315 = <span class="font-bold text-red-700">11,455 A</span> → needs 22 kA
            </div>
            <p class="mt-3 text-sm text-slate-600">
              <span class="font-semibold text-slate-900">Result:</span> a 10 kA residential loadcenter would be
              unsafe bolted straight to this transformer. Main switchgear here needs a 22 kA rating.
            </p>
          </div>

          <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
            <div class="flex items-center gap-3">
              <span class="flex h-9 w-9 items-center justify-center rounded-full bg-red-100 text-red-700 font-bold">2</span>
              <h3 class="text-lg font-bold text-slate-900">100 ft of 4/0 copper away — the defaults</h3>
            </div>
            <div class="mt-4 rounded-xl bg-slate-50 p-4 font-mono text-sm text-slate-700">
              Z_run = √(0.00608² + 0.00510²) = 0.00794 Ω<br />
              Z_source = (480 ÷ 1.732) ÷ 11,455 = 0.02419 Ω<br />
              f = 0.3280 · M = 0.7530 → <span class="font-bold text-red-700">8,626 A</span> → 10 kA is adequate
            </div>
            <p class="mt-3 text-sm text-slate-600">
              <span class="font-semibold text-slate-900">Result:</span> 100 ft of conductor sheds 25% of the fault
              current — enough to move the panel from a 22 kA requirement into 10 kA equipment.
            </p>
          </div>

          <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
            <div class="flex items-center gap-3">
              <span class="flex h-9 w-9 items-center justify-center rounded-full bg-red-100 text-red-700 font-bold">3</span>
              <h3 class="text-lg font-bold text-slate-900">400 ft away</h3>
            </div>
            <div class="mt-4 rounded-xl bg-slate-50 p-4 font-mono text-sm text-slate-700">
              M = 0.433 → <span class="font-bold text-red-700">4,954 A</span>
            </div>
            <p class="mt-3 text-sm text-slate-600">
              <span class="font-semibold text-slate-900">Result:</span> less than half the current at the
              transformer. The trade-off is that the same impedance causing this reduction is also causing voltage
              drop — which is why long feeders get sized on drop, not ampacity.
            </p>
          </div>
        </div>
      </section>

      <section class="bg-slate-50 border-y border-slate-200">
        <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-14">
          <h2 class="text-3xl font-extrabold tracking-tight text-slate-900">
            Fault current at the secondary, by transformer size
          </h2>
          <p class="mt-4 text-slate-600 leading-relaxed">
            480 V three-phase, typical impedance with the −10% tolerance applied, computed with the same helpers
            the calculator uses. Always use the nameplate impedance for real work.
          </p>

          <div class="mt-8 overflow-x-auto rounded-2xl border border-slate-200 bg-white shadow-sm">
            <table class="w-full text-left text-sm">
              <thead>
                <tr class="border-b border-slate-200 text-slate-500 bg-slate-50">
                  <th class="py-3 px-5 font-semibold">kVA</th>
                  <th class="py-3 px-4 font-semibold">Typical %Z</th>
                  <th class="py-3 px-4 font-semibold">Secondary FLA</th>
                  <th class="py-3 px-4 font-semibold">Fault current</th>
                  <th class="py-3 px-4 font-semibold">Minimum AIC</th>
                </tr>
              </thead>
              <tbody class="text-slate-700">
                {
                  transformerRows.map((row, index) => (
                    <tr class={index === transformerRows.length - 1 ? "" : "border-b border-slate-100"}>
                      <td class="py-3 px-5 font-semibold text-slate-900">{row.kva}</td>
                      <td class="py-3 px-4">{row.percentZ}%</td>
                      <td class="py-3 px-4">{fmtInt(row.fla)} A</td>
                      <td class="py-3 px-4 font-semibold text-slate-900">{fmtInt(row.faultCurrent)} A</td>
                      <td class="py-3 px-4">{row.aic ? `${fmtInt(row.aic)} A` : "over 200 kA"}</td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>

          <p class="mt-6 text-sm text-slate-500">
            Sources &amp; standards: NEC (NFPA 70) 2023 — <strong>110.9</strong> (interrupting rating),
            <strong>110.10</strong> (circuit impedance and other characteristics), <strong>110.24</strong>
            (field marking of available fault current at a service), <strong>240.86</strong> (series ratings), and
            <strong>Chapter 9 Tables 8 and 9</strong> for conductor resistance and reactance. This is a planning
            tool for one transformer and one run using the point-to-point method with an infinite primary source;
            it is not a coordination or arc-flash study, and it does not model motor contribution or asymmetrical
            peak current. Where equipment ratings are marginal or arc-flash labelling is required, engage a
            licensed engineer. Local amendments override the model code, and the AHJ has final say.
          </p>
        </div>
      </section>

      <CalculatorFaqSection
        faqs={faqs}
        accent="red"
        subtitle="Common questions about available fault current and interrupting ratings."
      />

      <CalculatorTradesQuoteCta heading={ctaHeading} description={ctaDescription} />

      <RelatedCalculators calculators={relatedCalculators} styles={styles} heading="More electrical calculators" />
    </main>

    <Footer />
  </div>

