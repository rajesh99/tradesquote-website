---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import RelatedCalculators from "@/components/RelatedCalculators.astro";
import CalculatorBreadcrumb from "@/components/CalculatorBreadcrumb.astro";
import CalculatorFaqSection from "@/components/CalculatorFaqSection.astro";
import CalculatorTradesQuoteCta from "@/components/CalculatorTradesQuoteCta.astro";
import { buildFaqPageSchema, type CalculatorFaq } from "@/lib/calculatorFaq";
import { electricalAccentStyles } from "@/config/electricalCalculators";
import { fmtInt } from "@/lib/nec";

const title = "Recessed Lighting Calculator — How Many Can Lights | TradesQuote";
const description =
  "Free recessed lighting calculator. Get the can count and spacing for any room, worked two ways — the ceiling-height spacing rule and the lumens the room actually needs for its use.";

const pageUrl = "https://www.tradesquote.ai/calculators/electrical/electrical-recessed-lighting-calculator";

const breadcrumbData = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: "https://www.tradesquote.ai/" },
    { "@type": "ListItem", position: 2, name: "Calculators", item: "https://www.tradesquote.ai/calculators" },
    { "@type": "ListItem", position: 3, name: "Electrical", item: "https://www.tradesquote.ai/calculators/electrical" },
    { "@type": "ListItem", position: 4, name: "Recessed Lighting Calculator", item: pageUrl },
  ],
};

const webAppData = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: "Recessed Lighting Calculator",
  url: pageUrl,
  applicationCategory: "BusinessApplication",
  operatingSystem: "Any (web-based)",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  description:
    "Free online recessed lighting calculator returning fixture count, grid layout, and spacing from room dimensions, ceiling height, fixture lumens, and a target light level in footcandles.",
};

const faqs: CalculatorFaq[] = [
  {
    question: "How many recessed lights do I need?",
    answer:
      "Two calculations, and you take the larger. The <strong>spacing rule</strong> puts fixtures roughly <strong>ceiling height ÷ 2</strong> apart — 4 ft on an 8 ft ceiling — which on a 16 × 12 ft room gives a 4 × 3 grid, or 12 cans. The <strong>light-level check</strong> multiplies area by target footcandles and divides by lumens per fixture: 192 ft² × 40 fc = 7,680 lm ÷ 650 lm = 12 fixtures. When both agree, as here, the layout is straightforward.",
  },
  {
    question: "How far apart should recessed lights be?",
    answer:
      "Take half the ceiling height as the spacing between fixtures, and half of that again as the distance from the wall. On an 8 ft ceiling that is <strong>4 ft apart and 2 ft off the wall</strong>; on a 10 ft ceiling, 5 ft apart and 2.5 ft off. Setting the perimeter row too close to the wall is the most common layout error — it puts scallops on the wall and leaves the middle of the room dim.",
  },
  {
    question: "How many footcandles does a room need?",
    answer:
      "It depends on the task. Roughly: <strong>hallways and closets 10</strong>, <strong>living and bedrooms 20</strong>, <strong>bathrooms 30</strong>, and <strong>kitchens, offices, and workshops 40</strong>. These are general-illumination targets — a kitchen still wants separate under-cabinet lighting for the counter, and a workshop wants task lighting at the bench regardless of how good the ceiling grid is.",
  },
  {
    question: "How many lumens is a recessed light?",
    answer:
      "A common 4-inch LED trim delivers around <strong>600–700 lumens</strong> and a 6-inch around <strong>800–1,100</strong>. Use the figure on the box rather than the wattage — LED wattage tells you consumption, not output, and it varies widely between products. Note the trim's <strong>beam angle</strong> too: a narrow spot puts the same lumens over a much smaller area than a wide flood.",
  },
  {
    question: "Can I put recessed lights in contact with insulation?",
    answer:
      "Only if they are rated for it. A fixture marked <strong>IC-rated</strong> may be covered by insulation; a non-IC fixture requires clearance — typically 3 inches — and covering it is a genuine fire hazard. In an insulated ceiling you also want an airtight (AT) rating to stop conditioned air leaking into the attic. Modern LED canless fixtures are usually IC-rated and airtight, which is much of their appeal.",
  },
  {
    question: "How many recessed lights on one circuit?",
    answer:
      'Far more than you would expect with LEDs. A 15-amp, 120-volt circuit at the 80% continuous limit gives 1,440 VA of usable capacity; at 12 W per LED trim that is over a hundred fixtures, so the practical limit is the switch and dimmer rating rather than the circuit. Confirm the count against the circuit with the <a href="/calculators/electrical/electrical-receptacle-circuit-calculator" class="font-semibold text-amber-700 underline decoration-amber-300 hover:decoration-amber-600">Receptacle &amp; Circuit Calculator</a>, and check the dimmer is rated for the total load and for LED drivers.',
  },
  {
    question: "Should recessed lights be centred on the room or on the furniture?",
    answer:
      "Centre the <em>grid</em> on the room so the spacing reads evenly, then adjust individual fixtures for what is below them. Common adjustments: pull the row over a kitchen island so it lights the work surface rather than the walkway, and keep cans out of the arc of a door swing or a cabinet front where they would only light the doors.",
  },
];
const faqData = buildFaqPageSchema(faqs);

const ctaHeading = "Layout set? Quote the lighting in seconds.";
const ctaDescription =
  "Lighting jobs are quantity-heavy — trims, drivers, boxes, switches, dimmers, and labor per fixture. TradesQuote turns the layout into a detailed line-item estimate with quantities and totals, validated by a built-in quality control agent.";

const relatedCalculators = [
  {
    href: "/calculators/electrical/electrical-receptacle-circuit-calculator",
    title: "Receptacle & Circuit Calculator",
    description: "How many fixtures or outlets fit one circuit.",
  },
  {
    href: "/calculators/electrical/electrical-kwh-cost-calculator",
    title: "kWh Cost Calculator",
    description: "What the new lighting costs to run.",
  },
  {
    href: "/calculators/electrical/electrical-breaker-size-calculator",
    title: "Breaker Size Calculator",
    description: "Match the OCPD to the lighting load.",
  },
  {
    href: "/calculators/electrical/electrical-estimate-calculator",
    title: "Estimate Calculator",
    description: "Price the job with overhead and margin.",
  },
];

/** Target light levels by room use, with the lumens a 192 ft² room would need at each. */
const REFERENCE_AREA = 192;
const FIXTURE_LM = 650;
const roomRows = [
  { room: "Hallway, closet", fc: 10 },
  { room: "Living room, bedroom", fc: 20 },
  { room: "Dining room", fc: 25 },
  { room: "Bathroom", fc: 30 },
  { room: "Kitchen, office", fc: 40 },
  { room: "Workshop, garage", fc: 50 },
].map((r) => {
  const lumens = REFERENCE_AREA * r.fc;
  return { ...r, lumens, fixtures: Math.ceil(lumens / FIXTURE_LM) };
});

const styles = electricalAccentStyles.amber;
---

<Layout {title} {description}>
  <Fragment slot="head">
    <link rel="canonical" href={pageUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Recessed Lighting Calculator — How Many Can Lights" />
    <meta
      property="og:description"
      content="Can count and spacing for any room, worked by the ceiling-height rule and by the lumens the room actually needs."
    />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:site_name" content="TradesQuote" />
    <meta property="og:image" content="https://www.tradesquote.ai/logo.svg" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Recessed Lighting Calculator" />
    <meta name="twitter:description" content="How many can lights, and how far apart. Free and instant." />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbData)} />
    <script type="application/ld+json" set:html={JSON.stringify(webAppData)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqData)} />
  </Fragment>

  <div class="bg-white min-h-screen text-slate-700">
    <Header />

    <main>
      <section class="relative overflow-hidden bg-gradient-to-b from-slate-50 to-white">
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pt-10 pb-6">
          <CalculatorBreadcrumb
            category="Electrical"
            categoryHref="/calculators/electrical"
            current="Recessed Lighting Calculator"
          />

          <div class="max-w-3xl">
            <span
              class="inline-flex items-center gap-1.5 rounded-full bg-amber-100 px-3 py-1 text-xs font-semibold text-amber-700"
            >
              <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 18h6M10 22h4M15.09 14c.18-.98.65-1.74 1.41-2.5A4.65 4.65 0 0018 8 6 6 0 006 8c0 1 .23 2.23 1.5 3.5A4.61 4.61 0 018.91 14" />
              </svg>
              Electrical Tools · Free
            </span>

            <h1 class="mt-4 text-4xl sm:text-5xl font-extrabold tracking-tight text-slate-900">
              Recessed Lighting Calculator <span class="text-amber-600">— Count &amp; Spacing</span>
            </h1>

            <p class="mt-5 text-lg text-slate-600 leading-relaxed">
              There are two ways to answer "how many cans?" — the <strong>spacing rule</strong>, which gives even
              coverage, and the <strong>light level</strong> the room's use actually calls for. Good layouts
              satisfy both. This tool runs each one and tells you which is driving the count.
            </p>
          </div>
        </div>
      </section>

      <section id="calculator" class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pb-12">
        <div class="mx-auto max-w-5xl rounded-2xl border border-slate-200 bg-white p-6 sm:p-8 shadow-sm">
          <h2 class="text-xl font-bold text-slate-900 flex items-center gap-2">
            <svg class="h-5 w-5 text-amber-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M9 18h6M10 22h4M15.09 14c.18-.98.65-1.74 1.41-2.5A4.65 4.65 0 0018 8 6 6 0 006 8c0 1 .23 2.23 1.5 3.5A4.61 4.61 0 018.91 14"
              ></path>
            </svg>
            Lay out the room
          </h2>

          <div class="mt-6 lg:grid lg:grid-cols-2 lg:gap-8 lg:items-start">
            <div class="space-y-6">
              <div class="grid sm:grid-cols-2 gap-4">
                <div>
                  <label for="rl-length" class="text-sm font-semibold text-slate-800">Room length (ft)</label>
                  <input
                    id="rl-length"
                    type="number"
                    min="1"
                    max="80"
                    step="0.5"
                    value="16"
                    class="mt-2 w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm text-slate-900 focus:border-amber-500 focus:ring-2 focus:ring-amber-200 outline-none"
                  />
                </div>
                <div>
                  <label for="rl-width" class="text-sm font-semibold text-slate-800">Room width (ft)</label>
                  <input
                    id="rl-width"
                    type="number"
                    min="1"
                    max="80"
                    step="0.5"
                    value="12"
                    class="mt-2 w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm text-slate-900 focus:border-amber-500 focus:ring-2 focus:ring-amber-200 outline-none"
                  />
                </div>
              </div>

              <div>
                <div class="flex items-center justify-between">
                  <label for="rl-ceiling" class="text-sm font-semibold text-slate-800">Ceiling height</label>
                  <div class="flex items-center gap-1">
                    <input
                      id="rl-ceiling"
                      type="number"
                      min="6"
                      max="20"
                      step="0.5"
                      value="8"
                      class="w-20 rounded-lg border border-slate-300 px-3 py-1.5 text-right text-sm font-semibold text-slate-900 focus:border-amber-500 focus:ring-2 focus:ring-amber-200 outline-none"
                    />
                    <span class="text-sm text-slate-500">ft</span>
                  </div>
                </div>
                <input
                  id="rl-ceiling-range"
                  type="range"
                  min="6"
                  max="20"
                  step="0.5"
                  value="8"
                  class="elec-range mt-3 w-full bg-slate-200 accent-amber-600"
                />
                <div class="flex justify-between text-xs text-slate-400 mt-1">
                  <span>6 ft</span><span>20 ft</span>
                </div>
              </div>

              <div class="grid sm:grid-cols-2 gap-4">
                <div>
                  <label for="rl-lumens" class="text-sm font-semibold text-slate-800">Lumens per fixture</label>
                  <input
                    id="rl-lumens"
                    type="number"
                    min="100"
                    max="5000"
                    step="10"
                    value="650"
                    class="mt-2 w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm text-slate-900 focus:border-amber-500 focus:ring-2 focus:ring-amber-200 outline-none"
                  />
                </div>
                <div>
                  <label for="rl-target" class="text-sm font-semibold text-slate-800">Room use</label>
                  <select
                    id="rl-target"
                    class="mt-2 w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm text-slate-900 focus:border-amber-500 focus:ring-2 focus:ring-amber-200 outline-none"
                  >
                    <option value="10">Hallway, closet — 10 fc</option>
                    <option value="20">Living, bedroom — 20 fc</option>
                    <option value="25">Dining — 25 fc</option>
                    <option value="30">Bathroom — 30 fc</option>
                    <option value="40" selected>Kitchen, office — 40 fc</option>
                    <option value="50">Workshop — 50 fc</option>
                  </select>
                </div>
              </div>

              <p class="text-xs text-slate-500">
                Use the lumen figure on the box, not the wattage — LED wattage tells you consumption, not output.
                A 4-inch trim is typically 600–700 lm, a 6-inch 800–1,100 lm.
              </p>

              <button
                id="rl-reset"
                type="button"
                class="text-sm font-medium text-slate-500 hover:text-amber-600 transition flex items-center gap-1.5"
              >
                <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"
                  ></path>
                </svg>
                Reset to defaults
              </button>
            </div>

            <div class="mt-6 lg:mt-0 rounded-xl border border-amber-100 bg-amber-50 p-5 sm:p-6">
              <p class="text-sm font-medium text-slate-600">Fixtures needed</p>
              <div class="mt-2 flex items-baseline gap-2">
                <span id="rl-count" class="text-5xl font-extrabold tracking-tight text-amber-600">12</span>
                <span id="rl-layout" class="text-lg font-semibold text-slate-700">4 × 3 grid</span>
              </div>

              <div class="mt-6 grid grid-cols-2 gap-3">
                <div class="rounded-xl border border-amber-100 bg-white p-4">
                  <p class="text-xs text-slate-500">Spacing</p>
                  <p id="rl-spacing" class="mt-1 text-2xl font-bold text-slate-900">4.0 ft</p>
                </div>
                <div class="rounded-xl border border-amber-100 bg-white p-4">
                  <p class="text-xs text-slate-500">By light level</p>
                  <p id="rl-lumen-count" class="mt-1 text-2xl font-bold text-slate-900">12</p>
                </div>
              </div>

              <details class="group mt-5 rounded-xl border border-amber-100 bg-white">
                <summary
                  class="flex items-center justify-between cursor-pointer px-4 py-3 text-sm font-semibold text-slate-800"
                >
                  See the breakdown
                  <svg
                    class="h-4 w-4 text-slate-500 transition-transform group-open:rotate-180"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    viewBox="0 0 24 24"
                  >
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"></path>
                  </svg>
                </summary>
                <div class="px-4 pb-4 text-sm space-y-1.5 text-slate-600">
                  <div class="flex justify-between gap-3">
                    <span>Room area</span><span id="rl-bd-area" class="font-semibold text-slate-900">—</span>
                  </div>
                  <div class="flex justify-between gap-3">
                    <span>Spacing rule</span><span id="rl-bd-spacing" class="font-semibold text-slate-900">—</span>
                  </div>
                  <div class="flex justify-between gap-3">
                    <span>Grid</span><span id="rl-bd-grid" class="font-semibold text-slate-900">—</span>
                  </div>
                  <div class="flex justify-between gap-3">
                    <span>Lumens needed</span><span id="rl-bd-needed" class="font-semibold text-slate-900">—</span>
                  </div>
                  <div class="flex justify-between gap-3">
                    <span>By light level</span><span id="rl-bd-lumen" class="font-semibold text-slate-900">—</span>
                  </div>
                  <div class="flex justify-between gap-3 border-t border-slate-200 pt-1.5 mt-1.5">
                    <span class="font-bold">Delivered</span><span id="rl-bd-delivered" class="font-bold text-slate-900">—</span>
                  </div>
                </div>
              </details>

              <p id="rl-note" class="mt-4 text-xs text-slate-500 leading-relaxed">
                Both methods agree at 12 fixtures — a 4 × 3 grid at 4.0 ft spacing delivers 7,800 lumens.
              </p>
            </div>
          </div>
        </div>
      </section>

      <section class="bg-slate-50 border-y border-slate-200">
        <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-14">
          <h2 class="text-3xl font-extrabold tracking-tight text-slate-900">
            The method, explained in plain English
          </h2>

          <div
            class="mt-8 rounded-2xl bg-slate-900 p-6 sm:p-8 text-slate-100 font-mono text-sm leading-relaxed overflow-x-auto"
          >
            <div class="text-cyan-300"># Method 1 — spacing, for even coverage</div>
            <div>spacing&nbsp;=&nbsp;ceiling height ÷ <span class="text-amber-300">2</span></div>
            <div>grid&nbsp;=&nbsp;round(length ÷ spacing) × round(width ÷ spacing)</div>
            <div>wall offset&nbsp;=&nbsp;spacing ÷ 2</div>
            <div class="mt-4 text-cyan-300"># Method 2 — light level, for the task</div>
            <div>lumens needed&nbsp;=&nbsp;area × target footcandles</div>
            <div>count&nbsp;=&nbsp;lumens needed ÷ lumens per fixture</div>
            <div class="mt-4 text-cyan-300"># Take the larger, then adjust to the room</div>
          </div>

          <div class="mt-8 grid sm:grid-cols-2 gap-4">
            <div class="rounded-xl border border-slate-200 bg-white p-5">
              <h3 class="font-bold text-slate-900">Half the ceiling height</h3>
              <p class="mt-2 text-sm text-slate-600">
                The spacing rule scales with ceiling height because a higher fixture throws light over a wider
                area. A 10 ft ceiling wants 5 ft spacing, not 4.
              </p>
            </div>
            <div class="rounded-xl border border-slate-200 bg-white p-5">
              <h3 class="font-bold text-slate-900">Keep off the walls</h3>
              <p class="mt-2 text-sm text-slate-600">
                Set the perimeter row half a spacing in — 2 ft on an 8 ft ceiling. Too close and you get scallops
                on the wall and a dim middle.
              </p>
            </div>
            <div class="rounded-xl border border-slate-200 bg-white p-5">
              <h3 class="font-bold text-slate-900">Lumens, not watts</h3>
              <p class="mt-2 text-sm text-slate-600">
                LED wattage says nothing consistent about output. Two 12 W trims can differ by 300 lumens. Read
                the lumen figure off the box.
              </p>
            </div>
            <div class="rounded-xl border border-slate-200 bg-white p-5">
              <h3 class="font-bold text-slate-900">General light isn't task light</h3>
              <p class="mt-2 text-sm text-slate-600">
                A perfect ceiling grid still leaves a kitchen counter in your own shadow. Under-cabinet and bench
                lighting are separate line items.
              </p>
            </div>
          </div>
        </div>
      </section>

      <section class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 py-14">
        <h2 class="text-3xl font-extrabold tracking-tight text-slate-900">Worked examples</h2>
        <p class="mt-4 text-slate-600">
          The same 16 × 12 ft room in three different uses — and one with a taller ceiling.
        </p>

        <div class="mt-8 space-y-6">
          <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
            <div class="flex items-center gap-3">
              <span class="flex h-9 w-9 items-center justify-center rounded-full bg-amber-100 text-amber-700 font-bold">1</span>
              <h3 class="text-lg font-bold text-slate-900">Kitchen, 8 ft ceiling — both methods agree</h3>
            </div>
            <p class="mt-3 text-sm text-slate-600">The defaults above. 192 ft², 40 fc target, 650 lm trims.</p>
            <div class="mt-4 rounded-xl bg-slate-50 p-4 font-mono text-sm text-slate-700">
              spacing: 8 ÷ 2 = 4 ft → 4 × 3 = 12 fixtures<br />
              light level: 192 × 40 = 7,680 lm ÷ 650 = 11.8 → 12 fixtures<br />
              <span class="font-bold text-amber-700">12 cans</span>, 4 ft apart, 2 ft off the walls
            </div>
            <p class="mt-3 text-sm text-slate-600">
              <span class="font-semibold text-slate-900">Result:</span> the ideal case — even spacing and the right
              light level are the same answer. Add under-cabinet lighting separately for the counter.
            </p>
          </div>

          <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
            <div class="flex items-center gap-3">
              <span class="flex h-9 w-9 items-center justify-center rounded-full bg-amber-100 text-amber-700 font-bold">2</span>
              <h3 class="text-lg font-bold text-slate-900">Same room as a living room — spacing governs</h3>
            </div>
            <p class="mt-3 text-sm text-slate-600">Switch the room use to 20 fc; nothing else changes.</p>
            <div class="mt-4 rounded-xl bg-slate-50 p-4 font-mono text-sm text-slate-700">
              spacing: still 4 × 3 = 12 fixtures<br />
              light level: 192 × 20 = 3,840 lm ÷ 650 = 5.9 → 6 fixtures<br />
              take the larger → <span class="font-bold text-amber-700">12 cans</span> on a dimmer
            </div>
            <p class="mt-3 text-sm text-slate-600">
              <span class="font-semibold text-slate-900">Result:</span> keep the even grid and dim it. Six cans
              would hit the target light level but leave visible dark patches between them.
            </p>
          </div>

          <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
            <div class="flex items-center gap-3">
              <span class="flex h-9 w-9 items-center justify-center rounded-full bg-amber-100 text-amber-700 font-bold">3</span>
              <h3 class="text-lg font-bold text-slate-900">Kitchen with a 10 ft ceiling — light level governs</h3>
            </div>
            <p class="mt-3 text-sm text-slate-600">Higher ceiling, so wider spacing and fewer grid positions.</p>
            <div class="mt-4 rounded-xl bg-slate-50 p-4 font-mono text-sm text-slate-700">
              spacing: 10 ÷ 2 = 5 ft → 3 × 2 = 6 fixtures<br />
              light level: 192 × 40 = 7,680 lm ÷ 650 = 11.8 → 12 fixtures<br />
              take the larger → <span class="font-bold text-amber-700">12 cans</span>, or 6 brighter ones
            </div>
            <p class="mt-3 text-sm text-slate-600">
              <span class="font-semibold text-slate-900">Result:</span> a taller ceiling needs more output, not
              fewer fixtures. Either tighten the grid to 12 or specify 1,300 lm trims and keep 6.
            </p>
          </div>
        </div>
      </section>

      <section class="bg-slate-50 border-y border-slate-200">
