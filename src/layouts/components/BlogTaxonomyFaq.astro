---
import type { TaxonomyFaq } from "@/config/blogTaxonomy";

interface Props {
  faqs: TaxonomyFaq[];
  title: string;
}

const { faqs, title } = Astro.props;
---

{
  faqs.length > 0 && (
    <section class="mt-16 border-t border-border pt-12">
      <div class="mx-auto max-w-3xl">
        <h2 class="mb-3 text-center text-2xl font-semibold text-dark">
          Frequently asked questions
        </h2>
        <p class="mb-8 text-center text-text">
          Common questions about {title} guides on the TradesQuote blog.
        </p>
        <div class="space-y-3">
          {faqs.map((faq) => (
            <details class="group rounded-lg border border-border bg-light/30 p-5">
              <summary class="flex cursor-pointer items-center justify-between font-semibold text-dark">
                {faq.question}
                <span class="ml-3 text-primary transition group-open:rotate-45">+</span>
              </summary>
              <p class="mt-3 text-sm leading-relaxed text-text">{faq.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  )
}
