---
const productLinks = [
  { label: "Home", href: "/#home" },
  { label: "Pricing", href: "/#pricing" },
  { label: "Blog", href: "/blog" },
  { label: "Calculators", href: "/calculators" },
  { label: "Simpro Integration", href: "/simpro-integration" },
  { label: "Jobber Integration", href: "/getjobber-integration" },
  { label: "QuickBooks Integration", href: "/quickbooks-integration" },
  { label: "Xero Integration", href: "/xero-integration" },
  { label: "Zapier Integration", href: "/zapier-integration" },
];

const legalLinks = [
  { label: "About", href: "/about" },
  { label: "FAQ", href: "/#faq" },
  { label: "Contact us", href: "/contact" },
  { label: "Privacy Policy", href: "/privacy-policy" },
  { label: "Terms of Service", href: "/terms-of-service" },
];

const contactItems = [
  {
    type: "email",
    text: "tradesquoteai@veersoftsolutions.com",
    href: "mailto:tradesquoteai@veersoftsolutions.com",
  },
  {
    type: "address",
    lines: ["Veersoft Solutions LLC", "30 N Gould St.Sheridan, Wyoming 82801"],
    href: null,
  },
];

interface SocialLink {
  label: string;
  href: string;
  icon: string;
}
const socialLinks: SocialLink[] = [
  {
    label: "LinkedIn",
    href: "https://www.linkedin.com/company/tradesquote/",
    icon: "linkedin",
  },
  { label: "X", href: "https://x.com/tradesquoteai", icon: "x" },
  {
    label: "Instagram",
    href: "https://www.instagram.com/tradesquoteai/",
    icon: "instagram",
  },
  {
    label: "TikTok",
    href: "https://www.tiktok.com/@tradesquoteai",
    icon: "tiktok",
  },
  {
    label: "YouTube",
    href: "https://www.youtube.com/@TradesQuoteAI",
    icon: "youtube",
  },
  {
    label: "Reddit",
    href: "https://www.reddit.com/user/TradesQuoteAI/",
    icon: "reddit",
  },
  {
    label: "Bluesky",
    href: "https://bsky.app/profile/tradesquoteai.bsky.social",
    icon: "bluesky",
  },
  {
    label: "Tumblr",
    href: "https://www.tumblr.com/tradesquoteai",
    icon: "tumblr",
  },
];
---

<footer
  class="footer flex flex-col items-center w-full bg-[#f7f7fb]"
  role="contentinfo"
>
  <!-- Upper section: four columns -->
  <div
    class="w-full max-w-[1216px] px-6 sm:px-8 lg:px-12 pt-12 sm:pt-16 pb-12 sm:pb-16"
  >
    <div
      class="flex flex-col justify-between sm:flex-row flex-wrap items-start gap-10 sm:gap-12 lg:gap-16"
    >
      <!-- Company: logo + description -->
      <div class="flex flex-col gap-6 min-w-0 max-w-[280px]">
        <a
          href="#home"
          class="inline-flex items-center shrink-0"
          aria-label="Multi Nudge home"
        >
          <img
            src="/tradesquote-logo-hz.svg"
            alt="TradesQuote"
            height="48"
            class="h-14 w-auto"
          />
        </a>
        <p
          class="text-[#4b5563] font-normal text-base leading-6 tracking-normal"
        >
          TradesQuote uses artificial intelligence to generate accurate,
          professional project estimates in seconds.
        </p>
      </div>

      <!-- Product links -->
      <nav
        class="flex flex-col gap-5 min-w-[122px]"
        aria-label="Product navigation"
      >
        <h3
          class="font-semibold text-[#1f2937] text-xl leading-5 tracking-normal"
        >
          Product
        </h3>
        <ul class="flex flex-col gap-4 list-none p-0 m-0">
          {
            productLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-[#4b5563] font-medium text-base leading-6 no-underline hover:text-[#4b44d4] transition-colors"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <!-- Legal links -->
      <nav
        class="flex flex-col gap-5 min-w-[108px]"
        aria-label="Legal navigation"
      >
        <h3
          class="font-semibold text-[#1f2937] text-xl leading-5 tracking-normal"
        >
          Legal
        </h3>
        <ul class="flex flex-col gap-4 list-none p-0 m-0">
          {
            legalLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-[#4b5563] font-medium text-base leading-6 no-underline hover:text-[#4b44d4] transition-colors"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <!-- Contact us -->
      <div class="flex flex-col gap-5 min-w-0 max-w-[260px]">
        <h3
          class="font-semibold text-[#1f2937] text-xl leading-5 tracking-normal"
        >
          Contact us
        </h3>
        <div class="flex flex-col gap-4 not-italic">
          {
            contactItems.map((item) => (
              <div class="flex items-start gap-2">
                <span
                  class="shrink-0 w-4 h-4 mt-0.5 text-[#4b5563]"
                  aria-hidden="true"
                >
                  {item.type === "email" && (
                    <svg
                      width="16"
                      height="16"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <rect x="2" y="4" width="20" height="16" rx="2" />
                      <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
                    </svg>
                  )}
                  {item.type === "phone" && (
                    <svg
                      width="16"
                      height="16"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
                    </svg>
                  )}
                  {item.type === "address" && (
                    <svg
                      width="16"
                      height="16"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" />
                      <circle cx="12" cy="10" r="3" />
                    </svg>
                  )}
                </span>
                {item.href ? (
                  <a
                    href={item.href}
                    class="text-[#4b5563] font-medium text-base leading-[22px] no-underline hover:text-[#4b44d4] transition-colors wrap-break-word"
                  >
                    {item.text}
                  </a>
                ) : item.lines ? (
                  <p class="text-[#4b5563] font-medium text-base leading-[22px] m-0 wrap-break-word">
                    {item.lines[0]}
                    <br />
                    {item.lines[1]}
                  </p>
                ) : null}
              </div>
            ))
          }
        </div>
        <nav
          class="flex flex-wrap items-center gap-3 mt-5"
          aria-label="Social media links"
        >
          {
            socialLinks.map((social) => (
              <a
                href={social.href}
                aria-label={social.label}
                target="_blank"
                rel="noopener noreferrer"
                class="text-[#4b5563] hover:text-[#4b44d4] transition-colors p-1"
              >
                {social.icon === "linkedin" && (
                  <svg
                    class="w-6 h-6"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    aria-hidden="true"
                  >
                    <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
                  </svg>
                )}
                {social.icon === "x" && (
                  <svg
                    class="w-6 h-6"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    aria-hidden="true"
                  >
                    <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
                  </svg>
                )}
                {social.icon === "instagram" && (
                  <svg
                    class="w-6 h-6"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    aria-hidden="true"
                  >
                    <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z" />
                  </svg>
                )}
                {social.icon === "tiktok" && (
                  <svg
                    class="w-6 h-6"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    aria-hidden="true"
                  >
                    <path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z" />
                  </svg>
                )}
                {social.icon === "youtube" && (
                  <svg
                    class="w-6 h-6"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    aria-hidden="true"
                  >
                    <path d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z" />
                  </svg>
                )}
                {social.icon === "reddit" && (
                  <svg
                    class="w-6 h-6"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    aria-hidden="true"
                  >
                    <path d="M12 0A12 12 0 000 12a12 12 0 0012 12 12 12 0 0012-12A12 12 0 0012 0zm5.01 4.744c.688 0 1.25.561 1.25 1.249a1.25 1.25 0 01-2.498.056l-2.573-.99A3.747 3.747 0 0012 6.5c-.738 0-1.41.23-1.972.612l-2.573.99a1.25 1.25 0 01-1.25-1.25c0-.687.562-1.248 1.25-1.248.687 0 1.248.561 1.248 1.249v.011l2.554-.984a3.747 3.747 0 013.486 0l2.554.984V5.993c0-.688.561-1.249 1.249-1.249zM9.5 10.5c.828 0 1.5.672 1.5 1.5s-.672 1.5-1.5 1.5S8 12.828 8 12s.672-1.5 1.5-1.5zm5 0c.828 0 1.5.672 1.5 1.5s-.672 1.5-1.5 1.5-1.5-.672-1.5-1.5.672-1.5 1.5-1.5zm-5.5 4.5c.5 1.5 2 2.5 3.5 2.5s3-1 3.5-2.5c.1-.3-.1-.5-.4-.5H9.4c-.3 0-.5.2-.4.5z" />
                  </svg>
                )}
                {social.icon === "bluesky" && (
                  <svg
                    class="w-6 h-6"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    aria-hidden="true"
                  >
                    <path d="M12 10.8c-1.087-2.114-4.046-6.053-6.798-7.995C2.566.944 1.561 1.266.902 1.565.139 1.908 0 3.08 0 3.795c0 .715.378 5.86 3.775 9.848C6.52 16.98 9.246 18.5 11.048 18.5c.392 0 .595-.168.595-.168s.203.168.595.168c1.802 0 4.528-1.52 7.273-4.857C23.622 9.655 24 4.51 24 3.795c0-.715-.139-1.887-.902-2.23-.659-.299-1.664-.621-4.3 1.24C16.046 4.747 13.087 8.686 12 10.8z" />
                  </svg>
                )}
                {social.icon === "tumblr" && (
                  <svg
                    class="w-6 h-6"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    aria-hidden="true"
                  >
                    <path d="M14.563 24c-5.093 0-7.031-3.756-7.031-6.482V9.747H5.116V6.648c3.63-1.313 4.512-4.596 4.71-6.469C9.84.051 9.941 0 9.999 0h3.517v6.028h4.079v3.719h-4.079v7.43c0 2.183 1.384 2.942 2.279 2.942.414 0 1.038-.075 1.546-.264v3.336c-.521.199-1.755.37-3.778.37z" />
                  </svg>
                )}
              </a>
            ))
          }
        </nav>
      </div>
    </div>
  </div>

  <!-- Lower section: copyright -->
  <div
    class="w-full max-w-[1216px] px-6 sm:px-8 lg:px-12 py-8 sm:py-10 border-t border-[#e5e7eb]"
  >
    <p class="text-[#374151] font-normal text-base leading-6 tracking-normal">
      &copy; {new Date().getFullYear()} Veersoft Solutions LLC. All rights reserved.
    </p>
  </div>
</footer>
