---
/**
 * HVAC-flavoured wrapper around the category-neutral `ExternalResources`.
 * Kept so existing HVAC pages need no changes.
 */
import {
  DEFAULT_HVAC_EXTERNAL_RESOURCES,
  type ExternalResource,
} from "@/config/hvacExternalResources";
import ExternalResources from "@/components/ExternalResources.astro";

export type { ExternalResource };

interface Props {
  heading?: string;
  subheading?: string;
  resources?: ExternalResource[];
}

const {
  heading = "Trusted HVAC Standards & Resources",
  subheading = "The design rules and CFM targets on this page trace back to widely adopted industry standards. These organisations publish the specifications contractors, engineers, and code officials rely on.",
  resources = DEFAULT_HVAC_EXTERNAL_RESOURCES,
} = Astro.props;

const styles = {
  hoverBorder: "hover:border-cyan-300",
  iconBg: "bg-cyan-100",
  iconColor: "text-cyan-700",
  hoverTitle: "group-hover:text-cyan-700",
  hoverIcon: "group-hover:text-cyan-600",
};
---

<ExternalResources {heading} {subheading} {resources} {styles} />
