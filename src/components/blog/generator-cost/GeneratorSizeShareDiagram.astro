---
import { C, FONT } from "../infographicTokens";

/**
 * Fixed installation costs do not scale down with the machine, so the smallest
 * standby is the worst value per kilowatt. The same $5,190 of switch, gas, pad,
 * permit and labour sits under every row.
 */
const FIXED_INSTALL = 1600 + 40 * 28 + 600 + 350 + 16 * 95;

const rows = [
  { kw: 10, unit: 3200 },
  { kw: 14, unit: 4200 },
  { kw: 18, unit: 5000 },
  { kw: 22, unit: 5800 },
  { kw: 26, unit: 7400 },
  { kw: 36, unit: 11500 },
  { kw: 48, unit: 15000 },
].map((r) => {
  const total = r.unit + FIXED_INSTALL;
  return { ...r, total, installShare: Math.round((FIXED_INSTALL / total) * 100), perKw: total / r.kw };
});

const peak = Math.max(...rows.map((r) => r.total));
const BAR_X = 96;
const BAR_MAX = 400;
const usd = (n: number) => `$${Math.round(n).toLocaleString("en-US")}`;
---

<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 720 292" fill="none" aria-hidden="true">
  <title>Installation share by generator size</title>
  <desc>
    Holding installation constant at $5,190, a 10 kilowatt standby totals $8,390 with installation at 62 percent of
    the cost, while a 48 kilowatt set totals $20,190 with installation at 26 percent. Cost per kilowatt falls from
    $839 to $421, so the smallest machine is the worst value.
  </desc>

  <rect x="8" y="8" width="704" height="276" rx="12" fill={C.panelBg} stroke={C.border} />
  <text x="24" y="34" fill={C.dark} font-family={FONT} font-size="14" font-weight="700">
    Fixed costs do not scale down with the machine
  </text>
  <text x="24" y="52" fill={C.muted} font-family={FONT} font-size="11">
    {`The same ${usd(FIXED_INSTALL)} of switch, gas, pad, permit and labour sits under every size.`}
  </text>

  {rows.map((r, i) => {
    const y = 68 + i * 28;
    const unitW = (r.unit / peak) * BAR_MAX;
    const fixedW = (FIXED_INSTALL / peak) * BAR_MAX;
    return (
      <g>
        <text x="28" y={y + 15} fill={C.dark} font-family={FONT} font-size="10" font-weight="700">{`${r.kw} kW`}</text>
        <rect x={BAR_X} y={y + 3} width={unitW} height="17" fill={C.blue} opacity="0.24" />
        <rect x={BAR_X} y={y + 3} width={unitW} height="17" fill="none" stroke={C.blue} stroke-width="1.3" />
        <rect x={BAR_X + unitW} y={y + 3} width={fixedW} height="17" fill={C.orange} opacity="0.24" />
        <rect x={BAR_X + unitW} y={y + 3} width={fixedW} height="17" fill="none" stroke={C.orange} stroke-width="1.3" />
        <text x={BAR_X + unitW + fixedW + 9} y={y + 16} fill={C.dark} font-family={FONT} font-size="9.5" font-weight="800">
          {usd(r.total)}
        </text>
        <text x={BAR_X + unitW + fixedW + 68} y={y + 16} fill={C.muted} font-family={FONT} font-size="8.5">
          {`install ${r.installShare}% · ${usd(r.perKw)}/kW`}
        </text>
      </g>
    );
  })}

  <g>
    <rect x="28" y="268" width="11" height="11" rx="2.5" fill={C.blue} opacity="0.35" />
    <rect x="28" y="268" width="11" height="11" rx="2.5" fill="none" stroke={C.blue} stroke-width="1.3" />
    <text x="46" y="278" fill={C.muted} font-family={FONT} font-size="9">the set</text>
    <rect x="102" y="268" width="11" height="11" rx="2.5" fill={C.orange} opacity="0.35" />
    <rect x="102" y="268" width="11" height="11" rx="2.5" fill="none" stroke={C.orange} stroke-width="1.3" />
    <text x="120" y="278" fill={C.muted} font-family={FONT} font-size="9">installation</text>
  </g>

  <line x1="24" y1="252" x2="696" y2="252" stroke={C.border} />
  <text x="196" y="278" fill={C.dark} font-family={FONT} font-size="9.5" font-weight="700">
    Halving the generator does not halve the job — cost per kW doubles at the small end.
  </text>
</svg>
