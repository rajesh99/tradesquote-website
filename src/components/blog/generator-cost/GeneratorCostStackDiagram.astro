---
import { C, FONT } from "../infographicTokens";

/**
 * The default 22 kW whole-house job, broken into its six lines. Offsets are
 * precomputed here rather than in the template — an inline cumulative reduce in
 * JSX is fragile and harder to read.
 */
const SIZE_KW = 22;
const lines = [
  { name: "Generator set", amount: 5800, accent: C.blue, detail: `${SIZE_KW} kW air-cooled` },
  { name: "Transfer switch", amount: 1600, accent: C.primary, detail: "200 A service-rated" },
  { name: "Labor", amount: 1520, accent: C.orange, detail: "16 h × $95" },
  { name: "Gas run", amount: 1120, accent: C.green, detail: "40 ft × $28/ft" },
  { name: "Pad", amount: 600, accent: C.muted, detail: "precast composite" },
  { name: "Permits", amount: 350, accent: C.red, detail: "electrical + gas" },
];

const total = lines.reduce((s, l) => s + l.amount, 0);
const BAR_X = 24;
const BAR_W = 672;

let cursor = 0;
const segments = lines.map((l) => {
  const width = (l.amount / total) * BAR_W;
  const seg = { ...l, x: BAR_X + cursor, width, share: (l.amount / total) * 100 };
  cursor += width;
  return seg;
});

const usd = (n: number) => `$${n.toLocaleString("en-US")}`;
const setShare = Math.round((lines[0].amount / total) * 100);
---

<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 720 300" fill="none" aria-hidden="true">
  <title>Where the money goes on a standby generator installation</title>
  <desc>
    A 22 kilowatt whole-house standby totalling $10,990. The generator set is $5,800 or 53 percent, the transfer
    switch $1,600, labour $1,520, the gas run $1,120, the pad $600 and permits $350. Installation is 47 percent of
    the invoice.
  </desc>

  <rect x="8" y="8" width="704" height="284" rx="12" fill={C.panelBg} stroke={C.border} />
  <text x="24" y="34" fill={C.dark} font-family={FONT} font-size="14" font-weight="700">
    {`A ${SIZE_KW} kW whole-house standby: ${usd(total)}`}
  </text>
  <text x="24" y="52" fill={C.muted} font-family={FONT} font-size="11">
    200 A service-rated switch, 40 ft of natural gas, precast pad, 16 hours at $95.
  </text>

  {segments.map((s) => (
    <g>
      <rect x={s.x} y={68} width={s.width} height="34" fill={s.accent} opacity="0.22" />
      <rect x={s.x} y={68} width={s.width} height="34" fill="none" stroke={s.accent} stroke-width="1.5" />
      {s.width > 42 && (
        <text
          x={s.x + s.width / 2}
          y={89}
          text-anchor="middle"
          fill={C.dark}
          font-family={FONT}
          font-size="9.5"
          font-weight="800"
        >
          {`${Math.round(s.share)}%`}
        </text>
      )}
    </g>
  ))}

  {lines.map((l, i) => {
    const y = 124 + i * 26;
    return (
      <g>
        <rect x="28" y={y - 9} width="11" height="11" rx="2.5" fill={l.accent} opacity="0.35" />
        <rect x="28" y={y - 9} width="11" height="11" rx="2.5" fill="none" stroke={l.accent} stroke-width="1.3" />
        <text x="48" y={y} fill={C.dark} font-family={FONT} font-size="10.5" font-weight="700">{l.name}</text>
        <text x="176" y={y} fill={C.muted} font-family={FONT} font-size="9">{l.detail}</text>
        <text x="330" y={y} fill={C.dark} font-family={FONT} font-size="10.5" font-weight="800">{usd(l.amount)}</text>
      </g>
    );
  })}

  <rect x="400" y="116" width="296" height="90" rx="9" fill={C.white} stroke={C.primary} stroke-width="2" />
  <text x="548" y="142" text-anchor="middle" fill={C.dark} font-family={FONT} font-size="11" font-weight="700">
    The machine is
  </text>
  <text x="548" y="176" text-anchor="middle" fill={C.primary} font-family={FONT} font-size="34" font-weight="800">
    {`${setShare}%`}
  </text>
  <text x="548" y="196" text-anchor="middle" fill={C.muted} font-family={FONT} font-size="9.5">
    of the invoice. The rest is installation.
  </text>

  <line x1="24" y1="256" x2="696" y2="256" stroke={C.border} />
  <text x="28" y="274" fill={C.dark} font-family={FONT} font-size="10" font-weight="700">
    Quoting band at ±15%: $9,342 to $12,638.
  </text>
  <text x="28" y="288" fill={C.muted} font-family={FONT} font-size="9.5">
    Comparing bids on the generator model alone tells you almost nothing about the job.
  </text>
</svg>
