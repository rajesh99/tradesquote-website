---
import { C, FONT } from "../infographicTokens";
import { panelCapacity } from "@/lib/nec";

/**
 * The gap between the two numbers in a panel's designation IS the tandem
 * allowance. A "40-space, 40-circuit" panel accepts no tandems at all — which
 * surprises people who assume a bigger panel is always more flexible.
 */
const rows = [
  { label: "12-space, 12-circuit", spaces: 12, devices: 12 },
  { label: "20-space, 20-circuit", spaces: 20, devices: 20 },
  { label: "20-space, 30-circuit", spaces: 20, devices: 30 },
  { label: "30-space, 40-circuit", spaces: 30, devices: 40 },
  { label: "40-space, 40-circuit", spaces: 40, devices: 40 },
  { label: "42-space, 42-circuit", spaces: 42, devices: 42 },
].map((p) => {
  const tandemSlots = Math.max(0, p.devices - p.spaces);
  const r = panelCapacity({ ...p, tandemSlots, maxDevices: p.devices, fullSizeUsed: 0, tandemsUsed: 0 });
  return { ...p, tandemSlots, maxPoles: r.maxPolesWithTandems };
});

const peak = Math.max(...rows.map((r) => r.maxPoles));
const BAR_X = 190;
const BAR_MAX = 330;
---

<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 720 268" fill="none" aria-hidden="true">
  <title>Tandem allowance by panel designation</title>
  <desc>
    The gap between the two numbers in a panel's designation is its tandem allowance. A 20-space 30-circuit panel
    accepts ten tandems and a 30-space 40-circuit panel accepts ten. A 12-space 12-circuit, 20-space 20-circuit,
    40-space 40-circuit or 42-space 42-circuit panel accepts none at all.
  </desc>

  <rect x="8" y="8" width="704" height="252" rx="12" fill={C.panelBg} stroke={C.border} />
  <text x="24" y="34" fill={C.dark} font-family={FONT} font-size="14" font-weight="700">
    The gap between the two numbers is the tandem allowance
  </text>
  <text x="24" y="52" fill={C.muted} font-family={FONT} font-size="11">
    Solid is spaces, hatched is the extra poles tandems add. A 40/40 panel takes no tandems at all.
  </text>

  {rows.map((r, i) => {
    const y = 68 + i * 28;
    const spacesW = (r.spaces / peak) * BAR_MAX;
    const tandemW = (r.tandemSlots / peak) * BAR_MAX;
    const none = r.tandemSlots === 0;
    return (
      <g>
        <text x="28" y={y + 15} fill={C.dark} font-family={FONT} font-size="9.5" font-weight="700">{r.label}</text>
        <rect x={BAR_X} y={y + 3} width={spacesW} height="17" rx="3" fill={C.blue} opacity="0.22" />
        <rect x={BAR_X} y={y + 3} width={spacesW} height="17" rx="3" fill="none" stroke={C.blue} stroke-width="1.4" />
        {!none && (
          <g>
            <rect x={BAR_X + spacesW} y={y + 3} width={tandemW} height="17" rx="3" fill={C.primary} opacity="0.18" />
            <rect
              x={BAR_X + spacesW}
              y={y + 3}
              width={tandemW}
              height="17"
              rx="3"
              fill="none"
              stroke={C.primary}
              stroke-width="1.4"
              stroke-dasharray="4 2"
            />
          </g>
        )}
        <text x={BAR_X + spacesW + tandemW + 9} y={y + 16} fill={C.dark} font-family={FONT} font-size="9.5" font-weight="800">
          {`${r.maxPoles} poles`}
        </text>
        <text x={BAR_X + spacesW + tandemW + 62} y={y + 16} fill={none ? C.muted : C.primary} font-family={FONT} font-size="8.5">
          {none ? "no tandems permitted" : `${r.tandemSlots} tandem slots`}
        </text>
      </g>
    );
  })}

  <line x1="24" y1="238" x2="696" y2="238" stroke={C.border} />
  <text x="28" y="254" fill={C.muted} font-family={FONT} font-size="9.5">
    Read the label inside the door — it names the limit and usually which positions accept a tandem.
  </text>
</svg>
