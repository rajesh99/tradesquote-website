---
import { C, FONT } from "../infographicTokens";

/**
 * Who actually gets the Table 310.12 allowance. Its title limits it to a dwelling
 * SERVICE, or the one feeder carrying an ENTIRE dwelling load — which an ordinary
 * garage or shop subpanel is not. This single distinction is why the ubiquitous
 * "4 AWG for a 100 A subpanel" answer is wrong more often than it is right.
 */
const cases = [
  {
    name: "Dwelling service conductors",
    table: "Table 310.12",
    gets: true,
    detail: "Utility to the main disconnect. The allowance's primary case.",
  },
  {
    name: "Feeder carrying the ENTIRE dwelling load",
    table: "Table 310.12",
    gets: true,
    detail: "Meter-main to the one panel that serves the whole house.",
  },
  {
    name: "Garage or shop subpanel",
    table: "Table 310.16",
    gets: false,
    detail: "Carries part of the load, so no allowance. This is most subpanels.",
  },
  {
    name: "Subpanel in a detached building",
    table: "Table 310.16",
    gets: false,
    detail: "Same reasoning — it is not the entire dwelling load.",
  },
  {
    name: "Any non-dwelling feeder",
    table: "Table 310.16",
    gets: false,
    detail: "310.12 is a dwelling rule. Commercial work never uses it.",
  },
];
---

<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 720 288" fill="none" aria-hidden="true">
  <title>Who gets the Table 310.12 83 percent allowance</title>
  <desc>
    Table 310.12's reduced conductor sizes apply only to dwelling service conductors and to a feeder carrying an
    entire dwelling load. An ordinary garage or shop subpanel, a subpanel in a detached building, and any
    non-dwelling feeder are all sized from Table 310.16 instead, which requires a larger conductor.
  </desc>

  <rect x="8" y="8" width="704" height="272" rx="12" fill={C.panelBg} stroke={C.border} />
  <text x="24" y="34" fill={C.dark} font-family={FONT} font-size="14" font-weight="700">
    The 83% allowance is narrower than everyone thinks
  </text>
  <text x="24" y="52" fill={C.muted} font-family={FONT} font-size="11">
    Table 310.12 covers a dwelling <tspan font-style="italic">service</tspan>, or the one feeder carrying an
    <tspan font-style="italic"> entire</tspan> dwelling load. That is all.
  </text>

  {cases.map((c, i) => {
    const y = 70 + i * 38;
    const accent = c.gets ? C.green : C.red;
    return (
      <g>
        <rect x="24" y={y} width="672" height="32" rx="7" fill={c.gets ? C.greenLight : C.redLight} stroke={accent} stroke-width="1.4" />
        <text x={40} y={y + 14} fill={accent} font-family={FONT} font-size="11" font-weight="800">
          {c.gets ? "✓" : "✕"}
        </text>
        <text x={58} y={y + 14} fill={C.dark} font-family={FONT} font-size="10.5" font-weight="700">{c.name}</text>
        <text x={58} y={y + 26} fill={C.muted} font-family={FONT} font-size="8.5">{c.detail}</text>
        <rect x="580" y={y + 6} width="100" height="20" rx="4" fill={C.white} stroke={accent} stroke-width="1.2" />
        <text x="630" y={y + 20} text-anchor="middle" fill={C.dark} font-family={FONT} font-size="9" font-weight="800">
          {c.table}
        </text>
      </g>
    );
  })}

  <line x1="24" y1="268" x2="696" y2="268" stroke={C.border} />
  <text x="28" y="282" fill={C.dark} font-family={FONT} font-size="9.5" font-weight="700">
    So "4 AWG for a 100 A subpanel" is right for a whole-house feeder and wrong for a garage.
  </text>
</svg>
