---
import { C, FONT } from "../infographicTokens";

/**
 * The other half of a subpanel job, and the half that fails inspection: four
 * wires, with the neutral floated and the grounds bonded. Getting this wrong
 * puts normal neutral current onto the equipment grounding conductors and every
 * metal enclosure they touch.
 */
---

<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 720 306" fill="none" aria-hidden="true">
  <title>Neutral and ground separation in a subpanel</title>
  <desc>
    A subpanel needs a four-wire feeder with the neutral bar isolated from the enclosure and the grounding bar
    bonded to it. The neutral and ground are joined only once, at the service disconnect. Bonding them again at
    the subpanel puts normal return current onto the equipment grounding conductors and every metal enclosure they
    touch.
  </desc>

  <rect x="8" y="8" width="704" height="290" rx="12" fill={C.panelBg} stroke={C.border} />
  <text x="24" y="34" fill={C.dark} font-family={FONT} font-size="14" font-weight="700">
    Four wires, and the bonding screw stays out
  </text>
  <text x="24" y="52" fill={C.muted} font-family={FONT} font-size="11">
    Neutral and ground are joined exactly once, at the service. Never again downstream.
  </text>

  <!-- Service panel -->
  <rect x="36" y="76" width="180" height="150" rx="8" fill={C.white} stroke={C.blue} stroke-width="1.8" />
  <text x="126" y="98" text-anchor="middle" fill={C.blue} font-family={FONT} font-size="10.5" font-weight="800">
    SERVICE PANEL
  </text>
  <rect x="52" y="112" width="148" height="20" rx="3" fill={C.blueLight} stroke={C.blue} stroke-width="1" />
  <text x="126" y="126" text-anchor="middle" fill={C.dark} font-family={FONT} font-size="9" font-weight="700">neutral bar</text>
  <rect x="52" y="152" width="148" height="20" rx="3" fill={C.greenLight} stroke={C.green} stroke-width="1" />
  <text x="126" y="166" text-anchor="middle" fill={C.dark} font-family={FONT} font-size="9" font-weight="700">ground bar</text>
  <line x1="126" y1="132" x2="126" y2="152" stroke={C.primary} stroke-width="3" />
  <text x="136" y="147" fill={C.primary} font-family={FONT} font-size="8.5" font-weight="800">BONDED</text>
  <text x="126" y="196" text-anchor="middle" fill={C.primary} font-family={FONT} font-size="9" font-weight="700">
    main bonding jumper
  </text>
  <text x="126" y="212" text-anchor="middle" fill={C.muted} font-family={FONT} font-size="8.5">
    250.24(A)(5) — here and only here
  </text>

  <!-- Feeder -->
  <g>
    {[
      { y: 108, label: "hot", color: C.dark },
      { y: 128, label: "hot", color: C.dark },
      { y: 148, label: "neutral", color: C.blue },
      { y: 168, label: "ground", color: C.green },
    ].map((wire) => (
      <g>
        <line x1="216" y1={wire.y} x2="436" y2={wire.y} stroke={wire.color} stroke-width="2.4" />
        <text x="326" y={wire.y - 5} text-anchor="middle" fill={wire.color} font-family={FONT} font-size="8.5" font-weight="700">
          {wire.label}
        </text>
      </g>
    ))}
    <text x="326" y="196" text-anchor="middle" fill={C.dark} font-family={FONT} font-size="10" font-weight="800">
      4-wire feeder
    </text>
    <text x="326" y="212" text-anchor="middle" fill={C.muted} font-family={FONT} font-size="8.5">
      neutral and ground run separately
    </text>
  </g>

  <!-- Subpanel -->
  <rect x="436" y="76" width="180" height="150" rx="8" fill={C.white} stroke={C.orange} stroke-width="1.8" />
  <text x="526" y="98" text-anchor="middle" fill={C.orange} font-family={FONT} font-size="10.5" font-weight="800">
    SUBPANEL
  </text>
  <rect x="452" y="112" width="148" height="20" rx="3" fill={C.blueLight} stroke={C.blue} stroke-width="1" />
  <text x="526" y="126" text-anchor="middle" fill={C.dark} font-family={FONT} font-size="9" font-weight="700">
    neutral bar — floated
  </text>
  <rect x="452" y="152" width="148" height="20" rx="3" fill={C.greenLight} stroke={C.green} stroke-width="1" />
  <text x="526" y="166" text-anchor="middle" fill={C.dark} font-family={FONT} font-size="9" font-weight="700">
    ground bar — bonded
  </text>
  <text x="526" y="142" text-anchor="middle" fill={C.red} font-family={FONT} font-size="8.5" font-weight="800">
    no bonding screw
  </text>
  <text x="526" y="196" text-anchor="middle" fill={C.orange} font-family={FONT} font-size="9" font-weight="700">
    408.40 — isolated neutral
  </text>
  <text x="526" y="212" text-anchor="middle" fill={C.muted} font-family={FONT} font-size="8.5">
    remove the green bonding screw
  </text>

  <text x="640" y="126" fill={C.muted} font-family={FONT} font-size="8.5">to</text>
  <text x="640" y="138" fill={C.muted} font-family={FONT} font-size="8.5">loads</text>

  <rect x="24" y="238" width="672" height="50" rx="8" fill={C.redLight} stroke={C.red} stroke-width="1.6" />
  <text x="40" y="256" fill={C.red} font-family={FONT} font-size="10.5" font-weight="800">
    Bond them twice and normal return current flows on the grounding conductors
  </text>
  <text x="40" y="272" fill={C.dark} font-family={FONT} font-size="9.5">
    — and on the conduit, the enclosures, and anything metal bonded to them. It works, and it is dangerous.
  </text>
  <text x="40" y="284" fill={C.muted} font-family={FONT} font-size="8.5">
    A detached building also needs its own grounding electrode under 250.32.
  </text>
</svg>
