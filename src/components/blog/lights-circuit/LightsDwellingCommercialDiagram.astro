---
import { fmtInt } from "@/lib/nec";
import { C, FONT } from "../infographicTokens";

/**
 * Two different code regimes, and the dwelling one has no per-circuit limit at
 * all — 220.14(J) has already counted lighting outlets inside the 3 VA/ft²
 * general lighting load, so there is no per-outlet VA left to divide by.
 */
const SQFT = 2000;
const VA_PER_SQFT = 3;
const generalLighting = SQFT * VA_PER_SQFT;
const circuits15 = Math.ceil(generalLighting / (15 * 120));
const circuits20 = Math.ceil(generalLighting / (20 * 120));

const lanes = [
  {
    accent: C.primary,
    heading: "Dwelling unit",
    rule: "220.14(J)",
    answer: "No limit per circuit",
    points: [
      `General lighting is ${VA_PER_SQFT} VA/ft² — ${fmtInt(generalLighting)} VA for ${fmtInt(SQFT)} ft²`,
      `That sets a MINIMUM of ${circuits15} × 15 A or ${circuits20} × 20 A circuits`,
      "Lighting outlets are already inside that figure",
      "No per-outlet VA exists to divide by",
      "Generally not a continuous load",
    ],
  },
  {
    accent: C.orange,
    heading: "Non-dwelling",
    rule: "220.14(D)",
    answer: "Compute the actual VA",
    points: [
      "Each luminaire counts at its own maximum VA",
      "Lighting is normally continuous — apply 125%",
      "So a 20 A circuit carries 16 A of lighting",
      "That is 1,920 VA, not 2,400 VA",
      "Sign circuits get their own rules in 600.5",
    ],
  },
];

const LANE_X = [24, 366];
const LANE_W = 330;
---

<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 720 252" fill="none" aria-hidden="true">
  <title>Dwelling and non-dwelling lighting rules are different</title>
  <desc>
    In a dwelling unit, 220.14(J) folds lighting outlets into the general lighting load of 3 volt-amperes per square
    foot, so there is no per-circuit limit on the number of luminaires — a 2,000 square foot house has 6,000
    volt-amperes of general lighting, which sets a minimum of 5 fifteen-amp or 3 twenty-amp circuits. In a
    non-dwelling occupancy, 220.14(D) counts each luminaire at its actual volt-amperes and the load is normally
    continuous, so a 20 amp circuit carries 16 amps of lighting.
  </desc>

  <rect x="8" y="8" width="704" height="236" rx="12" fill={C.panelBg} stroke={C.border} />
  <text x="24" y="34" fill={C.dark} font-family={FONT} font-size="14" font-weight="700">The rule depends on the occupancy, not the fixture</text>

  {lanes.map((lane, j) => (
    <g>
      <rect x={LANE_X[j]} y="48" width={LANE_W} height="158" rx="10" fill={lane.accent} opacity="0.07" />
      <rect x={LANE_X[j]} y="48" width={LANE_W} height="158" rx="10" fill="none" stroke={lane.accent} stroke-width="1.6" />
      <text x={LANE_X[j] + 18} y="70" fill={lane.accent} font-family={FONT} font-size="12.5" font-weight="800">{lane.heading}</text>
      <text x={LANE_X[j] + LANE_W - 18} y="70" text-anchor="end" fill={C.muted} font-family={FONT} font-size="9" font-weight="700">{lane.rule}</text>
      <rect x={LANE_X[j] + 18} y="78" width={LANE_W - 36} height="22" rx="6" fill={C.white} stroke={lane.accent} stroke-width="1.4" />
      <text x={LANE_X[j] + LANE_W / 2} y="93" text-anchor="middle" fill={lane.accent} font-family={FONT} font-size="10.5" font-weight="800">{lane.answer}</text>
      {lane.points.map((p, k) => (
        <g>
          <circle cx={LANE_X[j] + 24} cy={117 + k * 19} r="2.4" fill={lane.accent} />
          <text x={LANE_X[j] + 34} y={120 + k * 19} fill={C.dark} font-family={FONT} font-size="8.5">{p}</text>
        </g>
      ))}
    </g>
  ))}

  <text x="24" y="228" fill={C.muted} font-family={FONT} font-size="10">The dwelling calculation gives a minimum number of circuits. It never gives a maximum number of fixtures.</text>
</svg>
