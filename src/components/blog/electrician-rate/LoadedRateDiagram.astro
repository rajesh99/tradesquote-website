---
import { C, FONT, markerDefs } from "../infographicTokens";

const defs = markerDefs("lrd");

/**
 * Wage to billing rate, computed with the same maths as the labor-rate calculator:
 * annual wage + 35% burden + $9,000 overhead, recovered over billable hours only,
 * then divided by (1 − margin).
 */
const WAGE = 32;
const PAID_HOURS = 2080;
const BURDEN_PCT = 0.35;
const OVERHEAD = 9000;
const BILLABLE_PCT = 0.75;
const MARGIN_PCT = 0.4;

const annualWage = WAGE * PAID_HOURS;
const burden = annualWage * BURDEN_PCT;
const employment = annualWage + burden;
const totalCost = employment + OVERHEAD;
const billableHours = PAID_HOURS * BILLABLE_PCT;
const loaded = totalCost / billableHours;
const billRate = loaded / (1 - MARGIN_PCT);
const multiplier = billRate / WAGE;

const steps = [
  { label: "Wage", value: `$${WAGE}/h`, note: `× ${PAID_HOURS.toLocaleString("en-US")} h paid`, accent: C.blue, bg: C.blueLight },
  { label: "+ 35% burden", value: `$${Math.round(employment).toLocaleString("en-US")}`, note: "tax, insurance, PTO", accent: C.blue, bg: C.blueLight },
  { label: "+ overhead", value: `$${Math.round(totalCost).toLocaleString("en-US")}`, note: "truck, software, admin", accent: C.orange, bg: C.orangeLight },
  { label: "÷ billable hours", value: `$${loaded.toFixed(2)}`, note: `only ${billableHours.toLocaleString("en-US")} h recover it`, accent: C.orange, bg: C.orangeLight },
  { label: "÷ 0.60 margin", value: `$${billRate.toFixed(2)}`, note: "what you must bill", accent: C.primary, bg: C.primaryLight },
];
---

<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 720 270" fill="none" aria-hidden="true">
  <title>From hourly wage to billing rate</title>
  <desc>
    A 32 dollar hourly wage across 2,080 paid hours is 66,560 dollars. Adding 35 percent payroll burden brings
    employment cost to 89,856. Adding 9,000 dollars of annual overhead gives a total cost of 98,856. Only the
    1,560 billable hours can recover that, giving a loaded cost of 63 dollars 37 cents per billable hour.
    Dividing by 0.60 for a 40 percent margin gives a required billing rate of 105 dollars 62 cents — about 3.3
    times the wage.
  </desc>

  <defs set:html={defs} />

  <rect x="8" y="8" width="704" height="254" rx="12" fill={C.panelBg} stroke={C.border} />
  <text x="24" y="36" fill={C.dark} font-family={FONT} font-size="14" font-weight="700">{`$${WAGE} an hour costs you $${billRate.toFixed(2)} an hour`}</text>
  <text x="24" y="54" fill={C.muted} font-family={FONT} font-size="11">Every step is a real cost. None of it is profit until the last one.</text>

  {steps.map((s, i) => {
    const x = 24 + i * 137;
    return (
      <g>
        <rect x={x} y="76" width="126" height="106" rx="9" fill={s.bg} stroke={s.accent} stroke-width="1.5" />
        <text x={x + 63} y="98" text-anchor="middle" fill={C.dark} font-family={FONT} font-size="9.5" font-weight="800">{s.label}</text>
        <text x={x + 63} y="130" text-anchor="middle" fill={s.accent} font-family={FONT} font-size="15" font-weight="800">{s.value}</text>
        <text x={x + 63} y="154" text-anchor="middle" fill={C.muted} font-family={FONT} font-size="8">{s.note}</text>
        {i !== steps.length - 1 && (
          <path d={`M${x + 130} 129 L ${x + 133} 129`} stroke={C.border} stroke-width="1.6" marker-end="url(#lrd-arrow-muted)" />
        )}
      </g>
    );
  })}

  <rect x="24" y="200" width="672" height="52" rx="10" fill={C.primaryLight} stroke={C.primary} stroke-width="1.8" />
  <text x="44" y="222" fill={C.dark} font-family={FONT} font-size="12.5" font-weight="800">{`Multiplier: ${multiplier.toFixed(2)}× the wage`}</text>
  <text x="44" y="240" fill={C.muted} font-family={FONT} font-size="9.5">Billing at twice the wage loses money on every hour. This is why "he only earns $32, why am I charged $105?" has an answer.</text>
</svg>
