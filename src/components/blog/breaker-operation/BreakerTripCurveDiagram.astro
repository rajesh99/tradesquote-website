---
import { C, FONT } from "../infographicTokens";

/**
 * The characteristic shape of a thermal-magnetic breaker: a long inverse-time
 * thermal region where more overload means a faster trip, and a near-vertical
 * magnetic region where a short circuit opens it in about a cycle. Shape is
 * representative — real curves vary by manufacturer and frame size.
 */
const X0 = 80;
const X1 = 660;
const Y0 = 90;
const Y1 = 220;

const M_MIN = 1;
const M_MAX = 20;
const T_MAX = 3600;
const T_MIN = 0.01;

const lx = (m: number) => X0 + ((Math.log10(m) - Math.log10(M_MIN)) / (Math.log10(M_MAX) - Math.log10(M_MIN))) * (X1 - X0);
const ly = (t: number) => Y0 + ((Math.log10(T_MAX) - Math.log10(t)) / (Math.log10(T_MAX) - Math.log10(T_MIN))) * (Y1 - Y0);

const THERMAL = [
  { m: 1.35, t: 3600 },
  { m: 1.6, t: 900 },
  { m: 2, t: 200 },
  { m: 3, t: 40 },
  { m: 4, t: 12 },
  { m: 5, t: 5 },
];
const MAG_M = 5;
const MAG_T = 1 / 60;

const thermalPath = `M${THERMAL.map((p) => `${lx(p.m).toFixed(1)},${ly(p.t).toFixed(1)}`).join(" L")}`;
const magPath = `M${lx(MAG_M).toFixed(1)},${ly(5).toFixed(1)} L${lx(MAG_M).toFixed(1)},${ly(MAG_T).toFixed(1)} L${X1},${ly(MAG_T).toFixed(1)}`;

const X_TICKS = [1, 1.35, 2, 3, 5, 10, 20];
const Y_TICKS = [
  { t: 3600, label: "1 hour" },
  { t: 60, label: "1 min" },
  { t: 1, label: "1 s" },
  { t: 1 / 60, label: "1 cycle" },
];
---

<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 720 282" fill="none" aria-hidden="true">
  <title>The two trip regions of a thermal-magnetic circuit breaker</title>
  <desc>
    A breaker carries its rated current indefinitely. Above about 135 percent a bimetallic strip heats and trips it
    within roughly an hour, and the greater the overload the faster it acts — around 200 seconds at twice rating and 5
    seconds at five times. Beyond about five times rating a magnetic solenoid trips it in roughly one cycle, about 17
    milliseconds.
  </desc>

  <rect x="8" y="8" width="704" height="266" rx="12" fill={C.panelBg} stroke={C.border} />
  <text x="24" y="34" fill={C.dark} font-family={FONT} font-size="14" font-weight="700">Two mechanisms, one device</text>
  <text x="24" y="52" fill={C.muted} font-family={FONT} font-size="11">Trip time against overload. Both axes are logarithmic; the shape is representative, not a specific product.</text>

  <text x={lx(2.4)} y="78" text-anchor="middle" fill={C.orange} font-family={FONT} font-size="9" font-weight="700">THERMAL — BIMETAL, INVERSE TIME</text>
  <text x={lx(11)} y="78" text-anchor="middle" fill={C.red} font-family={FONT} font-size="9" font-weight="700">MAGNETIC — SOLENOID, ~1 CYCLE</text>

  <rect x={lx(1.35)} y={Y0} width={lx(MAG_M) - lx(1.35)} height={Y1 - Y0} fill={C.orange} opacity="0.06" />
  <rect x={lx(MAG_M)} y={Y0} width={X1 - lx(MAG_M)} height={Y1 - Y0} fill={C.red} opacity="0.06" />

  {Y_TICKS.map((tick) => (
    <g>
      <line x1={X0} y1={ly(tick.t)} x2={X1} y2={ly(tick.t)} stroke={C.border} stroke-width="0.8" stroke-dasharray="2 5" />
      <text x={X0 - 8} y={ly(tick.t) + 3.5} text-anchor="end" fill={C.muted} font-family={FONT} font-size="8.5">{tick.label}</text>
    </g>
  ))}

  <line x1={X0} y1={Y0} x2={X0} y2={Y1} stroke={C.border} stroke-width="1.2" />
  <line x1={X0} y1={Y1} x2={X1} y2={Y1} stroke={C.border} stroke-width="1.2" />

  <line x1={lx(1)} y1={Y0} x2={lx(1)} y2={Y1} stroke={C.green} stroke-width="2" />
  <text x={lx(1) + 6} y={Y0 + 14} fill={C.green} font-family={FONT} font-size="9" font-weight="700">holds here</text>
  <text x={lx(1) + 6} y={Y0 + 26} fill={C.green} font-family={FONT} font-size="9" font-weight="700">indefinitely</text>

  <path d={thermalPath} stroke={C.orange} stroke-width="2.6" fill="none" stroke-linejoin="round" stroke-linecap="round" />
  <path d={magPath} stroke={C.red} stroke-width="2.6" fill="none" stroke-linejoin="round" stroke-linecap="round" />

  {X_TICKS.map((m) => (
    <g>
      <line x1={lx(m)} y1={Y1} x2={lx(m)} y2={Y1 + 4} stroke={C.border} stroke-width="1.2" />
      <text x={lx(m)} y={Y1 + 16} text-anchor="middle" fill={C.muted} font-family={FONT} font-size="9">{`${m}×`}</text>
    </g>
  ))}
  <text x={(X0 + X1) / 2} y={Y1 + 32} text-anchor="middle" fill={C.muted} font-family={FONT} font-size="9" font-weight="700">CURRENT AS A MULTIPLE OF THE BREAKER'S RATING</text>

  <text x="24" y="266" fill={C.muted} font-family={FONT} font-size="10">
    Overload is a heat problem, so it is timed. A short circuit is not, so it is not — the solenoid acts in one cycle.
  </text>
</svg>
