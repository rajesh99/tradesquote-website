---
import { C, FONT } from "../infographicTokens";
import {
  convertUnit,
  PSI_PER_FOOT_HEAD,
  FEET_HEAD_PER_PSI,
  CUBIC_INCHES_PER_GALLON,
  GALLONS_PER_CUBIC_FOOT,
  fmt,
} from "@/lib/plumbing";

/**
 * Which conversions are definitions and which are measurements. The distinction
 * matters because only one of these shifts with temperature — and it is the one
 * plumbers use most.
 */
const ROWS = [
  {
    conv: `1 US gallon = ${CUBIC_INCHES_PER_GALLON} cubic inches`,
    kind: "Definition",
    note: "Exact. Every US plumbing volume figure rests on it.",
    exact: true,
  },
  {
    conv: "1 US gallon = 3.785411784 litres",
    kind: "Definition",
    note: "Exact, and it follows from the inch being defined in metres.",
    exact: true,
  },
  {
    conv: `1 cubic foot = ${GALLONS_PER_CUBIC_FOOT} gallons`,
    kind: "Definition",
    note: "Exact. Behind the roof runoff divisor and pipe volume alike.",
    exact: true,
  },
  {
    conv: `1 bar = ${fmt(convertUnit("pressure", "bar", "psi", 1), 4)} psi`,
    kind: "Definition",
    note: "Bar is defined as exactly 100 kPa, so the factor is exact.",
    exact: true,
  },
  {
    conv: `1 psi = ${fmt(FEET_HEAD_PER_PSI, 3)} feet of water`,
    kind: "Measurement",
    note: `From water at 62.37 lb/ft³ — ${PSI_PER_FOOT_HEAD} psi per foot. Shifts slightly with temperature.`,
    exact: false,
  },
];

const ROW_H = 34;
const TOP = 84;
---

<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 720 288" fill="none" aria-hidden="true">
  <title>Which plumbing conversions are exact and which are measurements</title>
  <desc>
    Most plumbing unit conversions are definitions and therefore exact. The psi-to-feet-of-head pair is a
    measurement of water density and shifts slightly with temperature.
  </desc>

  <rect x="8" y="8" width="704" height="272" rx="12" fill={C.panelBg} stroke={C.border} />
  <text x="24" y="34" fill={C.dark} font-family={FONT} font-size="14" font-weight="700">Four of these are exact. One is a measurement.</text>
  <text x="24" y="52" fill={C.muted} font-family={FONT} font-size="11">
    Worth knowing which, because only the measured one moves — and it is the conversion plumbers reach for most.
  </text>

  <text x="40" y="76" fill={C.muted} font-family={FONT} font-size="8" font-weight="700">CONVERSION</text>
  <text x={492} y="76" fill={C.muted} font-family={FONT} font-size="8" font-weight="700">KIND</text>

  {ROWS.map((row, i) => {
    const y = TOP + i * ROW_H;
    const tone = row.exact ? C.primary : C.orange;
    return (
      <g>
        <rect x="24" y={y} width="672" height={ROW_H - 6} rx="7" fill={tone} opacity="0.07" />
        <rect x="24" y={y} width="4" height={ROW_H - 6} rx="2" fill={tone} opacity="0.9" />
        <text x="40" y={y + 14} fill={C.dark} font-family={FONT} font-size="10.5" font-weight="700">{row.conv}</text>
        <text x="40" y={y + 25} fill={C.muted} font-family={FONT} font-size="8.5">{row.note}</text>
        <rect x={480} y={y + 4} width={92} height="18" rx="5" fill={tone} opacity="0.16" />
        <text x={526} y={y + 17} text-anchor="middle" fill={tone} font-family={FONT} font-size="9" font-weight="800">
          {row.kind}
        </text>
      </g>
    );
  })}

  <text x="24" y="270" fill={C.muted} font-family={FONT} font-size="10">
    The practical consequence is small — a few tenths of a percent across normal water temperatures — but it is why two references can disagree in the last digit.
  </text>
</svg>
