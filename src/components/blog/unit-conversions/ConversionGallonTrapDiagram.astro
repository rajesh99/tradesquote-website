---
import { C, FONT, markerDefs } from "../infographicTokens";
import { convertUnit, fmt } from "@/lib/plumbing";

/**
 * The imperial gallon is the one conversion error large enough to change a pipe
 * size, and the one most likely to arrive silently on a spec sheet that just
 * says "gallons".
 */
const defs = markerDefs("gal-trap");

const ukToUs = convertUnit("volume", "ukgal", "gal", 1);
const errorPct = (ukToUs - 1) * 100;

/* A fixture quoted in each gallon. */
const QUOTED = 5;
const asUs = QUOTED;
const asUk = convertUnit("volume", "ukgal", "gal", QUOTED);
---

<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 720 268" fill="none" aria-hidden="true">
  <title>The imperial gallon trap</title>
  <desc>
    An imperial gallon is about twenty percent larger than a US gallon. A spec sheet that says only "gallons" can
    therefore be wrong by enough to change a pipe size.
  </desc>
  <defs set:html={defs} />

  <rect x="8" y="8" width="704" height="252" rx="12" fill={C.panelBg} stroke={C.border} />
  <text x="24" y="34" fill={C.dark} font-family={FONT} font-size="14" font-weight="700">
    {`Two gallons, ${fmt(errorPct, 1)}% apart, one word`}
  </text>
  <text x="24" y="52" fill={C.muted} font-family={FONT} font-size="11">
    Both are exact definitions. Neither is a rounding. And a data sheet saying only "gallons" tells you nothing about which.
  </text>

  <rect x="24" y="74" width="320" height="80" rx="10" fill={C.blueLight} stroke={C.blue} stroke-width="2" />
  <text x="40" y="94" fill={C.blue} font-family={FONT} font-size="9" font-weight="700">US GALLON</text>
  <text x="40" y="120" fill={C.blue} font-family={FONT} font-size="18" font-weight="800">3.785411784 L</text>
  <text x="40" y="142" fill={C.muted} font-family={FONT} font-size="9.5">231 cubic inches, exactly. The one every US plumbing figure uses.</text>

  <rect x="366" y="74" width="330" height="80" rx="10" fill={C.orangeLight} stroke={C.orange} stroke-width="2" />
  <text x="382" y="94" fill={C.orange} font-family={FONT} font-size="9" font-weight="700">IMPERIAL GALLON</text>
  <text x="382" y="120" fill={C.orange} font-family={FONT} font-size="18" font-weight="800">4.54609 L</text>
  <text x="382" y="142" fill={C.muted} font-family={FONT} font-size="9.5">UK and older Commonwealth data. A separate definition, never reconciled.</text>

  <line x1="348" y1="114" x2="362" y2="114" stroke={C.red} stroke-width="2" marker-end="url(#gal-trap-arrow-orange)" />

  <rect x="24" y="168" width="672" height="46" rx="10" fill={C.redLight} stroke={C.red} stroke-width="2" />
  <text x="360" y="188" text-anchor="middle" fill={C.red} font-family={FONT} font-size="13" font-weight="800">
    {`1 imperial gallon = ${fmt(ukToUs, 4)} US gallons`}
  </text>
  <text x="360" y="206" text-anchor="middle" fill={C.dark} font-family={FONT} font-size="10">
    {`A fixture quoted at ${QUOTED} gal is either ${fmt(asUs, 2)} or ${fmt(asUk, 2)} US gallons — a ${fmt(errorPct, 1)}% error, and enough to move a pipe size.`}
  </text>

  <text x="24" y="234" fill={C.muted} font-family={FONT} font-size="10">
    It shows up most often on imported fixture flow rates, older tank capacities, and anything sourced from a UK or Australian catalogue.
  </text>
  <text x="24" y="250" fill={C.muted} font-family={FONT} font-size="10">
    If the sheet does not say which gallon, it is not a specification — go back and ask.
  </text>
</svg>
