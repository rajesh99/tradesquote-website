---
import { C, FONT } from "../infographicTokens";

/**
 * The core distinction: different fault, different threshold, different thing being
 * protected. GFCI trip level is the UL 943 Class A 4–6 mA band; note that 30 mA GFPE
 * is equipment protection and a separate device class.
 */
const devices = [
  {
    abbr: "GFCI",
    name: "Ground-fault circuit interrupter",
    accent: C.blue,
    bg: C.blueLight,
    detects: "Current leaving the circuit",
    threshold: "4–6 mA",
    protects: "People",
    how: [
      "Compares current out on the hot",
      "against current back on the neutral.",
      "Any difference is leaking somewhere —",
      "possibly through a person.",
    ],
  },
  {
    abbr: "AFCI",
    name: "Arc-fault circuit interrupter",
    accent: C.orange,
    bg: C.orangeLight,
    detects: "The signature of an arc",
    threshold: "pattern-based",
    protects: "Property",
    how: [
      "Watches for the high-frequency",
      "current pattern arcing produces —",
      "a damaged cord, a nicked cable, a",
      "loose terminal starting to spark.",
    ],
  },
];
---

<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 720 290" fill="none" aria-hidden="true">
  <title>GFCI versus AFCI protection</title>
  <desc>
    A ground-fault circuit interrupter compares current leaving on the hot conductor with current returning on
    the neutral and trips on a difference of 4 to 6 milliamperes, because that difference means current is
    leaking somewhere — possibly through a person. It protects people from shock. An arc-fault circuit
    interrupter instead watches for the high-frequency current pattern that arcing produces, from a damaged
    cord, a nicked cable or a loose terminal, and protects property from fire. They detect different faults and
    are not interchangeable.
  </desc>

  <rect x="8" y="8" width="704" height="274" rx="12" fill={C.panelBg} stroke={C.border} />
  <text x="24" y="36" fill={C.dark} font-family={FONT} font-size="14" font-weight="700">Different faults, different jobs — not interchangeable</text>
  <text x="24" y="54" fill={C.muted} font-family={FONT} font-size="11">One is looking for current going missing; the other is listening for a spark</text>

  {devices.map((d, i) => {
    const x = 24 + i * 340;
    return (
      <g>
        <rect x={x} y="72" width="324" height="198" rx="10" fill={d.bg} stroke={d.accent} stroke-width="1.6" />
        <text x={x + 20} y="102" fill={d.accent} font-family={FONT} font-size="22" font-weight="800">{d.abbr}</text>
        <text x={x + 96} y="102" fill={C.dark} font-family={FONT} font-size="10" font-weight="700">{d.name}</text>
        <line x1={x + 20} y1="112" x2={x + 304} y2="112" stroke={d.accent} stroke-opacity="0.35" />

        <text x={x + 20} y="132" fill={C.muted} font-family={FONT} font-size="9.5">Detects</text>
        <text x={x + 88} y="132" fill={C.dark} font-family={FONT} font-size="10" font-weight="700">{d.detects}</text>
        <text x={x + 20} y="150" fill={C.muted} font-family={FONT} font-size="9.5">Trips at</text>
        <text x={x + 88} y="150" fill={C.dark} font-family={FONT} font-size="10" font-weight="700">{d.threshold}</text>

        <text x={x + 20} y="176" fill={C.muted} font-family={FONT} font-size="9.5">
          {d.how.map((line, li) => (
            <tspan x={x + 20} dy={li === 0 ? "0" : "13"}>{line}</tspan>
          ))}
        </text>

        <rect x={x + 20} y="234" width="284" height="26" rx="7" fill={C.white} stroke={d.accent} stroke-width="1.3" />
        <text x={x + 162} y="251" text-anchor="middle" fill={d.accent} font-family={FONT} font-size="11.5" font-weight="800">{`Protects ${d.protects.toLowerCase()}`}</text>
      </g>
    );
  })}
</svg>
