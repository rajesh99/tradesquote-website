---
import { motorFlc, motorConductorAmps, motorOverloadRating, prevStandardOcpd, ampacityOf, CONDUCTOR_SIZES, egcSize, fmt } from "@/lib/nec";
import { C, FONT } from "../infographicTokens";

/**
 * A motor circuit has four protective functions and they are not the same device.
 * Drawing them in series is the only way the 35 A breaker on 14 AWG stops looking
 * like a violation: the breaker handles short circuits, the overload handles the
 * conductor and the motor.
 */
const flc = motorFlc(10, "3ph", 460)!;
const NAMEPLATE = 13.0;
const condAmps = motorConductorAmps(flc);
const cond = CONDUCTOR_SIZES.find((s) => {
  const a = ampacityOf(s, "copper", 75);
  return a !== null && a >= condAmps;
})!;
const ocpd = prevStandardOcpd(flc * 2.5);
const overload = motorOverloadRating(NAMEPLATE, "serviceFactor115");

const stages = [
  {
    name: "Disconnect",
    rule: "430 Part IX",
    protects: "People — lockable, in sight of the motor",
    value: `${Math.ceil(flc * 1.15)} A min`,
    accent: C.muted,
  },
  {
    name: "Branch OCPD",
    rule: "430.52",
    protects: "Short circuits and ground faults only",
    value: `${ocpd} A`,
    accent: C.red,
  },
  {
    name: "Controller",
    rule: "430 Part VII",
    protects: "Switching — starts and stops the motor",
    value: `≥ ${flc} A`,
    accent: C.blue,
  },
  {
    name: "Overload",
    rule: "430.32",
    protects: "The conductor AND the motor windings",
    value: `${fmt(overload, 2)} A`,
    accent: C.green,
  },
];

const X = [24, 196, 368, 540];
const W = 156;
---

<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 720 268" fill="none" aria-hidden="true">
  <title>The four protective functions in a motor circuit</title>
  <desc>
    A motor circuit contains four separate functions in series. The disconnecting means protects people and must be
    lockable and in sight of the motor. The branch-circuit overcurrent device, at 35 amps here, protects only against
    short circuits and ground faults. The controller switches the motor. The overload device, set at 16.25 amps,
    is what actually protects both the conductor and the motor windings against sustained overcurrent.
  </desc>

  <rect x="8" y="8" width="704" height="252" rx="12" fill={C.panelBg} stroke={C.border} />
  <text x="24" y="34" fill={C.dark} font-family={FONT} font-size="14" font-weight="700">Four devices, four different jobs</text>
  <text x="24" y="52" fill={C.muted} font-family={FONT} font-size="11">{`10 HP, 3φ 460 V, FLC ${flc} A, ${cond.label} AWG conductor rated ${ampacityOf(cond, "copper", 75)} A.`}</text>

  {stages.map((s, i) => (
    <g>
      <rect x={X[i]} y="70" width={W} height="118" rx="10" fill={s.accent} opacity="0.07" />
      <rect x={X[i]} y="70" width={W} height="118" rx="10" fill="none" stroke={s.accent} stroke-width="1.8" />
      <text x={X[i] + W / 2} y="92" text-anchor="middle" fill={s.accent} font-family={FONT} font-size="11" font-weight="800">{s.name}</text>
      <text x={X[i] + W / 2} y="106" text-anchor="middle" fill={C.muted} font-family={FONT} font-size="7.5">{s.rule}</text>
      <rect x={X[i] + 20} y="116" width={W - 40} height="26" rx="6" fill={C.white} stroke={s.accent} stroke-width="1.4" />
      <text x={X[i] + W / 2} y="133" text-anchor="middle" fill={C.dark} font-family={FONT} font-size="12" font-weight="800">{s.value}</text>
      <text x={X[i] + 12} y="160" fill={C.dark} font-family={FONT} font-size="8">{s.protects.split(" — ")[0]}</text>
      {s.protects.includes(" — ") && (
        <text x={X[i] + 12} y="172" fill={C.muted} font-family={FONT} font-size="7.5">{s.protects.split(" — ")[1]}</text>
      )}
      {i < stages.length - 1 && (
        <g>
          <line x1={X[i] + W + 3} y1="129" x2={X[i] + W + 13} y2="129" stroke={C.border} stroke-width="1.6" />
        </g>
      )}
    </g>
  ))}

  <rect x="24" y="200" width="672" height="34" rx="8" fill={C.primaryLight} stroke={C.primary} stroke-width="1.6" />
  <text x="40" y="221" fill={C.dark} font-family={FONT} font-size="10.5" font-weight="700">
    {`The ${ocpd} A device is ${fmt(ocpd / ampacityOf(cond, "copper", 75)!, 2)}× the conductor's ampacity — legal because the overload, not the breaker, protects it.`}
  </text>

  <text x="24" y="250" fill={C.muted} font-family={FONT} font-size="10">{`EGC is keyed to the ${ocpd} A device, so ${egcSize(ocpd, "copper")} AWG Cu — larger than the circuit conductors.`}</text>
</svg>
