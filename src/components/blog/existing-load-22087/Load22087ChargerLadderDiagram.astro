---
import { fmt } from "@/lib/nec";
import { C, FONT } from "../infographicTokens";

/**
 * The whole decision on the anchor house, and the reason to run this calculation
 * before quoting an upgrade: the 32 A charger fits with 5.0 A spare and the 40 A
 * charger misses by exactly 5.0 A. Two adjacent product choices, and one of them
 * costs four thousand dollars more.
 */
const PEAK = 44;
const SERVICE = 100;
const existing = PEAK * 1.25;

const chargers = [16, 24, 32, 40, 48].map((amps) => {
  const added = amps * 1.25;
  const total = existing + added;
  return { amps, added, total, fits: total <= SERVICE, margin: SERVICE - total, kw: (amps * 240) / 1000 };
});

const BAR_X = 246;
const BAR_MAX = 300;
const peakTotal = Math.max(...chargers.map((c) => c.total));
const serviceX = BAR_X + Math.round((SERVICE / peakTotal) * BAR_MAX);
const bars = chargers.map((c) => ({ ...c, width: Math.round((c.total / peakTotal) * BAR_MAX) }));
const largestFitting = chargers.filter((c) => c.fits).slice(-1)[0];
const firstFailing = chargers.find((c) => !c.fits)!;
---

<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 720 292" fill="none" aria-hidden="true">
  <title>Which EV charger fits the existing service</title>
  <desc>
    On a house with a 44 amp recorded peak and a 100 amp service, the established existing load is 55 amps. A 16 amp
    charger totals 75.0 amps, a 24 amp charger 85.0, and a 32 amp charger 95.0 amps — all fitting. A 40 amp charger
    totals 105.0 amps and a 48 amp charger 115.0 amps, both exceeding the service. The 32 amp charger fits with 5.0
    amps to spare and the 40 amp charger misses by exactly 5.0 amps.
  </desc>

  <rect x="8" y="8" width="704" height="276" rx="12" fill={C.panelBg} stroke={C.border} />
  <text x="24" y="36" fill={C.dark} font-family={FONT} font-size="14" font-weight="700">The charger you specify is the whole decision</text>
  <text x="24" y="54" fill={C.muted} font-family={FONT} font-size="11">{`${fmt(existing, 1)} A of established existing load, plus each charger at 125%, against a ${SERVICE} A service.`}</text>

  <text x="28" y="78" fill={C.muted} font-family={FONT} font-size="8" font-weight="700">CHARGER</text>
  <text x={BAR_X} y="78" fill={C.muted} font-family={FONT} font-size="8" font-weight="700">TOTAL CALCULATED LOAD</text>

  <line x1={serviceX} y1="84" x2={serviceX} y2="248" stroke={C.dark} stroke-width="1.4" stroke-dasharray="4 3" />
  <text x={serviceX + 5} y="94" fill={C.dark} font-family={FONT} font-size="8" font-weight="700">{`${SERVICE} A`}</text>

  {bars.map((c, i) => {
    const y = 98 + i * 30;
    const accent = c.fits ? C.green : C.red;
    return (
      <g>
        <text x="28" y={y + 15} fill={C.dark} font-family={FONT} font-size="10.5" font-weight="700">{`${c.amps} A`}</text>
        <text x="70" y={y + 15} fill={C.muted} font-family={FONT} font-size="8.5">{`${fmt(c.kw, 1)} kW · +${fmt(c.added, 1)} A`}</text>
        <rect x={BAR_X} y={y + 2} width={c.width} height="20" rx="5" fill={accent} opacity="0.16" />
        <rect x={BAR_X} y={y + 2} width={c.width} height="20" rx="5" fill="none" stroke={accent} stroke-width={c.fits ? 1.5 : 2.2} />
        <text x={BAR_X + 8} y={y + 16} fill={C.dark} font-family={FONT} font-size="10.5" font-weight="800">{`${fmt(c.total, 1)} A`}</text>
        <text x={BAR_X + c.width + 8} y={y + 16} fill={accent} font-family={FONT} font-size="8.5" font-weight="700">
          {c.fits ? `${fmt(c.margin, 1)} A spare` : `${fmt(-c.margin, 1)} A over`}
        </text>
      </g>
    );
  })}

  <text x="24" y="268" fill={C.muted} font-family={FONT} font-size="10">
    {`${largestFitting?.amps} A fits with ${fmt(largestFitting!.margin, 1)} A spare; ${firstFailing.amps} A misses by ${fmt(-firstFailing.margin, 1)} A. One product choice, one panel upgrade.`}
  </text>
</svg>
