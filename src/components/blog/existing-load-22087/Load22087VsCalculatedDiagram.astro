---
import { fmt } from "@/lib/nec";
import { C, FONT } from "../infographicTokens";

/**
 * The same 2,000 ft² all-electric house by all three methods. The calculated
 * methods say a 125 A service; the measured method says the 100 A service has
 * room for a car charger. That gap is the entire argument for 220.87.
 */
const SERVICE = 100;
const PEAK = 44;

const methods = [
  { name: "220.42 standard", detail: "Part III, appliance by appliance", amps: 122.2, accent: C.red },
  { name: "220.82 optional", detail: "10,000 VA at 100%, remainder at 40%", amps: 101.2, accent: C.orange },
  { name: "220.87 measured", detail: `${PEAK} A utility peak × 1.25`, amps: PEAK * 1.25, accent: C.green },
];

const BAR_X = 232;
const BAR_MAX = 320;
const peak = Math.max(...methods.map((m) => m.amps));
const serviceX = BAR_X + Math.round((SERVICE / peak) * BAR_MAX);
const bars = methods.map((m) => ({ ...m, width: Math.round((m.amps / peak) * BAR_MAX) }));
const gap = methods[1].amps - methods[2].amps;
---

<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 720 260" fill="none" aria-hidden="true">
  <title>The same house by three load-calculation methods</title>
  <desc>
    A 2,000 square foot all-electric house calculates to 122.2 amps by the standard method of Part III, 101.2 amps by
    the optional method of 220.82, and 55.0 amps by the measured method of 220.87 using a 44 amp utility peak times
    125 percent. The two calculated methods both exceed a 100 amp service; the measured method sits 45 amps below it.
  </desc>

  <rect x="8" y="8" width="704" height="244" rx="12" fill={C.panelBg} stroke={C.border} />
  <text x="24" y="36" fill={C.dark} font-family={FONT} font-size="14" font-weight="700">One house, three legal answers</text>
  <text x="24" y="54" fill={C.muted} font-family={FONT} font-size="11">{`A 2,000 ft² all-electric house on a ${SERVICE} A service. All three methods are in the code.`}</text>

  <line x1={serviceX} y1="72" x2={serviceX} y2="196" stroke={C.dark} stroke-width="1.4" stroke-dasharray="4 3" />
  <text x={serviceX + 5} y="82" fill={C.dark} font-family={FONT} font-size="8" font-weight="700">{`${SERVICE} A service`}</text>

  {bars.map((m, i) => {
    const y = 90 + i * 38;
    const over = m.amps > SERVICE;
    return (
      <g>
        <text x="28" y={y + 15} fill={C.dark} font-family={FONT} font-size="10.5" font-weight="700">{m.name}</text>
        <text x="28" y={y + 27} fill={C.muted} font-family={FONT} font-size="7.5">{m.detail}</text>
        <rect x={BAR_X} y={y + 2} width={m.width} height="22" rx="5" fill={m.accent} opacity="0.16" />
        <rect x={BAR_X} y={y + 2} width={m.width} height="22" rx="5" fill="none" stroke={m.accent} stroke-width={over ? 2.2 : 1.5} />
        <text x={BAR_X + 9} y={y + 18} fill={C.dark} font-family={FONT} font-size="11.5" font-weight="800">{`${fmt(m.amps, 1)} A`}</text>
        <text x={BAR_X + m.width + 9} y={y + 18} fill={m.accent} font-family={FONT} font-size="8.5" font-weight="700">
          {over ? "needs 125 A" : "fits 100 A"}
        </text>
      </g>
    );
  })}

  <rect x="24" y="206" width="672" height="34" rx="8" fill={C.primaryLight} stroke={C.primary} stroke-width="1.6" />
  <text x="40" y="227" fill={C.dark} font-family={FONT} font-size="10.5" font-weight="700">
    {`${fmt(gap, 1)} A apart. The calculated methods model a hypothetical worst case; 220.87 measures what the house does.`}
  </text>
</svg>
