---
import { C, FONT, markerDefs } from "../infographicTokens";

const defs = markerDefs("ests");

/**
 * The five stages of a real estimate. The last two are where most small contractors
 * lose money — overhead gets omitted, and margin gets confused with markup.
 */
const stages = [
  {
    n: "1",
    title: "Takeoff",
    body: ["Count every device, fixture,", "home run and foot of wire", "off the plan or the walkthrough."],
    accent: C.blue,
    bg: C.blueLight,
  },
  {
    n: "2",
    title: "Assemblies",
    body: ["Price a receptacle as a unit —", "box, device, plate, wire, staples,", "connectors — not item by item."],
    accent: C.blue,
    bg: C.blueLight,
  },
  {
    n: "3",
    title: "Labor units",
    body: ["Hours per assembly, from NECA", "MLU or your own job history.", "Yours beats published every time."],
    accent: C.primary,
    bg: C.primaryLight,
  },
  {
    n: "4",
    title: "Overhead",
    body: ["Truck, insurance, software,", "unbillable time. A percentage", "on direct cost — never zero."],
    accent: C.orange,
    bg: C.orangeLight,
  },
  {
    n: "5",
    title: "Margin",
    body: ["Divide by (1 − margin).", "Do not multiply by (1 + margin)", "— that's markup, and it's less."],
    accent: C.red,
    bg: C.redLight,
  },
];
---

<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 720 250" fill="none" aria-hidden="true">
  <title>The five stages of an electrical estimate</title>
  <desc>
    Stage one, takeoff: count every device, fixture, home run and foot of wire from the plan or walkthrough.
    Stage two, assemblies: price a receptacle as a complete unit including box, device, plate, wire, staples and
    connectors rather than item by item. Stage three, labor units: hours per assembly, taken from NECA manual
    labor units or preferably your own job history. Stage four, overhead: truck, insurance, software and
    unbillable time, applied as a percentage of direct cost and never omitted. Stage five, margin: divide by one
    minus the margin rather than multiplying by one plus it, because multiplying gives you markup instead.
  </desc>

  <defs set:html={defs} />

  <rect x="8" y="8" width="704" height="234" rx="12" fill={C.panelBg} stroke={C.border} />
  <text x="24" y="36" fill={C.dark} font-family={FONT} font-size="14" font-weight="700">Five stages — and the last two are where the money is lost</text>
  <text x="24" y="54" fill={C.muted} font-family={FONT} font-size="11">Most under-priced jobs are correct through stage 3 and wrong at 4 or 5</text>

  {stages.map((s, i) => {
    const x = 24 + i * 137;
    return (
      <g>
        <rect x={x} y="74" width="126" height="152" rx="9" fill={s.bg} stroke={s.accent} stroke-width="1.5" />
        <circle cx={x + 21} cy="98" r="12" fill={C.white} stroke={s.accent} stroke-width="1.4" />
        <text x={x + 21} y="103" text-anchor="middle" fill={s.accent} font-family={FONT} font-size="12" font-weight="800">{s.n}</text>
        <text x={x + 40} y="102" fill={C.dark} font-family={FONT} font-size="10.5" font-weight="800">{s.title}</text>
        <text x={x + 12} y="130" fill={C.muted} font-family={FONT} font-size="9">
          {s.body.map((line, li) => (
            <tspan x={x + 12} dy={li === 0 ? "0" : "12"}>{line}</tspan>
          ))}
        </text>
        {i !== stages.length - 1 && (
          <path d={`M${x + 130} 150 L ${x + 133} 150`} stroke={C.border} stroke-width="1.6" marker-end="url(#ests-arrow-muted)" />
        )}
      </g>
    );
  })}
</svg>
