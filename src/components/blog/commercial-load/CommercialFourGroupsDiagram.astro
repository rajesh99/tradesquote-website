---
import { C, FONT } from "../infographicTokens";

/**
 * The four load groups of the Part III standard method, sized to the reference
 * 5,000 ft² retail store. The point of the layout is that each group carries its
 * own demand rule — two get a factor, two never do.
 */
const AREA = 5000;
const VA_FT2 = 3;
const STRAPS = 40;
const WINDOW_FT = 30;
const TRACK_FT = 20;
const HVAC = 25000;

const groups = [
  {
    name: "General lighting",
    rule: "area × VA/ft²  ·  Table 220.42",
    connected: AREA * VA_FT2,
    demand: AREA * VA_FT2,
    accent: C.blue,
    factored: true,
  },
  {
    name: "Show window",
    rule: "200 VA per linear foot  ·  no factor",
    connected: WINDOW_FT * 200,
    demand: WINDOW_FT * 200,
    accent: C.orange,
    factored: false,
  },
  {
    name: "Track lighting",
    rule: "150 VA per 2 ft  ·  no factor",
    connected: Math.ceil(TRACK_FT / 2) * 150,
    demand: Math.ceil(TRACK_FT / 2) * 150,
    accent: C.orange,
    factored: false,
  },
  {
    name: "Receptacles",
    rule: "180 VA per strap  ·  Table 220.44",
    connected: STRAPS * 180,
    demand: STRAPS * 180,
    accent: C.primary,
    factored: true,
  },
  {
    name: "HVAC and everything else",
    rule: "at 100%",
    connected: HVAC,
    demand: HVAC,
    accent: C.muted,
    factored: false,
  },
];

const total = groups.reduce((s, g) => s + g.demand, 0);
const amps = total / (Math.sqrt(3) * 208);

const BAR_X = 250;
const BAR_MAX = 300;
const peak = Math.max(...groups.map((g) => g.demand));
const bars = groups.map((g) => ({
  ...g,
  width: Math.max(20, Math.round((g.demand / peak) * BAR_MAX)),
}));
const fmt = (n: number) => n.toLocaleString("en-US");
---

<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 720 306" fill="none" aria-hidden="true">
  <title>The four load groups of a commercial load calculation</title>
  <desc>
    A 5,000 square foot retail store worked by the NEC Article 220 Part III standard method. General lighting is
    15,000 volt-amperes, show window lighting 6,000, track lighting 1,500, receptacles 7,200 and HVAC 25,000, for a
    total calculated load of 54,700 volt-amperes, or 151.8 amperes on a 208 volt three-phase service. General
    lighting and receptacles each carry their own demand factor; show window, track and HVAC do not.
  </desc>

  <rect x="8" y="8" width="704" height="290" rx="12" fill={C.panelBg} stroke={C.border} />
  <text x="24" y="34" fill={C.dark} font-family={FONT} font-size="14" font-weight="700">
    Four groups, four different rules
  </text>
  <text x="24" y="52" fill={C.muted} font-family={FONT} font-size="11">
    {`A ${fmt(AREA)} ft² retail store at ${VA_FT2} VA/ft², ${STRAPS} straps, ${WINDOW_FT} ft of show window.`}
  </text>

  {bars.map((g, i) => {
    const y = 70 + i * 40;
    return (
      <g>
        <text x="28" y={y + 13} fill={C.dark} font-family={FONT} font-size="10.5" font-weight="700">{g.name}</text>
        <text x="28" y={y + 27} fill={C.muted} font-family={FONT} font-size="8.5">{g.rule}</text>
        <rect x={BAR_X} y={y + 2} width={g.width} height="19" rx="5" fill={g.accent} opacity="0.16" />
        <rect x={BAR_X} y={y + 2} width={g.width} height="19" rx="5" fill="none" stroke={g.accent} stroke-width="1.6" />
        <text x={BAR_X + 8} y={y + 16} fill={C.dark} font-family={FONT} font-size="10.5" font-weight="800">
          {fmt(g.demand)}
        </text>
        <text x={BAR_X + g.width + 8} y={y + 16} fill={C.muted} font-family={FONT} font-size="8.5">VA</text>
      </g>
    );
  })}

  <line x1="24" y1="272" x2="696" y2="272" stroke={C.border} />
  <text x="28" y="290" fill={C.dark} font-family={FONT} font-size="11" font-weight="800">
    {`Calculated load ${fmt(total)} VA ÷ (1.732 × 208 V) = ${amps.toFixed(1)} A → 175 A service`}
  </text>
</svg>
