---
import { C, FONT } from "../infographicTokens";
import { TABLE_220_12 } from "@/lib/nec";

/**
 * Occupancy dominates a commercial load calculation more than floor area does.
 * A warehouse four times the size of a store carries a twelfth of its lighting
 * density, so the bigger building needs the smaller service.
 */
const SHOWN = ["office", "bank", "store", "school", "restaurant", "hospital", "garage", "warehouse"];
const rows = SHOWN.map((key) => TABLE_220_12.find((r) => r.key === key)!).filter(Boolean);

const peak = Math.max(...rows.map((r) => r.vaPerFt2));
const BAR_X = 230;
const BAR_MAX = 300;
const bars = rows.map((r) => ({
  ...r,
  width: Math.max(8, Math.round((r.vaPerFt2 / peak) * BAR_MAX)),
  per10k: r.vaPerFt2 * 10000,
}));
const fmt = (n: number) => n.toLocaleString("en-US");

const store = rows.find((r) => r.key === "store")!;
const warehouse = rows.find((r) => r.key === "warehouse")!;
const ratio = store.vaPerFt2 / warehouse.vaPerFt2;
---

<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 720 330" fill="none" aria-hidden="true">
  <title>General lighting load by occupancy</title>
  <desc>
    Volt-amperes per square foot by occupancy type. An office is 3.5, a store and a school 3, a restaurant and a
    hospital 2, a commercial garage 0.5, and a warehouse 0.25 — a twelvefold spread between a store and a
    warehouse, which is why occupancy matters more than floor area in a commercial load calculation.
  </desc>

  <rect x="8" y="8" width="704" height="314" rx="12" fill={C.panelBg} stroke={C.border} />
  <text x="24" y="34" fill={C.dark} font-family={FONT} font-size="14" font-weight="700">
    Occupancy decides more than floor area does
  </text>
  <text x="24" y="52" fill={C.muted} font-family={FONT} font-size="11">
    General lighting VA per ft², with what each gives across a 10,000 ft² building.
  </text>

  {bars.map((r, i) => {
    const y = 68 + i * 28;
    const highlight = r.key === "store" || r.key === "warehouse";
    const accent = highlight ? C.blue : C.muted;
    return (
      <g>
        <text
          x="28"
          y={y + 14}
          fill={highlight ? C.dark : C.muted}
          font-family={FONT}
          font-size="10"
          font-weight={highlight ? "700" : "500"}
        >
          {r.occupancy}
        </text>
        <rect x={BAR_X} y={y + 2} width={r.width} height="17" rx="4" fill={accent} opacity="0.16" />
        <rect x={BAR_X} y={y + 2} width={r.width} height="17" rx="4" fill="none" stroke={accent} stroke-width="1.5" />
        <text x={BAR_X + 7} y={y + 15} fill={C.dark} font-family={FONT} font-size="10" font-weight="800">
          {r.vaPerFt2}
        </text>
        <text x={BAR_X + r.width + 9} y={y + 15} fill={C.muted} font-family={FONT} font-size="8.5">
          {`VA/ft²  →  ${fmt(r.per10k)} VA`}
        </text>
      </g>
    );
  })}

  <line x1="24" y1="296" x2="696" y2="296" stroke={C.border} />
  <text x="28" y="314" fill={C.dark} font-family={FONT} font-size="10" font-weight="700">
    {`A store carries ${ratio}× a warehouse per square foot — so the larger warehouse takes the smaller service.`}
  </text>
</svg>
