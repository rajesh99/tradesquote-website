---
import { C, FONT } from "../infographicTokens";
import { TABLE_220_44, applyDemandTiers, VA_PER_RECEPTACLE_STRAP } from "@/lib/nec";

/**
 * Table 220.44 does nothing at all until the receptacle load passes 10 kVA, which
 * takes 56 straps. Below that the "demand factor" is a 100% pass-through — the
 * thing most people miss when they assume every table reduces something.
 */
const CROSSOVER_STRAPS = Math.ceil(10000 / VA_PER_RECEPTACLE_STRAP);

const rows = [20, 40, 56, 80, 120, 200, 400].map((straps) => {
  const connected = straps * VA_PER_RECEPTACLE_STRAP;
  const { demandVa } = applyDemandTiers(connected, TABLE_220_44);
  return { straps, connected, demand: demandVa, saved: connected - demandVa };
});

const peak = Math.max(...rows.map((r) => r.connected));
const BAR_X = 108;
const BAR_MAX = 380;
const bars = rows.map((r) => ({
  ...r,
  fullWidth: Math.max(4, Math.round((r.connected / peak) * BAR_MAX)),
  demandWidth: Math.max(4, Math.round((r.demand / peak) * BAR_MAX)),
}));
const fmt = (n: number) => n.toLocaleString("en-US");
---

<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 720 296" fill="none" aria-hidden="true">
  <title>Where the receptacle demand factor starts working</title>
  <desc>
    Table 220.44 applies no reduction at all until the receptacle load exceeds 10,000 volt-amperes, which takes 56
    straps at 180 volt-amperes each. Twenty straps give 3,600 volt-amperes with no reduction; 200 straps give
    36,000 connected but only 23,000 after the demand factor, removing 13,000 volt-amperes.
  </desc>

  <rect x="8" y="8" width="704" height="280" rx="12" fill={C.panelBg} stroke={C.border} />
  <text x="24" y="34" fill={C.dark} font-family={FONT} font-size="14" font-weight="700">
    Table 220.44 does nothing until 10 kVA
  </text>
  <text x="24" y="52" fill={C.muted} font-family={FONT} font-size="11">
    {`Outline is connected load, solid is after the demand factor. The crossover is ${CROSSOVER_STRAPS} straps.`}
  </text>

  {bars.map((r, i) => {
    const y = 68 + i * 28;
    const reduced = r.saved > 0;
    return (
      <g>
        <text x="28" y={y + 14} fill={C.dark} font-family={FONT} font-size="10" font-weight="700">
          {`${r.straps} straps`}
        </text>
        <rect x={BAR_X} y={y + 3} width={r.fullWidth} height="16" rx="4" fill="none" stroke={C.border} stroke-width="1.4" />
        <rect
          x={BAR_X}
          y={y + 3}
          width={r.demandWidth}
          height="16"
          rx="4"
          fill={reduced ? C.primary : C.muted}
          opacity="0.2"
        />
        <rect
          x={BAR_X}
          y={y + 3}
          width={r.demandWidth}
          height="16"
          rx="4"
          fill="none"
          stroke={reduced ? C.primary : C.muted}
          stroke-width="1.6"
        />
        <text x={BAR_X + r.fullWidth + 9} y={y + 15} fill={C.dark} font-family={FONT} font-size="9.5" font-weight="700">
          {`${fmt(r.demand)} VA`}
        </text>
        <text x={BAR_X + r.fullWidth + 78} y={y + 15} fill={reduced ? C.primary : C.muted} font-family={FONT} font-size="8.5">
          {reduced ? `−${fmt(r.saved)}` : "no reduction"}
        </text>
      </g>
    );
  })}

  <line x1="24" y1="262" x2="696" y2="262" stroke={C.border} />
  <text x="28" y="278" fill={C.muted} font-family={FONT} font-size="10">
    First 10,000 VA at 100%, the remainder at 50%. Below 56 straps the table is a pass-through.
  </text>
</svg>
