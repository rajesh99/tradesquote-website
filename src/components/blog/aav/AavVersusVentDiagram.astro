---
import { C, FONT } from "../infographicTokens";
import { ventSize, sizeLabel, VENT_LENGTH_UPSIZE_FEET, MIN_VENT_SIZE } from "@/lib/plumbing";

/**
 * Side by side on the four functions a vent performs. The AAV column is a
 * single tick and three crosses, which is the argument in one image.
 */
const DRAIN = 2;
const DEV_FT = 30;
const dryVent = ventSize(DRAIN, DEV_FT);

const FUNCTIONS = [
  {
    fn: "Admit air to break a siphon",
    vent: true,
    aav: true,
    note: "The only function they share",
  },
  {
    fn: "Relieve positive pressure",
    vent: true,
    aav: false,
    note: "An AAV seals harder as pressure rises",
  },
  {
    fn: "Vent sewer gas to atmosphere",
    vent: true,
    aav: false,
    note: "Gas has to leave the system somewhere",
  },
  {
    fn: "Work with no moving parts",
    vent: true,
    aav: false,
    note: "A diaphragm is a wear item; open pipe is not",
  },
];

const ROW_H = 38;
const TOP = 96;
---

<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 720 288" fill="none" aria-hidden="true">
  <title>An air admittance valve compared with a conventional vent</title>
  <desc>
    A vent performs four functions. An air admittance valve performs one of them, which is why it can reduce the
    number of vents but never replace the last one.
  </desc>

  <rect x="8" y="8" width="704" height="272" rx="12" fill={C.panelBg} stroke={C.border} />
  <text x="24" y="34" fill={C.dark} font-family={FONT} font-size="14" font-weight="700">A vent does four things. An AAV does one.</text>
  <text x="24" y="52" fill={C.muted} font-family={FONT} font-size="11">
    {`Example: a ${sizeLabel(DRAIN)} drain over ${DEV_FT} ft takes a ${sizeLabel(dryVent.size)} dry vent under IPC 906.2, floor ${sizeLabel(MIN_VENT_SIZE)}.`}
  </text>

  <text x="34" y="86" fill={C.muted} font-family={FONT} font-size="8" font-weight="700">FUNCTION</text>
  <text x={452} y="86" text-anchor="middle" fill={C.primary} font-family={FONT} font-size="8" font-weight="700">OPEN VENT</text>
  <text x={556} y="86" text-anchor="middle" fill={C.orange} font-family={FONT} font-size="8" font-weight="700">AAV</text>

  {FUNCTIONS.map((row, i) => {
    const y = TOP + i * ROW_H;
    const only = row.vent && !row.aav;
    return (
      <g>
        <rect x="24" y={y} width="672" height={ROW_H - 6} rx="7" fill={only ? C.red : C.primary} opacity="0.07" />
        <text x="40" y={y + 15} fill={C.dark} font-family={FONT} font-size="10.5" font-weight="700">{row.fn}</text>
        <text x="40" y={y + 27} fill={C.muted} font-family={FONT} font-size="8.5">{row.note}</text>
        <circle cx={452} cy={y + 15} r="9" fill={C.primary} opacity="0.85" />
        <text x={452} y={y + 19} text-anchor="middle" fill={C.white} font-family={FONT} font-size="10" font-weight="800">✓</text>
        <circle cx={556} cy={y + 15} r="9" fill={row.aav ? C.primary : C.red} opacity={row.aav ? 0.85 : 0.85} />
        <text x={556} y={y + 19} text-anchor="middle" fill={C.white} font-family={FONT} font-size="10" font-weight="800">
          {row.aav ? "✓" : "✕"}
        </text>
      </g>
    );
  })}

  <rect x="24" y="250" width="672" height="24" rx="6" fill={C.orangeLight} stroke={C.orange} stroke-width="1.4" />
  <text x="36" y="266" fill={C.orange} font-family={FONT} font-size="10" font-weight="700">
    {`A vent over ${VENT_LENGTH_UPSIZE_FEET} ft of developed length also gets upsized. An AAV has no length to upsize — it is at the fixture, which is its one real advantage.`}
  </text>
</svg>
