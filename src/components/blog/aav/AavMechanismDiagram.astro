---
import { C, FONT, markerDefs } from "../infographicTokens";
import { ventSize, sizeLabel, MIN_VENT_SIZE } from "@/lib/plumbing";

/**
 * One-way, one job. The AAV opens on negative pressure and seals on positive,
 * which is exactly why it can substitute for a vent's supply function and never
 * for its relief function.
 *
 * The vent size it stands in for is computed rather than named, so the figure
 * states what the AAV is actually replacing.
 */
const defs = markerDefs("aav");
const DRAIN = 2;
const DEV_FT = 30;
const replaces = ventSize(DRAIN, DEV_FT).size;
---

<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 720 268" fill="none" aria-hidden="true">
  <title>What an air admittance valve does and does not do</title>
  <desc>
    An air admittance valve opens under negative pressure to admit air and seals under positive pressure. It can
    replace a vent's ability to supply air, never its ability to relieve pressure.
  </desc>
  <defs set:html={defs} />

  <rect x="8" y="8" width="704" height="252" rx="12" fill={C.panelBg} stroke={C.border} />
  <text x="24" y="34" fill={C.dark} font-family={FONT} font-size="14" font-weight="700">A one-way device doing half a vent's job</text>
  <text x="24" y="52" fill={C.muted} font-family={FONT} font-size="11">
    {`Standing in for the ${sizeLabel(replaces)} dry vent a ${sizeLabel(DRAIN)} drain would take. Negative pressure lifts the diaphragm; positive pressure seats it harder.`}
  </text>

  <rect x="24" y="70" width="330" height="140" rx="10" fill={C.primaryLight} stroke={C.primary} stroke-width="2" />
  <text x="40" y="90" fill={C.primary} font-family={FONT} font-size="9" font-weight="700">NEGATIVE PRESSURE — IT OPENS</text>
  <line x1="188" y1="106" x2="188" y2="146" stroke={C.primary} stroke-width="2.4" marker-end="url(#aav-arrow-primary)" />
  <text x="60" y="122" fill={C.dark} font-family={FONT} font-size="10.5" font-weight="700">room air in</text>
  <rect x="140" y="146" width="96" height="16" rx="4" fill={C.white} stroke={C.primary} stroke-width="2" />
  <text x="188" y="158" text-anchor="middle" fill={C.primary} font-family={FONT} font-size="8.5" font-weight="700">diaphragm lifts</text>
  <text x="40" y="186" fill={C.dark} font-family={FONT} font-size="10">Breaks the siphon. The trap seal stays.</text>
  <text x="40" y="201" fill={C.muted} font-family={FONT} font-size="9">This is the whole of what it can do.</text>

  <rect x="366" y="70" width="330" height="140" rx="10" fill={C.redLight} stroke={C.red} stroke-width="2" />
  <text x="382" y="90" fill={C.red} font-family={FONT} font-size="9" font-weight="700">POSITIVE PRESSURE — IT SEALS</text>
  <line x1="530" y1="146" x2="530" y2="112" stroke={C.red} stroke-width="2.4" stroke-dasharray="5 4" />
  <line x1="518" y1="112" x2="542" y2="112" stroke={C.red} stroke-width="3" stroke-linecap="round" />
  <text x="556" y="118" fill={C.red} font-family={FONT} font-size="10.5" font-weight="700">nothing gets out</text>
  <rect x="482" y="146" width="96" height="16" rx="4" fill={C.white} stroke={C.red} stroke-width="2" />
  <text x="530" y="158" text-anchor="middle" fill={C.red} font-family={FONT} font-size="8.5" font-weight="700">diaphragm seats</text>
  <text x="382" y="186" fill={C.dark} font-family={FONT} font-size="10">Pressure has to leave somewhere else.</text>
  <text x="382" y="201" fill={C.muted} font-family={FONT} font-size="9">Usually up through a trap, into the room.</text>

  <text x="24" y="232" fill={C.dark} font-family={FONT} font-size="10.5" font-weight="700">
    That asymmetry is the entire limitation: an AAV reduces the number of vents, and never removes the last one.
  </text>
  <text x="24" y="250" fill={C.muted} font-family={FONT} font-size="10">
    {`A system with only AAVs has no path to atmosphere at all — and the ${sizeLabel(MIN_VENT_SIZE)} floor and every trap arm limit still apply exactly as before.`}
  </text>
</svg>
