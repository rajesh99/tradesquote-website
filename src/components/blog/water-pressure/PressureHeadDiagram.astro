---
import { C, FONT } from "../infographicTokens";
import {
  psiToHead, PRV_THRESHOLD_PSI, PSI_PER_FOOT_HEAD,
} from "@/lib/plumbing";
/** Pressure and head are the same quantity in different units. 0.4331 psi per
 * foot is the whole conversion, and IPC 604.8 draws the line at 80 psi. */
const PRESSURES = [30, 40, 50, 60, 65, 80, 100];

const rows = PRESSURES.map((psi) => {
  const low = psi < 40;
  const high = psi > PRV_THRESHOLD_PSI;
  return {
    label: `${psi} psi`,
    cells: [
      `${psiToHead(psi).toFixed(1)} ft`,
      `${(psi / PSI_PER_FOOT_HEAD / 10).toFixed(1)} storeys`,
      high ? "PRV required" : low ? "below comfort" : "normal range",
    ],
    tone: ["neutral", "neutral", high ? "bad" : low ? "bad" : "good"],
  };
});
---

<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 720 340" fill="none" aria-hidden="true">
  <title>Pressure, head, and where the code draws its line</title>
  <desc>psi to feet of head at 0.4331 psi per foot; IPC 604.8 requires a pressure-reducing valve above 80 psi</desc>

  <rect x="8" y="8" width="704" height="326" rx="12" fill={C.panelBg} stroke={C.border} />
  <text x="24" y="34" fill={C.dark} font-family={FONT} font-size="14" font-weight="700">Pressure, head, and where the code draws its line</text>
  <text x="24" y="52" fill={C.muted} font-family={FONT} font-size="11">psi to feet of head at 0.4331 psi per foot; IPC 604.8 requires a pressure-reducing valve above 80 psi</text>

  <text x="28" y="76" fill={C.muted} font-family={FONT} font-size="8" font-weight="700">STATIC PRESSURE</text>
  <text x={302} y="76" text-anchor="middle" fill={C.muted} font-family={FONT} font-size="8" font-weight="700">EQUIVALENT HEAD</text>
  <text x={454} y="76" text-anchor="middle" fill={C.muted} font-family={FONT} font-size="8" font-weight="700">STOREYS IT LIFTS</text>
  <text x={606} y="76" text-anchor="middle" fill={C.muted} font-family={FONT} font-size="8" font-weight="700">VERDICT</text>

  {rows.map((row, i) => {
    const y = 86 + i * 30;
    return (
      <g>
        <text x="28" y={y + 16} fill={C.dark} font-family={FONT} font-size="10.5" font-weight="700">{row.label}</text>
            <rect x={232} y={y} width={140} height="24" rx="6" fill={row.tone[0] === "bad" ? C.red : row.tone[0] === "good" ? C.green : C.orange} opacity={row.tone[0] === "bad" ? 0.18 : 0.1} />
            <rect x={232} y={y} width={140} height="24" rx="6" fill="none" stroke={row.tone[0] === "bad" ? C.red : row.tone[0] === "good" ? C.green : C.orange} stroke-width={row.tone[0] === "bad" ? 2 : 1.2} />
            <text x={302} y={y + 16} text-anchor="middle" fill={row.tone[0] === "bad" ? C.red : row.tone[0] === "good" ? C.green : C.orange} font-family={FONT} font-size="10.5" font-weight={row.tone[0] === "bad" ? 800 : 700}>
              {row.cells[0]}
            </text>
            <rect x={384} y={y} width={140} height="24" rx="6" fill={row.tone[1] === "bad" ? C.red : row.tone[1] === "good" ? C.green : C.orange} opacity={row.tone[1] === "bad" ? 0.18 : 0.1} />
            <rect x={384} y={y} width={140} height="24" rx="6" fill="none" stroke={row.tone[1] === "bad" ? C.red : row.tone[1] === "good" ? C.green : C.orange} stroke-width={row.tone[1] === "bad" ? 2 : 1.2} />
            <text x={454} y={y + 16} text-anchor="middle" fill={row.tone[1] === "bad" ? C.red : row.tone[1] === "good" ? C.green : C.orange} font-family={FONT} font-size="10.5" font-weight={row.tone[1] === "bad" ? 800 : 700}>
              {row.cells[1]}
            </text>
            <rect x={536} y={y} width={140} height="24" rx="6" fill={row.tone[2] === "bad" ? C.red : row.tone[2] === "good" ? C.green : C.orange} opacity={row.tone[2] === "bad" ? 0.18 : 0.1} />
            <rect x={536} y={y} width={140} height="24" rx="6" fill="none" stroke={row.tone[2] === "bad" ? C.red : row.tone[2] === "good" ? C.green : C.orange} stroke-width={row.tone[2] === "bad" ? 2 : 1.2} />
            <text x={606} y={y + 16} text-anchor="middle" fill={row.tone[2] === "bad" ? C.red : row.tone[2] === "good" ? C.green : C.orange} font-family={FONT} font-size="10.5" font-weight={row.tone[2] === "bad" ? 800 : 700}>
              {row.cells[2]}
            </text>
      </g>
    );
  })}

  <text x="24" y="320" fill={C.muted} font-family={FONT} font-size="10">Above 80 psi a PRV stops being an upgrade and becomes a requirement. Below about 40 psi fixtures start to feel wrong.</text>
</svg>
