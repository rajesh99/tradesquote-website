---
import { C, FONT } from "../infographicTokens";
import {
  headToPsi,
} from "@/lib/plumbing";
/** Elevation loss is the one term in the whole system that does not care about
 * flow, pipe material, diameter or fittings. It is pure height. */
const START = 65;
const PER_STOREY = 10;
const STOREYS = [0, 1, 2, 3, 4, 5];

const results = STOREYS.map((s) => ({ s, psi: START - headToPsi(s * PER_STOREY) }));
const perStoreyCost = headToPsi(PER_STOREY);

const rows = results.map(({ s, psi }) => ({
  label: s === 0 ? "At the meter" : `Storey ${s}`,
  value: psi,
  frac: psi / START,
  display: `${psi.toFixed(2)} psi  ·  ${s === 0 ? "starting point" : `-${(headToPsi(s * PER_STOREY)).toFixed(2)} psi of lift`}`,
  highlight: s === 3,
}));

/* Bar geometry. The value label is drawn at BAR_X + width + 10, so BAR_MAX is
   chosen to leave room for the longest label inside the 720-wide viewBox. */
const BAR_X = 150;
const BAR_MAX = 250;
---

<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 720 308" fill="none" aria-hidden="true">
  <title>What each storey costs, starting from 65 psi</title>
  <desc>10 ft per storey at 0.4331 psi per foot — before a single drop of water moves</desc>

  <rect x="8" y="8" width="704" height="294" rx="12" fill={C.panelBg} stroke={C.border} />
  <text x="24" y="34" fill={C.dark} font-family={FONT} font-size="14" font-weight="700">What each storey costs, starting from 65 psi</text>
  <text x="24" y="52" fill={C.muted} font-family={FONT} font-size="11">10 ft per storey at 0.4331 psi per foot — before a single drop of water moves</text>

  {rows.map((row, i) => {
    const y = 82 + i * 30;
    const w = Math.max(2, row.frac * BAR_MAX);
    return (
      <g>
        <text x="28" y={y + 15} fill={C.dark} font-family={FONT} font-size="10.5" font-weight="700">{row.label}</text>
        <rect x={BAR_X} y={y + 3} width={BAR_MAX} height="18" rx="5" fill={C.border} opacity="0.28" />
        <rect x={BAR_X} y={y + 3} width={w} height="18" rx="5" fill={row.highlight ? C.primary : C.orange} opacity={row.highlight ? 0.95 : 0.62} />
        <text x={BAR_X + BAR_MAX + 10} y={y + 16} fill={row.highlight ? C.primary : C.dark} font-family={FONT} font-size="10.5" font-weight={row.highlight ? 800 : 600}>
          {row.display}
        </text>
      </g>
    );
  })}

  <text x="24" y="288" fill={C.muted} font-family={FONT} font-size="10">Every storey costs 4.33 psi flat. It is the only loss in the system that is completely independent of flow.</text>
</svg>
