---
import { C, FONT } from "../infographicTokens";
import {
  VELOCITY_CONSTANT,
  PSI_PER_FOOT_HEAD,
  FEET_HEAD_PER_PSI,
  LB_PER_GALLON,
  BTU_PER_GPM_PER_DEGF,
  insideDiameter,
  velocity,
  fmt,
} from "@/lib/plumbing";

/**
 * The sheet a reader should build before pasting anything. Values come from the
 * library so the worked answer in the picture is the calculator's answer.
 */
const ID_34 = insideDiameter("copper-l", 0.75) as number;
const GPM = 8;
const V = velocity(GPM, ID_34);

const INPUTS = [
  { name: "Flow", value: `${GPM}`, unit: "gpm" },
  { name: "Bore", value: `${ID_34}`, unit: "in" },
];

const CONSTANTS = [
  { name: "K_VEL", value: `${VELOCITY_CONSTANT}`, note: "velocity" },
  { name: "PSI_PER_FT", value: `${PSI_PER_FOOT_HEAD}`, note: "head" },
  { name: "FT_PER_PSI", value: `${fmt(FEET_HEAD_PER_PSI, 4)}`, note: "=1/PSI_PER_FT" },
  { name: "LB_GAL", value: `${LB_PER_GALLON}`, note: "water heating" },
  { name: "BTU_GPM_F", value: `${BTU_PER_GPM_PER_DEGF}`, note: "tankless" },
  { name: "CFS_GPM", value: "448.831", note: "Manning" },
];

const X = 24;
const COL_A = 44;
const COL_B = 150;
const COL_C = 250;
const ROW_H = 26;
const HEAD_Y = 96;
---

<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 720 415" fill="none" aria-hidden="true">
  <title>The spreadsheet layout every formula on the reference page assumes</title>

  <rect x="0" y="0" width="720" height="415" fill={C.white} />

  <text x={X} y="26" font-family={FONT} font-size="15" font-weight="700" fill={C.dark}>
    Build this sheet once, then paste any formula into it
  </text>
  <text x={X} y="46" font-family={FONT} font-size="11" fill={C.muted}>
    Labels in column A, values in column B, answers in column E. Name the constants and the formulas read like English.
  </text>

  {/* Column headers */}
  <rect x={X} y={HEAD_Y - 20} width="316" height="22" fill={C.panelBg} stroke={C.border} stroke-width="1" />
  <text x={COL_A} y={HEAD_Y - 5} font-family={FONT} font-size="10" font-weight="700" fill={C.muted}>A — label</text>
  <text x={COL_B} y={HEAD_Y - 5} font-family={FONT} font-size="10" font-weight="700" fill={C.muted}>B — value</text>
  <text x={COL_C} y={HEAD_Y - 5} font-family={FONT} font-size="10" font-weight="700" fill={C.muted}>C — unit</text>

  {/* Inputs block */}
  <text x={X} y={HEAD_Y + 18} font-family={FONT} font-size="10.5" font-weight="700" fill={C.blue}>INPUTS</text>
  {
    INPUTS.map((r, i) => (
      <g>
        <rect
          x={X}
          y={HEAD_Y + 24 + i * ROW_H}
          width="316"
          height={ROW_H}
          fill={i % 2 === 0 ? C.white : C.panelBg}
          stroke={C.border}
          stroke-width="0.5"
        />
        <text x={X + 8} y={HEAD_Y + 41 + i * ROW_H} font-family={FONT} font-size="9" fill={C.muted}>
          {i + 2}
        </text>
        <text x={COL_A} y={HEAD_Y + 41 + i * ROW_H} font-family={FONT} font-size="11" fill={C.dark}>
          {r.name}
        </text>
        <text x={COL_B} y={HEAD_Y + 41 + i * ROW_H} font-family={FONT} font-size="11" font-weight="600" fill={C.blue}>
          {r.value}
        </text>
        <text x={COL_C} y={HEAD_Y + 41 + i * ROW_H} font-family={FONT} font-size="10" fill={C.muted}>
          {r.unit}
        </text>
      </g>
    ))
  }

  {/* Constants block */}
  <text x={X} y={HEAD_Y + 100} font-family={FONT} font-size="10.5" font-weight="700" fill={C.primary}>
    CONSTANTS — from the calculator, not rounded
  </text>
  {
    CONSTANTS.map((r, i) => (
      <g>
        <rect
          x={X}
          y={HEAD_Y + 106 + i * ROW_H}
          width="316"
          height={ROW_H}
          fill={i % 2 === 0 ? C.white : C.panelBg}
          stroke={C.border}
          stroke-width="0.5"
        />
        <text x={X + 8} y={HEAD_Y + 123 + i * ROW_H} font-family={FONT} font-size="9" fill={C.muted}>
          {i + 5}
        </text>
        <text x={COL_A} y={HEAD_Y + 123 + i * ROW_H} font-family={FONT} font-size="10.5" fill={C.dark}>
          {r.name}
        </text>
        <text x={COL_B} y={HEAD_Y + 123 + i * ROW_H} font-family={FONT} font-size="11" font-weight="600" fill={C.primary}>
          {r.value}
        </text>
        <text x={COL_C} y={HEAD_Y + 123 + i * ROW_H} font-family={FONT} font-size="10" fill={C.muted}>
          {r.note}
        </text>
      </g>
    ))
  }

  {/* Result panel */}
  <rect x="376" y={HEAD_Y - 20} width="320" height="236" rx="8" fill={C.blueLight} stroke={C.blue} stroke-width="1" />
  <text x="392" y={HEAD_Y + 2} font-family={FONT} font-size="12" font-weight="700" fill={C.blue}>
    E2 — the formula, and what it returns
  </text>

  <rect x="392" y={HEAD_Y + 16} width="288" height="34" rx="5" fill={C.dark} />
  <text x="404" y={HEAD_Y + 38} font-family="ui-monospace, monospace" font-size="11" fill={C.white}>
    =K_VEL*Flow/Bore^2
  </text>

  <text x="392" y={HEAD_Y + 74} font-family={FONT} font-size="10.5" fill={C.muted}>
    Same thing with cell references:
  </text>
  <rect x="392" y={HEAD_Y + 82} width="288" height="30" rx="5" fill={C.panelBg} stroke={C.border} stroke-width="1" />
  <text x="404" y={HEAD_Y + 102} font-family="ui-monospace, monospace" font-size="11" fill={C.dark}>
    =0.4085*B2/B3^2
  </text>

  <line x1="392" y1={HEAD_Y + 126} x2="680" y2={HEAD_Y + 126} stroke={C.blue} stroke-width="1" stroke-dasharray="3 3" />

  <text x="392" y={HEAD_Y + 150} font-family={FONT} font-size="11" fill={C.dark}>
    {GPM} gpm through {ID_34} in bore returns
  </text>
  <text x="392" y={HEAD_Y + 182} font-family={FONT} font-size="26" font-weight="700" fill={C.blue}>
    {fmt(V, 2)} ft/s
  </text>
  <text x="392" y={HEAD_Y + 202} font-family={FONT} font-size="9.5" fill={C.muted}>
    — which is what the Pipe Velocity Calculator prints for the same inputs.
  </text>

  {/* Rounding note */}
  <rect x="376" y={HEAD_Y + 224} width="320" height="70" rx="8" fill={C.primaryLight} stroke={C.primary} stroke-width="1" />
  <text x="392" y={HEAD_Y + 244} font-family={FONT} font-size="11" font-weight="700" fill={C.dark}>
    Rounding agrees with our calculators
  </text>
  <text x="392" y={HEAD_Y + 262} font-family="ui-monospace, monospace" font-size="10" fill={C.dark}>
    =ROUND(23.615,2) → 23.62
  </text>
  <text x="392" y={HEAD_Y + 280} font-family={FONT} font-size="9.5" fill={C.muted}>
    Excel rounds a half away from zero, and so do we.
  </text>

  {/* Footer */}
  <text x={X} y={HEAD_Y + 268} font-family={FONT} font-size="10" fill={C.muted}>
    Name the block with Formulas &gt; Create from Selection &gt; Left column, and every
  </text>
  <text x={X} y={HEAD_Y + 282} font-family={FONT} font-size="10" fill={C.muted}>
    constant becomes readable. Excel reserves C and R as names, so use HW_C.
  </text>
</svg>
