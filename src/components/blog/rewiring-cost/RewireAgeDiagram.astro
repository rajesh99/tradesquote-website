---
import { C, FONT } from "../infographicTokens";

/**
 * What the age multiplier is actually paying for. The wiring method found in the
 * walls dictates how much remediation the job carries beyond pulling new cable.
 */
const eras = [
  {
    era: "1990s onward",
    mult: "× 1.0",
    accent: C.green,
    bg: C.greenLight,
    found: "NM-B with a ground",
    detail: ["Grounded throughout. A rewire here", "is usually about capacity or", "damage, not safety."],
  },
  {
    era: "1950s – 1970s",
    mult: "× 1.1",
    accent: C.orange,
    bg: C.orangeLight,
    found: "Cloth NM, early plastics",
    detail: ["Often ungrounded two-wire.", "Insulation goes brittle and sheds", "when disturbed."],
  },
  {
    era: "Pre-1950s",
    mult: "× 1.25",
    accent: C.red,
    bg: C.redLight,
    found: "Knob-and-tube",
    detail: ["Ungrounded, no cable sheath, and", "unsafe to bury in insulation.", "Removal adds real labour."],
  },
];
---

<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 720 260" fill="none" aria-hidden="true">
  <title>What the construction age multiplier pays for</title>
  <desc>
    Houses from the 1990s onward have NM-B cable with a ground and carry no age multiplier; a rewire is usually
    about capacity or damage rather than safety. Houses from the 1950s to 1970s carry a 1.1 multiplier, typically
    having cloth-sheathed or early plastic cable, often ungrounded two-wire, with insulation that goes brittle
    and sheds when disturbed. Pre-1950s houses carry a 1.25 multiplier for knob-and-tube wiring, which is
    ungrounded, has no cable sheath, cannot safely be buried in insulation, and takes real labour to remove.
  </desc>

  <rect x="8" y="8" width="704" height="244" rx="12" fill={C.panelBg} stroke={C.border} />
  <text x="24" y="36" fill={C.dark} font-family={FONT} font-size="14" font-weight="700">What the age multiplier is paying for</text>
  <text x="24" y="54" fill={C.muted} font-family={FONT} font-size="11">Not the cable — the remediation the old wiring forces on you</text>

  {eras.map((e, i) => {
    const x = 24 + i * 224;
    return (
      <g>
        <rect x={x} y="72" width="208" height="164" rx="10" fill={e.bg} stroke={e.accent} stroke-width="1.6" />
        <text x={x + 16} y="96" fill={C.dark} font-family={FONT} font-size="11.5" font-weight="800">{e.era}</text>
        <text x={x + 16} y="126" fill={e.accent} font-family={FONT} font-size="20" font-weight="800">{e.mult}</text>
        <rect x={x + 16} y="136" width="176" height="20" rx="5" fill={C.white} stroke={e.accent} stroke-width="1" />
        <text x={x + 104} y="150" text-anchor="middle" fill={e.accent} font-family={FONT} font-size="9.5" font-weight="700">{e.found}</text>
        <text x={x + 16} y="176" fill={C.muted} font-family={FONT} font-size="9.5">
          {e.detail.map((line, li) => (
            <tspan x={x + 16} dy={li === 0 ? "0" : "13"}>{line}</tspan>
          ))}
        </text>
      </g>
    );
  })}
</svg>
