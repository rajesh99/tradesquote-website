---
import { C, FONT } from "../infographicTokens";
import { mixedFlow, fmt } from "@/lib/plumbing";

/**
 * The capacity argument, taken further than the temperature post does: the
 * multiplier depends on the DELIVERY temperature as well as the storage
 * temperature, and a low-temperature application gets far more out of it.
 *
 * Base copied from plumbing-mixing-valve-calculator/index.astro.
 */
const BASE = { hotF: 140, coldF: 50, mixF: 120, mixedGpm: 2.5 };
const TANK = 50;

const storeRows = [120, 130, 140, 150, 160].map((hotF) => {
  const r = mixedFlow({ ...BASE, hotF });
  return { label: `store ${hotF} °F`, multiplier: r.storageMultiplier, effective: TANK * r.storageMultiplier };
});

const deliverRows = [105, 110, 120, 130].map((mixF) => {
  const r = mixedFlow({ ...BASE, mixF });
  return { label: `deliver ${mixF} °F`, multiplier: r.storageMultiplier, effective: TANK * r.storageMultiplier };
});

const maxEffective = Math.max(
  ...storeRows.map((r) => r.effective),
  ...deliverRows.map((r) => r.effective),
);

const BAR_X = 176;
const BAR_MAX = 214;
---

<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 720 336" fill="none" aria-hidden="true">
  <title>Effective tank capacity against storage and delivery temperature</title>
  <desc>
    The storage multiplier depends on both the stored temperature and the delivered temperature. A low-temperature
    application gets considerably more out of the same tank.
  </desc>

  <rect x="8" y="8" width="704" height="320" rx="12" fill={C.panelBg} stroke={C.border} />
  <text x="24" y="34" fill={C.dark} font-family={FONT} font-size="14" font-weight="700">Both ends of the mix move the multiplier</text>
  <text x="24" y="52" fill={C.muted} font-family={FONT} font-size="11">
    {`A ${TANK} gallon tank with ${BASE.coldF} °F cold. The wider the gap between stored and delivered, the further each stored gallon goes.`}
  </text>

  <text x="28" y="78" fill={C.orange} font-family={FONT} font-size="9" font-weight="700">
    {`RAISING STORAGE — delivering ${BASE.mixF} °F throughout`}
  </text>
  {storeRows.map((row, i) => {
    const y = 86 + i * 26;
    const w = Math.max(3, (row.effective / maxEffective) * BAR_MAX);
    const isBase = row.label === `store ${BASE.hotF} °F`;
    return (
      <g>
        <text x="28" y={y + 13} fill={C.dark} font-family={FONT} font-size="10" font-weight={isBase ? 800 : 600}>{row.label}</text>
        <rect x={BAR_X} y={y} width={BAR_MAX} height="17" rx="4" fill={C.border} opacity="0.28" />
        <rect x={BAR_X} y={y} width={w} height="17" rx="4" fill={C.orange} opacity={isBase ? 0.85 : 0.55} />
        <text x={BAR_X + BAR_MAX + 10} y={y + 13} fill={C.orange} font-family={FONT} font-size="10" font-weight={isBase ? 800 : 600}>
          {`${fmt(row.multiplier, 3)}x → ${fmt(row.effective, 1)} gal`}
        </text>
      </g>
    );
  })}

  <line x1="24" y1="222" x2="696" y2="222" stroke={C.border} stroke-width="1" />

  <text x="28" y="242" fill={C.blue} font-family={FONT} font-size="9" font-weight="700">
    {`LOWERING DELIVERY — storing ${BASE.hotF} °F throughout`}
  </text>
  {deliverRows.map((row, i) => {
    const y = 250 + i * 20;
    const w = Math.max(3, (row.effective / maxEffective) * BAR_MAX);
    const isBase = row.label === `deliver ${BASE.mixF} °F`;
    return (
      <g>
        <text x="28" y={y + 12} fill={C.dark} font-family={FONT} font-size="10" font-weight={isBase ? 800 : 600}>{row.label}</text>
        <rect x={BAR_X} y={y} width={BAR_MAX} height="15" rx="4" fill={C.border} opacity="0.28" />
        <rect x={BAR_X} y={y} width={w} height="15" rx="4" fill={C.blue} opacity={isBase ? 0.85 : 0.55} />
        <text x={BAR_X + BAR_MAX + 10} y={y + 12} fill={C.blue} font-family={FONT} font-size="10" font-weight={isBase ? 800 : 600}>
          {`${fmt(row.multiplier, 3)}x → ${fmt(row.effective, 1)} gal`}
        </text>
      </g>
    );
  })}

  <text x="24" y="326" fill={C.muted} font-family={FONT} font-size="10">
    {`Delivering ${deliverRows[0].label.replace("deliver ", "")} instead of ${BASE.mixF} turns the same tank into ${fmt(deliverRows[0].effective, 1)} gallons — which is why hand-wash-only applications gain the most.`}
  </text>
</svg>
