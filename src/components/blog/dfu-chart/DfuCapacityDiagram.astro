---
import { C, FONT } from "../infographicTokens";
import {
  drainCapacity, sizeLabel,
} from "@/lib/plumbing";
/** What the DFU total buys you. Capacity does not scale with diameter — it
 * scales with something much steeper, which is why one size up buys so much. */
const SIZES = [2, 3, 4, 6, 8];
const caps = SIZES.map((n) => ({ n, cap: drainCapacity(n, "building-drain", 0.25) }));
const maxCap = Math.max(...caps.map((c) => c.cap));

const rows = caps.map(({ n, cap }, i) => ({
  label: sizeLabel(n),
  value: cap,
  frac: cap / maxCap,
  display: i === 0 ? `${cap} DFU` : `${cap} DFU  ·  ${(cap / caps[i - 1].cap).toFixed(1)}x the size below`,
  highlight: n === 3,
}));

/* Bar geometry. The value label is drawn at BAR_X + width + 10, so BAR_MAX is
   chosen to leave room for the longest label inside the 720-wide viewBox. */
const BAR_X = 90;
const BAR_MAX = 250;
---

<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 720 278" fill="none" aria-hidden="true">
  <title>What each building drain size carries at 1/4 in per foot</title>
  <desc>IPC Table 710.1(1). The highlighted row is the minimum wherever a water closet is served</desc>

  <rect x="8" y="8" width="704" height="264" rx="12" fill={C.panelBg} stroke={C.border} />
  <text x="24" y="34" fill={C.dark} font-family={FONT} font-size="14" font-weight="700">What each building drain size carries at 1/4 in per foot</text>
  <text x="24" y="52" fill={C.muted} font-family={FONT} font-size="11">IPC Table 710.1(1). The highlighted row is the minimum wherever a water closet is served</text>

  {rows.map((row, i) => {
    const y = 82 + i * 30;
    const w = Math.max(2, row.frac * BAR_MAX);
    return (
      <g>
        <text x="28" y={y + 15} fill={C.dark} font-family={FONT} font-size="10.5" font-weight="700">{row.label}</text>
        <rect x={BAR_X} y={y + 3} width={BAR_MAX} height="18" rx="5" fill={C.border} opacity="0.28" />
        <rect x={BAR_X} y={y + 3} width={w} height="18" rx="5" fill={row.highlight ? C.primary : C.orange} opacity={row.highlight ? 0.95 : 0.62} />
        <text x={BAR_X + BAR_MAX + 10} y={y + 16} fill={row.highlight ? C.primary : C.dark} font-family={FONT} font-size="10.5" font-weight={row.highlight ? 800 : 600}>
          {row.display}
        </text>
      </g>
    );
  })}

  <text x="24" y="258" fill={C.muted} font-family={FONT} font-size="10">Going from 3 to 4 inch multiplies capacity more than fivefold. Drain capacity rewards one size up far more than supply pipe does.</text>
</svg>
