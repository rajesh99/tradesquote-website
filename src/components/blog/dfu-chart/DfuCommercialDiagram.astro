---
import { C, FONT } from "../infographicTokens";
import {
  DFU_FIXTURES,
} from "@/lib/plumbing";
/** The commercial rows. Note that the same fixture type carries a heavier DFU
 * in public use than in private use — occupancy changes the load. */
const rows = DFU_FIXTURES.filter((f) => f.group === "Commercial").map((f) => ({
  label: f.label.replace(" (per faucet set)", ""),
  cells: [
    `${f.dfu} DFU`,
    f.trap === null ? "integral" : `${f.trap} in`,
    f.dfu >= 4 ? "heavy" : f.dfu >= 2 ? "moderate" : "light",
  ],
  tone: ["neutral", f.trap === null ? "good" : "neutral", f.dfu >= 4 ? "bad" : f.dfu >= 2 ? "neutral" : "good"],
}));
---

<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 720 520" fill="none" aria-hidden="true">
  <title>Drainage fixture units — commercial, IPC Table 709.1</title>
  <desc>Public fixtures carry heavier weights than the same fixture in a dwelling, because use is more frequent</desc>

  <rect x="8" y="8" width="704" height="506" rx="12" fill={C.panelBg} stroke={C.border} />
  <text x="24" y="34" fill={C.dark} font-family={FONT} font-size="14" font-weight="700">Drainage fixture units — commercial, IPC Table 709.1</text>
  <text x="24" y="52" fill={C.muted} font-family={FONT} font-size="11">Public fixtures carry heavier weights than the same fixture in a dwelling, because use is more frequent</text>

  <text x="28" y="76" fill={C.muted} font-family={FONT} font-size="8" font-weight="700">FIXTURE</text>
  <text x={302} y="76" text-anchor="middle" fill={C.muted} font-family={FONT} font-size="8" font-weight="700">DFU</text>
  <text x={454} y="76" text-anchor="middle" fill={C.muted} font-family={FONT} font-size="8" font-weight="700">MIN TRAP</text>
  <text x={606} y="76" text-anchor="middle" fill={C.muted} font-family={FONT} font-size="8" font-weight="700">LOAD</text>

  {rows.map((row, i) => {
    const y = 86 + i * 30;
    return (
      <g>
        <text x="28" y={y + 16} fill={C.dark} font-family={FONT} font-size="10.5" font-weight="700">{row.label}</text>
            <rect x={232} y={y} width={140} height="24" rx="6" fill={row.tone[0] === "bad" ? C.red : row.tone[0] === "good" ? C.green : C.orange} opacity={row.tone[0] === "bad" ? 0.18 : 0.1} />
            <rect x={232} y={y} width={140} height="24" rx="6" fill="none" stroke={row.tone[0] === "bad" ? C.red : row.tone[0] === "good" ? C.green : C.orange} stroke-width={row.tone[0] === "bad" ? 2 : 1.2} />
            <text x={302} y={y + 16} text-anchor="middle" fill={row.tone[0] === "bad" ? C.red : row.tone[0] === "good" ? C.green : C.orange} font-family={FONT} font-size="10.5" font-weight={row.tone[0] === "bad" ? 800 : 700}>
              {row.cells[0]}
            </text>
            <rect x={384} y={y} width={140} height="24" rx="6" fill={row.tone[1] === "bad" ? C.red : row.tone[1] === "good" ? C.green : C.orange} opacity={row.tone[1] === "bad" ? 0.18 : 0.1} />
            <rect x={384} y={y} width={140} height="24" rx="6" fill="none" stroke={row.tone[1] === "bad" ? C.red : row.tone[1] === "good" ? C.green : C.orange} stroke-width={row.tone[1] === "bad" ? 2 : 1.2} />
            <text x={454} y={y + 16} text-anchor="middle" fill={row.tone[1] === "bad" ? C.red : row.tone[1] === "good" ? C.green : C.orange} font-family={FONT} font-size="10.5" font-weight={row.tone[1] === "bad" ? 800 : 700}>
              {row.cells[1]}
            </text>
            <rect x={536} y={y} width={140} height="24" rx="6" fill={row.tone[2] === "bad" ? C.red : row.tone[2] === "good" ? C.green : C.orange} opacity={row.tone[2] === "bad" ? 0.18 : 0.1} />
            <rect x={536} y={y} width={140} height="24" rx="6" fill="none" stroke={row.tone[2] === "bad" ? C.red : row.tone[2] === "good" ? C.green : C.orange} stroke-width={row.tone[2] === "bad" ? 2 : 1.2} />
            <text x={606} y={y + 16} text-anchor="middle" fill={row.tone[2] === "bad" ? C.red : row.tone[2] === "good" ? C.green : C.orange} font-family={FONT} font-size="10.5" font-weight={row.tone[2] === "bad" ? 800 : 700}>
              {row.cells[2]}
            </text>
      </g>
    );
  })}

  <text x="24" y="500" fill={C.muted} font-family={FONT} font-size="10">A public 1.6 gpf water closet is 4 DFU against a private one's 3 — same fixture, different occupancy, different weight.</text>
</svg>
