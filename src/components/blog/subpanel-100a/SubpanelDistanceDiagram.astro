---
import { C, FONT } from "../infographicTokens";

/**
 * Longest one-way run at 3% drop for a 100 A copper feeder at 240 V:
 * L = (0.03 × 240 × cmil) ÷ (2 × 12.9 × 100). Long subpanel feeders are the case
 * where voltage drop, not ampacity, picks the conductor.
 */
const K = 12.9;
const AMPS = 100;
const VOLTS = 240;
const sizes = [
  { label: "4 AWG", cmil: 41740, tag: "83% allowance size" },
  { label: "3 AWG", cmil: 52620, tag: "ordinary subpanel size" },
  { label: "2 AWG", cmil: 66360, tag: "one size up" },
  { label: "1 AWG", cmil: 83690, tag: "two sizes up" },
  { label: "1/0 AWG", cmil: 105600, tag: "three sizes up" },
];

const computed = sizes.map((s) => ({
  ...s,
  feet: Math.floor((0.03 * VOLTS * s.cmil) / (2 * K * AMPS)),
}));

const BAR_MAX = 360;
const peak = Math.max(...computed.map((s) => s.feet));
const bars = computed.map((s) => ({ ...s, width: Math.round((s.feet / peak) * BAR_MAX) }));
---

<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 720 300" fill="none" aria-hidden="true">
  <title>Maximum run length for a 100 amp copper feeder at 3 percent drop</title>
  <desc>
    Longest one-way run for a 100 amp copper feeder on 240 volts staying within 3 percent voltage drop: 4
    AWG reaches about 116 feet, 3 AWG about 146 feet, 2 AWG about 185 feet, 1 AWG about 233 feet, and 1/0
    about 294 feet. A detached garage 150 feet away therefore needs 2 AWG even though 3 AWG satisfies
    ampacity.
  </desc>

  <rect x="8" y="8" width="704" height="284" rx="12" fill={C.panelBg} stroke={C.border} />
  <text x="24" y="36" fill={C.dark} font-family={FONT} font-size="14" font-weight="700">How far a 100 A feeder reaches — 3% drop, copper, 240 V</text>
  <text x="24" y="54" fill={C.muted} font-family={FONT} font-size="11">Detached garages and shops are usually far enough that drop, not ampacity, picks the size</text>

  {bars.map((s, i) => {
    const y = 78 + i * 40;
    return (
      <g>
        <text x="28" y={y + 24} fill={C.dark} font-family={FONT} font-size="12" font-weight="700">{s.label}</text>
        <rect x="106" y={y + 6} width={s.width} height="26" rx="6" fill={C.primaryLight} stroke={C.primary} stroke-width="1.2" />
        <text x="116" y={y + 24} fill={C.muted} font-family={FONT} font-size="9.5">{s.tag}</text>
        <text x={106 + s.width + 10} y={y + 24} fill={C.dark} font-family={FONT} font-size="12.5" font-weight="800">{`${s.feet} ft`}</text>
      </g>
    );
  })}

  <text x="24" y="284" fill={C.muted} font-family={FONT} font-size="10">Upsize for drop and 250.122(B) requires the equipment grounding conductor to grow proportionally too.</text>
</svg>
