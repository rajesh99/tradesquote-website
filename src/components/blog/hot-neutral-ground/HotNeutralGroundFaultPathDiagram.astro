---
import { C, FONT } from "../infographicTokens";

/**
 * Why earth is not a fault return path. 120 V through a 25 Ω ground rod moves
 * 4.8 A — a quarter of what a 20 A breaker needs to even notice. The bonded
 * equipment grounding conductor is the thing that actually clears a fault.
 */
const V = 120;
const BREAKER = 20;

const PATHS = [
  { label: "Earth via a 25 Ω rod", ohms: 25, note: "a typical driven rod" },
  { label: "Earth via a 5 Ω rod", ohms: 5, note: "exceptionally good soil" },
  { label: "Earth via a 1 Ω rod", ohms: 1, note: "essentially unachievable" },
  { label: "Bonded EGC", ohms: 0.1, note: "a metallic path back to the source" },
];

const rows = PATHS.map((p) => ({ ...p, amps: V / p.ohms }));

const X0 = 218;
const BAR_W = 300;
const MAX = Math.max(...rows.map((r) => r.amps));
const frac = (a: number) => Math.log10(a) / Math.log10(MAX);
const breakerX = X0 + frac(BREAKER) * BAR_W;
---

<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 720 258" fill="none" aria-hidden="true">
  <title>Fault current available through earth compared with a bonded grounding conductor</title>
  <desc>
    At 120 volts, a 25 ohm ground rod passes only 4.8 amps, which is less than a quarter of a 20 amp breaker's rating and
    will never trip it. A 5 ohm rod passes 24 amps and a 1 ohm rod 120 amps. A bonded equipment grounding conductor of
    about 0.1 ohm passes roughly 1,200 amps and trips the breaker instantly. The scale is logarithmic.
  </desc>

  <rect x="8" y="8" width="704" height="242" rx="12" fill={C.panelBg} stroke={C.border} />
  <text x="24" y="34" fill={C.dark} font-family={FONT} font-size="14" font-weight="700">Earth is not a fault return path</text>
  <text x="24" y="52" fill={C.muted} font-family={FONT} font-size="11">{`Current available at ${V} V through each return path. Logarithmic scale.`}</text>

  <line x1={breakerX} y1="80" x2={breakerX} y2="212" stroke={C.dark} stroke-width="1.4" stroke-dasharray="5 4" />
  <text x={breakerX} y="74" text-anchor="middle" fill={C.dark} font-family={FONT} font-size="9" font-weight="700">{`${BREAKER} A breaker`}</text>

  {rows.map((row, i) => {
    const y = 90 + i * 32;
    const trips = row.amps >= BREAKER;
    const accent = row.ohms === 0.1 ? C.green : trips ? C.orange : C.red;
    const w = Math.max(3, frac(row.amps) * BAR_W);
    return (
      <g>
        <text x="28" y={y + 15} fill={accent} font-family={FONT} font-size="10.5" font-weight="800">{row.label}</text>
        <text x="28" y={y + 27} fill={C.muted} font-family={FONT} font-size="8.5">{row.note}</text>
        <rect x={X0} y={y + 2} width={w} height="18" rx="4" fill={accent} opacity="0.75" />
        <text x={X0 + w + 8} y={y + 16} fill={accent} font-family={FONT} font-size="10" font-weight="700">
          {`${row.amps.toLocaleString("en-US")} A · ${(row.amps / BREAKER).toFixed(2)}× the breaker`}
        </text>
      </g>
    );
  })}

  <text x="24" y="238" fill={C.muted} font-family={FONT} font-size="10">
    A ground rod cannot clear a fault. It handles lightning and voltage stabilisation; the bonded EGC does the tripping.
  </text>
</svg>
