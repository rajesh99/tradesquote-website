---
import { tanPhi, fmt } from "@/lib/nec";
import { C, FONT } from "../infographicTokens";

/**
 * kVAR required to reach successive targets from the same starting point. The
 * curve steepens sharply above 0.95 — the last few points cost nearly as much
 * capacitance as the whole climb from 0.80 — which is why 0.95 is the practical
 * target rather than unity.
 */
const KW = 80;
const FROM = 0.8;

const rows = [0.85, 0.9, 0.92, 0.95, 0.98, 1.0].map((to) => {
  const kvar = KW * (tanPhi(FROM) - tanPhi(to));
  const kvaTo = KW / to;
  const kvaFrom = KW / FROM;
  return {
    to,
    kvar,
    kvaTo,
    cut: (1 - kvaTo / kvaFrom) * 100,
    lossCut: (1 - Math.pow(kvaTo / kvaFrom, 2)) * 100,
  };
});

const peak = Math.max(...rows.map((r) => r.kvar));
const BAR_X = 106;
const BAR_MAX = 300;
const bars = rows.map((r) => ({ ...r, width: Math.max(20, Math.round((r.kvar / peak) * BAR_MAX)) }));
const target = rows.find((r) => r.to === 0.95)!;
const unity = rows.find((r) => r.to === 1.0)!;
---

<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 720 276" fill="none" aria-hidden="true">
  <title>Capacitance required for each power factor target</title>
  <desc>
    Starting from 0.8 power factor on an 80 kilowatt load, reaching 0.85 needs 10.4 kVAR, 0.9 needs 21.3, 0.92 needs
    25.9, 0.95 needs 33.7, 0.98 needs 43.7 and unity needs 60.0 kVAR. Getting from 0.95 to unity costs 26.3 kVAR — as
    much again as the whole climb from 0.8 to 0.95 — for only a further 5 percent reduction in current, which is why
    0.95 is the practical target.
  </desc>

  <rect x="8" y="8" width="704" height="260" rx="12" fill={C.panelBg} stroke={C.border} />
  <text x="24" y="34" fill={C.dark} font-family={FONT} font-size="14" font-weight="700">{`Why 0.95 is the target and unity is not`}</text>
  <text x="24" y="52" fill={C.muted} font-family={FONT} font-size="11">{`kVAR required to correct ${KW} kW from PF ${FROM} to each target.`}</text>

  <text x="28" y="78" fill={C.muted} font-family={FONT} font-size="8" font-weight="700">TARGET</text>
  <text x={BAR_X} y="78" fill={C.muted} font-family={FONT} font-size="8" font-weight="700">CAPACITOR kVAR</text>
  <text x="470" y="78" fill={C.muted} font-family={FONT} font-size="8" font-weight="700">CURRENT CUT</text>
  <text x="580" y="78" fill={C.muted} font-family={FONT} font-size="8" font-weight="700">I²R LOSS CUT</text>

  {bars.map((r, i) => {
    const y = 88 + i * 28;
    const isTarget = r.to === 0.95;
    const isUnity = r.to === 1.0;
    const accent = isTarget ? C.green : isUnity ? C.red : C.blue;
    return (
      <g>
        <text x="28" y={y + 15} fill={C.dark} font-family={FONT} font-size="10.5" font-weight={isTarget ? 800 : 600}>{r.to.toFixed(2)}</text>
        <rect x={BAR_X} y={y + 2} width={r.width} height="19" rx="5" fill={accent} opacity="0.16" />
        <rect x={BAR_X} y={y + 2} width={r.width} height="19" rx="5" fill="none" stroke={accent} stroke-width={isTarget ? 2.2 : 1.3} />
        <text x={BAR_X + 8} y={y + 16} fill={C.dark} font-family={FONT} font-size="10" font-weight="800">{`${fmt(r.kvar, 1)}`}</text>
        <text x="470" y={y + 16} fill={C.dark} font-family={FONT} font-size="10">{`${fmt(r.cut, 1)}%`}</text>
        <text x="580" y={y + 16} fill={C.muted} font-family={FONT} font-size="10">{`${fmt(r.lossCut, 1)}%`}</text>
      </g>
    );
  })}

  <text x="24" y="258" fill={C.muted} font-family={FONT} font-size="10">{`0.95 → unity costs another ${fmt(unity.kvar - target.kvar, 1)} kVAR for ${fmt(unity.cut - target.cut, 1)} more points of current reduction. Diminishing fast.`}</text>
</svg>
