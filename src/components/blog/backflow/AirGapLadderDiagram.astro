---
import { C, FONT } from "../infographicTokens";
import {
  MINIMUM_AIR_GAPS,
  AIR_GAP_MULTIPLIER,
  AIR_GAP_MULTIPLIER_NEAR_WALL,
  AIR_GAP_MINIMUM_IN,
  AIR_GAP_MINIMUM_NEAR_WALL_IN,
  fmt,
} from "@/lib/plumbing";

/**
 * The only method with no mechanism to fail. The table is DERIVED from the rule
 * — twice the opening, three times near a wall, with floors — so the numbers
 * cannot disagree with the sentence above them.
 */
const rows = MINIMUM_AIR_GAPS;
const maxGap = Math.max(...rows.map((r) => r.nearWall));

const BAR_X = 176;
const BAR_MAX = 300;
---

<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 720 288" fill="none" aria-hidden="true">
  <title>Minimum air gaps by effective opening</title>
  <desc>
    Twice the effective opening, three times where the outlet sits close to a wall, with one inch and one and a half
    inch floors. The values are computed from the rule rather than transcribed.
  </desc>

  <rect x="8" y="8" width="704" height="272" rx="12" fill={C.panelBg} stroke={C.border} />
  <text x="24" y="34" fill={C.dark} font-family={FONT} font-size="14" font-weight="700">The only device with nothing in it to fail</text>
  <text x="24" y="52" fill={C.muted} font-family={FONT} font-size="11">
    {`${AIR_GAP_MULTIPLIER}x the effective opening, ${AIR_GAP_MULTIPLIER_NEAR_WALL}x near a wall, never below ${AIR_GAP_MINIMUM_IN}" or ${AIR_GAP_MINIMUM_NEAR_WALL_IN}" respectively`}
  </text>

  <text x="28" y="76" fill={C.muted} font-family={FONT} font-size="8" font-weight="700">EFFECTIVE OPENING</text>
  <text x={BAR_X} y="76" fill={C.primary} font-family={FONT} font-size="8" font-weight="700">AWAY FROM A WALL (upper) · NEAR A WALL (lower)</text>

  {rows.map((row, i) => {
    const y = 86 + i * 30;
    const openW = Math.max(3, (row.awayFromWall / maxGap) * BAR_MAX);
    const wallW = Math.max(3, (row.nearWall / maxGap) * BAR_MAX);
    const floored = row.awayFromWall === AIR_GAP_MINIMUM_IN;
    return (
      <g>
        <text x="28" y={y + 15} fill={C.dark} font-family={FONT} font-size="11" font-weight="700">{row.label}</text>
        {floored && (
          <text x="80" y={y + 15} fill={C.orange} font-family={FONT} font-size="8.5" font-weight="700">floor applies</text>
        )}
        <rect x={BAR_X} y={y} width={openW} height="11" rx="3" fill={C.primary} opacity="0.8" />
        <text x={BAR_X + openW + 8} y={y + 9} fill={C.primary} font-family={FONT} font-size="9" font-weight="700">{`${fmt(row.awayFromWall, 2)} in`}</text>
        <rect x={BAR_X} y={y + 14} width={wallW} height="11" rx="3" fill={C.orange} opacity="0.8" />
        <text x={BAR_X + wallW + 8} y={y + 23} fill={C.orange} font-family={FONT} font-size="9" font-weight="700">{`${fmt(row.nearWall, 2)} in`}</text>
      </g>
    );
  })}

  <text x="24" y="270" fill={C.muted} font-family={FONT} font-size="10">
    An air gap cannot fail mechanically because there is no mechanism — the pipe simply stops above the water. It also destroys the pressure in the line.
  </text>
</svg>
