---
import { usd, fmt } from "@/lib/nec";
import { C, FONT } from "../infographicTokens";

/**
 * Where the money in a $242 outlet actually goes, as a stacked bar. Offsets are
 * precomputed in the frontmatter with a cumulative reduce rather than computed
 * inline, which keeps the template simple and the render predictable.
 */
const RATE = 95;
const HOURS = 1.5;
const DEVICE = 6;
const BOX_AND_WIRE = 9;
const OVERHEAD = 0.15;
const MARGIN = 0.25;

const labor = HOURS * RATE;
const material = DEVICE + BOX_AND_WIRE;
const direct = labor + material;
const overhead = direct * OVERHEAD;
const breakEven = direct + overhead;
const price = breakEven / (1 - MARGIN);
const profit = price - breakEven;

const raw = [
  { name: "Labour", value: labor, accent: C.primary, note: `${HOURS} h at $${RATE}` },
  { name: "The receptacle", value: DEVICE, accent: C.blue, note: "a tamper-resistant duplex" },
  { name: "Box, wire, plate", value: BOX_AND_WIRE, accent: C.blue, note: "and the staples" },
  { name: "Overhead", value: overhead, accent: C.orange, note: `${OVERHEAD * 100}% of direct cost` },
  { name: "Profit", value: profit, accent: C.green, note: `${MARGIN * 100}% margin` },
];

const BAR_X = 24;
const BAR_W = 672;
let running = 0;
const segments = raw.map((s) => {
  const x = BAR_X + (running / price) * BAR_W;
  const w = (s.value / price) * BAR_W;
  running += s.value;
  return { ...s, x, w, pct: (s.value / price) * 100 };
});
const laborPct = (labor / direct) * 100;
---

<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 720 252" fill="none" aria-hidden="true">
  <title>Where the money goes in a 242 dollar outlet</title>
  <desc>
    Of a 242 dollar price for adding a receptacle to an existing circuit: 142.50 dollars is labour at 1.5 hours,
    6 dollars is the receptacle itself, 9 dollars is the box, wire and plate, 24.53 dollars is overhead at 15 percent of
    direct cost, and 60.38 dollars is profit at a 25 percent margin. Labour is 90 percent of the direct cost, so the
    device is almost irrelevant to the price.
  </desc>

  <rect x="8" y="8" width="704" height="236" rx="12" fill={C.panelBg} stroke={C.border} />
  <text x="24" y="34" fill={C.dark} font-family={FONT} font-size="14" font-weight="700">{`Where ${usd(price)} goes`}</text>
  <text x="24" y="52" fill={C.muted} font-family={FONT} font-size="11">Adding one receptacle to an existing circuit with open access.</text>

  {/* stacked bar */}
  {segments.map((s) => (
    <g>
      <rect x={s.x} y="70" width={s.w} height="38" fill={s.accent} opacity="0.22" />
      <rect x={s.x} y="70" width={s.w} height="38" fill="none" stroke={s.accent} stroke-width="1.4" />
      {s.pct > 8 && (
        <text x={s.x + s.w / 2} y="94" text-anchor="middle" fill={C.dark} font-family={FONT} font-size="10" font-weight="800">
          {`${fmt(s.pct, 0)}%`}
        </text>
      )}
    </g>
  ))}

  {/* legend */}
  {segments.map((s, i) => {
    const y = 128 + i * 22;
    return (
      <g>
        <rect x="28" y={y} width="11" height="11" rx="2.5" fill={s.accent} opacity="0.5" />
        <rect x="28" y={y} width="11" height="11" rx="2.5" fill="none" stroke={s.accent} stroke-width="1.2" />
        <text x="48" y={y + 10} fill={C.dark} font-family={FONT} font-size="9.5" font-weight="700">{s.name}</text>
        <text x="160" y={y + 10} fill={C.dark} font-family={FONT} font-size="9.5">{usd(s.value)}</text>
        <text x="228" y={y + 10} fill={C.muted} font-family={FONT} font-size="8.5">{s.note}</text>
      </g>
    );
  })}

  <text x="24" y="242" fill={C.muted} font-family={FONT} font-size="10">{`Labour is ${fmt(laborPct, 0)}% of direct cost. Arguing about the price of the device misses where the money is.`}</text>
</svg>
