---
import { C, FONT } from "../infographicTokens";

/**
 * The 320/400 confusion. A "320 A" meter socket is a continuous-duty rating; the
 * same equipment is a "400 A class" device, and it is normally split into two
 * 200 A panels rather than feeding one 400 A panel.
 */
const facts = [
  {
    heading: "Why two numbers",
    accent: C.blue,
    bg: C.blueLight,
    lines: [
      "The same meter socket is sold as",
      "\"320 A\" and \"400 A class\". 320 A",
      "is the continuous rating; 400 A is",
      "the intermittent class rating —",
      "400 × 0.8 = 320.",
    ],
  },
  {
    heading: "How it's wired",
    accent: C.primary,
    bg: C.primaryLight,
    lines: [
      "Almost always split into two",
      "200 A panels rather than one",
      "400 A panel — cheaper gear, and",
      "two sets of 4/0 aluminum beats",
      "one set of 600 kcmil.",
    ],
  },
  {
    heading: "When you need it",
    accent: C.orange,
    bg: C.orangeLight,
    lines: [
      "Large all-electric homes, two EVs,",
      "electric resistance heat, a shop,",
      "or a pool and hot tub. Below that,",
      "200 A with load management is",
      "usually the better spend.",
    ],
  },
];
---

<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 720 250" fill="none" aria-hidden="true">
  <title>Why a 320 amp meter is called a 400 amp service</title>
  <desc>
    A meter socket sold as 320 amps and as 400 amp class is the same equipment: 320 amps is the continuous
    duty rating and 400 amps is the intermittent class rating, since 400 times 0.8 equals 320. Such a service
    is almost always split into two 200 amp panels rather than one 400 amp panel, because the gear is cheaper
    and two sets of 4/0 aluminum are easier than one set of 600 kcmil. It is worth it for large all-electric
    homes, two electric vehicles, resistance heat, a shop, or a pool and hot tub — below that a 200 amp service
    with load management is usually the better spend.
  </desc>

  <rect x="8" y="8" width="704" height="234" rx="12" fill={C.panelBg} stroke={C.border} />
  <text x="24" y="36" fill={C.dark} font-family={FONT} font-size="14" font-weight="700">"320 A" and "400 A" are the same service</text>
  <text x="24" y="54" fill={C.muted} font-family={FONT} font-size="11">One of the more confusing labels in residential work — here's what the two numbers mean</text>

  {facts.map((f, i) => {
    const x = 24 + i * 224;
    return (
      <g>
        <rect x={x} y="72" width="208" height="152" rx="10" fill={f.bg} stroke={f.accent} stroke-width="1.5" />
        <text x={x + 16} y="96" fill={f.accent} font-family={FONT} font-size="12" font-weight="800">{f.heading}</text>
        <line x1={x + 16} y1="106" x2={x + 192} y2="106" stroke={f.accent} stroke-opacity="0.35" />
        <text x={x + 16} y="126" fill={C.muted} font-family={FONT} font-size="9.5">
          {f.lines.map((line, li) => (
            <tspan x={x + 16} dy={li === 0 ? "0" : "13"}>{line}</tspan>
          ))}
        </text>
      </g>
    );
  })}
</svg>
