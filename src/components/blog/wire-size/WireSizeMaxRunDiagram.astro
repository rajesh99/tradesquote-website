---
import { C, FONT } from "../infographicTokens";

/**
 * Longest one-way run that keeps voltage drop within 3%, each gauge carrying the
 * load it is normally used for. Computed with the same circular-mil approximation
 * the voltage-drop calculator uses: L = (0.03 × V × cmil) ÷ (2 × K × I), K = 12.9
 * for copper. Values rounded down to the nearest foot.
 */
const K = 12.9;
const rows = [
  { gauge: "14 AWG", cmil: 4110, amps: 15, volts: 120 },
  { gauge: "12 AWG", cmil: 6530, amps: 20, volts: 120 },
  { gauge: "12 AWG", cmil: 6530, amps: 20, volts: 240 },
  { gauge: "10 AWG", cmil: 10380, amps: 30, volts: 240 },
  { gauge: "8 AWG", cmil: 16510, amps: 40, volts: 240 },
  { gauge: "6 AWG", cmil: 26240, amps: 50, volts: 240 },
  { gauge: "4 AWG", cmil: 41740, amps: 70, volts: 240 },
];

const computed = rows.map((r) => ({
  ...r,
  feet: Math.floor((0.03 * r.volts * r.cmil) / (2 * K * r.amps)),
}));

const maxFeet = Math.max(...computed.map((r) => r.feet));
const BAR_MAX = 400;
const bars = computed.map((r) => ({ ...r, width: Math.round((r.feet / maxFeet) * BAR_MAX) }));
---

<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 720 360" fill="none" aria-hidden="true">
  <title>How far each gauge runs before voltage drop hits 3 percent</title>
  <desc>
    Maximum one-way run length that keeps voltage drop within 3 percent for copper conductors, each
    carrying its usual load: 14 AWG at 15 amps on 120 volts reaches about 38 feet, 12 AWG at 20 amps on
    120 volts about 45 feet, the same 12 AWG at 240 volts about 91 feet, 10 AWG at 30 amps about 96
    feet, 8 AWG at 40 amps about 115 feet, 6 AWG at 50 amps about 146 feet, and 4 AWG at 70 amps about
    166 feet. Doubling the voltage doubles the distance.
  </desc>

  <rect x="8" y="8" width="704" height="344" rx="12" fill={C.panelBg} stroke={C.border} />
  <text x="24" y="36" fill={C.dark} font-family={FONT} font-size="14" font-weight="700">Max one-way run before 3% voltage drop — copper</text>
  <text x="24" y="54" fill={C.muted} font-family={FONT} font-size="11">Each gauge at the load it normally carries. Past these lengths, go up a size.</text>

  {bars.map((r, i) => {
    const y = 76 + i * 38;
    return (
      <g>
        <text x="28" y={y + 22} fill={C.dark} font-family={FONT} font-size="12" font-weight="700">{r.gauge}</text>
        <text x="92" y={y + 22} fill={C.muted} font-family={FONT} font-size="10">{`${r.amps} A · ${r.volts} V`}</text>
        <rect x="184" y={y + 6} width={r.width} height="24" rx="6" fill={C.primaryLight} stroke={C.primary} stroke-width="1.2" />
        <text x={184 + r.width + 10} y={y + 23} fill={C.dark} font-family={FONT} font-size="12.5" font-weight="800">{`${r.feet} ft`}</text>
      </g>
    );
  })}

  <text x="24" y="336" fill={C.muted} font-family={FONT} font-size="10">Same wire, same amps, double the voltage → double the distance. That's why 240 V circuits run so much farther.</text>
</svg>
