---
import { C, FONT } from "../infographicTokens";

/**
 * The centre-tapped secondary that gives a dwelling two voltages from one
 * winding. 120 V from either leg to the grounded centre tap, 240 V across the
 * whole winding — one phase, not two.
 */
const L1_Y = 100;
const N_Y = 160;
const L2_Y = 220;
const BUS_X0 = 118;
const BUS_X1 = 660;
---

<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 720 278" fill="none" aria-hidden="true">
  <title>A centre-tapped transformer secondary supplying 120 and 240 volts</title>
  <desc>
    One transformer winding with its centre tap grounded to form the neutral. Either outer leg to the neutral gives 120
    volts, and the two outer legs together give 240 volts. A 120 volt load connects between a leg and the neutral; a 240
    volt load connects between the two legs and needs no neutral at all.
  </desc>

  <rect x="8" y="8" width="704" height="262" rx="12" fill={C.panelBg} stroke={C.border} />
  <text x="24" y="34" fill={C.dark} font-family={FONT} font-size="14" font-weight="700">Two voltages from one winding</text>
  <text x="24" y="52" fill={C.muted} font-family={FONT} font-size="11">The utility transformer's secondary, with its centre tap grounded to become the neutral.</text>

  <text x="24" y="76" fill={C.muted} font-family={FONT} font-size="8" font-weight="700">TRANSFORMER SECONDARY</text>

  <rect x="96" y="94" width="22" height="132" rx="11" fill={C.white} stroke={C.dark} stroke-width="1.8" />
  <path d="M107 104 q9 8 0 16 q-9 8 0 16 q9 8 0 16 q-9 8 0 16 q9 8 0 16 q-9 8 0 16 q9 8 0 16" stroke={C.muted} stroke-width="1.4" fill="none" />

  <line x1={BUS_X0} y1={L1_Y} x2={BUS_X1} y2={L1_Y} stroke={C.dark} stroke-width="2.4" />
  <line x1={BUS_X0} y1={N_Y} x2={BUS_X1} y2={N_Y} stroke={C.blue} stroke-width="2.4" />
  <line x1={BUS_X0} y1={L2_Y} x2={BUS_X1} y2={L2_Y} stroke={C.dark} stroke-width="2.4" />
  <line x1="107" y1="94" x2="107" y2={L1_Y} stroke={C.dark} stroke-width="2.4" />
  <line x1="107" y1="226" x2="107" y2={L2_Y} stroke={C.dark} stroke-width="2.4" />
  <line x1="107" y1={N_Y} x2={BUS_X0} y2={N_Y} stroke={C.blue} stroke-width="2.4" />
  <circle cx="107" cy={N_Y} r="4" fill={C.blue} />

  <text x={BUS_X1 + 8} y={L1_Y + 4} fill={C.dark} font-family={FONT} font-size="10.5" font-weight="800">L1</text>
  <text x={BUS_X1 + 8} y={N_Y + 4} fill={C.blue} font-family={FONT} font-size="10.5" font-weight="800">N</text>
  <text x={BUS_X1 + 8} y={L2_Y + 4} fill={C.dark} font-family={FONT} font-size="10.5" font-weight="800">L2</text>

  <line x1="164" y1={L1_Y} x2="164" y2={N_Y} stroke={C.primary} stroke-width="1.4" stroke-dasharray="4 3" />
  <text x="170" y={(L1_Y + N_Y) / 2 + 4} fill={C.primary} font-family={FONT} font-size="10" font-weight="700">120 V</text>
  <line x1="164" y1={N_Y} x2="164" y2={L2_Y} stroke={C.primary} stroke-width="1.4" stroke-dasharray="4 3" />
  <text x="170" y={(N_Y + L2_Y) / 2 + 4} fill={C.primary} font-family={FONT} font-size="10" font-weight="700">120 V</text>
  <line x1="228" y1={L1_Y} x2="228" y2={L2_Y} stroke={C.orange} stroke-width="1.6" />
  <text x="234" y={N_Y + 4} fill={C.orange} font-family={FONT} font-size="10.5" font-weight="800">240 V</text>

  <line x1="340" y1={L1_Y} x2="340" y2={N_Y} stroke={C.muted} stroke-width="1.6" />
  <rect x="316" y="114" width="48" height="32" rx="5" fill={C.primaryLight} stroke={C.primary} stroke-width="1.6" />
  <text x="340" y="134" text-anchor="middle" fill={C.primary} font-family={FONT} font-size="10" font-weight="700">120 V</text>
  <text x="340" y="90" text-anchor="middle" fill={C.muted} font-family={FONT} font-size="9">lighting</text>

  <line x1="470" y1={L1_Y} x2="470" y2={L2_Y} stroke={C.muted} stroke-width="1.6" />
  <rect x="442" y="142" width="56" height="36" rx="5" fill={C.orangeLight} stroke={C.orange} stroke-width="1.8" />
  <text x="470" y="164" text-anchor="middle" fill={C.orange} font-family={FONT} font-size="10.5" font-weight="800">240 V</text>
  <text x="470" y="90" text-anchor="middle" fill={C.muted} font-family={FONT} font-size="9">water heater — no neutral</text>

  <line x1="600" y1={N_Y} x2="600" y2={L2_Y} stroke={C.muted} stroke-width="1.6" />
  <rect x="576" y="174" width="48" height="32" rx="5" fill={C.primaryLight} stroke={C.primary} stroke-width="1.6" />
  <text x="600" y="194" text-anchor="middle" fill={C.primary} font-family={FONT} font-size="10" font-weight="700">120 V</text>
  <text x="600" y="90" text-anchor="middle" fill={C.muted} font-family={FONT} font-size="9">receptacles</text>

  <text x="24" y="252" fill={C.muted} font-family={FONT} font-size="10">
    One winding, one phase, two halves 180° apart. "Split-phase" is the right name — there is no second phase here.
  </text>
</svg>
