---
import { C, FONT, markerDefs } from "../infographicTokens";
import { ventSize, sizeLabel } from "@/lib/plumbing";

/**
 * The two pipes the names refer to, drawn together. A stack vent is the top of
 * the drainage stack itself; a vent stack is a separate pipe running alongside
 * it, joined at both ends.
 */
const defs = markerDefs("vent-stack");
const DRAIN = 3;
const dryVent = ventSize(DRAIN, 30).size;
---

<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 720 300" fill="none" aria-hidden="true">
  <title>A stack vent and a vent stack drawn on the same building</title>
  <desc>
    A stack vent is the drainage stack continuing upward above the highest branch. A vent stack is a separate
    vertical pipe joined to the stack at the bottom and to the stack vent at the top.
  </desc>
  <defs set:html={defs} />

  <rect x="8" y="8" width="704" height="284" rx="12" fill={C.panelBg} stroke={C.border} />
  <text x="24" y="34" fill={C.dark} font-family={FONT} font-size="14" font-weight="700">Two pipes, and only one of them carries waste</text>
  <text x="24" y="52" fill={C.muted} font-family={FONT} font-size="11">
    {`A ${sizeLabel(DRAIN)} drainage stack. The names describe position, not size — both can be the same diameter.`}
  </text>

  <!-- roof line -->
  <line x1="120" y1="82" x2="600" y2="82" stroke={C.border} stroke-width="2" stroke-dasharray="6 4" />
  <text x="612" y="86" fill={C.muted} font-family={FONT} font-size="9" font-weight="700">roof</text>

  <!-- the drainage stack, carrying waste -->
  <line x1="240" y1="72" x2="240" y2="250" stroke={C.blue} stroke-width="7" stroke-linecap="round" />
  <!-- stack vent portion, highlighted -->
  <line x1="240" y1="72" x2="240" y2="132" stroke={C.primary} stroke-width="7" stroke-linecap="round" />
  <text x="256" y="96" fill={C.primary} font-family={FONT} font-size="11" font-weight="800">STACK VENT</text>
  <text x="256" y="110" fill={C.muted} font-family={FONT} font-size="9">the same pipe, above the highest branch</text>
  <text x="256" y="122" fill={C.muted} font-family={FONT} font-size="9">no waste passes through it — nothing is above it</text>

  <text x="256" y="180" fill={C.blue} font-family={FONT} font-size="11" font-weight="800">DRAINAGE STACK</text>
  <text x="256" y="194" fill={C.muted} font-family={FONT} font-size="9">carries waste down and air up, below the top branch</text>

  <!-- the separate vent stack -->
  <line x1="470" y1="72" x2="470" y2="238" stroke={C.orange} stroke-width="6" stroke-linecap="round" />
  <text x="486" y="150" fill={C.orange} font-family={FONT} font-size="11" font-weight="800">VENT STACK</text>
  <text x="486" y="164" fill={C.muted} font-family={FONT} font-size="9">a separate pipe. Never carries waste.</text>
  <text x="486" y="176" fill={C.muted} font-family={FONT} font-size="9">Joined at the bottom, and to the stack vent at the top.</text>

  <!-- connections -->
  <line x1="244" y1="238" x2="466" y2="238" stroke={C.orange} stroke-width="3" stroke-linecap="round" />
  <text x="355" y="254" text-anchor="middle" fill={C.orange} font-family={FONT} font-size="8.5" font-weight="700">connects at or below the lowest branch</text>
  <line x1="244" y1="90" x2="466" y2="90" stroke={C.orange} stroke-width="2.4" stroke-dasharray="5 4" />
  <text x="355" y="84" text-anchor="middle" fill={C.orange} font-family={FONT} font-size="8.5" font-weight="700">and rejoins above the highest branch</text>

  <!-- branches -->
  {[150, 180, 210].map((y) => (
    <g>
      <line x1="240" y1={y} x2="150" y2={y} stroke={C.dark} stroke-width="2.4" stroke-linecap="round" />
      <rect x="112" y={y - 8} width="38" height="16" rx="4" fill={C.white} stroke={C.dark} stroke-width="1.4" />
    </g>
  ))}
  <text x="112" y="232" fill={C.muted} font-family={FONT} font-size="9">branches</text>
  <line x1="240" y1="132" x2="150" y2="132" stroke={C.dark} stroke-width="2.4" stroke-linecap="round" />
  <rect x="112" y="124" width="38" height="16" rx="4" fill={C.white} stroke={C.primary} stroke-width="1.8" />
  <text x="158" y="128" fill={C.primary} font-family={FONT} font-size="8" font-weight="700">highest branch — the stack vent starts here</text>

  <text x="24" y="278" fill={C.muted} font-family={FONT} font-size="10">
    {`Every stack has a stack vent by definition. A vent stack is added only when the stack alone cannot move enough air.`}
  </text>
</svg>
