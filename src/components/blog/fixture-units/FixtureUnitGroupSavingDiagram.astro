---
import { C, FONT } from "../infographicTokens";
import {
  WSFU_FIXTURES, DFU_FIXTURES, fmt,
} from "@/lib/plumbing";
/** A bathroom group counts for less than its parts, on both sides, because the
 * code assumes one room's fixtures are not all discharging at once. */
const W_PARTS = ["wc-private-tank", "lavatory-private", "shower-private"];
const D_PARTS = ["wc-private-16", "lavatory", "shower-57"];

const wParts = W_PARTS.reduce((s, k) => s + WSFU_FIXTURES.find((f) => f.key === k)!.total, 0);
const wGroup = WSFU_FIXTURES.find((f) => f.key === "bathroom-group-tank")!.total;
const dParts = D_PARTS.reduce((s, k) => s + DFU_FIXTURES.find((f) => f.key === k)!.dfu, 0);
const dGroup = DFU_FIXTURES.find((f) => f.key === "bathroom-group-16")!.dfu;

const rows = [
  {
    label: "Counted separately",
    cells: [`${fmt(wParts, 1)} WSFU`, `${dParts} DFU`, "the arithmetic answer"],
    tone: ["bad", "bad", "neutral"],
  },
  {
    label: "Counted as a group",
    cells: [`${fmt(wGroup, 1)} WSFU`, `${dGroup} DFU`, "what the code allows"],
    tone: ["good", "good", "good"],
  },
  {
    label: "Difference",
    cells: [`${fmt(wParts - wGroup, 1)} WSFU`, `${dParts - dGroup} DFU`, `${fmt((1 - wGroup / wParts) * 100, 0)}% / ${fmt((1 - dGroup / dParts) * 100, 0)}% less`],
    tone: ["neutral", "neutral", "good"],
  },
];
---

<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 720 220" fill="none" aria-hidden="true">
  <title>A bathroom group counts for less than its parts</title>
  <desc>A water closet, a lavatory and a shower — added up individually, then taken as one group</desc>

  <rect x="8" y="8" width="704" height="206" rx="12" fill={C.panelBg} stroke={C.border} />
  <text x="24" y="34" fill={C.dark} font-family={FONT} font-size="14" font-weight="700">A bathroom group counts for less than its parts</text>
  <text x="24" y="52" fill={C.muted} font-family={FONT} font-size="11">A water closet, a lavatory and a shower — added up individually, then taken as one group</text>

  <text x="28" y="76" fill={C.muted} font-family={FONT} font-size="8" font-weight="700">HOW IT IS COUNTED</text>
  <text x={302} y="76" text-anchor="middle" fill={C.muted} font-family={FONT} font-size="8" font-weight="700">SUPPLY</text>
  <text x={454} y="76" text-anchor="middle" fill={C.muted} font-family={FONT} font-size="8" font-weight="700">DRAINAGE</text>
  <text x={606} y="76" text-anchor="middle" fill={C.muted} font-family={FONT} font-size="8" font-weight="700">NOTE</text>

  {rows.map((row, i) => {
    const y = 86 + i * 30;
    return (
      <g>
        <text x="28" y={y + 16} fill={C.dark} font-family={FONT} font-size="10.5" font-weight="700">{row.label}</text>
            <rect x={232} y={y} width={140} height="24" rx="6" fill={row.tone[0] === "bad" ? C.red : row.tone[0] === "good" ? C.green : C.orange} opacity={row.tone[0] === "bad" ? 0.18 : 0.1} />
            <rect x={232} y={y} width={140} height="24" rx="6" fill="none" stroke={row.tone[0] === "bad" ? C.red : row.tone[0] === "good" ? C.green : C.orange} stroke-width={row.tone[0] === "bad" ? 2 : 1.2} />
            <text x={302} y={y + 16} text-anchor="middle" fill={row.tone[0] === "bad" ? C.red : row.tone[0] === "good" ? C.green : C.orange} font-family={FONT} font-size="10.5" font-weight={row.tone[0] === "bad" ? 800 : 700}>
              {row.cells[0]}
            </text>
            <rect x={384} y={y} width={140} height="24" rx="6" fill={row.tone[1] === "bad" ? C.red : row.tone[1] === "good" ? C.green : C.orange} opacity={row.tone[1] === "bad" ? 0.18 : 0.1} />
            <rect x={384} y={y} width={140} height="24" rx="6" fill="none" stroke={row.tone[1] === "bad" ? C.red : row.tone[1] === "good" ? C.green : C.orange} stroke-width={row.tone[1] === "bad" ? 2 : 1.2} />
            <text x={454} y={y + 16} text-anchor="middle" fill={row.tone[1] === "bad" ? C.red : row.tone[1] === "good" ? C.green : C.orange} font-family={FONT} font-size="10.5" font-weight={row.tone[1] === "bad" ? 800 : 700}>
              {row.cells[1]}
            </text>
            <rect x={536} y={y} width={140} height="24" rx="6" fill={row.tone[2] === "bad" ? C.red : row.tone[2] === "good" ? C.green : C.orange} opacity={row.tone[2] === "bad" ? 0.18 : 0.1} />
            <rect x={536} y={y} width={140} height="24" rx="6" fill="none" stroke={row.tone[2] === "bad" ? C.red : row.tone[2] === "good" ? C.green : C.orange} stroke-width={row.tone[2] === "bad" ? 2 : 1.2} />
            <text x={606} y={y + 16} text-anchor="middle" fill={row.tone[2] === "bad" ? C.red : row.tone[2] === "good" ? C.green : C.orange} font-family={FONT} font-size="10.5" font-weight={row.tone[2] === "bad" ? 800 : 700}>
              {row.cells[2]}
            </text>
      </g>
    );
  })}

  <text x="24" y="200" fill={C.muted} font-family={FONT} font-size="10">The code is betting that a toilet, a basin and a shower in one room are never all running together. It is a good bet.</text>
</svg>
