---
import { C, FONT } from "../infographicTokens";
import {
  WSFU_FIXTURES, DFU_FIXTURES,
} from "@/lib/plumbing";
/** The point of the whole post: one fixture carries TWO different weights,
 * because supply load and drainage load are different physical questions. */
const PAIRS: [string, string, string][] = [
  ["Water closet, 1.6 gpf", "wc-private-tank", "wc-private-16"],
  ["Lavatory", "lavatory-private", "lavatory"],
  ["Bathtub", "bathtub-private", "bathtub"],
  ["Kitchen sink", "kitchen-sink-private", "kitchen-sink"],
  ["Dishwasher", "dishwasher-private", "dishwasher"],
  ["Clothes washer", "clothes-washer-private", "clothes-washer-res"],
  ["Bathroom group", "bathroom-group-tank", "bathroom-group-16"],
];

const rows = PAIRS.map(([label, wKey, dKey]) => {
  const w = WSFU_FIXTURES.find((f) => f.key === wKey)!;
  const d = DFU_FIXTURES.find((f) => f.key === dKey)!;
  const bigger = w.total > d.dfu ? "supply" : d.dfu > w.total ? "drainage" : "equal";
  return {
    label,
    cells: [`${w.total} WSFU`, `${d.dfu} DFU`, bigger === "drainage" ? "drainage is heavier" : "supply is heavier"],
    tone: ["neutral", "neutral", bigger === "drainage" ? "bad" : "good"],
  };
});
---

<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 720 340" fill="none" aria-hidden="true">
  <title>One fixture, two completely different weights</title>
  <desc>Water supply fixture units against drainage fixture units, for the same seven fixtures</desc>

  <rect x="8" y="8" width="704" height="326" rx="12" fill={C.panelBg} stroke={C.border} />
  <text x="24" y="34" fill={C.dark} font-family={FONT} font-size="14" font-weight="700">One fixture, two completely different weights</text>
  <text x="24" y="52" fill={C.muted} font-family={FONT} font-size="11">Water supply fixture units against drainage fixture units, for the same seven fixtures</text>

  <text x="28" y="76" fill={C.muted} font-family={FONT} font-size="8" font-weight="700">FIXTURE</text>
  <text x={302} y="76" text-anchor="middle" fill={C.muted} font-family={FONT} font-size="8" font-weight="700">SUPPLY (WSFU)</text>
  <text x={454} y="76" text-anchor="middle" fill={C.muted} font-family={FONT} font-size="8" font-weight="700">DRAINAGE (DFU)</text>
  <text x={606} y="76" text-anchor="middle" fill={C.muted} font-family={FONT} font-size="8" font-weight="700">WHICH IS HEAVIER</text>

  {rows.map((row, i) => {
    const y = 86 + i * 30;
    return (
      <g>
        <text x="28" y={y + 16} fill={C.dark} font-family={FONT} font-size="10.5" font-weight="700">{row.label}</text>
            <rect x={232} y={y} width={140} height="24" rx="6" fill={row.tone[0] === "bad" ? C.red : row.tone[0] === "good" ? C.green : C.orange} opacity={row.tone[0] === "bad" ? 0.18 : 0.1} />
            <rect x={232} y={y} width={140} height="24" rx="6" fill="none" stroke={row.tone[0] === "bad" ? C.red : row.tone[0] === "good" ? C.green : C.orange} stroke-width={row.tone[0] === "bad" ? 2 : 1.2} />
            <text x={302} y={y + 16} text-anchor="middle" fill={row.tone[0] === "bad" ? C.red : row.tone[0] === "good" ? C.green : C.orange} font-family={FONT} font-size="10.5" font-weight={row.tone[0] === "bad" ? 800 : 700}>
              {row.cells[0]}
            </text>
            <rect x={384} y={y} width={140} height="24" rx="6" fill={row.tone[1] === "bad" ? C.red : row.tone[1] === "good" ? C.green : C.orange} opacity={row.tone[1] === "bad" ? 0.18 : 0.1} />
            <rect x={384} y={y} width={140} height="24" rx="6" fill="none" stroke={row.tone[1] === "bad" ? C.red : row.tone[1] === "good" ? C.green : C.orange} stroke-width={row.tone[1] === "bad" ? 2 : 1.2} />
            <text x={454} y={y + 16} text-anchor="middle" fill={row.tone[1] === "bad" ? C.red : row.tone[1] === "good" ? C.green : C.orange} font-family={FONT} font-size="10.5" font-weight={row.tone[1] === "bad" ? 800 : 700}>
              {row.cells[1]}
            </text>
            <rect x={536} y={y} width={140} height="24" rx="6" fill={row.tone[2] === "bad" ? C.red : row.tone[2] === "good" ? C.green : C.orange} opacity={row.tone[2] === "bad" ? 0.18 : 0.1} />
            <rect x={536} y={y} width={140} height="24" rx="6" fill="none" stroke={row.tone[2] === "bad" ? C.red : row.tone[2] === "good" ? C.green : C.orange} stroke-width={row.tone[2] === "bad" ? 2 : 1.2} />
            <text x={606} y={y + 16} text-anchor="middle" fill={row.tone[2] === "bad" ? C.red : row.tone[2] === "good" ? C.green : C.orange} font-family={FONT} font-size="10.5" font-weight={row.tone[2] === "bad" ? 800 : 700}>
              {row.cells[2]}
            </text>
      </g>
    );
  })}

  <text x="24" y="320" fill={C.muted} font-family={FONT} font-size="10">A toilet is light on supply and heavy on drainage. A dishwasher is the reverse. The numbers are not interchangeable.</text>
</svg>
