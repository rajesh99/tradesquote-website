---
import { C, FONT } from "../infographicTokens";
import { expansionTank, selectExpansionTank, STANDARD_EXPANSION_TANKS, fmt } from "@/lib/plumbing";

/**
 * System volume against required shell, on the calculator's own basis. Note the
 * shell column moves far less than the tank-volume column: the stocked ladder is
 * coarse, so several system sizes collapse onto one product.
 */
const BASE = { systemGallons: 50, coldF: 40, hotF: 140, supplyPsi: 60, maxPsi: 80 };
const SYSTEMS = [30, 40, 50, 75, 80, 100, 120];

const rows = SYSTEMS.map((systemGallons) => {
  const r = expansionTank({ ...BASE, systemGallons });
  return {
    systemGallons,
    acceptance: r.acceptance,
    tankVolume: r.tankVolume,
    shell: selectExpansionTank(r.tankVolume),
    isDefault: systemGallons === BASE.systemGallons,
  };
});

const LADDER = STANDARD_EXPANSION_TANKS.slice(0, 4);
/* Counted, not asserted — an earlier draft said "four" and the sweep gives three. */
const COMMON_SHELL = STANDARD_EXPANSION_TANKS[1];
const sharingCommonShell = rows.filter((r) => r.shell === COMMON_SHELL).length;
const ROW_H = 26;
const TOP = 92;
---

<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 720 300" fill="none" aria-hidden="true">
  <title>Expansion tank required across residential system sizes</title>
  <desc>
    Required shell volume against system volume at the calculator's default pressures. The stocked ladder is coarse, so
    several system sizes land on the same product.
  </desc>

  <rect x="8" y="8" width="704" height="284" rx="12" fill={C.panelBg} stroke={C.border} />
  <text x="24" y="34" fill={C.dark} font-family={FONT} font-size="14" font-weight="700">System volume sets the expansion — pressure sets the shell</text>
  <text x="24" y="52" fill={C.muted} font-family={FONT} font-size="11">
    {`${BASE.coldF} → ${BASE.hotF} °F at ${BASE.supplyPsi} psi supply and an ${BASE.maxPsi} psi ceiling. Stocked ladder: ${LADDER.join(", ")} gallons.`}
  </text>

  <text x="28" y="80" fill={C.muted} font-family={FONT} font-size="8" font-weight="700">SYSTEM VOLUME</text>
  <text x={282} y="80" text-anchor="middle" fill={C.muted} font-family={FONT} font-size="8" font-weight="700">EXPANSION PRODUCED</text>
  <text x={444} y="80" text-anchor="middle" fill={C.muted} font-family={FONT} font-size="8" font-weight="700">SHELL REQUIRED</text>
  <text x={608} y="80" text-anchor="middle" fill={C.muted} font-family={FONT} font-size="8" font-weight="700">TANK TO FIT</text>

  {rows.map((row, i) => {
    const y = TOP + i * ROW_H;
    const smallest = row.shell === STANDARD_EXPANSION_TANKS[1];
    const tone = smallest ? C.primary : C.orange;
    return (
      <g>
        <text x="28" y={y + 15} fill={C.dark} font-family={FONT} font-size="10.5" font-weight={row.isDefault ? 800 : 700}>
          {`${row.systemGallons} gallon system`}
        </text>
        <text x={282} y={y + 15} text-anchor="middle" fill={C.muted} font-family={FONT} font-size="10">
          {`${fmt(row.acceptance, 2)} gal`}
        </text>
        <text x={444} y={y + 15} text-anchor="middle" fill={C.dark} font-family={FONT} font-size="10" font-weight="600">
          {`${fmt(row.tankVolume, 2)} gal`}
        </text>
        <rect x={548} y={y} width={120} height="20" rx="6" fill={tone} opacity="0.12" />
        <rect x={548} y={y} width={120} height="20" rx="6" fill="none" stroke={tone} stroke-width="1.4" />
        <text x={608} y={y + 14} text-anchor="middle" fill={tone} font-family={FONT} font-size="10" font-weight="800">
          {`${row.shell} gallon`}
        </text>
      </g>
    );
  })}

  <text x="24" y="284" fill={C.muted} font-family={FONT} font-size="10">
    {`${sharingCommonShell} of these system sizes share the ${COMMON_SHELL} gallon shell. The ladder is coarse, so it is the pressures — not the heater — that usually push you up a rung.`}
  </text>
</svg>
