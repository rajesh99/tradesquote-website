---
import { C, FONT } from "../infographicTokens";

/**
 * The 2020 change, which almost nobody explains correctly. "Six disconnects" is
 * still permitted; six disconnects in ONE enclosure is not. That kills the
 * split-bus six-handle panelboard while leaving the six-enclosure arrangement
 * (and the meter-main-plus-panel arrangement) entirely intact.
 */
const cases = [
  {
    accent: C.red,
    verdict: "NO LONGER PERMITTED",
    title: "Six mains in one enclosure",
    detail: "The classic split-bus panelboard. 230.71(A) now allows only one service disconnect per enclosure.",
    boxes: 6,
    single: true,
  },
  {
    accent: C.green,
    verdict: "STILL PERMITTED",
    title: "Two to six separate enclosures",
    detail: "Grouped per 230.72(A), each its own enclosure. Common on multifamily and large services.",
    boxes: 4,
    single: false,
  },
];
---

<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 720 268" fill="none" aria-hidden="true">
  <title>The six-handle rule after the 2020 code change</title>
  <desc>
    Six service disconnects inside a single enclosure, the classic split-bus panelboard, is no longer permitted
    because 230.71(A) now allows only one service disconnect per enclosure. Two to six service disconnects are still
    permitted where each is in its own separate enclosure and they are grouped together as required by 230.72(A).
  </desc>

  <rect x="8" y="8" width="704" height="252" rx="12" fill={C.panelBg} stroke={C.border} />
  <text x="24" y="36" fill={C.dark} font-family={FONT} font-size="14" font-weight="700">"Six disconnects" survived. Six in one box did not.</text>
  <text x="24" y="54" fill={C.muted} font-family={FONT} font-size="11">NEC 2020 revised 230.71(A) to permit one service disconnect per enclosure.</text>

  {cases.map((c, i) => {
    const y = 74 + i * 88;
    return (
      <g>
        <rect x="24" y={y} width="672" height="78" rx="10" fill={c.accent} opacity="0.07" />
        <rect x="24" y={y} width="672" height="78" rx="10" fill="none" stroke={c.accent} stroke-width="1.6" />
        <rect x="40" y={y + 12} width="152" height="18" rx="5" fill={c.accent} />
        <text x="116" y={y + 25} text-anchor="middle" fill={C.white} font-family={FONT} font-size="8" font-weight="800">{c.verdict}</text>
        <text x="206" y={y + 26} fill={C.dark} font-family={FONT} font-size="11.5" font-weight="800">{c.title}</text>
        <text x="40" y={y + 48} fill={C.muted} font-family={FONT} font-size="9">{c.detail}</text>

        {c.single ? (
          <g>
            <rect x="440" y={y + 38} width="240" height="32" rx="6" fill={C.white} stroke={c.accent} stroke-width="1.8" />
            {[0, 1, 2, 3, 4, 5].map((k) => (
              <rect x={448 + k * 38} y={y + 45} width="30" height="18" rx="3" fill={c.accent} opacity="0.25" />
            ))}
            <text x="560" y={y + 34} text-anchor="middle" fill={C.muted} font-family={FONT} font-size="7.5" font-weight="700">ONE ENCLOSURE</text>
          </g>
        ) : (
          <g>
            {[0, 1, 2, 3].map((k) => (
              <g>
                <rect x={452 + k * 58} y={y + 38} width="46" height="32" rx="5" fill={C.white} stroke={c.accent} stroke-width="1.6" />
                <rect x={460 + k * 58} y={y + 46} width="30" height="16" rx="3" fill={c.accent} opacity="0.25" />
              </g>
            ))}
            <text x="568" y={y + 34} text-anchor="middle" fill={C.muted} font-family={FONT} font-size="7.5" font-weight="700">SEPARATE ENCLOSURES, GROUPED</text>
          </g>
        )}
      </g>
    );
  })}

  <text x="24" y="250" fill={C.muted} font-family={FONT} font-size="10">Existing six-handle panels are not illegal — the rule applies to new installations, and the AHJ decides on alterations.</text>
</svg>
