---
import { C, FONT } from "../infographicTokens";
import { insideDiameter, velocity, headToPsi, fmt } from "@/lib/plumbing";

/**
 * The Joukowsky surge. Instant valve closure converts the whole velocity of
 * the column into pressure, and the conversion factor is the pipe's own wave
 * speed — which is why rigid copper bangs and flexible PEX does not.
 *
 * Wave speeds are PUBLISHED values for water in each material, quoted for
 * scale. The surge itself is computed: head = a x v / g, then head to psi.
 */
const GRAVITY = 32.174;

const MATERIALS = [
  { label: "Copper, rigid", waveSpeed: 4000, tone: "red" as const },
  { label: "CPVC", waveSpeed: 2200, tone: "orange" as const },
  { label: "PEX, flexible", waveSpeed: 1300, tone: "green" as const },
];

const TONES = {
  red: C.red,
  orange: C.orange,
  green: C.green,
};

const NOMINAL = 0.75;
const bore = insideDiameter("copper-l", NOMINAL)!;

const FLOWS = [5, 8, 10, 12.07];

const rows = FLOWS.map((gpm) => {
  const v = velocity(gpm, bore);
  return {
    gpm,
    v,
    surges: MATERIALS.map((m) => ({
      label: m.label,
      colour: TONES[m.tone],
      psi: headToPsi((m.waveSpeed * v) / GRAVITY),
    })),
  };
});

const maxPsi = Math.max(...rows.flatMap((r) => r.surges.map((s) => s.psi)));

const BAR_X = 168;
const BAR_MAX = 396;

const plotted = rows.map((r, i) => ({
  ...r,
  y: 108 + i * 42,
  bars: r.surges.map((s, j) => ({
    ...s,
    by: 108 + i * 42 + j * 11,
    w: Math.max(2, (s.psi / maxPsi) * BAR_MAX),
  })),
}));

const headline = rows.find((r) => r.gpm === 10)!;
const copperHeadline = headline.surges[0];
const pexHeadline = headline.surges[2];
const ratio = copperHeadline.psi / pexHeadline.psi;
---

<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 720 320" fill="none" aria-hidden="true">
  <title>Pressure surge from instant valve closure against flow rate and pipe material</title>
  <desc>
    Slamming a valve converts the whole velocity of the water column into pressure. In three-quarter inch copper
    at ten gallons a minute the spike is around 357 psi; the same flow in PEX produces about 116 psi.
  </desc>

  <rect x="8" y="8" width="704" height="304" rx="12" fill={C.panelBg} stroke={C.border} />
  <text x="24" y="34" fill={C.dark} font-family={FONT} font-size="14" font-weight="700">The spike is the velocity, converted</text>
  <text x="24" y="52" fill={C.muted} font-family={FONT} font-size="11">
    {`Instant closure in ${fmt(NOMINAL, 2)} inch nominal Type L copper, ${fmt(bore, 3)} inch bore. Surge head is the wave speed times the velocity, divided by g.`}
  </text>
  <text x="24" y="70" fill={C.muted} font-family={FONT} font-size="11">
    Three bars per flow, in material order — the only variable between them is how much the pipe wall can give.
  </text>

  <g font-family={FONT} font-size="9" font-weight="700">
    {MATERIALS.map((m, j) => (
      <g>
        <rect x={352 + j * 118} y="80" width="9" height="9" rx="2" fill={TONES[m.tone]} opacity="0.75" />
        <text x={366 + j * 118} y="88" fill={C.muted}>{m.label}</text>
      </g>
    ))}
  </g>

  {plotted.map((row) => (
    <g>
      <text x="28" y={row.y + 14} fill={C.dark} font-family={FONT} font-size="10" font-weight="700">
        {`${fmt(row.gpm, 2)} gpm`}
      </text>
      <text x="28" y={row.y + 28} fill={C.muted} font-family={FONT} font-size="9">
        {`${fmt(row.v, 2)} ft/s`}
      </text>
      {row.bars.map((b) => (
        <g>
          <rect x={BAR_X} y={b.by} width={b.w} height="9" rx="2" fill={b.colour} opacity="0.72" />
          <text x={BAR_X + b.w + 8} y={b.by + 8} fill={b.colour} font-family={FONT} font-size="9" font-weight="700">
            {`${fmt(b.psi, 0)} psi`}
          </text>
        </g>
      ))}
    </g>
  ))}

  <text x="24" y="298" fill={C.muted} font-family={FONT} font-size="10">
    {`At ${fmt(headline.gpm, 0)} gpm the same slam is ${fmt(copperHeadline.psi, 0)} psi in copper and ${fmt(pexHeadline.psi, 0)} psi in PEX — ${fmt(ratio, 1)}x, from material alone.`}
  </text>
</svg>
