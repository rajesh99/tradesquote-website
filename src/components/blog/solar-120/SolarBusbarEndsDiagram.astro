---
import { C, FONT } from "../infographicTokens";

/**
 * Why 120% is allowed at all. With the main at one end and the PV breaker at the
 * other, current enters from both ends and flows inward to the loads between —
 * so no section of busbar ever carries the arithmetic sum of the two devices.
 * Move the PV breaker next to the main and that stops being true, which is why
 * the placement is a condition of the allowance rather than a detail.
 */
const BUSBAR = 200;
const MAIN = 200;
const PV = 40;
const ALLOWANCE = (BUSBAR * 120) / 100;
---

<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 720 300" fill="none" aria-hidden="true">
  <title>Why the PV breaker must sit at the opposite end of the busbar</title>
  <desc>
    With the 200 amp main at the top of the busbar and the 40 amp PV breaker at the bottom, current enters from
    both ends and flows inward toward the loads in between, so no section of bar carries the 240 amp sum. Placing
    the PV breaker beside the main removes that split and the whole 240 amps would pass through one section.
  </desc>

  <rect x="8" y="8" width="704" height="284" rx="12" fill={C.panelBg} stroke={C.border} />
  <text x="24" y="34" fill={C.dark} font-family={FONT} font-size="14" font-weight="700">
    Opposite ends is the whole justification
  </text>
  <text x="24" y="52" fill={C.muted} font-family={FONT} font-size="11">
    {`A ${BUSBAR} A busbar with a ${MAIN} A main and a ${PV} A PV breaker — ${ALLOWANCE} A of devices on a ${BUSBAR} A bar.`}
  </text>

  <!-- CORRECT: opposite ends -->
  <g>
    <text x="28" y="82" fill={C.green} font-family={FONT} font-size="11" font-weight="800">CORRECT — PV at the far end</text>
    <rect x="28" y="92" width="300" height="112" rx="8" fill={C.white} stroke={C.green} stroke-width="1.6" />
    <rect x="168" y="104" width="20" height="88" rx="3" fill={C.border} opacity="0.55" />
    <text x="178" y="152" text-anchor="middle" fill={C.muted} font-family={FONT} font-size="7.5" font-weight="700" transform="rotate(-90 178 152)">BUSBAR</text>

    <rect x="44" y="104" width="112" height="22" rx="4" fill={C.blue} opacity="0.16" />
    <rect x="44" y="104" width="112" height="22" rx="4" fill="none" stroke={C.blue} stroke-width="1.5" />
    <text x="100" y="119" text-anchor="middle" fill={C.dark} font-family={FONT} font-size="9.5" font-weight="800">MAIN 200 A</text>
    <path d="M156 115 L166 115" stroke={C.blue} stroke-width="2" />

    <rect x="44" y="170" width="112" height="22" rx="4" fill={C.orange} opacity="0.16" />
    <rect x="44" y="170" width="112" height="22" rx="4" fill="none" stroke={C.orange} stroke-width="1.5" />
    <text x="100" y="185" text-anchor="middle" fill={C.dark} font-family={FONT} font-size="9.5" font-weight="800">PV 40 A</text>
    <path d="M156 181 L166 181" stroke={C.orange} stroke-width="2" />

    <text x="200" y="126" fill={C.muted} font-family={FONT} font-size="8.5">↓ current in</text>
    <text x="200" y="152" fill={C.green} font-family={FONT} font-size="9" font-weight="700">loads here</text>
    <text x="200" y="188" fill={C.muted} font-family={FONT} font-size="8.5">↑ current in</text>

    <text x="28" y="222" fill={C.dark} font-family={FONT} font-size="9.5" font-weight="700">Worst section carries 200 A, not 240 A.</text>
  </g>

  <!-- WRONG: adjacent -->
  <g>
    <text x="392" y="82" fill={C.red} font-family={FONT} font-size="11" font-weight="800">WRONG — PV beside the main</text>
    <rect x="392" y="92" width="300" height="112" rx="8" fill={C.white} stroke={C.red} stroke-width="1.6" />
    <rect x="532" y="104" width="20" height="88" rx="3" fill={C.border} opacity="0.55" />
    <text x="542" y="152" text-anchor="middle" fill={C.muted} font-family={FONT} font-size="7.5" font-weight="700" transform="rotate(-90 542 152)">BUSBAR</text>

    <rect x="408" y="104" width="112" height="22" rx="4" fill={C.blue} opacity="0.16" />
    <rect x="408" y="104" width="112" height="22" rx="4" fill="none" stroke={C.blue} stroke-width="1.5" />
    <text x="464" y="119" text-anchor="middle" fill={C.dark} font-family={FONT} font-size="9.5" font-weight="800">MAIN 200 A</text>
    <path d="M520 115 L530 115" stroke={C.blue} stroke-width="2" />

    <rect x="408" y="130" width="112" height="22" rx="4" fill={C.red} opacity="0.16" />
    <rect x="408" y="130" width="112" height="22" rx="4" fill="none" stroke={C.red} stroke-width="1.5" />
    <text x="464" y="145" text-anchor="middle" fill={C.dark} font-family={FONT} font-size="9.5" font-weight="800">PV 40 A</text>
    <path d="M520 141 L530 141" stroke={C.red} stroke-width="2" />

    <text x="564" y="128" fill={C.red} font-family={FONT} font-size="9" font-weight="700">240 A through</text>
    <text x="564" y="142" fill={C.red} font-family={FONT} font-size="9" font-weight="700">one section</text>
    <text x="564" y="186" fill={C.muted} font-family={FONT} font-size="8.5">loads below</text>

    <text x="392" y="222" fill={C.red} font-family={FONT} font-size="9.5" font-weight="700">The bar is overloaded by 40 A. Not permitted.</text>
  </g>

  <line x1="24" y1="240" x2="696" y2="240" stroke={C.border} />
  <text x="28" y="260" fill={C.dark} font-family={FONT} font-size="10" font-weight="700">
    705.12(B)(3)(2) allows main + PV ≤ 120% of the busbar — but only with the PV at the opposite end.
  </text>
  <text x="28" y="278" fill={C.muted} font-family={FONT} font-size="9.5">
    A permanent warning label on the panel is part of the same requirement.
  </text>
</svg>
