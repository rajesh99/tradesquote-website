---
import { C, FONT } from "../infographicTokens";

/**
 * The distinction the whole article rests on. Two different conductors, two
 * different tables, keyed to two different things — and only one of them exists on
 * an ordinary branch circuit.
 */
const conductors = [
  {
    abbr: "EGC",
    name: "Equipment grounding conductor",
    accent: C.primary,
    bg: C.primaryLight,
    table: "Table 250.122",
    keyedTo: "The OCPD rating",
    job: [
      "Carries fault current back to the",
      "source so the breaker trips. Runs",
      "with every circuit in the building.",
    ],
    example: "20 A breaker → 12 AWG Cu",
  },
  {
    abbr: "GEC",
    name: "Grounding electrode conductor",
    accent: C.blue,
    bg: C.blueLight,
    table: "Table 250.66",
    keyedTo: "The service conductor size",
    job: [
      "Connects the service to earth — rods,",
      "a Ufer, a water pipe. One per service,",
      "not per circuit.",
    ],
    example: "2/0 Cu service → 4 AWG Cu",
  },
];
---

<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 720 280" fill="none" aria-hidden="true">
  <title>Equipment grounding conductor versus grounding electrode conductor</title>
  <desc>
    Two different conductors people conflate. The equipment grounding conductor comes from Table 250.122, is
    keyed to the overcurrent device rating, carries fault current back so the breaker trips, and runs with
    every circuit — a 20 amp breaker takes 12 AWG copper. The grounding electrode conductor comes from Table
    250.66, is keyed to the size of the largest ungrounded service-entrance conductor, connects the service to
    earth through rods or a concrete-encased electrode or a water pipe, and there is one per service rather
    than one per circuit — a 2/0 copper service takes 4 AWG copper.
  </desc>

  <rect x="8" y="8" width="704" height="264" rx="12" fill={C.panelBg} stroke={C.border} />
  <text x="24" y="36" fill={C.dark} font-family={FONT} font-size="14" font-weight="700">Two different conductors, two different tables</text>
  <text x="24" y="54" fill={C.muted} font-family={FONT} font-size="11">Both get called "the ground wire". Only one of them exists on a branch circuit.</text>

  {conductors.map((c, i) => {
    const x = 24 + i * 340;
    return (
      <g>
        <rect x={x} y="72" width="324" height="188" rx="10" fill={c.bg} stroke={c.accent} stroke-width="1.6" />
        <text x={x + 20} y="102" fill={c.accent} font-family={FONT} font-size="22" font-weight="800">{c.abbr}</text>
        <text x={x + 82} y="102" fill={C.dark} font-family={FONT} font-size="10.5" font-weight="700">{c.name}</text>
        <line x1={x + 20} y1="112" x2={x + 304} y2="112" stroke={c.accent} stroke-opacity="0.35" />

        <rect x={x + 20} y="122" width="126" height="20" rx="5" fill={C.white} stroke={c.accent} stroke-width="1" />
        <text x={x + 83} y="136" text-anchor="middle" fill={c.accent} font-family={FONT} font-size="9.5" font-weight="700">{c.table}</text>
        <text x={x + 156} y="136" fill={C.muted} font-family={FONT} font-size="9.5">{`keyed to: ${c.keyedTo}`}</text>

        <text x={x + 20} y="164" fill={C.muted} font-family={FONT} font-size="9.5">
          {c.job.map((line, li) => (
            <tspan x={x + 20} dy={li === 0 ? "0" : "13"}>{line}</tspan>
          ))}
        </text>

        <rect x={x + 20} y="212" width="284" height="30" rx="7" fill={C.white} stroke={c.accent} stroke-width="1.3" />
        <text x={x + 162} y="232" text-anchor="middle" fill={C.dark} font-family={FONT} font-size="11.5" font-weight="800">{c.example}</text>
      </g>
    );
  })}
</svg>
