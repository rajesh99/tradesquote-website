---
import { C, FONT } from "../infographicTokens";
import { rangeDemand } from "@/lib/nec";

/**
 * Note 1 adds 5% to the Column C figure for each kilowatt above 12 — applied to
 * the table value, not to the nameplate. That distinction is what keeps a 27 kW
 * range at 14 kW of calculated load instead of something absurd.
 */
const rows = [12, 13, 14, 16, 18, 21, 27].map((kw) => {
  const r = rangeDemand(1, kw);
  return { kw, columnC: r.columnC, percent: r.note1Percent, demand: r.demandKw, ratio: r.demandKw / kw };
});

const peak = 27;
const BAR_X = 118;
const BAR_MAX = 300;
const w = (v: number) => Math.max(6, Math.round((v / peak) * BAR_MAX));
---

<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 720 292" fill="none" aria-hidden="true">
  <title>Note 1 — ranges over 12 kilowatts</title>
  <desc>
    Above 12 kilowatts, Note 1 to Table 220.55 increases the 8 kilowatt Column C figure by 5 percent for each
    additional kilowatt. A 13 kW range becomes 8.4, a 16 kW range 9.6, an 18 kW range 10.4, and a 27 kW range 14
    kilowatts. The increase applies to the table value, not to the nameplate.
  </desc>

  <rect x="8" y="8" width="704" height="276" rx="12" fill={C.panelBg} stroke={C.border} />
  <text x="24" y="34" fill={C.dark} font-family={FONT} font-size="14" font-weight="700">
    Note 1 multiplies the table, not the nameplate
  </text>
  <text x="24" y="52" fill={C.muted} font-family={FONT} font-size="11">
    +5% on the 8 kW Column C figure for each full kilowatt above 12. Outline is the nameplate.
  </text>

  {rows.map((r, i) => {
    const y = 68 + i * 29;
    return (
      <g>
        <text x="28" y={y + 16} fill={C.dark} font-family={FONT} font-size="10" font-weight="700">
          {`${r.kw} kW`}
        </text>
        <rect x={BAR_X} y={y + 3} width={w(r.kw)} height="18" rx="4" fill="none" stroke={C.border} stroke-width="1.4" />
        <rect x={BAR_X} y={y + 3} width={w(r.demand)} height="18" rx="4" fill={C.orange} opacity="0.2" />
        <rect x={BAR_X} y={y + 3} width={w(r.demand)} height="18" rx="4" fill="none" stroke={C.orange} stroke-width="1.6" />
        <text x={BAR_X + w(r.kw) + 10} y={y + 16} fill={C.dark} font-family={FONT} font-size="9.5" font-weight="800">
          {`${r.demand.toFixed(2)} kW`}
        </text>
        <text x={BAR_X + w(r.kw) + 68} y={y + 16} fill={C.muted} font-family={FONT} font-size="8.5">
          {r.percent > 0
            ? `8 × (1 + ${r.percent}%) · counts as ${(r.ratio * 100).toFixed(0)}% of nameplate`
            : `Column C flat · counts as ${(r.ratio * 100).toFixed(0)}% of nameplate`}
        </text>
      </g>
    );
  })}

  <line x1="24" y1="258" x2="696" y2="258" stroke={C.border} />
  <text x="28" y="274" fill={C.dark} font-family={FONT} font-size="10" font-weight="700">
    Going from a 12 kW to a 16 kW range adds 1.6 kW of load — under 7 A on a 240 V service.
  </text>
</svg>
