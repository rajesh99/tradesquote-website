---
import {
  ampacityOf,
  egcSize,
  findSizeByAmpacity,
  fmt,
  nextStandardOcpd,
  sizeLabel,
  voltageDrop,
} from "@/lib/nec";
import { C, FONT, markerDefs } from "../infographicTokens";

const defs = markerDefs("evc");

/**
 * The EVSE circuit, computed exactly as the EV charger calculator computes it:
 * 625.41 makes the load continuous by rule, so conductors and the overcurrent
 * device are sized at 125% of the charger's rated output.
 */
const CHARGER_AMPS = 48;
const VOLTS = 240;
const RUN_FT = 60;

const required = CHARGER_AMPS * 1.25;
const breaker = nextStandardOcpd(required);
const conductor = findSizeByAmpacity(breaker, "copper", 75);
const conductorAmpacity = conductor ? (ampacityOf(conductor, "copper", 75) ?? 0) : 0;
const egc = egcSize(breaker, "copper");
const drop = conductor
  ? voltageDrop({ cmil: conductor.cmil, material: "copper", amps: CHARGER_AMPS, lengthFt: RUN_FT, phase: 1 })
  : 0;
const dropPercent = (drop / VOLTS) * 100;
const kw = (CHARGER_AMPS * VOLTS) / 1000;

const steps = [
  { label: "Charger output", value: `${CHARGER_AMPS} A`, note: `${fmt(kw, 2)} kW at ${VOLTS} V`, accent: C.blue, bg: C.blueLight },
  { label: "× 1.25 — 625.41", value: `${fmt(required, 0)} A`, note: "continuous by rule", accent: C.orange, bg: C.orangeLight },
  { label: "OCPD — 240.6(A)", value: `${breaker} A`, note: "next standard rating", accent: C.orange, bg: C.orangeLight },
  { label: "Conductor", value: conductor ? sizeLabel(conductor.label) : "—", note: `${conductorAmpacity} A at 75 °C Cu`, accent: C.primary, bg: C.primaryLight },
  { label: "EGC — 250.122", value: sizeLabel(egc), note: "keyed to the 60 A OCPD", accent: C.primary, bg: C.primaryLight },
];
---

<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 720 268" fill="none" aria-hidden="true">
  <title>Sizing a 48 amp EV charger circuit</title>
  <desc>
    A 48 amp charger at 240 volts is 11.52 kilowatts. NEC 625.41 makes electric vehicle supply equipment a
    continuous load by rule, so 125 percent gives 60 amperes of required ampacity. The next standard overcurrent
    device rating is 60 amperes, which needs 6 AWG copper rated 65 amperes at 75 degrees, with a 10 AWG copper
    equipment grounding conductor from Table 250.122. Over a 60 foot run the voltage drop is 1.18 percent.
  </desc>

  <defs set:html={defs} />

  <rect x="8" y="8" width="704" height="252" rx="12" fill={C.panelBg} stroke={C.border} />
  <text x="24" y="36" fill={C.dark} font-family={FONT} font-size="14" font-weight="700">{`A ${CHARGER_AMPS} A charger is a ${breaker} A circuit — not a ${CHARGER_AMPS} A one`}</text>
  <text x="24" y="54" fill={C.muted} font-family={FONT} font-size="11">EV charging is continuous by rule, so you never have to judge whether it runs for three hours.</text>

  {steps.map((s, i) => {
    const x = 24 + i * 137;
    return (
      <g>
        <rect x={x} y="76" width="126" height="104" rx="9" fill={s.bg} stroke={s.accent} stroke-width="1.5" />
        <text x={x + 63} y="98" text-anchor="middle" fill={C.dark} font-family={FONT} font-size="8.5" font-weight="800">{s.label}</text>
        <text x={x + 63} y="130" text-anchor="middle" fill={s.accent} font-family={FONT} font-size="15" font-weight="800">{s.value}</text>
        <text x={x + 63} y="154" text-anchor="middle" fill={C.muted} font-family={FONT} font-size="8">{s.note}</text>
        {i !== steps.length - 1 && (
          <path d={`M${x + 130} 128 L ${x + 133} 128`} stroke={C.border} stroke-width="1.6" marker-end="url(#evc-arrow-muted)" />
        )}
      </g>
    );
  })}

  <rect x="24" y="198" width="672" height="52" rx="10" fill={C.primaryLight} stroke={C.primary} stroke-width="1.8" />
  <text x="44" y="220" fill={C.dark} font-family={FONT} font-size="12.5" font-weight="800">{`Voltage drop over ${RUN_FT} ft: ${fmt(dropPercent, 2)}%`}</text>
  <text x="44" y="238" fill={C.muted} font-family={FONT} font-size="9.5">{`Comfortably inside 3%. On 240 V a ${sizeLabel(conductor ? conductor.label : "6")} copper run carries ${CHARGER_AMPS} A about 153 ft before drop becomes the governing constraint instead of ampacity.`}</text>
</svg>
