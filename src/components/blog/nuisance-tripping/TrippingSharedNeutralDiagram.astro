---
import { C, FONT } from "../infographicTokens";

/**
 * The shared-neutral mechanism drawn as currents rather than as wiring, because
 * the reason it trips is arithmetic: the protected circuit's neutral carries the
 * sum of two circuits, so what returns never matches what left.
 */
const A_HOT = 8;
const B_HOT = 5;
const RETURN = A_HOT + B_HOT;
const IMBALANCE = RETURN - A_HOT;
const THRESHOLD_MA = 5;
---

<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 720 268" fill="none" aria-hidden="true">
  <title>Why a shared neutral trips a GFCI</title>
  <desc>
    A protected circuit draws 8 amps on its hot conductor while a second circuit sharing the same neutral draws 5
    amps. The shared neutral carries 13 amps back through the protective device, so the device sees 8 amps out and 13
    amps in — a 5 amp imbalance, which is a thousand times the 5 milliamp trip threshold. The device trips instantly
    and correctly; the fault is the wiring, not the breaker.
  </desc>

  <rect x="8" y="8" width="704" height="252" rx="12" fill={C.panelBg} stroke={C.border} />
  <text x="24" y="34" fill={C.dark} font-family={FONT} font-size="14" font-weight="700">A shared neutral is arithmetic, not a defect</text>
  <text x="24" y="52" fill={C.muted} font-family={FONT} font-size="11">The protective device compares what leaves against what returns. A borrowed neutral breaks the comparison.</text>

  {/* protected circuit */}
  <rect x="24" y="72" width="120" height="46" rx="8" fill={C.primaryLight} stroke={C.primary} stroke-width="1.8" />
  <text x="84" y="92" text-anchor="middle" fill={C.primary} font-family={FONT} font-size="9.5" font-weight="800">PROTECTED</text>
  <text x="84" y="107" text-anchor="middle" fill={C.muted} font-family={FONT} font-size="8">AFCI or GFCI</text>

  <line x1="144" y1="86" x2="420" y2="86" stroke={C.red} stroke-width="2.4" />
  <text x="282" y="79" text-anchor="middle" fill={C.red} font-family={FONT} font-size="9.5" font-weight="800">{`hot out — ${A_HOT} A`}</text>
  <rect x="420" y="68" width="112" height="36" rx="7" fill={C.white} stroke={C.border} />
  <text x="476" y="90" text-anchor="middle" fill={C.dark} font-family={FONT} font-size="9">circuit A load</text>

  {/* second circuit */}
  <rect x="24" y="132" width="120" height="46" rx="8" fill={C.white} stroke={C.border} stroke-width="1.4" />
  <text x="84" y="152" text-anchor="middle" fill={C.muted} font-family={FONT} font-size="9.5" font-weight="800">UNPROTECTED</text>
  <text x="84" y="167" text-anchor="middle" fill={C.muted} font-family={FONT} font-size="8">ordinary breaker</text>

  <line x1="144" y1="146" x2="420" y2="146" stroke={C.orange} stroke-width="2.4" />
  <text x="282" y="139" text-anchor="middle" fill={C.orange} font-family={FONT} font-size="9.5" font-weight="800">{`hot out — ${B_HOT} A`}</text>
  <rect x="420" y="128" width="112" height="36" rx="7" fill={C.white} stroke={C.border} />
  <text x="476" y="150" text-anchor="middle" fill={C.dark} font-family={FONT} font-size="9">circuit B load</text>

  {/* the shared neutral carrying both back through the protected device */}
  <line x1="532" y1="104" x2="568" y2="104" stroke={C.blue} stroke-width="2.4" />
  <line x1="532" y1="164" x2="568" y2="164" stroke={C.blue} stroke-width="2.4" />
  <line x1="568" y1="104" x2="568" y2="164" stroke={C.blue} stroke-width="2.4" />
  <circle cx="568" cy="134" r="4" fill={C.blue} />
  <line x1="568" y1="134" x2="600" y2="134" stroke={C.blue} stroke-width="2.4" />
  <line x1="600" y1="134" x2="600" y2="200" stroke={C.blue} stroke-width="2.4" />
  <line x1="600" y1="200" x2="84" y2="200" stroke={C.blue} stroke-width="2.4" />
  <line x1="84" y1="200" x2="84" y2="118" stroke={C.blue} stroke-width="2.4" />
  <text x="342" y="194" text-anchor="middle" fill={C.blue} font-family={FONT} font-size="9.5" font-weight="800">{`shared neutral returns ${RETURN} A through the protected device`}</text>

  <rect x="24" y="214" width="672" height="34" rx="8" fill={C.redLight} stroke={C.red} stroke-width="1.8" />
  <text x="40" y="235" fill={C.dark} font-family={FONT} font-size="10.5" font-weight="700">
    {`Device sees ${A_HOT} A out, ${RETURN} A in — a ${IMBALANCE} A imbalance, about ${(IMBALANCE * 1000) / THRESHOLD_MA}× the ${THRESHOLD_MA} mA threshold. It trips correctly.`}
  </text>
</svg>
