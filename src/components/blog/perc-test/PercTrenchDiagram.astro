---
import { C, FONT } from "../infographicTokens";
import { septicSizing, fmt } from "@/lib/plumbing";

/**
 * Area is the requirement; trench length is how you deliver it. Widening the
 * trench shortens the run for the same absorption area, which is the one lever
 * available once the soil result is in.
 *
 * Base copied from plumbing-septic-tank-calculator/index.astro.
 */
const BASE = { bedrooms: 3, galPerBedroom: 150, applicationRate: 0.8, trenchWidthFt: 3 };

const widths = [2, 3, 4].map((trenchWidthFt) => {
  const r = septicSizing({ ...BASE, trenchWidthFt });
  return { trenchWidthFt, field: r.leachFieldSqFt, trench: r.trenchFeet, isDefault: trenchWidthFt === BASE.trenchWidthFt };
});

const bedrooms = [2, 3, 4, 5].map((b) => {
  const r = septicSizing({ ...BASE, bedrooms: b });
  return { bedrooms: b, flow: r.dailyFlow, field: r.leachFieldSqFt };
});

const field = widths[0].field;
const maxTrench = Math.max(...widths.map((w) => w.trench));
const maxField = Math.max(...bedrooms.map((b) => b.field));

const BAR_X = 214;
const BAR_MAX = 200;
---

<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 720 300" fill="none" aria-hidden="true">
  <title>Trench width against trench length, and bedrooms against field area</title>
  <desc>
    The absorption area is fixed by the soil and the flow. Trench width is the one lever that changes how much
    linear run it takes to deliver that area.
  </desc>

  <rect x="8" y="8" width="704" height="284" rx="12" fill={C.panelBg} stroke={C.border} />
  <text x="24" y="34" fill={C.dark} font-family={FONT} font-size="14" font-weight="700">Area is the requirement. Trench length is just how you deliver it.</text>
  <text x="24" y="52" fill={C.muted} font-family={FONT} font-size="11">
    {`On loam at ${BASE.applicationRate} gal per sq ft per day, a ${BASE.bedrooms}-bedroom house needs ${fmt(field)} sq ft however you arrange it.`}
  </text>

  <text x="28" y="78" fill={C.primary} font-family={FONT} font-size="9" font-weight="700">WIDER TRENCHES, SHORTER RUN — same area throughout</text>
  {widths.map((w, i) => {
    const y = 86 + i * 28;
    const barW = Math.max(3, (w.trench / maxTrench) * BAR_MAX);
    return (
      <g>
        <text x="28" y={y + 15} fill={C.dark} font-family={FONT} font-size="10.5" font-weight={w.isDefault ? 800 : 600}>
          {`${w.trenchWidthFt} ft wide`}
        </text>
        <rect x={BAR_X} y={y + 2} width={BAR_MAX} height="18" rx="5" fill={C.border} opacity="0.28" />
        <rect x={BAR_X} y={y + 2} width={barW} height="18" rx="5" fill={C.primary} opacity={w.isDefault ? 0.85 : 0.55} />
        <text x={BAR_X + BAR_MAX + 10} y={y + 16} fill={C.primary} font-family={FONT} font-size="10.5" font-weight="800">
          {`${fmt(w.trench)} ft of trench for ${fmt(w.field)} sq ft`}
        </text>
      </g>
    );
  })}

  <line x1="24" y1="180" x2="696" y2="180" stroke={C.border} stroke-width="1" />

  <text x="28" y="200" fill={C.orange} font-family={FONT} font-size="9" font-weight="700">MORE BEDROOMS, MORE AREA — soil held at loam</text>
  {bedrooms.map((b, i) => {
    const y = 208 + i * 22;
    const barW = Math.max(3, (b.field / maxField) * BAR_MAX);
    return (
      <g>
        <text x="28" y={y + 12} fill={C.dark} font-family={FONT} font-size="10" font-weight="600">
          {`${b.bedrooms} bedrooms`}
        </text>
        <rect x={BAR_X} y={y} width={BAR_MAX} height="15" rx="4" fill={C.border} opacity="0.28" />
        <rect x={BAR_X} y={y} width={barW} height="15" rx="4" fill={C.orange} opacity="0.7" />
        <text x={BAR_X + BAR_MAX + 10} y={y + 12} fill={C.orange} font-family={FONT} font-size="10" font-weight="700">
          {`${b.flow} gpd → ${fmt(b.field)} sq ft`}
        </text>
      </g>
    );
  })}

  <text x="24" y="288" fill={C.muted} font-family={FONT} font-size="10">
    And remember the reserve area: most jurisdictions want a second, equally sized, undisturbed piece of ground held for the replacement field.
  </text>
</svg>
