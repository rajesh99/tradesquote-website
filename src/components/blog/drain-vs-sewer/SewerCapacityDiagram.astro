---
import { C, FONT } from "../infographicTokens";
import { drainCapacity, minSlope, slopeToPercent, sizeLabel, fmt } from "@/lib/plumbing";

/**
 * One table sizes both sides of the boundary, and it is slope-dependent — which
 * matters far more outside, where the run is long and the fall is fixed by
 * where the main sits.
 */
const SIZES = [3, 4, 6];
const SLOPES = [0.0625, 0.125, 0.25, 0.5] as const;

const rows = SIZES.map((nominal) => ({
  nominal,
  minimum: minSlope(nominal),
  cells: SLOPES.map((s) => ({ slope: s, dfu: drainCapacity(nominal, "building-drain", s) })),
}));

const four = rows.find((r) => r.nominal === 4)!;
const flattest = four.cells.find((c) => c.dfu !== null)!;
const steepest = four.cells[four.cells.length - 1];

const ROW_H = 36;
const TOP = 106;
const COL_X = [286, 388, 490, 596];
---

<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 720 276" fill="none" aria-hidden="true">
  <title>Building drain and sewer capacity by size and slope</title>
  <desc>
    One table sizes both sides of the boundary, and it is slope-dependent. Slope matters most outside, where the
    run is long and the fall is fixed by where the main sits.
  </desc>

  <rect x="8" y="8" width="704" height="260" rx="12" fill={C.panelBg} stroke={C.border} />
  <text x="24" y="34" fill={C.dark} font-family={FONT} font-size="14" font-weight="700">One table, both sides of the line</text>
  <text x="24" y="52" fill={C.muted} font-family={FONT} font-size="11">
    Drainage fixture units carried, IPC Table 710.1(1). A dash means that slope is not permitted at that size.
  </text>

  <text x="40" y="80" fill={C.muted} font-family={FONT} font-size="8" font-weight="700">SIZE</text>
  <text x={140} y="80" fill={C.muted} font-family={FONT} font-size="8" font-weight="700">MINIMUM SLOPE</text>
  {SLOPES.map((s, i) => (
    <text x={COL_X[i]} y="80" text-anchor="middle" fill={C.muted} font-family={FONT} font-size="8" font-weight="700">
      {`${s} IN/FT`}
    </text>
  ))}
  {SLOPES.map((s, i) => (
    <text x={COL_X[i]} y="92" text-anchor="middle" fill={C.border} font-family={FONT} font-size="7.5">
      {`${fmt(slopeToPercent(s), 2)}%`}
    </text>
  ))}

  {rows.map((row, i) => {
    const y = TOP + i * ROW_H;
    const common = row.nominal === 4;
    return (
      <g>
        <rect x="24" y={y - 6} width="672" height={ROW_H - 8} rx="7" fill={common ? C.primary : C.border} opacity={common ? 0.08 : 0.05} />
        <text x="40" y={y + 12} fill={C.dark} font-family={FONT} font-size="12.5" font-weight="800">{sizeLabel(row.nominal)}</text>
        <text x={140} y={y + 12} fill={C.muted} font-family={FONT} font-size="10">
          {`${row.minimum} in/ft`}
        </text>
        {row.cells.map((c, j) => (
          <text
            x={COL_X[j]}
            y={y + 12}
            text-anchor="middle"
            fill={c.dfu === null ? C.border : C.dark}
            font-family={FONT}
            font-size="11"
            font-weight={common ? 800 : 600}
          >
            {c.dfu === null ? "—" : `${fmt(c.dfu)} DFU`}
          </text>
        ))}
      </g>
    );
  })}

  <rect x="24" y="232" width="672" height="30" rx="8" fill={C.primaryLight} stroke={C.primary} stroke-width="1.6" />
  <text x="36" y="248" fill={C.primary} font-family={FONT} font-size="10.5" font-weight="800">
    {`A ${sizeLabel(4)} line carries ${fmt(flattest.dfu ?? 0)} DFU at ${flattest.slope} in/ft and ${fmt(steepest.dfu ?? 0)} at ${steepest.slope} — a ${fmt(((steepest.dfu ?? 0) / (flattest.dfu ?? 1) - 1) * 100)}% gain from grade alone.`}
  </text>
  <text x="36" y="260" fill={C.dark} font-family={FONT} font-size="9.5">
    Rarely decisive inside, where runs are short. Outside, the fall is set by where the main sits and you take what the ground gives you.
  </text>
</svg>
