---
import { C, FONT, markerDefs } from "../infographicTokens";
import { minDrainSizeApplied, MIN_BUILDING_DRAIN_WITH_WC, sizeLabel } from "@/lib/plumbing";

/**
 * The boundary, drawn. The pipe does not change at 30 inches — the definition
 * does, and with it the permit, the ownership and who pays when it fails.
 */
const defs = markerDefs("sewer-boundary");
const DFU = 18;
const size = minDrainSizeApplied(DFU, "building-drain", 0.25, true).size;
const BOUNDARY_IN = 30;
---

<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 720 268" fill="none" aria-hidden="true">
  <title>Where the building drain ends and the building sewer begins</title>
  <desc>
    The boundary sits thirty inches outside the wall. The pipe is identical on both sides; the definition changes,
    and with it the permit, the ownership and the responsibility.
  </desc>
  <defs set:html={defs} />

  <rect x="8" y="8" width="704" height="252" rx="12" fill={C.panelBg} stroke={C.border} />
  <text x="24" y="34" fill={C.dark} font-family={FONT} font-size="14" font-weight="700">
    {`The same pipe, and a boundary ${BOUNDARY_IN} inches outside the wall`}
  </text>
  <text x="24" y="52" fill={C.muted} font-family={FONT} font-size="11">
    {`Nothing about the ${sizeLabel(size)} pipe changes at that line. What changes is whose problem it is.`}
  </text>

  <!-- building wall -->
  <rect x="60" y="80" width="14" height="120" fill={C.dark} opacity="0.7" />
  <text x="67" y="72" text-anchor="middle" fill={C.dark} font-family={FONT} font-size="9" font-weight="700">wall</text>

  <!-- the pipe run -->
  <line x1="90" y1="150" x2="240" y2="150" stroke={C.blue} stroke-width="8" stroke-linecap="round" />
  <line x1="240" y1="150" x2="600" y2="150" stroke={C.orange} stroke-width="8" stroke-linecap="round" />

  <!-- boundary marker -->
  <line x1="240" y1="112" x2="240" y2="188" stroke={C.dark} stroke-width="2" stroke-dasharray="5 4" />
  <text x="240" y="106" text-anchor="middle" fill={C.dark} font-family={FONT} font-size="9.5" font-weight="800">
    {`${BOUNDARY_IN} in`}
  </text>
  <line x1="82" y1="200" x2="238" y2="200" stroke={C.muted} stroke-width="1.4" marker-end="url(#sewer-boundary-arrow-muted)" />
  <text x="160" y="214" text-anchor="middle" fill={C.muted} font-family={FONT} font-size="8.5">measured from the outside face</text>

  <text x="96" y="136" fill={C.blue} font-family={FONT} font-size="10.5" font-weight="800">BUILDING DRAIN</text>
  <text x="300" y="136" fill={C.orange} font-family={FONT} font-size="10.5" font-weight="800">BUILDING SEWER</text>

  <rect x="24" y="216" width="330" height="36" rx="8" fill={C.blueLight} stroke={C.blue} stroke-width="1.6" />
  <text x="38" y="232" fill={C.blue} font-family={FONT} font-size="9.5" font-weight="800">Inside the line: the plumbing code, your permit</text>
  <text x="38" y="245" fill={C.dark} font-family={FONT} font-size="9">
    {`Sized on DFU. ${DFU} DFU with a water closet is ${sizeLabel(size)} — the ${sizeLabel(MIN_BUILDING_DRAIN_WITH_WC)} floor, not the table.`}
  </text>

  <rect x="366" y="216" width="330" height="36" rx="8" fill={C.orangeLight} stroke={C.orange} stroke-width="1.6" />
  <text x="380" y="232" fill={C.orange} font-family={FONT} font-size="9.5" font-weight="800">Outside it: often the sewer authority too</text>
  <text x="380" y="245" fill={C.dark} font-family={FONT} font-size="9">
    Separate permit, separate inspection, and frequently a different contractor licence.
  </text>
</svg>
