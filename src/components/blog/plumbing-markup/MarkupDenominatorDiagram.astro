---
import { C, FONT } from "../infographicTokens";
import { estimateJob, usd, fmt } from "@/lib/plumbing";

/**
 * Why they differ at all: the same dollar profit measured against two different
 * denominators. Base copied from plumbing-estimate-calculator/index.astro so
 * the post and the calculator agree.
 */
const BASE = {
  labourHours: 10,
  labourRate: 110,
  fixtureCost: 850,
  materialCost: 450,
  overheadPercent: 15,
};
const RATE = 25;
const r = estimateJob({ ...BASE, marginPercent: RATE });

const cost = r.breakEven;
const markupProfit = r.markupProfit;
const markupPrice = r.markupPrice;

const SCALE_X = 150;
const SCALE_W = 470;
const maxVal = markupPrice;
const toW = (v: number) => (v / maxVal) * SCALE_W;
---

<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 720 268" fill="none" aria-hidden="true">
  <title>Why markup and margin differ — two denominators for one profit</title>
  <desc>
    The same profit measured against cost gives the markup percentage and measured against price gives the margin
    percentage. Price is always the larger denominator, so margin is always the smaller number.
  </desc>

  <rect x="8" y="8" width="704" height="252" rx="12" fill={C.panelBg} stroke={C.border} />
  <text x="24" y="34" fill={C.dark} font-family={FONT} font-size="14" font-weight="700">One profit, two denominators</text>
  <text x="24" y="52" fill={C.muted} font-family={FONT} font-size="11">
    {`A job costing ${usd(cost)} sold for ${usd(markupPrice)}. The ${usd(markupProfit)} of profit does not change — only what you divide it by.`}
  </text>

  <rect x={SCALE_X} y="80" width={toW(cost)} height="34" rx="6" fill={C.dark} opacity="0.6" />
  <rect x={SCALE_X + toW(cost)} y="80" width={toW(markupProfit)} height="34" rx="6" fill={C.primary} opacity="0.8" />
  <text x={SCALE_X + toW(cost) / 2} y="102" text-anchor="middle" fill={C.white} font-family={FONT} font-size="11" font-weight="800">
    {`cost ${usd(cost)}`}
  </text>
  <text x={SCALE_X + toW(cost) + toW(markupProfit) / 2} y="102" text-anchor="middle" fill={C.white} font-family={FONT} font-size="10" font-weight="800">
    {usd(markupProfit)}
  </text>
  <text x="28" y="102" fill={C.muted} font-family={FONT} font-size="9.5" font-weight="700">THE JOB</text>

  <line x1={SCALE_X} y1="126" x2={SCALE_X + toW(cost)} y2="126" stroke={C.orange} stroke-width="2.4" />
  <text x={SCALE_X + toW(cost) / 2} y="144" text-anchor="middle" fill={C.orange} font-family={FONT} font-size="10.5" font-weight="800">
    {`MARKUP divides by cost → ${usd(markupProfit)} ÷ ${usd(cost)} = ${fmt(RATE)}%`}
  </text>

  <line x1={SCALE_X} y1="164" x2={SCALE_X + toW(markupPrice)} y2="164" stroke={C.blue} stroke-width="2.4" />
  <text x={SCALE_X + toW(markupPrice) / 2} y="182" text-anchor="middle" fill={C.blue} font-family={FONT} font-size="10.5" font-weight="800">
    {`MARGIN divides by price → ${usd(markupProfit)} ÷ ${usd(markupPrice)} = ${fmt(r.effectiveMargin, 1)}%`}
  </text>

  <rect x="24" y="200" width="672" height="46" rx="10" fill={C.primaryLight} stroke={C.primary} stroke-width="2" />
  <text x="360" y="220" text-anchor="middle" fill={C.primary} font-family={FONT} font-size="12.5" font-weight="800">
    {`Price is always bigger than cost, so margin is always the smaller percentage.`}
  </text>
  <text x="360" y="238" text-anchor="middle" fill={C.dark} font-family={FONT} font-size="10">
    {`They can never be equal — and the gap widens as the rate rises, which is what makes the confusion expensive.`}
  </text>
</svg>
