---
import { C, FONT } from "../infographicTokens";
import {
  firstHourRating, recoveryGph, STANDARD_TANK_SIZES,
} from "@/lib/plumbing";
/** The differentiator. First-hour rating is 70% of the tank plus one hour of
 * recovery, and gas recovers more than twice as fast as a 4500 W element. */
const PEAK = 66;
const RISE = 90;
const gasRecovery = recoveryGph(40000, 0.8, RISE);
const elecRecovery = recoveryGph(4500 * 3.412142, 1.0, RISE);

const rows = STANDARD_TANK_SIZES.slice(0, 6).map((tank) => {
  const gas = firstHourRating(tank, gasRecovery);
  const elec = firstHourRating(tank, elecRecovery);
  return {
    label: `${tank} gallon tank`,
    cells: [`${gas.toFixed(1)} gal`, `${elec.toFixed(1)} gal`, gas >= PEAK && elec >= PEAK ? "both" : gas >= PEAK ? "gas only" : "neither"],
    tone: [gas >= PEAK ? "good" : "bad", elec >= PEAK ? "good" : "bad", gas >= PEAK && elec >= PEAK ? "good" : gas >= PEAK ? "neutral" : "bad"],
  };
});
---

<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 720 310" fill="none" aria-hidden="true">
  <title>First-hour rating, gas against electric — a 66 gallon peak</title>
  <desc>40,000 BTU at 80% recovers 42.7 gph; a 4,500 W element recovers 20.5 gph. FHR = 0.70 x tank + recovery</desc>

  <rect x="8" y="8" width="704" height="296" rx="12" fill={C.panelBg} stroke={C.border} />
  <text x="24" y="34" fill={C.dark} font-family={FONT} font-size="14" font-weight="700">First-hour rating, gas against electric — a 66 gallon peak</text>
  <text x="24" y="52" fill={C.muted} font-family={FONT} font-size="11">40,000 BTU at 80% recovers 42.7 gph; a 4,500 W element recovers 20.5 gph. FHR = 0.70 x tank + recovery</text>

  <text x="28" y="76" fill={C.muted} font-family={FONT} font-size="8" font-weight="700">TANK SIZE</text>
  <text x={302} y="76" text-anchor="middle" fill={C.muted} font-family={FONT} font-size="8" font-weight="700">GAS FHR</text>
  <text x={454} y="76" text-anchor="middle" fill={C.muted} font-family={FONT} font-size="8" font-weight="700">ELECTRIC FHR</text>
  <text x={606} y="76" text-anchor="middle" fill={C.muted} font-family={FONT} font-size="8" font-weight="700">MEETS 66 GAL?</text>

  {rows.map((row, i) => {
    const y = 86 + i * 30;
    return (
      <g>
        <text x="28" y={y + 16} fill={C.dark} font-family={FONT} font-size="10.5" font-weight="700">{row.label}</text>
            <rect x={232} y={y} width={140} height="24" rx="6" fill={row.tone[0] === "bad" ? C.red : row.tone[0] === "good" ? C.green : C.orange} opacity={row.tone[0] === "bad" ? 0.18 : 0.1} />
            <rect x={232} y={y} width={140} height="24" rx="6" fill="none" stroke={row.tone[0] === "bad" ? C.red : row.tone[0] === "good" ? C.green : C.orange} stroke-width={row.tone[0] === "bad" ? 2 : 1.2} />
            <text x={302} y={y + 16} text-anchor="middle" fill={row.tone[0] === "bad" ? C.red : row.tone[0] === "good" ? C.green : C.orange} font-family={FONT} font-size="10.5" font-weight={row.tone[0] === "bad" ? 800 : 700}>
              {row.cells[0]}
            </text>
            <rect x={384} y={y} width={140} height="24" rx="6" fill={row.tone[1] === "bad" ? C.red : row.tone[1] === "good" ? C.green : C.orange} opacity={row.tone[1] === "bad" ? 0.18 : 0.1} />
            <rect x={384} y={y} width={140} height="24" rx="6" fill="none" stroke={row.tone[1] === "bad" ? C.red : row.tone[1] === "good" ? C.green : C.orange} stroke-width={row.tone[1] === "bad" ? 2 : 1.2} />
            <text x={454} y={y + 16} text-anchor="middle" fill={row.tone[1] === "bad" ? C.red : row.tone[1] === "good" ? C.green : C.orange} font-family={FONT} font-size="10.5" font-weight={row.tone[1] === "bad" ? 800 : 700}>
              {row.cells[1]}
            </text>
            <rect x={536} y={y} width={140} height="24" rx="6" fill={row.tone[2] === "bad" ? C.red : row.tone[2] === "good" ? C.green : C.orange} opacity={row.tone[2] === "bad" ? 0.18 : 0.1} />
            <rect x={536} y={y} width={140} height="24" rx="6" fill="none" stroke={row.tone[2] === "bad" ? C.red : row.tone[2] === "good" ? C.green : C.orange} stroke-width={row.tone[2] === "bad" ? 2 : 1.2} />
            <text x={606} y={y + 16} text-anchor="middle" fill={row.tone[2] === "bad" ? C.red : row.tone[2] === "good" ? C.green : C.orange} font-family={FONT} font-size="10.5" font-weight={row.tone[2] === "bad" ? 800 : 700}>
              {row.cells[2]}
            </text>
      </g>
    );
  })}

  <text x="24" y="290" fill={C.muted} font-family={FONT} font-size="10">A 40 gallon gas heater clears this peak. The 50 gallon electric everybody reaches for does not — it needs 75 gallons.</text>
</svg>
