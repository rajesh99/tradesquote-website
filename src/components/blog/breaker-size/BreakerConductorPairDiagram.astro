---
import { C, FONT } from "../infographicTokens";

/**
 * Minimum copper and aluminum conductor for each common breaker rating — Table
 * 310.16 at 75 °C with the 240.4(D) caps applied, which is why 25 A lands on 10 AWG
 * rather than 12.
 */
const pairs = [
  { breaker: "15 A", copper: "14 AWG", aluminum: "12 AWG" },
  { breaker: "20 A", copper: "12 AWG", aluminum: "10 AWG" },
  { breaker: "25 A", copper: "10 AWG", aluminum: "10 AWG" },
  { breaker: "30 A", copper: "10 AWG", aluminum: "8 AWG" },
  { breaker: "40 A", copper: "8 AWG", aluminum: "8 AWG" },
  { breaker: "50 A", copper: "8 AWG", aluminum: "6 AWG" },
  { breaker: "60 A", copper: "6 AWG", aluminum: "4 AWG" },
  { breaker: "80 A", copper: "4 AWG", aluminum: "2 AWG" },
  { breaker: "100 A", copper: "3 AWG", aluminum: "1 AWG" },
];
---

<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 720 400" fill="none" aria-hidden="true">
  <title>Minimum conductor size for each breaker rating</title>
  <desc>
    Smallest conductor that may be protected by each common breaker rating, from Table 310.16 at 75 degrees
    Celsius with the 240.4(D) caps applied. 15 amps takes 14 AWG copper or 12 AWG aluminum; 20 amps 12 AWG
    or 10 AWG; 25 amps 10 AWG in either material; 30 amps 10 AWG copper or 8 AWG aluminum; 40 amps 8 AWG in
    either; 50 amps 8 AWG copper or 6 AWG aluminum; 60 amps 6 AWG or 4 AWG; 80 amps 4 AWG or 2 AWG; and 100
    amps 3 AWG copper or 1 AWG aluminum.
  </desc>

  <rect x="8" y="8" width="704" height="384" rx="12" fill={C.panelBg} stroke={C.border} />
  <text x="24" y="36" fill={C.dark} font-family={FONT} font-size="14" font-weight="700">Breaker → minimum conductor</text>
  <text x="24" y="54" fill={C.muted} font-family={FONT} font-size="11">Table 310.16 at 75 °C with the 240.4(D) caps applied. Longer runs may need more.</text>

  <text x="52" y="88" fill={C.muted} font-family={FONT} font-size="10" font-weight="700" letter-spacing="0.5">BREAKER</text>
  <text x="252" y="88" fill={C.primary} font-family={FONT} font-size="10" font-weight="700" letter-spacing="0.5">COPPER</text>
  <text x="472" y="88" fill={C.blue} font-family={FONT} font-size="10" font-weight="700" letter-spacing="0.5">ALUMINUM</text>
  <line x1="24" y1="96" x2="696" y2="96" stroke={C.border} />

  {pairs.map((p, i) => {
    const y = 106 + i * 31;
    return (
      <g>
        <rect x="24" y={y} width="672" height="26" rx="6" fill={C.white} stroke={C.border} stroke-width="0.8" />
        <text x="52" y={y + 18} fill={C.dark} font-family={FONT} font-size="12" font-weight="800">{p.breaker}</text>
        <rect x="248" y={y + 3} width="86" height="20" rx="5" fill={C.primaryLight} stroke={C.primary} stroke-width="1" />
        <text x="291" y={y + 17} text-anchor="middle" fill={C.dark} font-family={FONT} font-size="11" font-weight="700">{p.copper}</text>
        <rect x="468" y={y + 3} width="86" height="20" rx="5" fill={C.blueLight} stroke={C.blue} stroke-width="1" />
        <text x="511" y={y + 17} text-anchor="middle" fill={C.dark} font-family={FONT} font-size="11" font-weight="700">{p.aluminum}</text>
      </g>
    );
  })}

  <text x="24" y="384" fill={C.muted} font-family={FONT} font-size="10">Reading this backwards — picking a breaker to suit wire already pulled — is exactly how undersized circuits happen.</text>
</svg>
