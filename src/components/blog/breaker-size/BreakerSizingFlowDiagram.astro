---
import { C, FONT, markerDefs } from "../infographicTokens";

const defs = markerDefs("bsf");

/**
 * The order the checks run in. Steps 1–3 find the candidate breaker from the load;
 * steps 4–5 are the conductor's veto. Both have to pass.
 */
const steps = [
  {
    n: "1",
    title: "Start with the load",
    body: ["Actual amps drawn, from", "nameplate or calculation —", "not a guess."],
    accent: C.blue,
    bg: C.blueLight,
  },
  {
    n: "2",
    title: "× 1.25 if continuous",
    body: ["Continuous = 3 hours or", "more of operation.", "210.20(A)."],
    accent: C.blue,
    bg: C.blueLight,
  },
  {
    n: "3",
    title: "Round up to standard",
    body: ["15, 20, 25, 30, 35, 40…", "There is no 33 A breaker.", "240.6(A)."],
    accent: C.primary,
    bg: C.primaryLight,
  },
  {
    n: "4",
    title: "Conductor must cover it",
    body: ["Wire ampacity ≥ breaker,", "or use the next-size-up", "rule in 240.4(B)."],
    accent: C.orange,
    bg: C.orangeLight,
  },
  {
    n: "5",
    title: "Apply the small-wire cap",
    body: ["14/12/10 AWG are capped", "at 15/20/30 A regardless.", "240.4(D)."],
    accent: C.red,
    bg: C.redLight,
  },
];
---

<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 720 300" fill="none" aria-hidden="true">
  <title>How to size a breaker, step by step</title>
  <desc>
    Five steps in order. Start with the actual load in amps. Multiply by 1.25 if the load is continuous,
    meaning three hours or more, per 210.20(A). Round up to a standard rating from 240.6(A) — 15, 20, 25,
    30, 35, 40 and so on. Confirm the conductor ampacity covers that breaker, or apply the next standard
    size up rule of 240.4(B). Finally apply the 240.4(D) small conductor cap, which limits 14, 12 and 10
    AWG copper to 15, 20 and 30 amps regardless of the table.
  </desc>

  <defs set:html={defs} />

  <rect x="8" y="8" width="704" height="284" rx="12" fill={C.panelBg} stroke={C.border} />
  <text x="24" y="36" fill={C.dark} font-family={FONT} font-size="14" font-weight="700">Sizing a breaker: load first, conductor veto second</text>
  <text x="24" y="54" fill={C.muted} font-family={FONT} font-size="11">Steps 1–3 find the candidate from the load. Steps 4–5 are the wire's right to refuse it.</text>

  {steps.map((s, i) => {
    const x = 24 + i * 137;
    return (
      <g>
        <rect x={x} y="76" width="126" height="132" rx="9" fill={s.bg} stroke={s.accent} stroke-width="1.5" />
        <circle cx={x + 22} cy="100" r="12" fill={C.white} stroke={s.accent} stroke-width="1.4" />
        <text x={x + 22} y="105" text-anchor="middle" fill={s.accent} font-family={FONT} font-size="12" font-weight="800">{s.n}</text>
        <text x={x + 10} y="132" fill={C.dark} font-family={FONT} font-size="10" font-weight="800">
          <tspan x={x + 10} dy="0">{s.title}</tspan>
        </text>
        <text x={x + 10} y="154" fill={C.muted} font-family={FONT} font-size="9">
          {s.body.map((line, li) => (
            <tspan x={x + 10} dy={li === 0 ? "0" : "12"}>{line}</tspan>
          ))}
        </text>
      </g>
    );
  })}

  <!-- Outcome -->
  <rect x="24" y="224" width="330" height="54" rx="9" fill={C.greenLight} stroke={C.green} stroke-width="1.6" />
  <text x="40" y="246" fill={C.green} font-family={FONT} font-size="11.5" font-weight="800">Both tests pass → that's your breaker</text>
  <text x="40" y="266" fill={C.muted} font-family={FONT} font-size="9.5">The breaker protects the wire; the load only sets the minimum</text>

  <rect x="366" y="224" width="330" height="54" rx="9" fill={C.orangeLight} stroke={C.orange} stroke-width="1.6" />
  <text x="382" y="246" fill={C.orange} font-family={FONT} font-size="11.5" font-weight="800">Motors and A/C skip steps 2–5</text>
  <text x="382" y="266" fill={C.muted} font-family={FONT} font-size="9.5">430.52 and 440.22 set their own rules — often well above wire ampacity</text>
</svg>
