---
import { C, FONT } from "../infographicTokens";

/**
 * Why Annex C and a strict area calculation can disagree by one conductor: Note 7 to
 * the Chapter 9 tables permits rounding up when the calculation's decimal is 0.8 or
 * larger, for conductors all of the same size. Annex C bakes that in; a strict area
 * comparison does not. Each row is computed from the Table 4 and Table 5 figures.
 */
const cases = [
  { trade: '3/4"', area: 0.533, size: "14", condArea: 0.0097 },
  { trade: '3/4"', area: 0.533, size: "8", condArea: 0.0366 },
  { trade: '1"', area: 0.864, size: "12", condArea: 0.0133 },
];

const rows = cases.map((c) => {
  const raw = (c.area * 0.4) / c.condArea;
  const strict = Math.floor(raw);
  const annex = raw - strict >= 0.8 ? strict + 1 : strict;
  return { ...c, raw, strict, annex };
});
---

<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 720 290" fill="none" aria-hidden="true">
  <title>Why Annex C and a strict area calculation differ by one conductor</title>
  <desc>
    Note 7 to the Chapter 9 tables permits rounding up when a same-size conductor calculation produces a
    decimal of 0.8 or larger. Three-quarter inch EMT with 14 AWG THHN calculates to 21.98, so a strict reading
    gives 21 while Note 7 and Annex C permit 22. The same raceway with 8 AWG calculates to 5.83, giving 5
    strictly and 6 under Note 7. One inch EMT with 12 AWG calculates to 25.98, giving 25 strictly and 26 under
    Note 7. Note 7 applies only where every conductor is the same size, so a mixed fill must be computed
    strictly.
  </desc>

  <rect x="8" y="8" width="704" height="274" rx="12" fill={C.panelBg} stroke={C.border} />
  <text x="24" y="36" fill={C.dark} font-family={FONT} font-size="14" font-weight="700">Note 7 — the 0.8 rounding rule</text>
  <text x="24" y="54" fill={C.muted} font-family={FONT} font-size="11">Same-size conductors only. This is the exact reason Annex C can read one higher than your own arithmetic.</text>

  <text x="40" y="86" fill={C.muted} font-family={FONT} font-size="10" font-weight="700" letter-spacing="0.5">CASE</text>
  <text x="250" y="86" fill={C.muted} font-family={FONT} font-size="10" font-weight="700" letter-spacing="0.5">RAW</text>
  <text x="380" y="86" fill={C.orange} font-family={FONT} font-size="10" font-weight="700" letter-spacing="0.5">STRICT</text>
  <text x="520" y="86" fill={C.primary} font-family={FONT} font-size="10" font-weight="700" letter-spacing="0.5">NOTE 7 / ANNEX C</text>
  <line x1="24" y1="94" x2="696" y2="94" stroke={C.border} />

  {rows.map((r, i) => {
    const y = 104 + i * 40;
    return (
      <g>
        <rect x="24" y={y} width="672" height="34" rx="6" fill={C.white} stroke={C.border} stroke-width="0.9" />
        <text x="40" y={y + 22} fill={C.dark} font-family={FONT} font-size="11" font-weight="700">{`${r.trade} EMT · ${r.size} AWG THHN`}</text>
        <text x="250" y={y + 22} fill={C.muted} font-family={FONT} font-size="11.5" font-weight="700">{r.raw.toFixed(2)}</text>
        <rect x="374" y={y + 7} width="46" height="20" rx="5" fill={C.orangeLight} stroke={C.orange} stroke-width="1.1" />
        <text x="397" y={y + 21} text-anchor="middle" fill={C.dark} font-family={FONT} font-size="11" font-weight="800">{r.strict}</text>
        <rect x="520" y={y + 7} width="46" height="20" rx="5" fill={C.primaryLight} stroke={C.primary} stroke-width="1.3" />
        <text x="543" y={y + 21} text-anchor="middle" fill={C.dark} font-family={FONT} font-size="11" font-weight="800">{r.annex}</text>
        <text x="586" y={y + 22} fill={C.muted} font-family={FONT} font-size="9.5">decimal ≥ 0.8</text>
      </g>
    );
  })}

  <rect x="24" y="228" width="672" height="46" rx="9" fill={C.blueLight} stroke={C.blue} stroke-width="1.5" />
  <text x="44" y="248" fill={C.blue} font-family={FONT} font-size="11" font-weight="800">Note 7 says "all of the same size" — so it never applies to a mixed fill</text>
  <text x="44" y="265" fill={C.muted} font-family={FONT} font-size="9.5">Mixed conductor sizes must be computed strictly by area. Our calculator computes strictly throughout, so it reads one lower at these boundaries.</text>
</svg>
