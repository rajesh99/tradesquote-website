---
import { C, FONT } from "../infographicTokens";

/**
 * A mixed fill, worked. Areas are the Chapter 9 Table 5 THHN figures from
 * src/lib/nec.ts; the raceway areas are the Table 4 figures. Everything is computed
 * here so the diagram can't drift from the prose.
 */
const THHN = { "3": 0.0973, "8": 0.0366 };
const EMT = { '3/4"': 0.533, '1"': 0.864 };

const conductors = [
  { qty: 3, size: "3", role: "ungrounded + neutral", area: THHN["3"] },
  { qty: 1, size: "8", role: "equipment ground", area: THHN["8"] },
];

const totalArea = conductors.reduce((sum, c) => sum + c.qty * c.area, 0);
const count = conductors.reduce((sum, c) => sum + c.qty, 0);
const LIMIT = 0.4; // three or more conductors

const candidates = Object.entries(EMT).map(([trade, area]) => ({
  trade,
  area,
  allowed: area * LIMIT,
  pct: (totalArea / area) * 100,
  fits: totalArea <= area * LIMIT,
}));

const fmt4 = (n: number) => n.toFixed(4);
---

<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 720 320" fill="none" aria-hidden="true">
  <title>Mixed conductor size conduit fill worked example</title>
  <desc>
    Three 3 AWG THHN conductors at 0.0973 square inches each plus one 8 AWG equipment grounding conductor at
    0.0366 gives a total conductor area of 0.3285 square inches across four conductors, so the 40 percent limit
    applies. Three-quarter inch EMT has 0.533 square inches of internal area, allowing 0.2132, so the fill does
    not fit. One inch EMT has 0.864 square inches, allowing 0.3456, so it fits at 38.0 percent fill.
  </desc>

  <rect x="8" y="8" width="704" height="304" rx="12" fill={C.panelBg} stroke={C.border} />
  <text x="24" y="36" fill={C.dark} font-family={FONT} font-size="14" font-weight="700">A mixed fill, worked — no chart can do this one</text>
  <text x="24" y="54" fill={C.muted} font-family={FONT} font-size="11">Three 3 AWG THHN plus one 8 AWG equipment ground</text>

  <!-- Conductor rows -->
  {conductors.map((c, i) => {
    const y = 74 + i * 32;
    return (
      <g>
        <rect x="24" y={y} width="440" height="28" rx="6" fill={C.white} stroke={C.border} stroke-width="0.9" />
        <text x="40" y={y + 18} fill={C.dark} font-family={FONT} font-size="11" font-weight="700">{`${c.qty} × ${c.size} AWG THHN`}</text>
        <text x="176" y={y + 18} fill={C.muted} font-family={FONT} font-size="9.5">{c.role}</text>
        <text x="452" y={y + 18} text-anchor="end" fill={C.dark} font-family={FONT} font-size="10.5" font-weight="700">{`${c.qty} × ${fmt4(c.area)} = ${fmt4(c.qty * c.area)}`}</text>
      </g>
    );
  })}

  <line x1="24" y1="144" x2="464" y2="144" stroke={C.dark} stroke-width="1.1" />
  <text x="40" y="162" fill={C.dark} font-family={FONT} font-size="11.5" font-weight="800">{`Total — ${count} conductors, so 40% applies`}</text>
  <text x="452" y="162" text-anchor="end" fill={C.dark} font-family={FONT} font-size="12.5" font-weight="800">{`${fmt4(totalArea)} in²`}</text>

  <!-- Candidate raceways -->
  {candidates.map((c, i) => {
    const y = 186 + i * 58;
    const accent = c.fits ? C.green : C.red;
    const bg = c.fits ? C.greenLight : C.redLight;
    return (
      <g>
        <rect x="24" y={y} width="672" height="50" rx="9" fill={bg} stroke={accent} stroke-width="1.6" />
        <text x="44" y={y + 21} fill={C.dark} font-family={FONT} font-size="12" font-weight="800">{`${c.trade} EMT`}</text>
        <text x="44" y={y + 38} fill={C.muted} font-family={FONT} font-size="9.5">{`${fmt4(c.area)} in² × 40% = ${fmt4(c.allowed)} in² allowed`}</text>
        <text x="330" y={y + 31} fill={accent} font-family={FONT} font-size="14" font-weight="800">{`${c.pct.toFixed(1)}% fill`}</text>
        <text x="470" y={y + 31} fill={accent} font-family={FONT} font-size="12" font-weight="800">
          {c.fits ? "fits — use this one" : "over the limit — too small"}
        </text>
      </g>
    );
  })}
</svg>
