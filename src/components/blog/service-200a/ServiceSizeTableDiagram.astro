---
import { C, FONT } from "../infographicTokens";

/** NEC Table 310.12 — dwelling services and whole-dwelling feeders at 83%. */
const rows = [
  { rating: "100 A", copper: "4 AWG", aluminum: "2 AWG" },
  { rating: "125 A", copper: "2 AWG", aluminum: "1/0 AWG" },
  { rating: "150 A", copper: "1 AWG", aluminum: "2/0 AWG" },
  { rating: "175 A", copper: "1/0 AWG", aluminum: "3/0 AWG" },
  { rating: "200 A", copper: "2/0 AWG", aluminum: "4/0 AWG", highlight: true },
  { rating: "225 A", copper: "3/0 AWG", aluminum: "250 kcmil" },
  { rating: "250 A", copper: "4/0 AWG", aluminum: "300 kcmil" },
  { rating: "400 A", copper: "400 kcmil", aluminum: "600 kcmil" },
];
---

<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 720 400" fill="none" aria-hidden="true">
  <title>NEC Table 310.12 dwelling service conductor sizes</title>
  <desc>
    Dwelling service and whole-dwelling feeder conductors at the 83 percent allowance. 100 amps takes 4 AWG
    copper or 2 AWG aluminum; 125 amps 2 AWG or 1/0; 150 amps 1 AWG or 2/0; 175 amps 1/0 or 3/0; 200 amps
    2/0 copper or 4/0 aluminum; 225 amps 3/0 or 250 kcmil; 250 amps 4/0 or 300 kcmil; and 400 amps 400
    kcmil copper or 600 kcmil aluminum.
  </desc>

  <rect x="8" y="8" width="704" height="384" rx="12" fill={C.panelBg} stroke={C.border} />
  <text x="24" y="36" fill={C.dark} font-family={FONT} font-size="14" font-weight="700">Table 310.12 — dwelling service &amp; whole-dwelling feeder</text>
  <text x="24" y="54" fill={C.muted} font-family={FONT} font-size="11">Only for a dwelling service, or the one feeder carrying an entire dwelling's load</text>

  <text x="48" y="88" fill={C.muted} font-family={FONT} font-size="10" font-weight="700" letter-spacing="0.5">SERVICE</text>
  <text x="248" y="88" fill={C.primary} font-family={FONT} font-size="10" font-weight="700" letter-spacing="0.5">COPPER</text>
  <text x="468" y="88" fill={C.blue} font-family={FONT} font-size="10" font-weight="700" letter-spacing="0.5">ALUMINUM</text>
  <line x1="24" y1="96" x2="696" y2="96" stroke={C.border} />

  {rows.map((r, i) => {
    const y = 106 + i * 34;
    const rowFill = r.highlight ? C.primaryLight : C.white;
    const rowStroke = r.highlight ? C.primary : C.border;
    return (
      <g>
        <rect x="24" y={y} width="672" height="28" rx="6" fill={rowFill} stroke={rowStroke} stroke-width={r.highlight ? "1.6" : "0.8"} />
        <text x="48" y={y + 19} fill={C.dark} font-family={FONT} font-size="12" font-weight={r.highlight ? "800" : "700"}>{r.rating}</text>
        <text x="248" y={y + 19} fill={C.dark} font-family={FONT} font-size="12" font-weight={r.highlight ? "800" : "600"}>{r.copper}</text>
        <text x="468" y={y + 19} fill={C.dark} font-family={FONT} font-size="12" font-weight={r.highlight ? "800" : "600"}>{r.aluminum}</text>
      </g>
    );
  })}

  <text x="24" y="384" fill={C.muted} font-family={FONT} font-size="10">Voltage drop still has to be checked separately — the 83% allowance says nothing about run length.</text>
</svg>
