---
import { C, FONT } from "../infographicTokens";
import {
  totalDfu, minDrainSizeApplied, ventSize, sizeLabel,
} from "@/lib/plumbing";
/** Sizing a wet-vented group. The wet-vented section carries drainage AND air,
 * so it is sized on the DFU load like any branch, with a 2 inch floor once it
 * serves more than a single fixture. */
const GROUPS: { label: string; counts: Record<string, number> }[] = [
  { label: "Half bath (WC + lav)", counts: { "wc-private-16": 1, lavatory: 1 } },
  { label: "Full bath group", counts: { "bathroom-group-16": 1 } },
  { label: "Bath + separate shower", counts: { "bathroom-group-16": 1, "shower-57": 1 } },
  { label: "Two full baths", counts: { "bathroom-group-16": 2 } },
];

const rows = GROUPS.map((g) => {
  const dfu = totalDfu(g.counts);
  const branch = minDrainSizeApplied(dfu, "horizontal-branch", 0.25, true);
  const wet = Math.max(2, branch.size);
  const dry = ventSize(wet, 30).size;
  return {
    label: g.label,
    cells: [`${dfu} DFU`, sizeLabel(wet), sizeLabel(dry)],
    tone: ["neutral", wet > 2 ? "bad" : "good", "good"],
  };
});
---

<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 720 250" fill="none" aria-hidden="true">
  <title>Sizing a wet-vented bathroom group</title>
  <desc>The wet-vented section carries waste and air together, so it is sized on DFU load with a 2 inch floor</desc>

  <rect x="8" y="8" width="704" height="236" rx="12" fill={C.panelBg} stroke={C.border} />
  <text x="24" y="34" fill={C.dark} font-family={FONT} font-size="14" font-weight="700">Sizing a wet-vented bathroom group</text>
  <text x="24" y="52" fill={C.muted} font-family={FONT} font-size="11">The wet-vented section carries waste and air together, so it is sized on DFU load with a 2 inch floor</text>

  <text x="28" y="76" fill={C.muted} font-family={FONT} font-size="8" font-weight="700">WHAT IT SERVES</text>
  <text x={302} y="76" text-anchor="middle" fill={C.muted} font-family={FONT} font-size="8" font-weight="700">DRAINAGE LOAD</text>
  <text x={454} y="76" text-anchor="middle" fill={C.muted} font-family={FONT} font-size="8" font-weight="700">WET VENT SIZE</text>
  <text x={606} y="76" text-anchor="middle" fill={C.muted} font-family={FONT} font-size="8" font-weight="700">DRY VENT</text>

  {rows.map((row, i) => {
    const y = 86 + i * 30;
    return (
      <g>
        <text x="28" y={y + 16} fill={C.dark} font-family={FONT} font-size="10.5" font-weight="700">{row.label}</text>
            <rect x={232} y={y} width={140} height="24" rx="6" fill={row.tone[0] === "bad" ? C.red : row.tone[0] === "good" ? C.green : C.orange} opacity={row.tone[0] === "bad" ? 0.18 : 0.1} />
            <rect x={232} y={y} width={140} height="24" rx="6" fill="none" stroke={row.tone[0] === "bad" ? C.red : row.tone[0] === "good" ? C.green : C.orange} stroke-width={row.tone[0] === "bad" ? 2 : 1.2} />
            <text x={302} y={y + 16} text-anchor="middle" fill={row.tone[0] === "bad" ? C.red : row.tone[0] === "good" ? C.green : C.orange} font-family={FONT} font-size="10.5" font-weight={row.tone[0] === "bad" ? 800 : 700}>
              {row.cells[0]}
            </text>
            <rect x={384} y={y} width={140} height="24" rx="6" fill={row.tone[1] === "bad" ? C.red : row.tone[1] === "good" ? C.green : C.orange} opacity={row.tone[1] === "bad" ? 0.18 : 0.1} />
            <rect x={384} y={y} width={140} height="24" rx="6" fill="none" stroke={row.tone[1] === "bad" ? C.red : row.tone[1] === "good" ? C.green : C.orange} stroke-width={row.tone[1] === "bad" ? 2 : 1.2} />
            <text x={454} y={y + 16} text-anchor="middle" fill={row.tone[1] === "bad" ? C.red : row.tone[1] === "good" ? C.green : C.orange} font-family={FONT} font-size="10.5" font-weight={row.tone[1] === "bad" ? 800 : 700}>
              {row.cells[1]}
            </text>
            <rect x={536} y={y} width={140} height="24" rx="6" fill={row.tone[2] === "bad" ? C.red : row.tone[2] === "good" ? C.green : C.orange} opacity={row.tone[2] === "bad" ? 0.18 : 0.1} />
            <rect x={536} y={y} width={140} height="24" rx="6" fill="none" stroke={row.tone[2] === "bad" ? C.red : row.tone[2] === "good" ? C.green : C.orange} stroke-width={row.tone[2] === "bad" ? 2 : 1.2} />
            <text x={606} y={y + 16} text-anchor="middle" fill={row.tone[2] === "bad" ? C.red : row.tone[2] === "good" ? C.green : C.orange} font-family={FONT} font-size="10.5" font-weight={row.tone[2] === "bad" ? 800 : 700}>
              {row.cells[2]}
            </text>
      </g>
    );
  })}

  <text x="24" y="230" fill={C.muted} font-family={FONT} font-size="10">One dry vent serves the whole group. That is the saving — fewer penetrations, fewer fittings, less roof work.</text>
</svg>
