---
import { C, FONT, markerDefs } from "../infographicTokens";
import { ventSize, sizeLabel } from "@/lib/plumbing";

/**
 * The whole idea in one picture: the drain from the upstream fixture doubles as
 * the vent for the ones downstream of it, so only ONE dry vent is needed for
 * the whole group instead of one per fixture.
 */
const defs = markerDefs("wet-vent");
const WET_SIZE = 2;
const DRY_VENT = ventSize(WET_SIZE, 30).size;
---

<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 720 268" fill="none" aria-hidden="true">
  <title>How a wet vent works — one drain serving as the vent for fixtures downstream</title>
  <desc>
    The lavatory drain carries waste downward and air upward at the same time. Because the pipe never runs full, the
    space above the flow vents the bathtub and water closet downstream of it, so the group needs only one dry vent.
  </desc>
  <defs set:html={defs} />

  <rect x="8" y="8" width="704" height="252" rx="12" fill={C.panelBg} stroke={C.border} />
  <text x="24" y="34" fill={C.dark} font-family={FONT} font-size="14" font-weight="700">One pipe doing two jobs at once</text>
  <text x="24" y="52" fill={C.muted} font-family={FONT} font-size="11">
    {`The lavatory drain is also the vent for everything downstream. Only the ${sizeLabel(DRY_VENT)} dry vent leaves the group.`}
  </text>

  <!-- dry vent up -->
  <line x1="150" y1="82" x2="150" y2="140" stroke={C.primary} stroke-width="3.4" stroke-linecap="round" />
  <polygon points="150,74 145,86 155,86" fill={C.primary} />
  <text x="162" y="92" fill={C.primary} font-family={FONT} font-size="10.5" font-weight="700">{`${sizeLabel(DRY_VENT)} dry vent`}</text>
  <text x="162" y="106" fill={C.muted} font-family={FONT} font-size="9.5">the only one the group needs</text>

  <!-- lavatory -->
  <rect x="108" y="146" width="84" height="24" rx="5" fill={C.white} stroke={C.dark} stroke-width="1.6" />
  <text x="150" y="162" text-anchor="middle" fill={C.dark} font-family={FONT} font-size="10" font-weight="700">lavatory</text>

  <!-- the wet-vented run -->
  <line x1="150" y1="170" x2="150" y2="196" stroke={C.blue} stroke-width="3.4" stroke-linecap="round" />
  <line x1="150" y1="196" x2="560" y2="208" stroke={C.blue} stroke-width="4" stroke-linecap="round" />

  <!-- air travelling back up the same pipe -->
  <line x1="520" y1="186" x2="176" y2="176" stroke={C.primary} stroke-width="1.8" stroke-dasharray="6 4" marker-end={`url(#wet-vent-arrow-primary)`} />
  <text x="348" y="170" text-anchor="middle" fill={C.primary} font-family={FONT} font-size="10" font-weight="700">air travels UP the same pipe</text>
  <text x="348" y="228" text-anchor="middle" fill={C.blue} font-family={FONT} font-size="10" font-weight="700">
    {`waste travels DOWN — ${sizeLabel(WET_SIZE)} minimum wet vent`}
  </text>

  <!-- downstream fixtures -->
  <rect x="300" y="118" width="84" height="24" rx="5" fill={C.white} stroke={C.dark} stroke-width="1.6" />
  <text x="342" y="134" text-anchor="middle" fill={C.dark} font-family={FONT} font-size="10" font-weight="700">bathtub</text>
  <line x1="342" y1="142" x2="342" y2="203" stroke={C.dark} stroke-width="2.2" />

  <rect x="470" y="118" width="104" height="24" rx="5" fill={C.white} stroke={C.dark} stroke-width="1.6" />
  <text x="522" y="134" text-anchor="middle" fill={C.dark} font-family={FONT} font-size="10" font-weight="700">water closet</text>
  <line x1="522" y1="142" x2="522" y2="207" stroke={C.dark} stroke-width="2.2" />

  <text x="596" y="212" fill={C.muted} font-family={FONT} font-size="9.5" font-weight="700">to the stack</text>

  <text x="24" y="250" fill={C.muted} font-family={FONT} font-size="10">
    It works because a drainage pipe never runs full at these loads — the space above the flow is the vent path.
  </text>
</svg>
