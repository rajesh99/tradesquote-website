---
import { ampsToVoltAmps, ampsToWatts, fmtInt } from "@/lib/nec";
import { C, FONT } from "../infographicTokens";

/**
 * The three forms of amps-to-watts, each showing the volt-amperes alongside the
 * watts so the distinction between apparent and real power stays visible.
 * Computed with the same helpers the calculator uses.
 */
const cards = [
  {
    tag: "DC",
    formula: "P = V × I",
    amps: 10,
    volts: 12,
    pf: 1,
    mode: "dc" as const,
    note: "Watts and VA are the same number",
    accent: C.blue,
    bg: C.blueLight,
  },
  {
    tag: "AC single-phase",
    formula: "P = V × I × PF",
    amps: 20,
    volts: 120,
    pf: 0.8,
    mode: "1ph" as const,
    note: "PF only reduces the watts, never the amps",
    accent: C.orange,
    bg: C.orangeLight,
  },
  {
    tag: "AC three-phase",
    formula: "P = √3 × V × I × PF",
    amps: 30,
    volts: 480,
    pf: 0.85,
    mode: "3ph" as const,
    note: "I is the line current, not the total",
    accent: C.primary,
    bg: C.primaryLight,
  },
].map((c) => ({
  ...c,
  watts: ampsToWatts(c.amps, c.mode, c.volts, c.pf),
  va: c.mode === "dc" ? ampsToWatts(c.amps, c.mode, c.volts, c.pf) : ampsToVoltAmps(c.amps, c.mode, c.volts),
}));
---

<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 720 258" fill="none" aria-hidden="true">
  <title>Amps to watts in its three forms</title>
  <desc>
    On direct current, 10 amps at 12 volts is 120 watts and 120 volt-amperes — the same number. On alternating
    single-phase, 20 amps at 120 volts with a 0.8 power factor is 1,920 watts of the 2,400 volt-amperes the
    conductor carries. On balanced three-phase, 30 amps at 480 volts with a 0.85 power factor is 21,200 watts of
    24,942 volt-amperes.
  </desc>

  <rect x="8" y="8" width="704" height="242" rx="12" fill={C.panelBg} stroke={C.border} />
  <text x="24" y="36" fill={C.dark} font-family={FONT} font-size="14" font-weight="700">Amps × volts always gives VA. Watts only equal VA at unity power factor.</text>
  <text x="24" y="54" fill={C.muted} font-family={FONT} font-size="11">The conductor is sized for the amps, so the VA figure is the one that decides the wire.</text>

  {cards.map((c, i) => {
    const x = 24 + i * 228;
    return (
      <g>
        <rect x={x} y="72" width="216" height="154" rx="10" fill={c.bg} stroke={c.accent} stroke-width="1.5" />
        <text x={x + 16} y="94" fill={c.accent} font-family={FONT} font-size="10" font-weight="800">{c.tag.toUpperCase()}</text>
        <text x={x + 16} y="116" fill={C.dark} font-family={FONT} font-size="13" font-weight="800">{c.formula}</text>
        <line x1={x + 16} y1="128" x2={x + 200} y2="128" stroke={c.accent} stroke-width="1" opacity="0.4" />
        <text x={x + 16} y="146" fill={C.muted} font-family={FONT} font-size="9.5">{`${c.amps} A at ${c.volts} V${c.mode === "dc" ? "" : `, PF ${c.pf}`}`}</text>
        <text x={x + 16} y="172" fill={c.accent} font-family={FONT} font-size="18" font-weight="800">{`${fmtInt(c.watts)} W`}</text>
        <text x={x + 16} y="192" fill={C.dark} font-family={FONT} font-size="11" font-weight="700">{`of ${fmtInt(c.va)} VA`}</text>
        <text x={x + 16} y="212" fill={C.muted} font-family={FONT} font-size="8.5">{c.note}</text>
      </g>
    );
  })}
</svg>
