---
import { C, FONT } from "../infographicTokens";
import { PRV_THRESHOLD_PSI, availableFrictionPsi, headToPsi, fmt } from "@/lib/plumbing";

/**
 * The threshold is a bright line, and the interesting part is that the pressure
 * above it is not doing anything useful — the friction budget is already
 * generous well below 80 psi.
 */
const LIFT_FT = 25;
const FIXTURE_PSI = 15;
const METER_PSI = 8;

const rows = [50, 65, 80, 100, 120].map((supplyPsi) => ({
  supplyPsi,
  available: availableFrictionPsi({
    supplyPsi,
    highestFixtureFeet: LIFT_FT,
    fixtureRequiredPsi: FIXTURE_PSI,
    meterLossPsi: METER_PSI,
    otherLossPsi: 0,
  }),
  needsPrv: supplyPsi > PRV_THRESHOLD_PSI,
}));

const maxAvail = Math.max(...rows.map((r) => r.available));
const liftPsi = headToPsi(LIFT_FT);

const BAR_X = 176;
const BAR_MAX = 264;
---

<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 720 276" fill="none" aria-hidden="true">
  <title>Friction budget against supply pressure, with the PRV threshold</title>
  <desc>
    The pressure available for friction at five supply pressures, showing that the budget is already generous well
    below the eighty psi point at which a pressure reducing valve becomes required.
  </desc>

  <rect x="8" y="8" width="704" height="260" rx="12" fill={C.panelBg} stroke={C.border} />
  <text x="24" y="34" fill={C.dark} font-family={FONT} font-size="14" font-weight="700">
    {`Above ${PRV_THRESHOLD_PSI} psi the extra pressure buys you nothing`}
  </text>
  <text x="24" y="52" fill={C.muted} font-family={FONT} font-size="11">
    {`${LIFT_FT} ft to the highest fixture (${fmt(liftPsi, 2)} psi), ${METER_PSI} psi meter loss, ${FIXTURE_PSI} psi needed at the fixture.`}
  </text>

  {rows.map((row, i) => {
    const y = 78 + i * 32;
    const w = Math.max(3, (row.available / maxAvail) * BAR_MAX);
    const tone = row.needsPrv ? C.red : C.primary;
    return (
      <g>
        <text x="28" y={y + 17} fill={C.dark} font-family={FONT} font-size="11" font-weight="700">
          {`${row.supplyPsi} psi static`}
        </text>
        <rect x={BAR_X} y={y + 3} width={BAR_MAX} height="20" rx="5" fill={C.border} opacity="0.28" />
        <rect x={BAR_X} y={y + 3} width={w} height="20" rx="5" fill={tone} opacity="0.72" />
        <text x={BAR_X + BAR_MAX + 10} y={y + 18} fill={tone} font-family={FONT} font-size="10.5" font-weight={row.needsPrv ? 800 : 600}>
          {row.needsPrv
            ? `${fmt(row.available, 1)} psi — and a PRV is required`
            : `${fmt(row.available, 1)} psi for friction`}
        </text>
      </g>
    );
  })}

  <rect x="24" y="234" width="672" height="30" rx="8" fill={C.orangeLight} stroke={C.orange} stroke-width="1.6" />
  <text x="36" y="248" fill={C.orange} font-family={FONT} font-size="10" font-weight="800">
    {`At 65 psi there is already ${fmt(rows[1].available, 1)} psi of friction budget — enough for a long run in generous pipe.`}
  </text>
  <text x="36" y="260" fill={C.dark} font-family={FONT} font-size="9.5">
    The pressure above the threshold is not improving your fixtures. It is working every joint, hose and appliance valve in the house.
  </text>
</svg>
