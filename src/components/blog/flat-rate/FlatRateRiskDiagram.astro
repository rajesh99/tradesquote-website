---
import { C, FONT } from "../infographicTokens";

/**
 * The comparison as a risk allocation rather than a preference. Everything else
 * about the two models follows from who absorbs the difference between estimated
 * and actual hours.
 */
const rows = [
  { aspect: "Who absorbs an overrun", flat: "The contractor", tm: "The customer", flatGood: false },
  { aspect: "Who benefits from speed", flat: "The contractor", tm: "The customer", flatGood: true },
  { aspect: "Price known before work starts", flat: "Yes", tm: "No — an estimate only", flatGood: true },
  { aspect: "Rewards investing in tools and skill", flat: "Yes", tm: "No — faster means less revenue", flatGood: true },
  { aspect: "Needs accurate labour data", flat: "Critically", tm: "Less so", flatGood: false },
  { aspect: "Works on unknown scope", flat: "Badly", tm: "Well", flatGood: false },
  { aspect: "Invites argument about hours", flat: "No", tm: "Frequently", flatGood: true },
];
---

<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 720 284" fill="none" aria-hidden="true">
  <title>Flat rate and time and materials compared as risk allocation</title>
  <desc>
    Under flat rate the contractor absorbs overruns and keeps the benefit of working quickly, the price is known before
    work starts, and investing in tools and skill pays off — but it needs accurate labour data, works badly on unknown
    scope, and never invites an argument about hours. Under time and materials the customer absorbs overruns and
    benefits from speed, the price is only an estimate, working faster reduces revenue, and disputes about hours are
    common.
  </desc>

  <rect x="8" y="8" width="704" height="268" rx="12" fill={C.panelBg} stroke={C.border} />
  <text x="24" y="34" fill={C.dark} font-family={FONT} font-size="14" font-weight="700">It's a risk allocation, not a preference</text>
  <text x="24" y="52" fill={C.muted} font-family={FONT} font-size="11">Everything else about the two models follows from who absorbs the gap between estimated and actual hours.</text>

  <rect x="326" y="64" width="180" height="22" rx="6" fill={C.primary} opacity="0.14" />
  <text x="416" y="79" text-anchor="middle" fill={C.primary} font-family={FONT} font-size="10.5" font-weight="800">FLAT RATE</text>
  <rect x="514" y="64" width="180" height="22" rx="6" fill={C.orange} opacity="0.14" />
  <text x="604" y="79" text-anchor="middle" fill={C.orange} font-family={FONT} font-size="10.5" font-weight="800">TIME & MATERIALS</text>

  {rows.map((r, i) => {
    const y = 92 + i * 26;
    return (
      <g>
        <rect x="24" y={y} width="672" height="22" rx="5" fill={C.white} stroke={C.border} />
        <text x="38" y={y + 15} fill={C.dark} font-family={FONT} font-size="9.5" font-weight="700">{r.aspect}</text>
        <text x="340" y={y + 15} fill={r.flatGood ? C.green : C.red} font-family={FONT} font-size="9" font-weight="700">{r.flat}</text>
        <text x="528" y={y + 15} fill={r.flatGood ? C.red : C.green} font-family={FONT} font-size="9" font-weight="700">{r.tm}</text>
      </g>
    );
  })}

  <text x="24" y="272" fill={C.muted} font-family={FONT} font-size="10">Green is the favourable side of each row. Neither column is green throughout — which is why both models survive.</text>
</svg>
