---
import { usd, fmt } from "@/lib/nec";
import { C, FONT } from "../infographicTokens";

/**
 * Ten real instances of "add a receptacle", showing why a flat rate has to be
 * built on the mean rather than the mode. Pricing on the common case loses money
 * on the tail, and the tail is where the hours are.
 */
const RATE = 95;
const MATERIAL = 15;
const OVERHEAD = 0.15;
const MARGIN = 0.25;

function price(hours: number) {
  const direct = hours * RATE + MATERIAL;
  return (direct * (1 + OVERHEAD)) / (1 - MARGIN);
}

const jobs = [1.2, 1.4, 1.5, 1.5, 1.6, 1.8, 2.0, 2.5, 3.2, 5.3];
const mean = jobs.reduce((a, b) => a + b, 0) / jobs.length;
const mode = 1.5;

const flatOnMode = price(mode);
const flatOnMean = price(mean);

const peak = Math.max(...jobs);
const BAR_X = 96;
const BAR_MAX = 300;
const meanX = BAR_X + (mean / peak) * BAR_MAX;
const modeX = BAR_X + (mode / peak) * BAR_MAX;

const lostOnMode = jobs.reduce((s, h) => s + (flatOnMode - (h * RATE + MATERIAL) * (1 + OVERHEAD)), 0);
const earnedOnMean = jobs.reduce((s, h) => s + (flatOnMean - (h * RATE + MATERIAL) * (1 + OVERHEAD)), 0);
---

<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 720 300" fill="none" aria-hidden="true">
  <title>Why a flat rate must be built on the mean, not the common case</title>
  <desc>
    Ten instances of the same job take 1.2, 1.4, 1.5, 1.5, 1.6, 1.8, 2.0, 2.5, 3.2 and 5.3 hours. The most common
    figure is 1.5 hours but the mean is 2.2 hours, because the long tail pulls it up. A flat rate priced on 1.5 hours
    loses money across the ten jobs; a flat rate priced on the 2.2 hour mean earns the intended margin.
  </desc>

  <rect x="8" y="8" width="704" height="284" rx="12" fill={C.panelBg} stroke={C.border} />
  <text x="24" y="34" fill={C.dark} font-family={FONT} font-size="14" font-weight="700">Ten times you did "the same job"</text>
  <text x="24" y="52" fill={C.muted} font-family={FONT} font-size="11">Actual hours logged. The tail is short but heavy, and it decides the flat rate.</text>

  {jobs.map((h, i) => {
    const y = 68 + i * 17;
    const w = Math.round((h / peak) * BAR_MAX);
    const accent = h > mean ? C.orange : C.primary;
    return (
      <g>
        <text x="28" y={y + 11} fill={C.muted} font-family={FONT} font-size="8.5">{`job ${i + 1}`}</text>
        <rect x={BAR_X} y={y + 1} width={w} height="12" rx="3" fill={accent} opacity="0.22" />
        <rect x={BAR_X} y={y + 1} width={w} height="12" rx="3" fill="none" stroke={accent} stroke-width="1.1" />
        <text x={BAR_X + w + 6} y={y + 11} fill={C.dark} font-family={FONT} font-size="8.5" font-weight="700">{`${fmt(h, 1)} h`}</text>
      </g>
    );
  })}

  <line x1={modeX} y1="62" x2={modeX} y2="244" stroke={C.red} stroke-width="1.4" stroke-dasharray="4 3" />
  <text x={modeX + 4} y="256" fill={C.red} font-family={FONT} font-size="8.5" font-weight="800">{`mode ${fmt(mode, 1)} h`}</text>

  <line x1={meanX} y1="62" x2={meanX} y2="244" stroke={C.green} stroke-width="1.8" />
  <text x={meanX + 4} y="272" fill={C.green} font-family={FONT} font-size="8.5" font-weight="800">{`mean ${fmt(mean, 1)} h`}</text>

  <rect x="452" y="68" width="244" height="80" rx="9" fill={C.redLight} stroke={C.red} stroke-width="1.6" />
  <text x="468" y="88" fill={C.red} font-family={FONT} font-size="9.5" font-weight="800">PRICED ON THE COMMON CASE</text>
  <text x="468" y="110" fill={C.dark} font-family={FONT} font-size="15" font-weight="800">{usd(flatOnMode)}</text>
  <text x="468" y="130" fill={C.muted} font-family={FONT} font-size="8.5">{`across 10 jobs: ${usd(lostOnMode)} of margin`}</text>
  <text x="468" y="142" fill={C.muted} font-family={FONT} font-size="8.5">— a loss once overheads are real</text>

  <rect x="452" y="158" width="244" height="80" rx="9" fill={C.greenLight} stroke={C.green} stroke-width="2" />
  <text x="468" y="178" fill={C.green} font-family={FONT} font-size="9.5" font-weight="800">PRICED ON THE MEAN</text>
  <text x="468" y="200" fill={C.dark} font-family={FONT} font-size="15" font-weight="800">{usd(flatOnMean)}</text>
  <text x="468" y="220" fill={C.muted} font-family={FONT} font-size="8.5">{`across 10 jobs: ${usd(earnedOnMean)} of margin`}</text>
  <text x="468" y="232" fill={C.muted} font-family={FONT} font-size="8.5">— the fast jobs fund the slow ones</text>

  <text x="24" y="288" fill={C.muted} font-family={FONT} font-size="10">A flat rate is a bet on your average. It only pays if you have the volume for the average to show up.</text>
</svg>
