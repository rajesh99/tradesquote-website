---
import { C, FONT, markerDefs } from "../infographicTokens";
import { trapArmMaxFeet, sizeLabel } from "@/lib/plumbing";

/**
 * The mechanism in one picture. Water falling past a fixture connection drags
 * air with it; if the vent cannot supply that air, the only other source is
 * through the trap — and the trap seal is what comes with it.
 */
const defs = markerDefs("gurgle");
const ARM = 2;
const MAX_FT = trapArmMaxFeet(ARM);
---

<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 720 276" fill="none" aria-hidden="true">
  <title>Why a drain gurgles — air taking the only route it can find</title>
  <desc>
    Water falling in a stack drags air behind it. If the vent cannot supply that air, the system pulls it through
    the nearest trap instead, and the trap seal goes with it.
  </desc>
  <defs set:html={defs} />

  <rect x="8" y="8" width="704" height="260" rx="12" fill={C.panelBg} stroke={C.border} />
  <text x="24" y="34" fill={C.dark} font-family={FONT} font-size="14" font-weight="700">The gurgle is air arriving the wrong way</text>
  <text x="24" y="52" fill={C.muted} font-family={FONT} font-size="11">
    Falling water drags air with it. Every drainage system has to replace that air from somewhere.
  </text>

  <!-- working system -->
  <rect x="24" y="70" width="330" height="150" rx="10" fill={C.primaryLight} stroke={C.primary} stroke-width="2" />
  <text x="40" y="90" fill={C.primary} font-family={FONT} font-size="9" font-weight="700">VENTED — AIR COMES FROM ABOVE</text>
  <line x1="150" y1="104" x2="150" y2="150" stroke={C.primary} stroke-width="3" stroke-linecap="round" />
  <polygon points="150,192 145,180 155,180" fill={C.primary} />
  <line x1="150" y1="150" x2="150" y2="184" stroke={C.primary} stroke-width="2" stroke-dasharray="5 4" />
  <text x="164" y="120" fill={C.primary} font-family={FONT} font-size="10" font-weight="700">vent to open air</text>
  <text x="164" y="136" fill={C.muted} font-family={FONT} font-size="9">supplies air on demand</text>
  <rect x="46" y="150" width="76" height="20" rx="4" fill={C.white} stroke={C.dark} stroke-width="1.4" />
  <text x="84" y="164" text-anchor="middle" fill={C.dark} font-family={FONT} font-size="9" font-weight="700">fixture</text>
  <path d="M84 170 v14 q0 8 8 8 h8 q8 0 8 -8 v-6" stroke={C.blue} stroke-width="2.6" fill="none" stroke-linecap="round" />
  <text x="46" y="210" fill={C.dark} font-family={FONT} font-size="9.5" font-weight="700">Trap seal stays put. No sound.</text>

  <!-- failing system -->
  <rect x="366" y="70" width="330" height="150" rx="10" fill={C.redLight} stroke={C.red} stroke-width="2" />
  <text x="382" y="90" fill={C.red} font-family={FONT} font-size="9" font-weight="700">NOT VENTED — AIR COMES THROUGH THE TRAP</text>
  <line x1="492" y1="104" x2="492" y2="140" stroke={C.border} stroke-width="3" stroke-linecap="round" />
  <line x1="480" y1="110" x2="504" y2="134" stroke={C.red} stroke-width="2.6" stroke-linecap="round" />
  <line x1="504" y1="110" x2="480" y2="134" stroke={C.red} stroke-width="2.6" stroke-linecap="round" />
  <text x="516" y="120" fill={C.red} font-family={FONT} font-size="10" font-weight="700">blocked, too far, or absent</text>
  <rect x="388" y="150" width="76" height="20" rx="4" fill={C.white} stroke={C.dark} stroke-width="1.4" />
  <text x="426" y="164" text-anchor="middle" fill={C.dark} font-family={FONT} font-size="9" font-weight="700">fixture</text>
  <path d="M426 170 v14 q0 8 8 8 h8 q8 0 8 -8 v-6" stroke={C.blue} stroke-width="2.6" fill="none" stroke-linecap="round" />
  <line x1="470" y1="182" x2="432" y2="176" stroke={C.red} stroke-width="2" stroke-dasharray="4 3" marker-end="url(#gurgle-arrow-muted)" />
  <text x="388" y="210" fill={C.red} font-family={FONT} font-size="9.5" font-weight="700">Air pulls through the seal. That is the gurgle.</text>

  <text x="24" y="240" fill={C.dark} font-family={FONT} font-size="10.5" font-weight="700">
    {`The sound is the symptom. The loss of seal is the problem — and a ${sizeLabel(ARM)} trap arm is unvented past ${MAX_FT} ft no matter what it connects to.`}
  </text>
  <text x="24" y="258" fill={C.muted} font-family={FONT} font-size="10">
    Once the seal is gone, the drain stops being a barrier and sewer gas has an open path into the room.
  </text>
</svg>
