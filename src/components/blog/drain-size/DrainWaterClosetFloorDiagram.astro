---
import { C, FONT } from "../infographicTokens";
import {
  minDrainSizeApplied, sizeLabel,
} from "@/lib/plumbing";
/** The rule that overrides the table. A water closet anywhere on a building
 * drain floors it at 3 inch regardless of what the DFU arithmetic allows. */
const LOADS = [6, 12, 18, 24];

const rows = LOADS.map((dfu) => {
  const without = minDrainSizeApplied(dfu, "building-drain", 0.25, false);
  const with_ = minDrainSizeApplied(dfu, "building-drain", 0.25, true);
  const floored = with_.governedBy === "water-closet";
  return {
    label: `${dfu} DFU`,
    cells: [
      sizeLabel(without.size),
      sizeLabel(with_.size),
      floored ? "the water closet" : "the table",
    ],
    tone: ["neutral", floored ? "bad" : "good", floored ? "bad" : "good"],
  };
});
---

<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 720 250" fill="none" aria-hidden="true">
  <title>A water closet overrides the DFU table</title>
  <desc>Building drain at 1/4 in per foot, sized with and without a water closet on it</desc>

  <rect x="8" y="8" width="704" height="236" rx="12" fill={C.panelBg} stroke={C.border} />
  <text x="24" y="34" fill={C.dark} font-family={FONT} font-size="14" font-weight="700">A water closet overrides the DFU table</text>
  <text x="24" y="52" fill={C.muted} font-family={FONT} font-size="11">Building drain at 1/4 in per foot, sized with and without a water closet on it</text>

  <text x="28" y="76" fill={C.muted} font-family={FONT} font-size="8" font-weight="700">DFU LOAD</text>
  <text x={302} y="76" text-anchor="middle" fill={C.muted} font-family={FONT} font-size="8" font-weight="700">TABLE ALONE</text>
  <text x={454} y="76" text-anchor="middle" fill={C.muted} font-family={FONT} font-size="8" font-weight="700">WITH A WATER CLOSET</text>
  <text x={606} y="76" text-anchor="middle" fill={C.muted} font-family={FONT} font-size="8" font-weight="700">WHAT GOVERNED</text>

  {rows.map((row, i) => {
    const y = 86 + i * 30;
    return (
      <g>
        <text x="28" y={y + 16} fill={C.dark} font-family={FONT} font-size="10.5" font-weight="700">{row.label}</text>
            <rect x={232} y={y} width={140} height="24" rx="6" fill={row.tone[0] === "bad" ? C.red : row.tone[0] === "good" ? C.green : C.orange} opacity={row.tone[0] === "bad" ? 0.18 : 0.1} />
            <rect x={232} y={y} width={140} height="24" rx="6" fill="none" stroke={row.tone[0] === "bad" ? C.red : row.tone[0] === "good" ? C.green : C.orange} stroke-width={row.tone[0] === "bad" ? 2 : 1.2} />
            <text x={302} y={y + 16} text-anchor="middle" fill={row.tone[0] === "bad" ? C.red : row.tone[0] === "good" ? C.green : C.orange} font-family={FONT} font-size="10.5" font-weight={row.tone[0] === "bad" ? 800 : 700}>
              {row.cells[0]}
            </text>
            <rect x={384} y={y} width={140} height="24" rx="6" fill={row.tone[1] === "bad" ? C.red : row.tone[1] === "good" ? C.green : C.orange} opacity={row.tone[1] === "bad" ? 0.18 : 0.1} />
            <rect x={384} y={y} width={140} height="24" rx="6" fill="none" stroke={row.tone[1] === "bad" ? C.red : row.tone[1] === "good" ? C.green : C.orange} stroke-width={row.tone[1] === "bad" ? 2 : 1.2} />
            <text x={454} y={y + 16} text-anchor="middle" fill={row.tone[1] === "bad" ? C.red : row.tone[1] === "good" ? C.green : C.orange} font-family={FONT} font-size="10.5" font-weight={row.tone[1] === "bad" ? 800 : 700}>
              {row.cells[1]}
            </text>
            <rect x={536} y={y} width={140} height="24" rx="6" fill={row.tone[2] === "bad" ? C.red : row.tone[2] === "good" ? C.green : C.orange} opacity={row.tone[2] === "bad" ? 0.18 : 0.1} />
            <rect x={536} y={y} width={140} height="24" rx="6" fill="none" stroke={row.tone[2] === "bad" ? C.red : row.tone[2] === "good" ? C.green : C.orange} stroke-width={row.tone[2] === "bad" ? 2 : 1.2} />
            <text x={606} y={y + 16} text-anchor="middle" fill={row.tone[2] === "bad" ? C.red : row.tone[2] === "good" ? C.green : C.orange} font-family={FONT} font-size="10.5" font-weight={row.tone[2] === "bad" ? 800 : 700}>
              {row.cells[2]}
            </text>
      </g>
    );
  })}

  <text x="24" y="230" fill={C.muted} font-family={FONT} font-size="10">Below 21 DFU the table would allow 2 inch, and a single toilet anywhere on the run makes that illegal. Solids need the bore.</text>
</svg>
