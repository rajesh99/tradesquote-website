---
import { C, FONT } from "../infographicTokens";
import {
  minDrainSizeApplied, drainCapacity, sizeLabel,
} from "@/lib/plumbing";
/** The same DFU load lands on four different sizes depending on where in the
 * system the pipe sits. The tables are not interchangeable. */
const DFU = 18;
const SLOPE = 0.25;
const APPLICATIONS = [
  { key: "building-drain", label: "Building drain / sewer" },
  { key: "horizontal-branch", label: "Horizontal fixture branch" },
  { key: "stack-short", label: "Stack, 3 intervals or less" },
  { key: "stack-tall", label: "Stack, more than 3 intervals" },
] as const;

const rows = APPLICATIONS.map((a) => {
  const r = minDrainSizeApplied(DFU, a.key, SLOPE, false);
  const cap = drainCapacity(r.size, a.key, SLOPE);
  return {
    label: a.label,
    cells: [sizeLabel(r.size), `${cap} DFU`, `${cap - DFU} spare`],
    tone: ["neutral", "neutral", "good"],
  };
});
---

<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 720 250" fill="none" aria-hidden="true">
  <title>Same 18 DFU, four places in the system, four answers</title>
  <desc>Table 710.1(1) sizes drains and sewers; Table 710.1(2) sizes branches and stacks</desc>

  <rect x="8" y="8" width="704" height="236" rx="12" fill={C.panelBg} stroke={C.border} />
  <text x="24" y="34" fill={C.dark} font-family={FONT} font-size="14" font-weight="700">Same 18 DFU, four places in the system, four answers</text>
  <text x="24" y="52" fill={C.muted} font-family={FONT} font-size="11">Table 710.1(1) sizes drains and sewers; Table 710.1(2) sizes branches and stacks</text>

  <text x="28" y="76" fill={C.muted} font-family={FONT} font-size="8" font-weight="700">WHERE THE PIPE SITS</text>
  <text x={302} y="76" text-anchor="middle" fill={C.muted} font-family={FONT} font-size="8" font-weight="700">MINIMUM SIZE</text>
  <text x={454} y="76" text-anchor="middle" fill={C.muted} font-family={FONT} font-size="8" font-weight="700">ITS CAPACITY</text>
  <text x={606} y="76" text-anchor="middle" fill={C.muted} font-family={FONT} font-size="8" font-weight="700">HEADROOM</text>

  {rows.map((row, i) => {
    const y = 86 + i * 30;
    return (
      <g>
        <text x="28" y={y + 16} fill={C.dark} font-family={FONT} font-size="10.5" font-weight="700">{row.label}</text>
            <rect x={232} y={y} width={140} height="24" rx="6" fill={row.tone[0] === "bad" ? C.red : row.tone[0] === "good" ? C.green : C.orange} opacity={row.tone[0] === "bad" ? 0.18 : 0.1} />
            <rect x={232} y={y} width={140} height="24" rx="6" fill="none" stroke={row.tone[0] === "bad" ? C.red : row.tone[0] === "good" ? C.green : C.orange} stroke-width={row.tone[0] === "bad" ? 2 : 1.2} />
            <text x={302} y={y + 16} text-anchor="middle" fill={row.tone[0] === "bad" ? C.red : row.tone[0] === "good" ? C.green : C.orange} font-family={FONT} font-size="10.5" font-weight={row.tone[0] === "bad" ? 800 : 700}>
              {row.cells[0]}
            </text>
            <rect x={384} y={y} width={140} height="24" rx="6" fill={row.tone[1] === "bad" ? C.red : row.tone[1] === "good" ? C.green : C.orange} opacity={row.tone[1] === "bad" ? 0.18 : 0.1} />
            <rect x={384} y={y} width={140} height="24" rx="6" fill="none" stroke={row.tone[1] === "bad" ? C.red : row.tone[1] === "good" ? C.green : C.orange} stroke-width={row.tone[1] === "bad" ? 2 : 1.2} />
            <text x={454} y={y + 16} text-anchor="middle" fill={row.tone[1] === "bad" ? C.red : row.tone[1] === "good" ? C.green : C.orange} font-family={FONT} font-size="10.5" font-weight={row.tone[1] === "bad" ? 800 : 700}>
              {row.cells[1]}
            </text>
            <rect x={536} y={y} width={140} height="24" rx="6" fill={row.tone[2] === "bad" ? C.red : row.tone[2] === "good" ? C.green : C.orange} opacity={row.tone[2] === "bad" ? 0.18 : 0.1} />
            <rect x={536} y={y} width={140} height="24" rx="6" fill="none" stroke={row.tone[2] === "bad" ? C.red : row.tone[2] === "good" ? C.green : C.orange} stroke-width={row.tone[2] === "bad" ? 2 : 1.2} />
            <text x={606} y={y + 16} text-anchor="middle" fill={row.tone[2] === "bad" ? C.red : row.tone[2] === "good" ? C.green : C.orange} font-family={FONT} font-size="10.5" font-weight={row.tone[2] === "bad" ? 800 : 700}>
              {row.cells[2]}
            </text>
      </g>
    );
  })}

  <text x="24" y="230" fill={C.muted} font-family={FONT} font-size="10">A horizontal branch needs a bigger pipe than the building drain it discharges into — branches carry surges, drains carry averages.</text>
</svg>
