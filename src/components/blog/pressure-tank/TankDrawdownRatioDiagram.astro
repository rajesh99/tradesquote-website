---
import { C, FONT } from "../infographicTokens";
import {
  pressureTankSizing,
  drawdownFraction,
  ATMOSPHERIC_PSI,
  PRECHARGE_BELOW_CUTIN_PSI,
  fmt,
} from "@/lib/plumbing";

/**
 * The headline defect this post exists to correct: a "44 gallon tank" does not
 * hold 44 gallons of usable water, and the gauge-pressure shortcut overstates
 * what it does hold by a third.
 */
const SHELL = 44;
const CUT_IN = 30;
const CUT_OUT = 50;
const PRECHARGE = CUT_IN - PRECHARGE_BELOW_CUTIN_PSI;

const result = pressureTankSizing({ pumpGpm: 10, cutInPsi: CUT_IN, cutOutPsi: CUT_OUT });
const correctFraction = drawdownFraction(CUT_IN, CUT_OUT, PRECHARGE);
const gaugeFraction = 1 - CUT_IN / CUT_OUT;

const usable = SHELL * correctFraction;
const gaugeClaim = SHELL * gaugeFraction;

/* Vertical shell drawing. */
const SHELL_X = 60;
const SHELL_Y = 84;
const SHELL_W = 96;
const SHELL_H = 150;
const waterH = SHELL_H * correctFraction;
---

<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 720 286" fill="none" aria-hidden="true">
  <title>How much water a forty-four gallon pressure tank actually delivers</title>
  <desc>
    Drawdown is the fraction of the shell swept between cut-in and cut-out, computed from absolute pressures. On a
    thirty-fifty switch that is under thirty percent, not the forty percent gauge arithmetic suggests.
  </desc>

  <rect x="8" y="8" width="704" height="270" rx="12" fill={C.panelBg} stroke={C.border} />
  <text x="24" y="34" fill={C.dark} font-family={FONT} font-size="14" font-weight="700">A 44 gallon tank does not hold 44 gallons</text>
  <text x="24" y="52" fill={C.muted} font-family={FONT} font-size="11">
    {`${CUT_IN}/${CUT_OUT} psi switch, ${PRECHARGE} psi pre-charge. Only the volume swept between the two pressures is water you get.`}
  </text>

  <rect x={SHELL_X} y={SHELL_Y} width={SHELL_W} height={SHELL_H} rx="14" fill={C.white} stroke={C.dark} stroke-width="2" />
  <rect x={SHELL_X} y={SHELL_Y + SHELL_H - waterH} width={SHELL_W} height={waterH} rx="6" fill={C.primary} opacity="0.55" />
  <line x1={SHELL_X} y1={SHELL_Y + SHELL_H - waterH} x2={SHELL_X + SHELL_W} y2={SHELL_Y + SHELL_H - waterH} stroke={C.primary} stroke-width="2.4" />
  <text x={SHELL_X + SHELL_W / 2} y={SHELL_Y + SHELL_H - waterH / 2 + 4} text-anchor="middle" fill={C.dark} font-family={FONT} font-size="11" font-weight="800">
    {`${fmt(usable, 1)} gal`}
  </text>
  <text x={SHELL_X + SHELL_W / 2} y={SHELL_Y + 30} text-anchor="middle" fill={C.muted} font-family={FONT} font-size="10" font-weight="700">air</text>
  <text x={SHELL_X + SHELL_W / 2} y={SHELL_Y + 46} text-anchor="middle" fill={C.muted} font-family={FONT} font-size="9">never leaves</text>
  <text x={SHELL_X + SHELL_W / 2} y={SHELL_Y - 10} text-anchor="middle" fill={C.dark} font-family={FONT} font-size="11" font-weight="700">{`${SHELL} gal shell`}</text>
  <text x={SHELL_X + SHELL_W / 2} y={SHELL_Y + SHELL_H + 18} text-anchor="middle" fill={C.primary} font-family={FONT} font-size="10" font-weight="700">drawdown</text>

  <text x="212" y="94" fill={C.muted} font-family={FONT} font-size="9" font-weight="700">THE ARITHMETIC — ALL PRESSURES ABSOLUTE</text>
  <text x="212" y="116" fill={C.dark} font-family={FONT} font-size="10.5">
    {`air at cut-in = ${PRECHARGE} + ${ATMOSPHERIC_PSI} ÷ ${CUT_IN} + ${ATMOSPHERIC_PSI} = ${fmt((PRECHARGE + ATMOSPHERIC_PSI) / (CUT_IN + ATMOSPHERIC_PSI), 3)}`}
  </text>
  <text x="212" y="134" fill={C.dark} font-family={FONT} font-size="10.5">
    {`air at cut-out = ${PRECHARGE} + ${ATMOSPHERIC_PSI} ÷ ${CUT_OUT} + ${ATMOSPHERIC_PSI} = ${fmt((PRECHARGE + ATMOSPHERIC_PSI) / (CUT_OUT + ATMOSPHERIC_PSI), 3)}`}
  </text>
  <line x1="212" y1="146" x2="690" y2="146" stroke={C.border} stroke-width="1" />
  <text x="212" y="168" fill={C.primary} font-family={FONT} font-size="14" font-weight="800">
    {`drawdown = ${fmt(correctFraction * 100, 1)}% of the shell = ${fmt(usable, 1)} gallons`}
  </text>

  <rect x="212" y="184" width="478" height="50" rx="8" fill={C.redLight} stroke={C.red} stroke-width="1.6" />
  <text x="228" y="204" fill={C.red} font-family={FONT} font-size="10.5" font-weight="800">
    {`The gauge-pressure shortcut says 1 − ${CUT_IN}/${CUT_OUT} = ${fmt(gaugeFraction * 100, 0)}%`}
  </text>
  <text x="228" y="223" fill={C.dark} font-family={FONT} font-size="10">
    {`— it claims ${fmt(gaugeClaim, 1)} gallons, ${fmt(gaugeClaim - usable, 1)} more than the tank can deliver.`}
  </text>

  <text x="24" y="266" fill={C.muted} font-family={FONT} font-size="10">
    {`A 10 gpm pump needs ${result.requiredDrawdown} gallons per run, so this shell buys ${fmt(result.runMinutesAtStocked, 2)} minutes — just over the one minute convention.`}
  </text>
</svg>
