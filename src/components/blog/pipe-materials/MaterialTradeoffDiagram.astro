---
import { C, FONT } from "../infographicTokens";
import {
  insideDiameter, sizeSupplyPipe, availableFrictionPsi, PIPE_MATERIAL_LABELS, sizeLabel,
} from "@/lib/plumbing";
/** Where each material actually belongs. Bore is one axis; joints, freeze
 * tolerance and UV are the others, and they do not point the same way. */
const AVAILABLE = availableFrictionPsi({
  supplyPsi: 60,
  highestFixtureFeet: 20,
  fixtureRequiredPsi: 15,
  meterLossPsi: 8,
  otherLossPsi: 0,
});
const MATERIALS = [
  { key: "copper-l", freeze: "splits", uv: "fine" },
  { key: "cpvc-40", freeze: "cracks", uv: "degrades" },
  { key: "pex", freeze: "expands, usually survives", uv: "degrades fast" },
] as const;

const rows = MATERIALS.map((m) => {
  const r = sizeSupplyPipe({
    gpm: 18,
    material: m.key,
    developedFeet: 120,
    availablePsi: AVAILABLE,
    maxVelocity: 8,
  });
  return {
    label: PIPE_MATERIAL_LABELS[m.key],
    cells: [sizeLabel(r.size), m.freeze, m.uv],
    tone: [r.size > 1 ? "bad" : "good", m.freeze.startsWith("expands") ? "good" : "bad", m.uv === "fine" ? "good" : "bad"],
  };
});
---

<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 720 220" fill="none" aria-hidden="true">
  <title>Choosing between them — bore is only one axis</title>
  <desc>Size needed for 18 gpm on a 120 ft run, against the two failure modes that decide real installations</desc>

  <rect x="8" y="8" width="704" height="206" rx="12" fill={C.panelBg} stroke={C.border} />
  <text x="24" y="34" fill={C.dark} font-family={FONT} font-size="14" font-weight="700">Choosing between them — bore is only one axis</text>
  <text x="24" y="52" fill={C.muted} font-family={FONT} font-size="11">Size needed for 18 gpm on a 120 ft run, against the two failure modes that decide real installations</text>

  <text x="28" y="76" fill={C.muted} font-family={FONT} font-size="8" font-weight="700">MATERIAL</text>
  <text x={307} y="76" text-anchor="middle" fill={C.muted} font-family={FONT} font-size="8" font-weight="700">SIZE FOR 18 GPM</text>
  <text x={469} y="76" text-anchor="middle" fill={C.muted} font-family={FONT} font-size="8" font-weight="700">ON FREEZING</text>
  <text x={631} y="76" text-anchor="middle" fill={C.muted} font-family={FONT} font-size="8" font-weight="700">IN SUNLIGHT</text>

  {rows.map((row, i) => {
    const y = 86 + i * 30;
    return (
      <g>
        <text x="28" y={y + 16} fill={C.dark} font-family={FONT} font-size="10.5" font-weight="700">{row.label}</text>
            <rect x={232} y={y} width={150} height="24" rx="6" fill={row.tone[0] === "bad" ? C.red : row.tone[0] === "good" ? C.green : C.orange} opacity={row.tone[0] === "bad" ? 0.18 : 0.1} />
            <rect x={232} y={y} width={150} height="24" rx="6" fill="none" stroke={row.tone[0] === "bad" ? C.red : row.tone[0] === "good" ? C.green : C.orange} stroke-width={row.tone[0] === "bad" ? 2 : 1.2} />
            <text x={307} y={y + 16} text-anchor="middle" fill={row.tone[0] === "bad" ? C.red : row.tone[0] === "good" ? C.green : C.orange} font-family={FONT} font-size="10.5" font-weight={row.tone[0] === "bad" ? 800 : 700}>
              {row.cells[0]}
            </text>
            <rect x={394} y={y} width={150} height="24" rx="6" fill={row.tone[1] === "bad" ? C.red : row.tone[1] === "good" ? C.green : C.orange} opacity={row.tone[1] === "bad" ? 0.18 : 0.1} />
            <rect x={394} y={y} width={150} height="24" rx="6" fill="none" stroke={row.tone[1] === "bad" ? C.red : row.tone[1] === "good" ? C.green : C.orange} stroke-width={row.tone[1] === "bad" ? 2 : 1.2} />
            <text x={469} y={y + 16} text-anchor="middle" fill={row.tone[1] === "bad" ? C.red : row.tone[1] === "good" ? C.green : C.orange} font-family={FONT} font-size="10.5" font-weight={row.tone[1] === "bad" ? 800 : 700}>
              {row.cells[1]}
            </text>
            <rect x={556} y={y} width={150} height="24" rx="6" fill={row.tone[2] === "bad" ? C.red : row.tone[2] === "good" ? C.green : C.orange} opacity={row.tone[2] === "bad" ? 0.18 : 0.1} />
            <rect x={556} y={y} width={150} height="24" rx="6" fill="none" stroke={row.tone[2] === "bad" ? C.red : row.tone[2] === "good" ? C.green : C.orange} stroke-width={row.tone[2] === "bad" ? 2 : 1.2} />
            <text x={631} y={y + 16} text-anchor="middle" fill={row.tone[2] === "bad" ? C.red : row.tone[2] === "good" ? C.green : C.orange} font-family={FONT} font-size="10.5" font-weight={row.tone[2] === "bad" ? 800 : 700}>
              {row.cells[2]}
            </text>
      </g>
    );
  })}

  <text x="24" y="200" fill={C.muted} font-family={FONT} font-size="10">PEX needs the biggest pipe and survives a freeze best. Copper needs the smallest and splits. Neither wins outright.</text>
</svg>
