---
import { C, FONT } from "../infographicTokens";
import {
  insideDiameter, sizeLabel, fmt,
} from "@/lib/plumbing";
/** Nominal size is a label, not a dimension. Four materials called the same
 * thing bore four different holes, and PEX bores the smallest at every size. */
const SIZES = [0.5, 0.75, 1, 1.25, 1.5, 2];

const rows = SIZES.map((n) => {
  const copper = insideDiameter("copper-l", n)!;
  const pex = insideDiameter("pex", n)!;
  const cpvc = insideDiameter("cpvc-40", n)!;
  const areaPct = ((pex * pex) / (copper * copper)) * 100;
  return {
    label: sizeLabel(n),
    cells: [`${fmt(copper, 3)} in`, `${fmt(cpvc, 3)} in`, `${fmt(pex, 3)} in`, `${fmt(areaPct, 1)}%`],
    tone: ["good", "good", "bad", "bad"],
  };
});
---

<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 720 310" fill="none" aria-hidden="true">
  <title>Same nominal size, four different holes</title>
  <desc>Actual inside diameter by material, and PEX's flow area as a percentage of copper Type L's</desc>

  <rect x="8" y="8" width="704" height="296" rx="12" fill={C.panelBg} stroke={C.border} />
  <text x="24" y="34" fill={C.dark} font-family={FONT} font-size="14" font-weight="700">Same nominal size, four different holes</text>
  <text x="24" y="52" fill={C.muted} font-family={FONT} font-size="11">Actual inside diameter by material, and PEX's flow area as a percentage of copper Type L's</text>

  <text x="28" y="76" fill={C.muted} font-family={FONT} font-size="8" font-weight="700">NOMINAL</text>
  <text x={249} y="76" text-anchor="middle" fill={C.muted} font-family={FONT} font-size="8" font-weight="700">COPPER L</text>
  <text x={375} y="76" text-anchor="middle" fill={C.muted} font-family={FONT} font-size="8" font-weight="700">CPVC SCH 40</text>
  <text x={501} y="76" text-anchor="middle" fill={C.muted} font-family={FONT} font-size="8" font-weight="700">PEX</text>
  <text x={627} y="76" text-anchor="middle" fill={C.muted} font-family={FONT} font-size="8" font-weight="700">PEX AREA vs Cu</text>

  {rows.map((row, i) => {
    const y = 86 + i * 30;
    return (
      <g>
        <text x="28" y={y + 16} fill={C.dark} font-family={FONT} font-size="10.5" font-weight="700">{row.label}</text>
            <rect x={190} y={y} width={118} height="24" rx="6" fill={row.tone[0] === "bad" ? C.red : row.tone[0] === "good" ? C.green : C.orange} opacity={row.tone[0] === "bad" ? 0.18 : 0.1} />
            <rect x={190} y={y} width={118} height="24" rx="6" fill="none" stroke={row.tone[0] === "bad" ? C.red : row.tone[0] === "good" ? C.green : C.orange} stroke-width={row.tone[0] === "bad" ? 2 : 1.2} />
            <text x={249} y={y + 16} text-anchor="middle" fill={row.tone[0] === "bad" ? C.red : row.tone[0] === "good" ? C.green : C.orange} font-family={FONT} font-size="10.5" font-weight={row.tone[0] === "bad" ? 800 : 700}>
              {row.cells[0]}
            </text>
            <rect x={316} y={y} width={118} height="24" rx="6" fill={row.tone[1] === "bad" ? C.red : row.tone[1] === "good" ? C.green : C.orange} opacity={row.tone[1] === "bad" ? 0.18 : 0.1} />
            <rect x={316} y={y} width={118} height="24" rx="6" fill="none" stroke={row.tone[1] === "bad" ? C.red : row.tone[1] === "good" ? C.green : C.orange} stroke-width={row.tone[1] === "bad" ? 2 : 1.2} />
            <text x={375} y={y + 16} text-anchor="middle" fill={row.tone[1] === "bad" ? C.red : row.tone[1] === "good" ? C.green : C.orange} font-family={FONT} font-size="10.5" font-weight={row.tone[1] === "bad" ? 800 : 700}>
              {row.cells[1]}
            </text>
            <rect x={442} y={y} width={118} height="24" rx="6" fill={row.tone[2] === "bad" ? C.red : row.tone[2] === "good" ? C.green : C.orange} opacity={row.tone[2] === "bad" ? 0.18 : 0.1} />
            <rect x={442} y={y} width={118} height="24" rx="6" fill="none" stroke={row.tone[2] === "bad" ? C.red : row.tone[2] === "good" ? C.green : C.orange} stroke-width={row.tone[2] === "bad" ? 2 : 1.2} />
            <text x={501} y={y + 16} text-anchor="middle" fill={row.tone[2] === "bad" ? C.red : row.tone[2] === "good" ? C.green : C.orange} font-family={FONT} font-size="10.5" font-weight={row.tone[2] === "bad" ? 800 : 700}>
              {row.cells[2]}
            </text>
            <rect x={568} y={y} width={118} height="24" rx="6" fill={row.tone[3] === "bad" ? C.red : row.tone[3] === "good" ? C.green : C.orange} opacity={row.tone[3] === "bad" ? 0.18 : 0.1} />
            <rect x={568} y={y} width={118} height="24" rx="6" fill="none" stroke={row.tone[3] === "bad" ? C.red : row.tone[3] === "good" ? C.green : C.orange} stroke-width={row.tone[3] === "bad" ? 2 : 1.2} />
            <text x={627} y={y + 16} text-anchor="middle" fill={row.tone[3] === "bad" ? C.red : row.tone[3] === "good" ? C.green : C.orange} font-family={FONT} font-size="10.5" font-weight={row.tone[3] === "bad" ? 800 : 700}>
              {row.cells[3]}
            </text>
      </g>
    );
  })}

  <text x="24" y="290" fill={C.muted} font-family={FONT} font-size="10">PEX loses more area as the size grows — 79.6% of copper at 1/2 inch, down to 69.3% at 2 inch.</text>
</svg>
