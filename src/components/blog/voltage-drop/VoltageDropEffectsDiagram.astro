---
import { C, FONT } from "../infographicTokens";

/**
 * What a 10% sag actually costs at the load. Resistive power and motor torque both
 * follow V², so 0.9² = 0.81 — a 19% loss. Incandescent light output follows roughly
 * V^3.4, so 0.9^3.4 ≈ 0.70 — a 30% loss.
 */
const effects = [
  {
    title: "Heaters & resistive loads",
    accent: C.orange,
    bg: C.orangeLight,
    figure: "−19%",
    detail: ["Power follows V², so 0.9² = 0.81.", "A 4,500 W water heater element", "delivers about 3,650 W."],
  },
  {
    title: "Motors",
    accent: C.red,
    bg: C.redLight,
    figure: "−19%",
    detail: ["Starting torque also follows V².", "To hold output, running current", "climbs — so windings run hotter."],
  },
  {
    title: "Incandescent lighting",
    accent: C.blue,
    bg: C.blueLight,
    figure: "−30%",
    detail: ["Light output follows roughly V^3.4.", "This is why dimming is the first", "symptom anyone notices."],
  },
];
---

<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 720 250" fill="none" aria-hidden="true">
  <title>What a 10 percent voltage sag costs at the load</title>
  <desc>
    At 10 percent low voltage, resistive loads lose about 19 percent of their power because power follows
    voltage squared. Motors lose about 19 percent of starting torque for the same reason, and their
    running current rises to maintain output, which makes the windings run hotter. Incandescent lighting
    loses about 30 percent of its output because light follows voltage to roughly the 3.4 power.
  </desc>

  <rect x="8" y="8" width="704" height="234" rx="12" fill={C.panelBg} stroke={C.border} />
  <text x="24" y="36" fill={C.dark} font-family={FONT} font-size="14" font-weight="700">What 10% low voltage actually costs</text>
  <text x="24" y="54" fill={C.muted} font-family={FONT} font-size="11">Drop isn't a rounding error — most loads lose more than the percentage suggests</text>

  {effects.map((e, i) => {
    const x = 24 + i * 224;
    return (
      <g>
        <rect x={x} y="72" width="208" height="152" rx="10" fill={e.bg} stroke={e.accent} stroke-width="1.5" />
        <text x={x + 16} y="98" fill={C.dark} font-family={FONT} font-size="12" font-weight="800">{e.title}</text>
        <text x={x + 16} y="136" fill={e.accent} font-family={FONT} font-size="28" font-weight="800">{e.figure}</text>
        <text x={x + 16} y="164" fill={C.muted} font-family={FONT} font-size="9.5">
          {e.detail.map((line, li) => (
            <tspan x={x + 16} dy={li === 0 ? "0" : "13"}>{line}</tspan>
          ))}
        </text>
      </g>
    );
  })}
</svg>
