---
import { C, FONT } from "../infographicTokens";

/**
 * The identity that makes the whole topic simple: a footcandle IS one lumen per
 * square foot. People treat them as two quantities needing conversion, and there
 * is nothing to convert.
 */
const AREA = 192;
const targets = [
  { fc: 10, use: "Hallway, closet" },
  { fc: 20, use: "Living room, bedroom" },
  { fc: 40, use: "Kitchen, office" },
];
const FIXTURE_LM = 650;
const fmt = (n: number) => n.toLocaleString("en-US");
---

<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 720 264" fill="none" aria-hidden="true">
  <title>Footcandles and lumens per square foot are the same unit</title>
  <desc>
    One footcandle is defined as one lumen falling on one square foot, so the two are the same quantity under
    different names. A 192 square foot room at 20 footcandles needs 3,840 lumens, which at 650 lumens per fixture
    is six fixtures.
  </desc>

  <rect x="8" y="8" width="704" height="248" rx="12" fill={C.panelBg} stroke={C.border} />
  <text x="24" y="34" fill={C.dark} font-family={FONT} font-size="14" font-weight="700">
    There is nothing to convert
  </text>
  <text x="24" y="52" fill={C.muted} font-family={FONT} font-size="11">
    A footcandle is defined as one lumen falling on one square foot. Same quantity, two names.
  </text>

  <rect x="24" y="68" width="200" height="56" rx="9" fill={C.blueLight} stroke={C.blue} stroke-width="1.8" />
  <text x="124" y="92" text-anchor="middle" fill={C.blue} font-family={FONT} font-size="13" font-weight="800">
    1 footcandle
  </text>
  <text x="124" y="112" text-anchor="middle" fill={C.muted} font-family={FONT} font-size="10">
    what the surface receives
  </text>

  <text x="248" y="102" text-anchor="middle" fill={C.dark} font-family={FONT} font-size="20" font-weight="800">=</text>

  <rect x="272" y="68" width="200" height="56" rx="9" fill={C.primaryLight} stroke={C.primary} stroke-width="1.8" />
  <text x="372" y="92" text-anchor="middle" fill={C.primary} font-family={FONT} font-size="13" font-weight="800">
    1 lumen / ft²
  </text>
  <text x="372" y="112" text-anchor="middle" fill={C.muted} font-family={FONT} font-size="10">
    what you have to supply
  </text>

  <rect x="496" y="68" width="200" height="56" rx="9" fill={C.white} stroke={C.border} stroke-width="1.5" />
  <text x="596" y="90" text-anchor="middle" fill={C.dark} font-family={FONT} font-size="10.5" font-weight="700">
    So the whole method is
  </text>
  <text x="596" y="110" text-anchor="middle" fill={C.dark} font-family={FONT} font-size="11" font-weight="800">
    area × fc ÷ lm per fixture
  </text>

  <text x="24" y="152" fill={C.muted} font-family={FONT} font-size="9.5" font-weight="700">
    {`WORKED ON A ${AREA} ft² ROOM WITH ${FIXTURE_LM} lm TRIMS`}
  </text>

  {targets.map((t, i) => {
    const x = 24 + i * 226;
    const lumens = AREA * t.fc;
    const fixtures = Math.ceil(lumens / FIXTURE_LM);
    return (
      <g>
        <rect x={x} y={162} width="214" height="60" rx="8" fill={C.white} stroke={C.border} stroke-width="1.4" />
        <text x={x + 14} y={181} fill={C.dark} font-family={FONT} font-size="10" font-weight="700">{t.use}</text>
        <text x={x + 14} y={197} fill={C.muted} font-family={FONT} font-size="9">
          {`${t.fc} fc × ${AREA} ft² = ${fmt(lumens)} lm`}
        </text>
        <text x={x + 14} y={214} fill={C.primary} font-family={FONT} font-size="10.5" font-weight="800">
          {`${fixtures} fixtures`}
        </text>
      </g>
    );
  })}

  <text x="28" y="244" fill={C.muted} font-family={FONT} font-size="9.5">
    Lumens are what the fixture emits. Footcandles are what lands on the counter. Only the second matters.
  </text>
</svg>
