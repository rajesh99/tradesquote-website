---
import { C, FONT } from "../infographicTokens";
import {
  tanklessBtuRequired,
} from "@/lib/plumbing";
/** Read the other way round: the input a target flow demands. Past about a
 * 70 F rise, 5 gpm leaves the residential range entirely. */
const EFF = 0.95;
const TARGET = 120;
const CEILING = 199000;
const INLETS = [70, 60, 50, 45, 40];

const rows = INLETS.map((inlet) => {
  const rise = TARGET - inlet;
  const forFour = tanklessBtuRequired(4, rise, EFF);
  const forFive = tanklessBtuRequired(5, rise, EFF);
  return {
    label: `${inlet} F inlet`,
    cells: [
      `${Math.round(forFour).toLocaleString("en-US")}`,
      `${Math.round(forFive).toLocaleString("en-US")}`,
      forFive <= CEILING ? "within range" : "past 199k",
    ],
    tone: [forFour <= CEILING ? "good" : "bad", forFive <= CEILING ? "good" : "bad", forFive <= CEILING ? "good" : "bad"],
  };
});
---

<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 720 280" fill="none" aria-hidden="true">
  <title>BTU/hr a target flow demands, against the 199,000 ceiling</title>
  <desc>199,000 BTU/hr is where residential gas units stop, because 200,000 changes the venting and gas rules</desc>

  <rect x="8" y="8" width="704" height="266" rx="12" fill={C.panelBg} stroke={C.border} />
  <text x="24" y="34" fill={C.dark} font-family={FONT} font-size="14" font-weight="700">BTU/hr a target flow demands, against the 199,000 ceiling</text>
  <text x="24" y="52" fill={C.muted} font-family={FONT} font-size="11">199,000 BTU/hr is where residential gas units stop, because 200,000 changes the venting and gas rules</text>

  <text x="28" y="76" fill={C.muted} font-family={FONT} font-size="8" font-weight="700">INLET TEMPERATURE</text>
  <text x={302} y="76" text-anchor="middle" fill={C.muted} font-family={FONT} font-size="8" font-weight="700">FOR 4 GPM</text>
  <text x={454} y="76" text-anchor="middle" fill={C.muted} font-family={FONT} font-size="8" font-weight="700">FOR 5 GPM</text>
  <text x={606} y="76" text-anchor="middle" fill={C.muted} font-family={FONT} font-size="8" font-weight="700">VERDICT</text>

  {rows.map((row, i) => {
    const y = 86 + i * 30;
    return (
      <g>
        <text x="28" y={y + 16} fill={C.dark} font-family={FONT} font-size="10.5" font-weight="700">{row.label}</text>
            <rect x={232} y={y} width={140} height="24" rx="6" fill={row.tone[0] === "bad" ? C.red : row.tone[0] === "good" ? C.green : C.orange} opacity={row.tone[0] === "bad" ? 0.18 : 0.1} />
            <rect x={232} y={y} width={140} height="24" rx="6" fill="none" stroke={row.tone[0] === "bad" ? C.red : row.tone[0] === "good" ? C.green : C.orange} stroke-width={row.tone[0] === "bad" ? 2 : 1.2} />
            <text x={302} y={y + 16} text-anchor="middle" fill={row.tone[0] === "bad" ? C.red : row.tone[0] === "good" ? C.green : C.orange} font-family={FONT} font-size="10.5" font-weight={row.tone[0] === "bad" ? 800 : 700}>
              {row.cells[0]}
            </text>
            <rect x={384} y={y} width={140} height="24" rx="6" fill={row.tone[1] === "bad" ? C.red : row.tone[1] === "good" ? C.green : C.orange} opacity={row.tone[1] === "bad" ? 0.18 : 0.1} />
            <rect x={384} y={y} width={140} height="24" rx="6" fill="none" stroke={row.tone[1] === "bad" ? C.red : row.tone[1] === "good" ? C.green : C.orange} stroke-width={row.tone[1] === "bad" ? 2 : 1.2} />
            <text x={454} y={y + 16} text-anchor="middle" fill={row.tone[1] === "bad" ? C.red : row.tone[1] === "good" ? C.green : C.orange} font-family={FONT} font-size="10.5" font-weight={row.tone[1] === "bad" ? 800 : 700}>
              {row.cells[1]}
            </text>
            <rect x={536} y={y} width={140} height="24" rx="6" fill={row.tone[2] === "bad" ? C.red : row.tone[2] === "good" ? C.green : C.orange} opacity={row.tone[2] === "bad" ? 0.18 : 0.1} />
            <rect x={536} y={y} width={140} height="24" rx="6" fill="none" stroke={row.tone[2] === "bad" ? C.red : row.tone[2] === "good" ? C.green : C.orange} stroke-width={row.tone[2] === "bad" ? 2 : 1.2} />
            <text x={606} y={y + 16} text-anchor="middle" fill={row.tone[2] === "bad" ? C.red : row.tone[2] === "good" ? C.green : C.orange} font-family={FONT} font-size="10.5" font-weight={row.tone[2] === "bad" ? 800 : 700}>
              {row.cells[2]}
            </text>
      </g>
    );
  })}

  <text x="24" y="260" fill={C.muted} font-family={FONT} font-size="10">Below a 50 F inlet, 5 gpm cannot be had from one residential unit at all. Two units in parallel is the honest answer.</text>
</svg>
