---
import { C, FONT } from "../infographicTokens";
import {
  insideDiameter, flowAtVelocity, PIPE_MATERIAL_LABELS, sizeLabel, fmt, MAX_VELOCITY_COLD, MAX_VELOCITY_HOT,
} from "@/lib/plumbing";
/** The other way to read the chart: the most flow each size can carry before it
 * breaks the velocity ceiling. Hot is stricter because erosion accelerates
 * with temperature. */
const SIZES = [0.5, 0.75, 1, 1.25, 1.5, 2];

const rows = SIZES.map((n) => {
  const copper = insideDiameter("copper-l", n)!;
  const pex = insideDiameter("pex", n)!;
  return {
    label: sizeLabel(n),
    cells: [
      `${fmt(flowAtVelocity(MAX_VELOCITY_COLD, copper), 1)} gpm`,
      `${fmt(flowAtVelocity(MAX_VELOCITY_HOT, copper), 1)} gpm`,
      `${fmt(flowAtVelocity(MAX_VELOCITY_COLD, pex), 1)} gpm`,
    ],
    tone: ["good", "neutral", "bad"],
  };
});
---

<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 720 310" fill="none" aria-hidden="true">
  <title>Maximum flow per size at the velocity ceiling</title>
  <desc>8 ft/s cold and 5 ft/s hot — ASPE and manufacturer design practice, not IPC numbers</desc>

  <rect x="8" y="8" width="704" height="296" rx="12" fill={C.panelBg} stroke={C.border} />
  <text x="24" y="34" fill={C.dark} font-family={FONT} font-size="14" font-weight="700">Maximum flow per size at the velocity ceiling</text>
  <text x="24" y="52" fill={C.muted} font-family={FONT} font-size="11">8 ft/s cold and 5 ft/s hot — ASPE and manufacturer design practice, not IPC numbers</text>

  <text x="28" y="76" fill={C.muted} font-family={FONT} font-size="8" font-weight="700">NOMINAL SIZE</text>
  <text x={302} y="76" text-anchor="middle" fill={C.muted} font-family={FONT} font-size="8" font-weight="700">COPPER L, COLD</text>
  <text x={454} y="76" text-anchor="middle" fill={C.muted} font-family={FONT} font-size="8" font-weight="700">COPPER L, HOT</text>
  <text x={606} y="76" text-anchor="middle" fill={C.muted} font-family={FONT} font-size="8" font-weight="700">PEX, COLD</text>

  {rows.map((row, i) => {
    const y = 86 + i * 30;
    return (
      <g>
        <text x="28" y={y + 16} fill={C.dark} font-family={FONT} font-size="10.5" font-weight="700">{row.label}</text>
            <rect x={232} y={y} width={140} height="24" rx="6" fill={row.tone[0] === "bad" ? C.red : row.tone[0] === "good" ? C.green : C.orange} opacity={row.tone[0] === "bad" ? 0.18 : 0.1} />
            <rect x={232} y={y} width={140} height="24" rx="6" fill="none" stroke={row.tone[0] === "bad" ? C.red : row.tone[0] === "good" ? C.green : C.orange} stroke-width={row.tone[0] === "bad" ? 2 : 1.2} />
            <text x={302} y={y + 16} text-anchor="middle" fill={row.tone[0] === "bad" ? C.red : row.tone[0] === "good" ? C.green : C.orange} font-family={FONT} font-size="10.5" font-weight={row.tone[0] === "bad" ? 800 : 700}>
              {row.cells[0]}
            </text>
            <rect x={384} y={y} width={140} height="24" rx="6" fill={row.tone[1] === "bad" ? C.red : row.tone[1] === "good" ? C.green : C.orange} opacity={row.tone[1] === "bad" ? 0.18 : 0.1} />
            <rect x={384} y={y} width={140} height="24" rx="6" fill="none" stroke={row.tone[1] === "bad" ? C.red : row.tone[1] === "good" ? C.green : C.orange} stroke-width={row.tone[1] === "bad" ? 2 : 1.2} />
            <text x={454} y={y + 16} text-anchor="middle" fill={row.tone[1] === "bad" ? C.red : row.tone[1] === "good" ? C.green : C.orange} font-family={FONT} font-size="10.5" font-weight={row.tone[1] === "bad" ? 800 : 700}>
              {row.cells[1]}
            </text>
            <rect x={536} y={y} width={140} height="24" rx="6" fill={row.tone[2] === "bad" ? C.red : row.tone[2] === "good" ? C.green : C.orange} opacity={row.tone[2] === "bad" ? 0.18 : 0.1} />
            <rect x={536} y={y} width={140} height="24" rx="6" fill="none" stroke={row.tone[2] === "bad" ? C.red : row.tone[2] === "good" ? C.green : C.orange} stroke-width={row.tone[2] === "bad" ? 2 : 1.2} />
            <text x={606} y={y + 16} text-anchor="middle" fill={row.tone[2] === "bad" ? C.red : row.tone[2] === "good" ? C.green : C.orange} font-family={FONT} font-size="10.5" font-weight={row.tone[2] === "bad" ? 800 : 700}>
              {row.cells[2]}
            </text>
      </g>
    );
  })}

  <text x="24" y="290" fill={C.muted} font-family={FONT} font-size="10">The hot column is 62% of the cold one at every size, because erosion-corrosion scours copper faster as temperature rises.</text>
</svg>
