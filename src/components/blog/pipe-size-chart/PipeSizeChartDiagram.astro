---
import { C, FONT } from "../infographicTokens";
import {
  sizeSupplyPipe, availableFrictionPsi, insideDiameter, velocity, sizeLabel, fmt,
} from "@/lib/plumbing";
/** The chart people actually want — peak gpm to nominal size — but computed
 * rather than transcribed, and carrying the rule that governed each row. */
const AVAILABLE = availableFrictionPsi({
  supplyPsi: 60,
  highestFixtureFeet: 20,
  fixtureRequiredPsi: 15,
  meterLossPsi: 8,
  otherLossPsi: 0,
});
const FLOWS = [5, 8, 10, 12, 15, 18, 25, 40];

const rows = FLOWS.map((gpm) => {
  const r = sizeSupplyPipe({
    gpm,
    material: "copper-l",
    developedFeet: 120,
    availablePsi: AVAILABLE,
    maxVelocity: 8,
  });
  return {
    label: `${gpm} gpm`,
    cells: [
      sizeLabel(r.size),
      `${fmt(r.velocity, 2)} ft/s`,
      r.governedBy === "both" ? "both rules" : r.governedBy,
    ],
    tone: ["good", "neutral", r.governedBy === "both" ? "good" : "neutral"],
  };
});
---

<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 720 370" fill="none" aria-hidden="true">
  <title>Peak demand to nominal size — copper Type L</title>
  <desc>120 ft developed run, 60 psi supply, 20 ft of lift, 15 psi at the fixture, 8 psi meter loss</desc>

  <rect x="8" y="8" width="704" height="356" rx="12" fill={C.panelBg} stroke={C.border} />
  <text x="24" y="34" fill={C.dark} font-family={FONT} font-size="14" font-weight="700">Peak demand to nominal size — copper Type L</text>
  <text x="24" y="52" fill={C.muted} font-family={FONT} font-size="11">120 ft developed run, 60 psi supply, 20 ft of lift, 15 psi at the fixture, 8 psi meter loss</text>

  <text x="28" y="76" fill={C.muted} font-family={FONT} font-size="8" font-weight="700">PEAK DEMAND</text>
  <text x={302} y="76" text-anchor="middle" fill={C.muted} font-family={FONT} font-size="8" font-weight="700">NOMINAL SIZE</text>
  <text x={454} y="76" text-anchor="middle" fill={C.muted} font-family={FONT} font-size="8" font-weight="700">VELOCITY</text>
  <text x={606} y="76" text-anchor="middle" fill={C.muted} font-family={FONT} font-size="8" font-weight="700">GOVERNED BY</text>

  {rows.map((row, i) => {
    const y = 86 + i * 30;
    return (
      <g>
        <text x="28" y={y + 16} fill={C.dark} font-family={FONT} font-size="10.5" font-weight="700">{row.label}</text>
            <rect x={232} y={y} width={140} height="24" rx="6" fill={row.tone[0] === "bad" ? C.red : row.tone[0] === "good" ? C.green : C.orange} opacity={row.tone[0] === "bad" ? 0.18 : 0.1} />
            <rect x={232} y={y} width={140} height="24" rx="6" fill="none" stroke={row.tone[0] === "bad" ? C.red : row.tone[0] === "good" ? C.green : C.orange} stroke-width={row.tone[0] === "bad" ? 2 : 1.2} />
            <text x={302} y={y + 16} text-anchor="middle" fill={row.tone[0] === "bad" ? C.red : row.tone[0] === "good" ? C.green : C.orange} font-family={FONT} font-size="10.5" font-weight={row.tone[0] === "bad" ? 800 : 700}>
              {row.cells[0]}
            </text>
            <rect x={384} y={y} width={140} height="24" rx="6" fill={row.tone[1] === "bad" ? C.red : row.tone[1] === "good" ? C.green : C.orange} opacity={row.tone[1] === "bad" ? 0.18 : 0.1} />
            <rect x={384} y={y} width={140} height="24" rx="6" fill="none" stroke={row.tone[1] === "bad" ? C.red : row.tone[1] === "good" ? C.green : C.orange} stroke-width={row.tone[1] === "bad" ? 2 : 1.2} />
            <text x={454} y={y + 16} text-anchor="middle" fill={row.tone[1] === "bad" ? C.red : row.tone[1] === "good" ? C.green : C.orange} font-family={FONT} font-size="10.5" font-weight={row.tone[1] === "bad" ? 800 : 700}>
              {row.cells[1]}
            </text>
            <rect x={536} y={y} width={140} height="24" rx="6" fill={row.tone[2] === "bad" ? C.red : row.tone[2] === "good" ? C.green : C.orange} opacity={row.tone[2] === "bad" ? 0.18 : 0.1} />
            <rect x={536} y={y} width={140} height="24" rx="6" fill="none" stroke={row.tone[2] === "bad" ? C.red : row.tone[2] === "good" ? C.green : C.orange} stroke-width={row.tone[2] === "bad" ? 2 : 1.2} />
            <text x={606} y={y + 16} text-anchor="middle" fill={row.tone[2] === "bad" ? C.red : row.tone[2] === "good" ? C.green : C.orange} font-family={FONT} font-size="10.5" font-weight={row.tone[2] === "bad" ? 800 : 700}>
              {row.cells[2]}
            </text>
      </g>
    );
  })}

  <text x="24" y="350" fill={C.muted} font-family={FONT} font-size="10">Read this as a starting point, not an answer. Every row is conditional on the run length and supply pressure above it.</text>
</svg>
