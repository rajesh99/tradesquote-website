---
import { SQRT3, fmt, fmtSmart, wattsToAmps } from "@/lib/nec";
import { C, FONT } from "../infographicTokens";

/**
 * The three forms of the watts-to-amps conversion. Each worked example is computed
 * with the same `wattsToAmps` helper the calculator uses, so the diagram cannot
 * drift from the tool.
 */
const cards = [
  {
    tag: "DC",
    formula: "I = P ÷ V",
    note: "No power factor exists on DC",
    watts: 100,
    volts: 12,
    pf: 1,
    mode: "dc" as const,
    divisorText: "12 V",
    accent: C.blue,
    bg: C.blueLight,
  },
  {
    tag: "AC single-phase",
    formula: "I = P ÷ (V × PF)",
    note: "PF = 1 for heaters and elements",
    watts: 1800,
    volts: 120,
    pf: 1,
    mode: "1ph" as const,
    divisorText: "120 V × 1.0",
    accent: C.orange,
    bg: C.orangeLight,
  },
  {
    tag: "AC three-phase",
    formula: "I = P ÷ (√3 × V × PF)",
    note: `√3 = ${fmt(SQRT3, 3)} — line current, per leg`,
    watts: 10000,
    volts: 480,
    pf: 0.9,
    mode: "3ph" as const,
    divisorText: "1.732 × 480 V × 0.9",
    accent: C.primary,
    bg: C.primaryLight,
  },
].map((c) => ({ ...c, amps: wattsToAmps(c.watts, c.mode, c.volts, c.pf) }));
---

<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 720 246" fill="none" aria-hidden="true">
  <title>Watts to amps in its three forms</title>
  <desc>
    On direct current, amps equals watts divided by volts: 100 watts at 12 volts is 8.33 amps. On alternating
    single-phase, amps equals watts divided by volts times power factor: 1,800 watts at 120 volts and unity power
    factor is 15.00 amps. On balanced three-phase, amps equals watts divided by the square root of three times
    volts times power factor: 10,000 watts at 480 volts and 0.9 power factor is 13.36 amps per line.
  </desc>

  <rect x="8" y="8" width="704" height="230" rx="12" fill={C.panelBg} stroke={C.border} />
  <text x="24" y="36" fill={C.dark} font-family={FONT} font-size="14" font-weight="700">One conversion, three divisors</text>
  <text x="24" y="54" fill={C.muted} font-family={FONT} font-size="11">Only the denominator changes. Everything hard about the conversion is in the power factor and the √3.</text>

  {cards.map((c, i) => {
    const x = 24 + i * 228;
    return (
      <g>
        <rect x={x} y="72" width="216" height="142" rx="10" fill={c.bg} stroke={c.accent} stroke-width="1.5" />
        <text x={x + 16} y="94" fill={c.accent} font-family={FONT} font-size="10" font-weight="800">{c.tag.toUpperCase()}</text>
        <text x={x + 16} y="118" fill={C.dark} font-family={FONT} font-size="13.5" font-weight="800">{c.formula}</text>
        <line x1={x + 16} y1="130" x2={x + 200} y2="130" stroke={c.accent} stroke-width="1" opacity="0.4" />
        <text x={x + 16} y="150" fill={C.muted} font-family={FONT} font-size="9.5">{`${c.watts.toLocaleString("en-US")} W ÷ (${c.divisorText})`}</text>
        <text x={x + 16} y="178" fill={c.accent} font-family={FONT} font-size="20" font-weight="800">{`${fmtSmart(c.amps)} A`}</text>
        <text x={x + 16} y="200" fill={C.muted} font-family={FONT} font-size="8.5">{c.note}</text>
      </g>
    );
  })}
</svg>
