---
import { wattsToAmps, SQRT3, fmt } from "@/lib/nec";
import { C, FONT } from "../infographicTokens";

/**
 * The commercial argument for three-phase, computed rather than asserted: the
 * same 30 kW delivered four ways. At equal voltage, three-phase needs exactly
 * 1/√3 — 57.7% — of the single-phase current, which is copper you don't buy.
 */
const WATTS = 30000;
const PF = 1;

const rows = [
  { label: "1φ, 240 V", mode: "1ph" as const, volts: 240 },
  { label: "3φ, 208 V", mode: "3ph" as const, volts: 208 },
  { label: "3φ, 240 V", mode: "3ph" as const, volts: 240 },
  { label: "3φ, 480 V", mode: "3ph" as const, volts: 480 },
].map((r) => ({ ...r, amps: wattsToAmps(WATTS, r.mode, r.volts, PF) }));

const base = rows[0].amps;
const peak = Math.max(...rows.map((r) => r.amps));
const BAR_X = 148;
const BAR_MAX = 400;
const bars = rows.map((r) => ({ ...r, width: Math.round((r.amps / peak) * BAR_MAX), pct: (r.amps / base) * 100 }));
const sameVolts = rows.find((r) => r.mode === "3ph" && r.volts === 240)!;
---

<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 720 252" fill="none" aria-hidden="true">
  <title>The same power delivered at four different currents</title>
  <desc>
    Thirty kilowatts at unity power factor needs 125.0 amps single-phase at 240 volts, 83.3 amps three-phase at 208
    volts, 72.2 amps three-phase at 240 volts, and 36.1 amps three-phase at 480 volts. At the same voltage, three-phase
    needs 57.7 percent of the single-phase current, which is exactly one divided by the square root of three.
  </desc>

  <rect x="8" y="8" width="704" height="236" rx="12" fill={C.panelBg} stroke={C.border} />
  <text x="24" y="34" fill={C.dark} font-family={FONT} font-size="14" font-weight="700">{`${WATTS / 1000} kW, four ways to deliver it`}</text>
  <text x="24" y="52" fill={C.muted} font-family={FONT} font-size="11">{`At unity power factor. Less current means smaller conductors for identical work.`}</text>

  <text x="28" y="78" fill={C.muted} font-family={FONT} font-size="8" font-weight="700">SUPPLY</text>
  <text x={BAR_X} y="78" fill={C.muted} font-family={FONT} font-size="8" font-weight="700">LINE CURRENT</text>

  {bars.map((r, i) => {
    const y = 88 + i * 32;
    const accent = i === 0 ? C.red : i === bars.length - 1 ? C.green : C.blue;
    return (
      <g>
        <text x="28" y={y + 16} fill={C.dark} font-family={FONT} font-size="10.5" font-weight="700">{r.label}</text>
        <rect x={BAR_X} y={y + 2} width={r.width} height="21" rx="5" fill={accent} opacity="0.16" />
        <rect x={BAR_X} y={y + 2} width={r.width} height="21" rx="5" fill="none" stroke={accent} stroke-width="1.6" />
        <text x={BAR_X + 9} y={y + 17} fill={C.dark} font-family={FONT} font-size="11" font-weight="800">{`${fmt(r.amps, 1)} A`}</text>
        <text x={BAR_X + r.width + 9} y={y + 17} fill={C.muted} font-family={FONT} font-size="8.5">
          {i === 0 ? "the baseline" : `${fmt(r.pct, 1)}% of the single-phase current`}
        </text>
      </g>
    );
  })}

  <rect x="24" y="212" width="672" height="26" rx="7" fill={C.primaryLight} stroke={C.primary} stroke-width="1.5" />
  <text x="40" y="229" fill={C.dark} font-family={FONT} font-size="10">
    {`At the same 240 V, three-phase draws ${fmt(sameVolts.amps, 1)} A against ${fmt(base, 1)} A — exactly 1 ÷ √3 = ${fmt(100 / SQRT3, 1)}%.`}
  </text>
</svg>
