---
import { transformerSecondaryFaultCurrent, faultCurrentAfterRun, runImpedance, requiredAicRating, fmtInt, fmt } from "@/lib/nec";
import { C, FONT } from "../infographicTokens";

/**
 * Fault current down a run, and the AIC band it lands in. The commercially
 * interesting result is that 50 ft of 4/0 is enough to drop from 22 kA equipment
 * to 10 kA equipment — distance is the cheapest way to reduce a fault duty.
 */
const source = transformerSecondaryFaultCurrent({
  kva: 300, secondaryVolts: 480, phase: "3ph", percentZ: 3.5, applyToleranceMargin: true,
});

const rows = [0, 25, 50, 100, 200, 400].map((ft) => {
  if (ft === 0) {
    return { ft, faultCurrent: source.faultCurrent, aic: requiredAicRating(source.faultCurrent), multiplier: 1 };
  }
  const z = runImpedance({ label: "4/0", material: "copper", lengthFt: ft, parallelSets: 1, raceway: "steel", tempC: 75 })!;
  const r = faultCurrentAfterRun({ upstreamFaultCurrent: source.faultCurrent, volts: 480, phase: "3ph", runZ: z.z });
  return { ft, faultCurrent: r.faultCurrent, aic: requiredAicRating(r.faultCurrent), multiplier: r.multiplier };
});

const peak = rows[0].faultCurrent;
const BAR_X = 130;
const BAR_MAX = 340;
const bars = rows.map((r) => ({ ...r, width: Math.round((r.faultCurrent / peak) * BAR_MAX) }));
const dropAt100 = rows.find((r) => r.ft === 100)!;
const shed = ((peak - dropAt100.faultCurrent) / peak) * 100;
const firstLower = rows.find((r) => (r.aic ?? 0) < (rows[0].aic ?? 0));
---

<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 720 284" fill="none" aria-hidden="true">
  <title>Fault current falling down a conductor run</title>
  <desc>
    Starting from 11,455 amps at the transformer secondary and running 4/0 copper in steel raceway, fault current
    falls to 10,587 amps at 25 feet, 9,841 at 50 feet, 8,626 at 100 feet, 6,917 at 200 feet and 4,954 at 400 feet.
    The required interrupting rating drops from 22,000 amps to 10,000 amps at 50 feet, so distance alone changes the
    equipment you are permitted to install.
  </desc>

  <rect x="8" y="8" width="704" height="268" rx="12" fill={C.panelBg} stroke={C.border} />
  <text x="24" y="34" fill={C.dark} font-family={FONT} font-size="14" font-weight="700">Distance sheds fault current fast</text>
  <text x="24" y="52" fill={C.muted} font-family={FONT} font-size="11">4/0 copper in steel raceway from an 11,455 A source at 480 V three-phase.</text>

  <text x="28" y="78" fill={C.muted} font-family={FONT} font-size="8" font-weight="700">RUN LENGTH</text>
  <text x={BAR_X} y="78" fill={C.muted} font-family={FONT} font-size="8" font-weight="700">AVAILABLE FAULT CURRENT</text>
  <text x="596" y="78" fill={C.muted} font-family={FONT} font-size="8" font-weight="700">MINIMUM AIC</text>

  {bars.map((r, i) => {
    const y = 88 + i * 30;
    const highBand = (r.aic ?? 0) > 10000;
    const accent = highBand ? C.red : C.green;
    return (
      <g>
        <text x="28" y={y + 16} fill={C.dark} font-family={FONT} font-size="10.5" font-weight="700">{`${r.ft} ft`}</text>
        <rect x={BAR_X} y={y + 2} width={r.width} height="20" rx="5" fill={accent} opacity="0.16" />
        <rect x={BAR_X} y={y + 2} width={r.width} height="20" rx="5" fill="none" stroke={accent} stroke-width="1.5" />
        <text x={BAR_X + 8} y={y + 17} fill={C.dark} font-family={FONT} font-size="10.5" font-weight="800">{`${fmtInt(Math.round(r.faultCurrent))} A`}</text>
        {r.ft > 0 && (
          <text x={BAR_X + r.width + 8} y={y + 17} fill={C.muted} font-family={FONT} font-size="8">{`M = ${fmt(r.multiplier, 4)}`}</text>
        )}
        <rect x="592" y={y + 3} width="82" height="18" rx="5" fill={accent} opacity="0.16" />
        <text x="633" y={y + 16} text-anchor="middle" fill={accent} font-family={FONT} font-size="9" font-weight="800">{`${fmtInt(r.aic ?? 0)} A`}</text>
      </g>
    );
  })}

  <rect x="24" y="240" width="672" height="30" rx="8" fill={C.primaryLight} stroke={C.primary} stroke-width="1.6" />
  <text x="40" y="259" fill={C.dark} font-family={FONT} font-size="10">
    {`100 ft sheds ${fmt(shed, 0)}%, and at ${firstLower?.ft} ft the requirement already drops from 22 kA to 10 kA equipment.`}
  </text>
</svg>
