---
import { transformerSecondaryFaultCurrent, requiredAicRating, fmtInt, fmt } from "@/lib/nec";
import { C, FONT } from "../infographicTokens";

/**
 * The transformer secondary calculation, and the tolerance decision. NEMA allows
 * ±10% on impedance, and the LOW side is the worst case for an interrupting
 * rating check — lower impedance means more fault current. Using nominal
 * impedance understates the requirement by about 11%.
 */
const KVA = 300;
const VOLTS = 480;
const PERCENT_Z = 3.5;

const withTol = transformerSecondaryFaultCurrent({ kva: KVA, secondaryVolts: VOLTS, phase: "3ph", percentZ: PERCENT_Z, applyToleranceMargin: true });
const nominal = transformerSecondaryFaultCurrent({ kva: KVA, secondaryVolts: VOLTS, phase: "3ph", percentZ: PERCENT_Z, applyToleranceMargin: false });
const understated = ((withTol.faultCurrent - nominal.faultCurrent) / nominal.faultCurrent) * 100;
---

<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 720 268" fill="none" aria-hidden="true">
  <title>Fault current at a transformer secondary</title>
  <desc>
    A 300 kVA transformer at 480 volts three-phase has a full-load current of 360.8 amps. Dividing by the nameplate
    impedance of 3.5 percent gives 10,310 amps of available fault current. Applying the NEMA minus 10 percent
    impedance tolerance reduces the effective impedance to 3.15 percent and raises the fault current to 11,455 amps,
    which is 11.1 percent higher and is the figure to use for an interrupting-rating check.
  </desc>

  <rect x="8" y="8" width="704" height="252" rx="12" fill={C.panelBg} stroke={C.border} />
  <text x="24" y="34" fill={C.dark} font-family={FONT} font-size="14" font-weight="700">{`${KVA} kVA, ${VOLTS} V three-phase, ${PERCENT_Z}% nameplate impedance`}</text>
  <text x="24" y="52" fill={C.muted} font-family={FONT} font-size="11">Symmetrical RMS fault current at the secondary terminals, assuming an infinite primary source.</text>

  {/* the chain */}
  <rect x="24" y="70" width="200" height="48" rx="9" fill={C.white} stroke={C.border} />
  <text x="40" y="88" fill={C.muted} font-family={FONT} font-size="8.5" font-weight="700">FULL-LOAD CURRENT</text>
  <text x="40" y="108" fill={C.dark} font-family={FONT} font-size="14" font-weight="800">{`${fmt(withTol.fla, 1)} A`}</text>

  <line x1="228" y1="94" x2="244" y2="94" stroke={C.border} stroke-width="2" />

  <rect x="248" y="70" width="200" height="48" rx="9" fill={C.white} stroke={C.border} />
  <text x="264" y="88" fill={C.muted} font-family={FONT} font-size="8.5" font-weight="700">÷ IMPEDANCE</text>
  <text x="264" y="108" fill={C.dark} font-family={FONT} font-size="14" font-weight="800">{`${fmt(withTol.effectivePercentZ, 2)}%`}</text>
  <text x="330" y="108" fill={C.muted} font-family={FONT} font-size="8.5">{`= ${PERCENT_Z} × 0.9`}</text>

  <line x1="452" y1="94" x2="468" y2="94" stroke={C.border} stroke-width="2" />

  <rect x="472" y="70" width="224" height="48" rx="9" fill={C.redLight} stroke={C.red} stroke-width="2.4" />
  <text x="488" y="88" fill={C.red} font-family={FONT} font-size="8.5" font-weight="700">AVAILABLE FAULT CURRENT</text>
  <text x="488" y="108" fill={C.red} font-family={FONT} font-size="17" font-weight="800">{`${fmtInt(Math.round(withTol.faultCurrent))} A`}</text>

  {/* tolerance comparison */}
  <text x="28" y="146" fill={C.muted} font-family={FONT} font-size="8" font-weight="700">IMPEDANCE ASSUMPTION</text>
  <text x="300" y="146" fill={C.muted} font-family={FONT} font-size="8" font-weight="700">EFFECTIVE %Z</text>
  <text x="410" y="146" fill={C.muted} font-family={FONT} font-size="8" font-weight="700">FAULT CURRENT</text>
  <text x="560" y="146" fill={C.muted} font-family={FONT} font-size="8" font-weight="700">MINIMUM AIC</text>

  {[
    { label: "Nameplate value as marked", z: nominal.effectivePercentZ, fc: nominal.faultCurrent, safe: false },
    { label: "NEMA −10% tolerance — use this", z: withTol.effectivePercentZ, fc: withTol.faultCurrent, safe: true },
  ].map((r, i) => {
    const y = 156 + i * 34;
    const accent = r.safe ? C.green : C.orange;
    return (
      <g>
        <rect x="24" y={y} width="672" height="30" rx="7" fill={accent} opacity="0.07" />
        <rect x="24" y={y} width="672" height="30" rx="7" fill="none" stroke={accent} stroke-width={r.safe ? 2 : 1.3} />
        <text x="40" y={y + 19} fill={C.dark} font-family={FONT} font-size="10" font-weight={r.safe ? 700 : 500}>{r.label}</text>
        <text x="300" y={y + 19} fill={C.dark} font-family={FONT} font-size="10">{`${fmt(r.z, 2)}%`}</text>
        <text x="410" y={y + 19} fill={accent} font-family={FONT} font-size="11" font-weight="800">{`${fmtInt(Math.round(r.fc))} A`}</text>
        <text x="560" y={y + 19} fill={C.dark} font-family={FONT} font-size="10" font-weight="700">{`${fmtInt(requiredAicRating(r.fc) ?? 0)} A`}</text>
      </g>
    );
  })}

  <text x="24" y="248" fill={C.muted} font-family={FONT} font-size="10">{`Using the nameplate impedance understates the requirement by ${fmt(understated, 1)}%. Low impedance produces MORE fault current.`}</text>
</svg>
