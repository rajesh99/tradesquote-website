---
import { C, FONT } from "../infographicTokens";

/**
 * An explicit scope statement, because a point-to-point calculation is a planning
 * tool and publishing one without its limits invites it to be used for arc-flash
 * labelling, which it cannot support.
 */
const columns = [
  {
    accent: C.green,
    heading: "What this method gives you",
    items: [
      "Symmetrical RMS fault current",
      "One transformer, one run",
      "An interrupting-rating check",
      "A conservative planning figure",
    ],
  },
  {
    accent: C.orange,
    heading: "Conservative on purpose",
    items: [
      "Infinite primary source — overstates",
      "−10% impedance — the worst case",
      "No cable-length credit upstream",
      "Errors point the safe way",
    ],
  },
  {
    accent: C.red,
    heading: "What it does NOT model",
    items: [
      "Motor contribution to the fault",
      "Multiple or parallel sources",
      "Asymmetrical peak current",
      "Arc-flash incident energy",
    ],
  },
];

const LANE_X = [24, 256, 488];
const LANE_W = 208;
---

<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 720 252" fill="none" aria-hidden="true">
  <title>What the point-to-point method covers and what it does not</title>
  <desc>
    The point-to-point method gives a symmetrical RMS fault current for one transformer and one conductor run, which is
    enough for an interrupting-rating check and for planning. It is conservative by design: it assumes an infinite
    primary source, applies the minus 10 percent impedance tolerance, and takes no credit for upstream cable length, so
    its errors point in the safe direction. It does not model motor contribution, multiple or parallel sources,
    asymmetrical peak current, or arc-flash incident energy.
  </desc>

  <rect x="8" y="8" width="704" height="236" rx="12" fill={C.panelBg} stroke={C.border} />
  <text x="24" y="34" fill={C.dark} font-family={FONT} font-size="14" font-weight="700">A planning tool, and it's worth knowing its edges</text>

  {columns.map((col, j) => (
    <g>
      <rect x={LANE_X[j]} y="48" width={LANE_W} height="152" rx="10" fill={col.accent} opacity="0.07" />
      <rect x={LANE_X[j]} y="48" width={LANE_W} height="152" rx="10" fill="none" stroke={col.accent} stroke-width="1.6" />
      <text x={LANE_X[j] + 14} y="70" fill={col.accent} font-family={FONT} font-size="10.5" font-weight="800">{col.heading}</text>
      {col.items.map((item, k) => (
        <g>
          <circle cx={LANE_X[j] + 20} cy={97 + k * 26} r="2.4" fill={col.accent} />
          <text x={LANE_X[j] + 30} y={100 + k * 26} fill={C.dark} font-family={FONT} font-size="8.5">{item}</text>
        </g>
      ))}
    </g>
  ))}

  <text x="24" y="228" fill={C.muted} font-family={FONT} font-size="10">Marginal ratings, coordination studies and arc-flash labelling need a licensed engineer and real study software.</text>
</svg>
