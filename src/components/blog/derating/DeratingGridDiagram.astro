---
import { ampacityOf, ambientFactor, bundlingFactor, CONDUCTOR_SIZES, fmt } from "@/lib/nec";
import { C, FONT } from "../infographicTokens";

/**
 * The two corrections multiply, so neither one alone tells you whether a circuit
 * survives. Six conductors pass at 30 °C and 40 °C but fail at 50 °C; nine pass
 * only at 30 °C. The failure boundary runs diagonally, which is exactly why
 * "four to six conductors is fine" is not a rule you can carry around.
 */
const SIZE = CONDUCTOR_SIZES.find((s) => s.label === "12")!;
const BREAKER = 20;
const base90 = ampacityOf(SIZE, "copper", 90)!;

const AMBIENTS = [30, 40, 50];
const COUNTS = [3, 6, 9];

const cells = COUNTS.map((count) =>
  AMBIENTS.map((ambientC) => {
    const amps = base90 * ambientFactor(ambientC, 90) * bundlingFactor(count);
    return { count, ambientC, amps, passes: amps >= BREAKER };
  }),
);

const COL_X = [156, 342, 528];
const COL_W = 168;
const ROW_Y = [104, 152, 200];
const ROW_H = 40;
const failures = cells.flat().filter((c) => !c.passes).length;
---

<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 720 276" fill="none" aria-hidden="true">
  <title>Ambient temperature and bundling multiply together</title>
  <desc>
    A grid of 12 AWG copper THHN adjusted ampacities against a 20 amp breaker. Three conductors give 30.00 amps at
    30 degrees, 27.30 at 40 degrees and 24.60 at 50 degrees, all passing. Six conductors give 24.00, 21.84 and 19.68
    amps, so 50 degrees fails. Nine conductors give 21.00, 19.11 and 17.22 amps, so only 30 degrees passes. Four of
    the nine combinations fail.
  </desc>

  <rect x="8" y="8" width="704" height="260" rx="12" fill={C.panelBg} stroke={C.border} />
  <text x="24" y="36" fill={C.dark} font-family={FONT} font-size="14" font-weight="700">Neither correction means anything on its own</text>
  <text x="24" y="54" fill={C.muted} font-family={FONT} font-size="11">{`12 AWG copper THHN, ${base90} A at 90 °C, against a ${BREAKER} A breaker. Green holds; red does not.`}</text>

  <text x="28" y="94" fill={C.muted} font-family={FONT} font-size="8" font-weight="700">CONDUCTORS</text>
  {AMBIENTS.map((a, j) => (
    <text x={COL_X[j] + COL_W / 2} y="94" text-anchor="middle" fill={C.muted} font-family={FONT} font-size="8" font-weight="700">
      {`${a} °C AMBIENT`}
    </text>
  ))}

  {cells.map((row, i) => (
    <g>
      <text x="28" y={ROW_Y[i] + 25} fill={C.dark} font-family={FONT} font-size="11" font-weight="700">{`${COUNTS[i]} in a raceway`}</text>
      <text x="28" y={ROW_Y[i] + 36} fill={C.muted} font-family={FONT} font-size="7.5">{`× ${bundlingFactor(COUNTS[i])}`}</text>
      {row.map((cell, j) => {
        const accent = cell.passes ? C.green : C.red;
        return (
          <g>
            <rect x={COL_X[j]} y={ROW_Y[i]} width={COL_W} height={ROW_H} rx="8" fill={accent} opacity="0.1" />
            <rect x={COL_X[j]} y={ROW_Y[i]} width={COL_W} height={ROW_H} rx="8" fill="none" stroke={accent} stroke-width={cell.passes ? 1.3 : 2.2} />
            <text x={COL_X[j] + 14} y={ROW_Y[i] + 26} fill={C.dark} font-family={FONT} font-size="13" font-weight="800">{`${fmt(cell.amps, 2)} A`}</text>
            <text x={COL_X[j] + COL_W - 14} y={ROW_Y[i] + 26} text-anchor="end" fill={accent} font-family={FONT} font-size="9.5" font-weight="700">
              {cell.passes ? "holds" : "fails"}
            </text>
          </g>
        );
      })}
    </g>
  ))}

  <text x="24" y="256" fill={C.muted} font-family={FONT} font-size="10">{`${failures} of the 9 combinations fail. The boundary runs diagonally, so no single conductor count is universally safe.`}</text>
</svg>
