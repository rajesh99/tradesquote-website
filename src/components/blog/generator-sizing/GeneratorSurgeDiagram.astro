---
import { fmt, fmtInt } from "@/lib/nec";
import { C, FONT } from "../infographicTokens";

/**
 * One input — how hard the largest motor starts — moves the answer across four
 * generator sizes on identical loads. It is the strongest lever in the calculation,
 * and a soft starter is what buys the bottom row.
 */
const STANDARD_KW = [7.5, 10, 12, 14, 16, 18, 20, 22, 24, 26, 30, 36, 48, 60];

const RUNNING_TOTAL = 9200;
const LARGEST_MOTOR = 5000;
const MARGIN = 0.25;
const runningRequirement = RUNNING_TOTAL * (1 + MARGIN);

const rows = [
  { surge: 1, label: "1× — soft starter or inverter compressor" },
  { surge: 2, label: "2× — easy starting" },
  { surge: 3, label: "3× — typical motor" },
  { surge: 4, label: "4× — hard-starting compressor" },
].map((r) => {
  const starting = RUNNING_TOTAL - LARGEST_MOTOR + LARGEST_MOTOR * r.surge;
  const required = Math.max(runningRequirement, starting);
  const selected = STANDARD_KW.find((k) => k >= required / 1000) ?? 60;
  return { ...r, starting, required, selected, startingGoverns: starting > runningRequirement };
});

const peak = Math.max(...rows.map((r) => r.required));
const BAR_X = 300;
const BAR_MAX = 300;
const bars = rows.map((r) => ({ ...r, width: Math.round((r.required / peak) * BAR_MAX) }));
const saving = rows[2].selected - rows[0].selected;
---

<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 720 254" fill="none" aria-hidden="true">
  <title>How motor inrush changes the generator size</title>
  <desc>
    On identical 9,200 watt loads, a soft-started compressor needs only 11,500 watts and a 12 kilowatt set. A 2
    times surge needs 14,200 watts and a 16 kilowatt set. A typical 3 times surge needs 19,200 watts and a 20
    kilowatt set. A hard-starting compressor at 4 times needs 24,200 watts and a 26 kilowatt set. Fitting a soft
    starter drops the requirement by 8 kilowatts.
  </desc>

  <rect x="8" y="8" width="704" height="238" rx="12" fill={C.panelBg} stroke={C.border} />
  <text x="24" y="36" fill={C.dark} font-family={FONT} font-size="14" font-weight="700">The same loads, four generator sizes</text>
  <text x="24" y="54" fill={C.muted} font-family={FONT} font-size="11">{`${fmtInt(RUNNING_TOTAL)} W running in every row. Only how hard the ${fmtInt(LARGEST_MOTOR)} W compressor starts changes.`}</text>

  {bars.map((r, i) => {
    const y = 76 + i * 36;
    const accent = i === 0 ? C.green : i === 3 ? C.red : C.orange;
    return (
      <g>
        <text x="28" y={y + 15} fill={C.dark} font-family={FONT} font-size="10.5" font-weight="700">{r.label}</text>
        <text x="28" y={y + 27} fill={C.muted} font-family={FONT} font-size="8">{`starting requirement ${fmtInt(r.starting)} W${r.startingGoverns ? "" : " — running load governs"}`}</text>
        <rect x={BAR_X} y={y + 2} width={r.width} height="24" rx="6" fill={accent} opacity="0.16" />
        <rect x={BAR_X} y={y + 2} width={r.width} height="24" rx="6" fill="none" stroke={accent} stroke-width="1.5" />
        <text x={BAR_X + r.width - 10} y={y + 19} text-anchor="end" fill={C.dark} font-family={FONT} font-size="12.5" font-weight="800">{`${fmt(r.selected, r.selected % 1 === 0 ? 0 : 1)} kW`}</text>
        <text x={BAR_X + BAR_MAX + 14} y={y + 19} fill={C.muted} font-family={FONT} font-size="9">{`${fmt(r.required / 1000, 1)} kW needed`}</text>
      </g>
    );
  })}

  <text x="24" y="234" fill={C.green} font-family={FONT} font-size="10" font-weight="700">{`A soft starter on the compressor drops the set by ${saving} kW — normally a far cheaper part than the difference between the two generators.`}</text>
</svg>
