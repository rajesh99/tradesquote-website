---
import { C, FONT } from "../infographicTokens";

/**
 * The standard method on a 2,000 ft² house — the same house the optional-method
 * example uses, so the two can be compared directly. Every figure is computed here
 * rather than hardcoded.
 */
const SQFT = 2000;
const generalLighting = SQFT * 3;
const sac = 2 * 1500;
const laundry = 1 * 1500;
const lightingGroup = generalLighting + sac + laundry;

// Table 220.42 — first 3,000 VA at 100%, 3,001–120,000 at 35%.
const tier1 = Math.min(lightingGroup, 3000);
const tier2 = Math.max(0, lightingGroup - 3000);
const lightingDemand = tier1 + tier2 * 0.35;

const range = 8000; // Table 220.55, Column C — one range not over 12 kW
const dryer = 5000; // Table 220.54 — 5,000 VA or nameplate, whichever is greater
const fixedAppliances = 4500 + 1200; // water heater + dishwasher; only 2, so no 75% factor
const hvac = 5000; // 220.60 — largest of noncoincident heating/cooling

const total = lightingDemand + range + dryer + fixedAppliances + hvac;
const amps = total / 240;

const rows = [
  { label: "Lighting group after Table 220.42", detail: "3,000 @ 100% + 7,500 @ 35%", value: lightingDemand },
  { label: "Range — Table 220.55, Column C", detail: "12 kW nameplate counts as 8 kW", value: range },
  { label: "Dryer — Table 220.54", detail: "5,000 VA minimum", value: dryer },
  { label: "Fixed appliances — 220.53", detail: "only 2, so no 75% factor", value: fixedAppliances },
  { label: "Largest of heat or A/C — 220.60", detail: "noncoincident loads", value: hvac },
];

const fmt = (n: number) => n.toLocaleString("en-US");
---

<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 720 340" fill="none" aria-hidden="true">
  <title>The standard method load calculation step by step</title>
  <desc>
    Standard method on a 2,000 square foot house. The lighting group of 10,500 volt-amperes — general
    lighting plus small appliance and laundry circuits — reduces to 5,625 after Table 220.42 takes the first
    3,000 at 100 percent and the remaining 7,500 at 35 percent. A 12 kilowatt range counts as 8,000 under
    Table 220.55 Column C. The dryer is 5,000 under Table 220.54. Water heater and dishwasher total 5,700
    with no 75 percent factor because there are only two fixed appliances. Air conditioning adds 5,000 as the
    larger noncoincident load. The total is 29,325 volt-amperes, or 122.2 amps.
  </desc>

  <rect x="8" y="8" width="704" height="324" rx="12" fill={C.panelBg} stroke={C.border} />
  <text x="24" y="36" fill={C.dark} font-family={FONT} font-size="14" font-weight="700">Standard method — every category gets its own factor</text>
  <text x="24" y="54" fill={C.muted} font-family={FONT} font-size="11">{`2,000 ft² house · lighting group ${fmt(lightingGroup)} VA before demand factors`}</text>

  {rows.map((r, i) => {
    const y = 74 + i * 38;
    return (
      <g>
        <rect x="24" y={y} width="672" height="33" rx="6" fill={C.white} stroke={C.border} stroke-width="0.9" />
        <text x="40" y={y + 15} fill={C.dark} font-family={FONT} font-size="10.5" font-weight="700">{r.label}</text>
        <text x="40" y={y + 27} fill={C.muted} font-family={FONT} font-size="9">{r.detail}</text>
        <text x="676" y={y + 21} text-anchor="end" fill={C.dark} font-family={FONT} font-size="12.5" font-weight="800">{`${fmt(r.value)} VA`}</text>
      </g>
    );
  })}

  <line x1="24" y1="272" x2="696" y2="272" stroke={C.dark} stroke-width="1.2" />

  <rect x="24" y="282" width="672" height="42" rx="9" fill={C.blueLight} stroke={C.blue} stroke-width="1.7" />
  <text x="44" y="300" fill={C.dark} font-family={FONT} font-size="11.5" font-weight="800">{`Total ${fmt(total)} VA ÷ 240 V`}</text>
  <text x="44" y="316" fill={C.muted} font-family={FONT} font-size="9.5">Compare with 101.2 A by the optional method on the identical house</text>
  <text x="676" y="312" text-anchor="end" fill={C.blue} font-family={FONT} font-size="26" font-weight="800">{`${amps.toFixed(1)} A`}</text>
</svg>
