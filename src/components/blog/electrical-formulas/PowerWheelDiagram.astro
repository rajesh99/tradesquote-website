---
import { C, FONT } from "../infographicTokens";

/**
 * The power wheel — the twelve rearrangements of Ohm's law and the power formula.
 * Any two of V, I, R and P give the other two.
 */
const groups = [
  {
    symbol: "V",
    name: "VOLTS",
    unit: "potential difference",
    formulas: ["V = I × R", "V = P ÷ I", "V = √(P × R)"],
    accent: C.blue,
    bg: C.blueLight,
  },
  {
    symbol: "I",
    name: "AMPS",
    unit: "current",
    formulas: ["I = V ÷ R", "I = P ÷ V", "I = √(P ÷ R)"],
    accent: C.orange,
    bg: C.orangeLight,
  },
  {
    symbol: "R",
    name: "OHMS",
    unit: "resistance",
    formulas: ["R = V ÷ I", "R = V² ÷ P", "R = P ÷ I²"],
    accent: C.primary,
    bg: C.primaryLight,
  },
  {
    symbol: "P",
    name: "WATTS",
    unit: "real power",
    formulas: ["P = V × I", "P = I² × R", "P = V² ÷ R"],
    accent: C.red,
    bg: C.redLight,
  },
];
---

<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 720 254" fill="none" aria-hidden="true">
  <title>The power wheel — twelve forms of Ohm's law and the power formula</title>
  <desc>
    Volts equals current times resistance, power divided by current, or the square root of power times resistance.
    Amps equals volts divided by resistance, power divided by volts, or the square root of power divided by
    resistance. Ohms equals volts divided by current, volts squared divided by power, or power divided by current
    squared. Watts equals volts times current, current squared times resistance, or volts squared divided by
    resistance. Knowing any two quantities gives the other two.
  </desc>

  <rect x="8" y="8" width="704" height="238" rx="12" fill={C.panelBg} stroke={C.border} />
  <text x="24" y="36" fill={C.dark} font-family={FONT} font-size="14" font-weight="700">Know any two, and the other two follow</text>
  <text x="24" y="54" fill={C.muted} font-family={FONT} font-size="11">Ohm's law and the power formula, in all twelve rearrangements.</text>

  {groups.map((g, i) => {
    const x = 24 + i * 172;
    return (
      <g>
        <rect x={x} y="72" width="160" height="150" rx="10" fill={g.bg} stroke={g.accent} stroke-width="1.5" />
        <circle cx={x + 26} cy="96" r="14" fill={g.accent} opacity="0.16" />
        <text x={x + 26} y="101" text-anchor="middle" fill={g.accent} font-family={FONT} font-size="14" font-weight="800">{g.symbol}</text>
        <text x={x + 48} y="94" fill={C.dark} font-family={FONT} font-size="10.5" font-weight="800">{g.name}</text>
        <text x={x + 48} y="106" fill={C.muted} font-family={FONT} font-size="8">{g.unit}</text>
        <line x1={x + 14} y1="120" x2={x + 146} y2="120" stroke={g.accent} stroke-width="1" opacity="0.4" />
        {g.formulas.map((f, j) => (
          <text x={x + 16} y={144 + j * 26} fill={C.dark} font-family={FONT} font-size="13" font-weight="700">{f}</text>
        ))}
      </g>
    );
  })}
</svg>
