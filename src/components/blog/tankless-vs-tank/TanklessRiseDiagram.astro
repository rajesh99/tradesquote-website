---
import { C, FONT } from "../infographicTokens";
import { tanklessGpm, fmt } from "@/lib/plumbing";

/**
 * The tankless spec sheet's headline gpm is quoted at a rise nobody in a cold
 * climate ever sees. The same unit is a different appliance in Minnesota and in
 * Florida, and that is the whole answer to "will it keep up".
 */
const BTU = 199000;
const EFF = 0.95;
const RISES = [
  { rise: 30, note: "Florida in summer — 75 °F in" },
  { rise: 40, note: "warm climate" },
  { rise: 50, note: "mild winter" },
  { rise: 60, note: "cold winter" },
  { rise: 70, note: "northern winter — 50 °F in" },
  { rise: 80, note: "hard northern winter — 40 °F in" },
];

const SHOWER_GPM = 2;

/* `showers` and `tight` are derived HERE rather than in the template: a `<` or
   `<=` inside the markup section is parsed by the Astro compiler as a tag
   opener, not as a comparison. */
const rows = RISES.map((r) => {
  const gpm = tanklessGpm(BTU, EFF, r.rise);
  const showers = Math.floor(gpm / SHOWER_GPM);
  return { ...r, gpm, showers, tight: showers <= 2 };
});

const maxGpm = Math.max(...rows.map((r) => r.gpm));

const BAR_X = 236;
const BAR_MAX = 268;
---

<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 720 288" fill="none" aria-hidden="true">
  <title>Tankless flow rate against temperature rise</title>
  <desc>
    One two-hundred-thousand BTU tankless unit at six temperature rises. Its rated flow more than halves between a warm
    climate and a northern winter, which is why the same model behaves differently by geography.
  </desc>

  <rect x="8" y="8" width="704" height="272" rx="12" fill={C.panelBg} stroke={C.border} />
  <text x="24" y="34" fill={C.dark} font-family={FONT} font-size="14" font-weight="700">The same unit is a different appliance in a cold climate</text>
  <text x="24" y="52" fill={C.muted} font-family={FONT} font-size="11">
    {`One ${fmt(BTU / 1000)}k BTU tankless at ${fmt(EFF * 100)}% efficiency. Rise is outlet temperature minus incoming groundwater temperature.`}
  </text>

  {rows.map((row, i) => {
    const y = 76 + i * 30;
    const w = Math.max(3, (row.gpm / maxGpm) * BAR_MAX);
    const { showers, tight } = row;
    return (
      <g>
        <text x="28" y={y + 12} fill={C.dark} font-family={FONT} font-size="10.5" font-weight="700">{`${row.rise} °F rise`}</text>
        <text x="98" y={y + 12} fill={C.muted} font-family={FONT} font-size="9">{row.note}</text>
        <rect x={BAR_X} y={y} width={BAR_MAX} height="19" rx="5" fill={C.border} opacity="0.28" />
        <rect x={BAR_X} y={y} width={w} height="19" rx="5" fill={tight ? C.orange : C.primary} opacity="0.72" />
        <text x={BAR_X + BAR_MAX + 10} y={y + 14} fill={tight ? C.orange : C.primary} font-family={FONT} font-size="10.5" font-weight="800">
          {`${fmt(row.gpm, 2)} gpm · ${showers} shower${showers === 1 ? "" : "s"}`}
        </text>
      </g>
    );
  })}

  <text x="24" y="264" fill={C.muted} font-family={FONT} font-size="10">
    {`Rated flow falls ${fmt(rows[0].gpm / rows[rows.length - 1].gpm, 1)}x across this range. A datasheet headline quoted at a 35 °F rise tells a northern buyer almost nothing.`}
  </text>
</svg>
