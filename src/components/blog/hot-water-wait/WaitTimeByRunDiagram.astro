---
import { C, FONT } from "../infographicTokens";
import {
  insideDiameter, pipeVolume, fmt,
} from "@/lib/plumbing";
/** Distance is the dominant term, and it is linear — which is why the fix is
 * a shorter path or a recirculation loop, never a bigger heater. */
const FLOW_GPM = 2;
const ID = insideDiameter("copper-l", 0.75)!;
const RUNS = [10, 25, 50, 75, 100];

const results = RUNS.map((ft) => {
  const v = pipeVolume(ID, ft);
  return { ft, gallons: v.gallons, seconds: (v.gallons / FLOW_GPM) * 60 };
});
const maxSec = Math.max(...results.map((r) => r.seconds));

const rows = results.map((r) => ({
  label: `${r.ft} ft run`,
  value: r.seconds,
  frac: r.seconds / maxSec,
  display: `${fmt(r.seconds, 0)} s  ·  ${fmt(r.gallons, 2)} gal down the drain each time`,
  highlight: r.ft === 100,
}));

/* Bar geometry. The value label is drawn at BAR_X + width + 10, so BAR_MAX is
   chosen to leave room for the longest label inside the 720-wide viewBox. */
const BAR_X = 130;
const BAR_MAX = 250;
---

<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 720 278" fill="none" aria-hidden="true">
  <title>Distance decides it — 3/4 inch copper at 2 gpm</title>
  <desc>Every foot of hot line between the heater and the tap is water you pay to heat and then pour away</desc>

  <rect x="8" y="8" width="704" height="264" rx="12" fill={C.panelBg} stroke={C.border} />
  <text x="24" y="34" fill={C.dark} font-family={FONT} font-size="14" font-weight="700">Distance decides it — 3/4 inch copper at 2 gpm</text>
  <text x="24" y="52" fill={C.muted} font-family={FONT} font-size="11">Every foot of hot line between the heater and the tap is water you pay to heat and then pour away</text>

  {rows.map((row, i) => {
    const y = 82 + i * 30;
    const w = Math.max(2, row.frac * BAR_MAX);
    return (
      <g>
        <text x="28" y={y + 15} fill={C.dark} font-family={FONT} font-size="10.5" font-weight="700">{row.label}</text>
        <rect x={BAR_X} y={y + 3} width={BAR_MAX} height="18" rx="5" fill={C.border} opacity="0.28" />
        <rect x={BAR_X} y={y + 3} width={w} height="18" rx="5" fill={row.highlight ? C.primary : C.orange} opacity={row.highlight ? 0.95 : 0.62} />
        <text x={BAR_X + BAR_MAX + 10} y={y + 16} fill={row.highlight ? C.primary : C.dark} font-family={FONT} font-size="10.5" font-weight={row.highlight ? 800 : 600}>
          {row.display}
        </text>
      </g>
    );
  })}

  <text x="24" y="258" fill={C.muted} font-family={FONT} font-size="10">A hundred feet is a 75 second wait and two and a half gallons wasted on every single draw of hot water.</text>
</svg>
