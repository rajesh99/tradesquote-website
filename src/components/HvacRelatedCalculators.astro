---
/**
 * HVAC-flavoured wrapper around the category-neutral `RelatedCalculators`.
 * Kept so the 40+ existing HVAC calculator pages need no changes; it just
 * resolves the HVAC accent map and forwards.
 */
import type { HvacCalculatorAccent } from "@/config/hvacCalculators";
import { hvacAccentStyles } from "@/config/hvacCalculators";
import RelatedCalculators from "@/components/RelatedCalculators.astro";

export type HvacRelatedCalculator = {
  href: string;
  title: string;
  description: string;
};

interface Props {
  calculators: HvacRelatedCalculator[];
  accent?: HvacCalculatorAccent;
  heading?: string;
}

const { calculators, accent = "blue", heading = "More HVAC calculators" } = Astro.props;
const styles = hvacAccentStyles[accent];
---

<RelatedCalculators {calculators} {styles} {heading} />
